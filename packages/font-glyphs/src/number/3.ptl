$$include '../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [MathSansSerif] from "@iosevka/glyph/relation"

glyph-module

glyph-block Digits-Three : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Digits-Shared : OnumHeight OnumMarks ShiftDown CodeLnum CodeOnum
	glyph-block-import Letter-Latin-Ezh : Ezh
	glyph-block-import Letter-Latin-C : CLetterForm
	glyph-block-import Letter-Arc-Hook : MakeFlatHook

	define SLAB-NONE      0
	define SLAB-FLAT-HOOK 4

	define [ThreeShapeT sink offset sw top flatHook] : glyph-proc
		local barcenter : mix 0 top HBarPos
		local xMid : mix SB RightSB 0.4
		local fine : sw * CThin

		include : sink
			widths.rhs sw
			if flatHook
				[MakeFlatHook SB RightSB top 0 (sw -- sw)].hookStartL
				list
					g4 (SB + offset - O) (top - Hook)
					HookStart (top - offset) (sw -- sw)
			g4 (RightSB - offset) [YSmoothMidR (top - offset - O) (barcenter - sw / 2) ArchDepthA ArchDepthB]
			flat (xMid + TINY) (barcenter - (fine - sw / 2)) [widths.rhs.heading fine Leftward]
			curl xMid (barcenter - (fine - sw / 2)) [heading Leftward]
		include : sink
			widths.rhs fine
			flat xMid (barcenter + (fine - sw / 2)) [heading Rightward]
			curl (xMid + TINY) (barcenter + (fine - sw / 2)) [heading Rightward]
			g4 (RightSB - offset - O * 2) [YSmoothMidR (barcenter + sw / 2) (offset + O) ArchDepthA ArchDepthB] [widths.rhs sw]
			if flatHook
				[MakeFlatHook SB RightSB top 0 (sw -- sw)].hookEndL
				list
					HookEnd offset (sw -- sw)
					g4 (SB + offset + O) Hook

	define [ThreeShape top] : ThreeShapeT dispiro 0 Stroke top
	define [ThreeShapeFlatHook top] : ThreeShapeT dispiro 0 Stroke top true

	define [ThreeFlatTopShape top serif flatHook] : glyph-proc
		define ezh : Ezh [DivFrame 1] top 0
			pxMidLeft  -- 0.25
			pxTopRight -- 0.975
			fSerifed   -- serif
			fFlatHook  -- flatHook
		include : ezh.Shape

	# Horizontal top bar plus a tironian-et diagonal (60° from horizontal,
	# diagonal terminal). Reversed-c bowl is clipped against that stem so
	# the arch continues past it.
	define [ThreeFlatTopArchedShape top serif flatHook] : glyph-proc
		local kFall : Math.tan (60 * Math.PI / 180)
		local yBarBot : top - Stroke
		local cor : Stroke * [DiagCor kFall 1]
		local yEndIdeal : mix 0 top 0.50
		local xEnd : Math.max (SB + cor) : RightSB - (yBarBot - yEndIdeal) / kFall
		local yEnd : yBarBot - (RightSB - xEnd) * kFall
		local yBowl : mix 0 top 0.74
		local styBot : if flatHook SLAB-FLAT-HOOK SLAB-NONE

		define [etTop] : union
			HBar.t SB RightSB top
			intersection
				Rect yBarBot (yEnd - 2 * Stroke) SB RightSB
				dispiro
					widths.rhs
					flat RightSB yBarBot
					curl xEnd yEnd

		local lf : CLetterForm [DivFrame 1] SLAB-NONE styBot yBowl 0
			ada -- [ArchDepthAClamped yBowl 0 ArchDepthA ArchDepthB]
			adb -- [ArchDepthBClamped yBowl 0 ArchDepthA ArchDepthB]

		include : union
			etTop
			difference
				intersection
					lf.revFull
					MaskBelowLine RightSB yBarBot xEnd yEnd 4
				union
					etTop
					intersection [MaskLeft xEnd] [MaskAbove yEnd]
		if serif : include : VSerif.dl (SB + (OX - O)) top VJut

	create-glyph 'three.lnum.rounded' : glyph-proc
		include : MarkSet.capital
		include : ThreeShape CAP
	create-glyph 'three.lnum.flatTopArched' : glyph-proc
		include : MarkSet.capital
		include : ThreeFlatTopArchedShape CAP false false
	create-glyph 'three.lnum.flatTopArchedSerifed' : glyph-proc
		include : MarkSet.capital
		include : ThreeFlatTopArchedShape CAP true false
	create-glyph 'three.lnum.flatTopArchedFlatHook' : glyph-proc
		include : MarkSet.capital
		include : ThreeFlatTopArchedShape CAP false true
	create-glyph 'three.lnum.flatTopArchedSerifedFlatHook' : glyph-proc
		include : MarkSet.capital
		include : ThreeFlatTopArchedShape CAP true true
	create-glyph 'three.lnum.flatHooked' : glyph-proc
		include : MarkSet.capital
		include : ThreeShapeFlatHook CAP
	create-glyph 'three.lnum.flatTop' : glyph-proc
		include : MarkSet.capital
		include : ThreeFlatTopShape CAP false false
	create-glyph 'three.lnum.flatTopSerifed' : glyph-proc
		include : MarkSet.capital
		include : ThreeFlatTopShape CAP true false
	create-glyph 'three.lnum.flatTopFlatHook' : glyph-proc
		include : MarkSet.capital
		include : ThreeFlatTopShape CAP false true
	create-glyph 'three.lnum.flatTopSerifedFlatHook' : glyph-proc
		include : MarkSet.capital
		include : ThreeFlatTopShape CAP true true
	create-glyph 'three.onum.rounded' : glyph-proc
		include : OnumMarks.p
		include : ThreeShape CAP
		include : ShiftDown
	create-glyph 'three.onum.flatTopArched' : glyph-proc
		include : OnumMarks.p
		include : ThreeFlatTopArchedShape CAP false false
		include : ShiftDown
	create-glyph 'three.onum.flatTopArchedSerifed' : glyph-proc
		include : OnumMarks.p
		include : ThreeFlatTopArchedShape CAP true false
		include : ShiftDown
	create-glyph 'three.onum.flatTopArchedFlatHook' : glyph-proc
		include : OnumMarks.p
		include : ThreeFlatTopArchedShape CAP false true
		include : ShiftDown
	create-glyph 'three.onum.flatTopArchedSerifedFlatHook' : glyph-proc
		include : OnumMarks.p
		include : ThreeFlatTopArchedShape CAP true true
		include : ShiftDown
	create-glyph 'three.onum.flatHooked' : glyph-proc
		include : OnumMarks.p
		include : ThreeShapeFlatHook CAP
		include : ShiftDown
	create-glyph 'three.onum.flatTop' : glyph-proc
		include : OnumMarks.p
		include : ThreeFlatTopShape CAP false false
		include : ShiftDown
	create-glyph 'three.onum.flatTopSerifed' : glyph-proc
		include : OnumMarks.p
		include : ThreeFlatTopShape CAP true false
		include : ShiftDown
	create-glyph 'three.onum.flatTopFlatHook' : glyph-proc
		include : OnumMarks.p
		include : ThreeFlatTopShape CAP false true
		include : ShiftDown
	create-glyph 'three.onum.flatTopSerifedFlatHook' : glyph-proc
		include : OnumMarks.p
		include : ThreeFlatTopShape CAP true true
		include : ShiftDown

	select-variant 'three.lnum' [CodeLnum '3'] (follow -- 'three')
	select-variant 'three.onum' [CodeOnum '3'] (follow -- 'three')

	turned 'turnThree' 0x218B 'three.lnum' Middle (CAP / 2)

	link-reduced-variant 'three/sansSerif.lnum' 'three.lnum' MathSansSerif (follow -- 'three/sansSerif')
	link-reduced-variant 'three/sansSerif.onum' 'three.onum' MathSansSerif (follow -- 'three/sansSerif')

	glyph-block-import Letter-Blackboard : BBS BBD
	create-glyph 'mathbb/three' 0x1D7DB : glyph-proc
		include : MarkSet.capital
		include : union
			ThreeShapeT dispiro 0 BBS CAP
			intersection
				ThreeShapeT spiro-outline 1 BBS CAP
				union
					VBar.r (RightSB - BBD)    [mix 0 CAP HBarPos] CAP          BBS
					VBar.r (RightSB - BBD - O * 2) 0       [mix 0 CAP HBarPos] BBS
