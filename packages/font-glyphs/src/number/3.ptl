$$include '../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from '@iosevka/util'
import [MathSansSerif] from '@iosevka/glyph/relation'
import [Box] from '@iosevka/geometry/box'

glyph-module

glyph-block Digits-Three-Top : begin
	glyph-block-import CommonShapes

	glyph-block-export ThreeFlatTopEtGeom ThreeFlatTopEtTop
	define [ThreeFlatTopEtGeom top _yEndIdeal _sw _angle _left _right] : begin
		local sw : fallback _sw Stroke
		local left : fallback _left SB
		local right : fallback _right RightSB
		local kFall : Math.tan ([fallback _angle 50] * Math.PI / 180)
		local yBarBot : top - sw
		local cor : sw * [DiagCor kFall 1]
		local yEndIdeal : Math.min (yBarBot - sw / 2) : fallback _yEndIdeal : mix 0 top 0.42
		local xEnd : Math.max (left + cor) : right - (yBarBot - yEndIdeal) / kFall
		local yEnd : yBarBot - (right - xEnd) * kFall
		return : object kFall yBarBot cor xEnd yEnd

	define [ThreeFlatTopEtTop top _swEnd _yEndIdeal _sw _angle _left _right] : glyph-proc
		local sw : fallback _sw Stroke
		local left : fallback _left SB
		local right : fallback _right RightSB
		local swEnd : fallback _swEnd sw
		local [object yBarBot xEnd yEnd] : ThreeFlatTopEtGeom top _yEndIdeal sw _angle left right
		include : union
			HBar.t left right top sw
			intersection
				Rect yBarBot (yEnd - 2 * sw) left right
				dispiro
					widths.rhs sw
					flat right yBarBot
					curl xEnd yEnd [widths.rhs swEnd]

glyph-block Digits-Three : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Digits-Three-Top : ThreeFlatTopEtGeom ThreeFlatTopEtTop
	glyph-block-import Digits-Shared : OnumHeight OnumMarks ShiftDown CodeLnum CodeOnum
	glyph-block-import Letter-Latin-Ezh : Ezh
	glyph-block-import Letter-Latin-C : CLetterForm
	glyph-block-import Letter-Arc-Hook : MakeFlatHook MakeCornerHook Rounded Flat
	glyph-block-import Letter-Shared-Shapes : SerifedArcStart SerifedArcEnd InwardSlabArcStart InwardSlabArcEnd ArcStartSerif ArcEndSerif

	define SLAB-NONE        0
	define SLAB-CLASSICAL   1
	define FLAT-CONNECTION  3
	define SLAB-FLAT-HOOK   4
	define SLAB-CORNER-HOOK 5

	define HOOK-ROUND  0
	define HOOK-FLAT   1
	define HOOK-CORNER 2
	define HOOK-INWARD 3
	define HOOK-SLAB   4

	define [ThreeShapeT sink offset sw top hookStyle _bottomHookStyle] : glyph-proc
		local barcenter : mix 0 top HBarPos
		local xMid : mix SB RightSB 0.4
		local fine : sw * CThin
		local bottomHookStyle : fallback _bottomHookStyle hookStyle

		include : sink
			widths.rhs sw
			match hookStyle
				[Just HOOK-FLAT]   : [MakeFlatHook SB RightSB top 0 (sw -- sw)].hookStartL
				[Just HOOK-CORNER] : [MakeCornerHook SB RightSB top 0 (sw -- sw)].hookStartL
				[Just HOOK-INWARD] : InwardSlabArcStart.LtrRhs (SB + offset) (top - offset) sw Hook
				[Just HOOK-SLAB]   : SerifedArcStart.LtrRhs (SB + offset) (top - offset) sw Hook
				__ : list
					g4 (SB + offset - O) (top - Hook)
					HookStart (top - offset) (sw -- sw)
			g4 (RightSB - offset) [YSmoothMidR (top - offset - O) (barcenter - sw / 2) ArchDepthA ArchDepthB]
			flat (xMid + TINY) (barcenter - (fine - sw / 2)) [widths.rhs.heading fine Leftward]
			curl xMid (barcenter - (fine - sw / 2)) [heading Leftward]
		include : sink
			widths.rhs fine
			flat xMid (barcenter + (fine - sw / 2)) [heading Rightward]
			curl (xMid + TINY) (barcenter + (fine - sw / 2)) [heading Rightward]
			g4 (RightSB - offset - O * 2) [YSmoothMidR (barcenter + sw / 2) (offset + O) ArchDepthA ArchDepthB] [widths.rhs sw]
			match bottomHookStyle
				[Just HOOK-FLAT]   : [MakeFlatHook SB RightSB top 0 (sw -- sw)].hookEndL
				[Just HOOK-CORNER] : [MakeCornerHook SB RightSB top 0 (sw -- sw)].hookEndL
				[Just HOOK-INWARD] : InwardSlabArcEnd.RtlRhs (SB + offset) offset sw Hook
				[Just HOOK-SLAB]   : SerifedArcEnd.RtlRhs (SB + offset) offset sw Hook
				__ : list
					HookEnd offset (sw -- sw)
					g4 (SB + offset + O) Hook
		if (hookStyle === HOOK-INWARD) : include : ArcStartSerif.InwardL (SB + offset) (top - offset) sw Hook
		if (bottomHookStyle === HOOK-INWARD) : include : ArcEndSerif.InwardL (SB + offset) offset sw Hook
		if (hookStyle === HOOK-SLAB) : include : ArcStartSerif.L (SB + offset) (top - offset) sw Hook
		if (bottomHookStyle === HOOK-SLAB) : include : ArcEndSerif.L (SB + offset) offset sw Hook

	define [ThreeShape top] : ThreeShapeT dispiro 0 Stroke top
	define [ThreeShapeHooked top hookStyle bottomHookStyle] : ThreeShapeT dispiro 0 Stroke top hookStyle bottomHookStyle

	define [ThreeFlatTopShape top serif hookStyle _sw lowerEnd lowerEndY] : glyph-proc
		local sw : fallback _sw Stroke
		define ezh : Ezh [DivFrame 1] top 0
			pxMidLeft    -- 0.25
			pxTopRight   -- 0.975
			fSerifed     -- serif
			fFlatHook    -- (hookStyle === HOOK-FLAT)
			fCornerHook  -- (hookStyle === HOOK-CORNER)
			terminal     -- [if lowerEnd 0 [if (hookStyle === HOOK-SLAB) 2 1]]
			stroke       -- sw
			lowerEnd     -- lowerEnd
			lowerEndY    -- lowerEndY
		include : ezh.Shape
		if (hookStyle === HOOK-SLAB) : include : ArcEndSerif.L SB 0 Stroke Hook

	define [ThreeFlatTopBrokenShape top serif hookStyle _sw lowerEnd lowerEndY _angle] : glyph-proc
		local sw : fallback _sw Stroke
		local [object kFall yBarBot cor xEnd yEnd] : ThreeFlatTopEtGeom top nothing sw _angle
		local yBowl : mix 0 top 0.72
		local joinOverlap : if _angle [Math.max 2 : 0.08 * sw] 0
		local styBot : match hookStyle
			[Just HOOK-FLAT]   SLAB-FLAT-HOOK
			[Just HOOK-CORNER] SLAB-CORNER-HOOK
			[Just HOOK-SLAB]   SLAB-CLASSICAL
			__                 SLAB-NONE

		define [etTop] : ThreeFlatTopEtTop top nothing nothing sw _angle

		local lf : CLetterForm [DivFrame 1] FLAT-CONNECTION styBot yBowl 0
			ada -- [ArchDepthAClamped yBowl 0 ArchDepthA ArchDepthB]
			adb -- [ArchDepthBClamped yBowl 0 ArchDepthA ArchDepthB]
			sw  -- sw
			lowerEnd -- lowerEnd
			lowerEndY -- lowerEndY

		include : union
			etTop
			difference
				lf.revFull
				union
					MaskAboveLine RightSB (yBarBot + joinOverlap) xEnd (yEnd + joinOverlap)
					intersection [MaskLeft xEnd] [MaskAbove (yEnd + joinOverlap)]
		if serif : begin
			local serifX : SB + (OX - O)
			local serifInnerX : serifX + [HSwToV VJutStroke]
			local maxSerifLength : Math.max 0 : top - (yBarBot - (RightSB - [HSwToV cor] - serifInnerX) * kFall) - [AdviceStroke 12]
			local serifLength : if _angle [Math.min VJut maxSerifLength] VJut
			include : VSerif.dl serifX top serifLength

	glyph-block-export ThreeFlatHookTop ThreeFlatHookBrokenTop
	define [ThreeFlatHookTop top serif sw lowerEnd lowerEndY] : ThreeFlatTopShape top serif HOOK-FLAT sw lowerEnd lowerEndY
	define [ThreeFlatHookBrokenTop top serif sw lowerEnd lowerEndY angle] : ThreeFlatTopBrokenShape top serif HOOK-FLAT sw lowerEnd lowerEndY angle

	define ThreeBodyConfig : object
		rounded        {HOOK-ROUND   HOOK-ROUND  }
		flatHooked     {HOOK-FLAT    HOOK-FLAT  }
		cornerHooked   {HOOK-CORNER  HOOK-CORNER  }
		inwardSerifed  {HOOK-INWARD  HOOK-INWARD  }
		serifedHooked  {HOOK-SLAB    HOOK-SLAB  }

	define ThreeArcTypes : object
		Rounded HOOK-ROUND
		FlatHook HOOK-FLAT
		CornerHook HOOK-CORNER
		InwardSerifed HOOK-INWARD
		Serifed HOOK-SLAB
	foreach {topName topStyle  } [pairs-of ThreeArcTypes] : begin
		foreach {bottomName bottomStyle  } [pairs-of ThreeArcTypes] : begin
			set ThreeBodyConfig.("top\(topName)Bottom\(bottomName)") : list topStyle bottomStyle

	foreach {suffix {topStyle bottomStyle   } } [pairs-of ThreeBodyConfig] : do
		create-glyph "three.lnum.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : ThreeShapeHooked CAP topStyle bottomStyle
		create-glyph "three.onum.\(suffix)" : glyph-proc
			include : OnumMarks.p
			include : ThreeShapeHooked CAP topStyle bottomStyle
			include : ShiftDown

	define ThreeFlatTopConfig : SuffixCfg.weave
		object
			flatTop       {ThreeFlatTopShape  }
			flatTopBroken {ThreeFlatTopBrokenShape  }
		object
			''      {false  }
			serifed {true  }
		object
			''          {HOOK-ROUND  }
			flatHook    {HOOK-FLAT  }
			cornerHook  {HOOK-CORNER  }
			serifedHook {HOOK-SLAB  }

	foreach {suffix {{Shape    } {fSerif  } {hookStyle  } } } [pairs-of ThreeFlatTopConfig] : do
		create-glyph "three.lnum.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : Shape CAP fSerif hookStyle
		create-glyph "three.onum.\(suffix)" : glyph-proc
			include : OnumMarks.p
			include : Shape CAP fSerif hookStyle
			include : ShiftDown

	select-variant 'three.lnum' [CodeLnum '3'] (follow -- 'three')
	select-variant 'three.onum' [CodeOnum '3'] (follow -- 'three')

	turned 'turnThree' 0x218B 'three.lnum' Middle (CAP / 2)

	link-reduced-variant 'three/sansSerif.lnum' 'three.lnum' MathSansSerif (follow -- 'three/sansSerif')
	link-reduced-variant 'three/sansSerif.onum' 'three.onum' MathSansSerif (follow -- 'three/sansSerif')

	glyph-block-import Letter-Blackboard : BBS BBD
	create-glyph 'mathbb/three' 0x1D7DB : glyph-proc
		include : MarkSet.capital
		include : union
			ThreeShapeT dispiro 0 BBS CAP
			intersection
				ThreeShapeT spiro-outline 1 BBS CAP
				union
					VBar.r (RightSB - BBD)    [mix 0 CAP HBarPos] CAP          BBS
					VBar.r (RightSB - BBD - O * 2) 0       [mix 0 CAP HBarPos] BBS
