$$include '../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from "@iosevka/util"
import [MathSansSerif] from "@iosevka/glyph/relation"
import [Box] from "@iosevka/geometry/box"

glyph-module

glyph-block Digits-Three : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Digits-Shared : OnumHeight OnumMarks ShiftDown CodeLnum CodeOnum
	glyph-block-import Letter-Latin-Ezh : Ezh
	glyph-block-import Letter-Latin-C : CLetterForm
	glyph-block-import Letter-Arc-Hook : MakeFlatHook MakeCornerHook Rounded Flat
	glyph-block-import Letter-Shared-Shapes : InwardSlabArcStart InwardSlabArcEnd ArcStartSerif ArcEndSerif

	define SLAB-NONE        0
	define FLAT-CONNECTION  3
	define SLAB-FLAT-HOOK   4
	define SLAB-CORNER-HOOK 5

	define HOOK-ROUND  0
	define HOOK-FLAT   1
	define HOOK-CORNER 2
	define HOOK-INWARD 3

	define [ThreeShapeT sink offset sw top hookStyle] : glyph-proc
		local barcenter : mix 0 top HBarPos
		local xMid : mix SB RightSB 0.4
		local fine : sw * CThin

		include : sink
			widths.rhs sw
			match hookStyle
				[Just HOOK-FLAT]   : [MakeFlatHook SB RightSB top 0 (sw -- sw)].hookStartL
				[Just HOOK-CORNER] : [MakeCornerHook SB RightSB top 0 (sw -- sw)].hookStartL
				[Just HOOK-INWARD] : InwardSlabArcStart.LtrRhs (SB + offset) (top - offset) sw Hook
				__ : list
					g4 (SB + offset - O) (top - Hook)
					HookStart (top - offset) (sw -- sw)
			g4 (RightSB - offset) [YSmoothMidR (top - offset - O) (barcenter - sw / 2) ArchDepthA ArchDepthB]
			flat (xMid + TINY) (barcenter - (fine - sw / 2)) [widths.rhs.heading fine Leftward]
			curl xMid (barcenter - (fine - sw / 2)) [heading Leftward]
		include : sink
			widths.rhs fine
			flat xMid (barcenter + (fine - sw / 2)) [heading Rightward]
			curl (xMid + TINY) (barcenter + (fine - sw / 2)) [heading Rightward]
			g4 (RightSB - offset - O * 2) [YSmoothMidR (barcenter + sw / 2) (offset + O) ArchDepthA ArchDepthB] [widths.rhs sw]
			match hookStyle
				[Just HOOK-FLAT]   : [MakeFlatHook SB RightSB top 0 (sw -- sw)].hookEndL
				[Just HOOK-CORNER] : [MakeCornerHook SB RightSB top 0 (sw -- sw)].hookEndL
				[Just HOOK-INWARD] : InwardSlabArcEnd.RtlRhs (SB + offset) offset sw Hook
				__ : list
					HookEnd offset (sw -- sw)
					g4 (SB + offset + O) Hook
		if (hookStyle === HOOK-INWARD) : begin
			include : ArcStartSerif.InwardL (SB + offset) (top - offset) sw Hook
			include : ArcEndSerif.InwardL (SB + offset) offset sw Hook

	define [ThreeShape top] : ThreeShapeT dispiro 0 Stroke top
	define [ThreeShapeHooked top hookStyle] : ThreeShapeT dispiro 0 Stroke top hookStyle

	define [ThreeFlatTopShape top serif hookStyle] : glyph-proc
		define ezh : Ezh [DivFrame 1] top 0
			pxMidLeft    -- 0.25
			pxTopRight   -- 0.975
			fSerifed     -- serif
			fFlatHook    -- (hookStyle === HOOK-FLAT)
			fCornerHook  -- (hookStyle === HOOK-CORNER)
		include : ezh.Shape

	# Horizontal top bar plus a tironian-et diagonal (50° from horizontal,
	# diagonal terminal). Used by the broken flat-top body.
	define [ThreeFlatTopEtGeom top _yEndIdeal] : begin
		local kFall : Math.tan (50 * Math.PI / 180)
		local yBarBot : top - Stroke
		local cor : Stroke * [DiagCor kFall 1]
		local yEndIdeal : Math.min (yBarBot - HalfStroke) : fallback _yEndIdeal : mix 0 top 0.42
		local xEnd : Math.max (SB + cor) : RightSB - (yBarBot - yEndIdeal) / kFall
		local yEnd : yBarBot - (RightSB - xEnd) * kFall
		return : object kFall yBarBot cor xEnd yEnd

	define [ThreeFlatTopEtTop top _swEnd _yEndIdeal] : glyph-proc
		local swEnd : fallback _swEnd Stroke
		local [object yBarBot xEnd yEnd] : ThreeFlatTopEtGeom top _yEndIdeal
		include : union
			HBar.t SB RightSB top
			intersection
				Rect yBarBot (yEnd - 2 * Stroke) SB RightSB
				dispiro
					widths.rhs
					flat RightSB yBarBot
					curl xEnd yEnd [widths.rhs swEnd]

	# Reversed-c bowl clipped against the et stem so the arch continues
	# past it. The leftover mask follows the et and stops at the terminal.
	define [ThreeFlatTopBrokenShape top serif hookStyle] : glyph-proc
		local [object yBarBot xEnd yEnd] : ThreeFlatTopEtGeom top
		local yBowl : mix 0 top 0.72
		local styBot : match hookStyle
			[Just HOOK-FLAT]   SLAB-FLAT-HOOK
			[Just HOOK-CORNER] SLAB-CORNER-HOOK
			__                 SLAB-NONE

		define [etTop] : ThreeFlatTopEtTop top

		local lf : CLetterForm [DivFrame 1] FLAT-CONNECTION styBot yBowl 0
			ada -- [ArchDepthAClamped yBowl 0 ArchDepthA ArchDepthB]
			adb -- [ArchDepthBClamped yBowl 0 ArchDepthA ArchDepthB]

		include : union
			etTop
			difference
				lf.revFull
				union
					etTop
					MaskAboveLine RightSB yBarBot xEnd yEnd
					intersection [MaskLeft xEnd] [MaskAbove yEnd]
		if serif : include : VSerif.dl (SB + (OX - O)) top VJut

	define ThreeBodyConfig : object
		rounded       HOOK-ROUND
		flatHooked    HOOK-FLAT
		cornerHooked  HOOK-CORNER
		inwardSerifed HOOK-INWARD

	foreach { suffix hookStyle } [pairs-of ThreeBodyConfig] : do
		create-glyph "three.lnum.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : ThreeShapeHooked CAP hookStyle
		create-glyph "three.onum.\(suffix)" : glyph-proc
			include : OnumMarks.p
			include : ThreeShapeHooked CAP hookStyle
			include : ShiftDown

	define ThreeFlatTopConfig : SuffixCfg.weave
		object
			flatTop       { ThreeFlatTopShape }
			flatTopBroken { ThreeFlatTopBrokenShape }
		object
			""      { false }
			serifed { true }
		object
			""         { HOOK-ROUND }
			flatHook   { HOOK-FLAT }
			cornerHook { HOOK-CORNER }

	foreach { suffix { { Shape } { fSerif } { hookStyle } } } [pairs-of ThreeFlatTopConfig] : do
		create-glyph "three.lnum.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : Shape CAP fSerif hookStyle
		create-glyph "three.onum.\(suffix)" : glyph-proc
			include : OnumMarks.p
			include : Shape CAP fSerif hookStyle
			include : ShiftDown

	select-variant 'three.lnum' [CodeLnum '3'] (follow -- 'three')
	select-variant 'three.onum' [CodeOnum '3'] (follow -- 'three')

	turned 'turnThree' 0x218B 'three.lnum' Middle (CAP / 2)

	link-reduced-variant 'three/sansSerif.lnum' 'three.lnum' MathSansSerif (follow -- 'three/sansSerif')
	link-reduced-variant 'three/sansSerif.onum' 'three.onum' MathSansSerif (follow -- 'three/sansSerif')

	glyph-block-import Letter-Blackboard : BBS BBD
	create-glyph 'mathbb/three' 0x1D7DB : glyph-proc
		include : MarkSet.capital
		include : union
			ThreeShapeT dispiro 0 BBS CAP
			intersection
				ThreeShapeT spiro-outline 1 BBS CAP
				union
					VBar.r (RightSB - BBD)    [mix 0 CAP HBarPos] CAP          BBS
					VBar.r (RightSB - BBD - O * 2) 0       [mix 0 CAP HBarPos] BBS
