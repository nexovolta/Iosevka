$$include '../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from "@iosevka/util"
import [MathSansSerif] from "@iosevka/glyph/relation"

glyph-module

glyph-block Digits-Two : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Digits-Shared : OnumHeight OnumMarks CodeLnum CodeOnum
	glyph-block-import Letter-Latin-Glottal-Stop : AdviceGlottalStopArchDepth
	glyph-block-import Letter-Arc-Hook : MakeFlatHook
	glyph-block-import Mark-Above : MeasureGlyphBoundsInY
	glyph-block-import Letter-Shared : PackSrc

	define [TwoStraightNeckArcT sink offset sw top flatHook _left _right _hook] : begin
		local left : fallback _left SB
		local right : fallback _right RightSB
		local hook : fallback _hook Hook
		define archDepth : [AdviceGlottalStopArchDepth top (+1)] * 0.95
		define xLB : left + offset
		define xR : right - OX / 2
		define yPhRight : top - archDepth * 1.5 - sw / 2 * (top / CAP - TanSlope)
		define pStraightBarStart 0.75
		return : sink
			widths.rhs sw
			if flatHook
				[MakeFlatHook left right top 0 (sw -- sw)].hookStartL
				list
					g4 left (top - hook)
					HookStart top (sw -- sw)
			g4.down.mid xR (top - archDepth)
			flat [mix xLB xR pStraightBarStart] [mix sw yPhRight pStraightBarStart]
			curl xLB sw [widths.lhs sw]

	define [TwoArcShapeT sink offsetU offsetD sw top flatHook _left _right _hook _width] : begin
		local left : fallback _left SB
		local right : fallback _right RightSB
		local hook : fallback _hook Hook
		local width : fallback _width Width
		define archDepth : [AdviceGlottalStopArchDepth top (+1)] * 0.95
		return : sink
			widths.rhs sw
			if flatHook
				[MakeFlatHook left right top 0 (sw -- sw)].hookStartL
				list
					g4 (left - offsetU) (top - hook)
					HookStart top (sw -- sw)
			g4.down.mid (right - offsetU - OX / 2) (top - archDepth)
			alsoThru.g2.withOffset 0.5 ([StrokeWidthBlend 0.425 0.4 sw] * [linreg 500 1 700 0.95 width]) 0 (0.25 * (offsetU - offsetD)) [widths.center sw]
			flat (left + offsetD) 1 [widths.heading sw 0 Downward]
			[if (sink == spiro-outline) corner curl] (left + offsetD) 0 [heading Downward]
			if (sink == spiro-outline) { [corner (left - offsetU) 0] } {}

	define [TwoShape top slab flatHook _left _right _sw _hook _width] : glyph-proc
		local left : fallback _left SB
		local right : fallback _right RightSB
		local sw : fallback _sw Stroke
		local hook : fallback _hook Hook
		local width : fallback _width Width
		include : TwoArcShapeT dispiro 0 0 sw top flatHook left right hook width
		include : HBar.b (left + sw / 2) right 0 sw
		if slab : begin
			include : VSerif.ur right 0 VJut

	define [TwoStraightNeckShape top slab flatHook _left _right _sw _hook] : glyph-proc
		local left : fallback _left SB
		local right : fallback _right RightSB
		local sw : fallback _sw Stroke
		local hook : fallback _hook Hook
		include : TwoStraightNeckArcT dispiro 0 sw top flatHook left right hook
		include : HBar.b left right 0 sw
		if slab : begin
			include : VSerif.ur right 0 VJut

	create-glyph 'two.lnum.straightNeckSerifless' : glyph-proc
		include : MarkSet.capital
		include : TwoStraightNeckShape CAP false

	create-glyph 'two.onum.straightNeckSerifless' : glyph-proc
		include : OnumMarks.e
		include : TwoStraightNeckShape OnumHeight false

	create-glyph 'two.lnum.straightNeckSerifed' : glyph-proc
		include : MarkSet.capital
		include : TwoStraightNeckShape CAP true

	create-glyph 'two.onum.straightNeckSerifed' : glyph-proc
		include : OnumMarks.e
		include : TwoStraightNeckShape OnumHeight true

	create-glyph 'two.lnum.curlyNeckSerifless' : glyph-proc
		include : MarkSet.capital
		include : TwoShape CAP false

	create-glyph 'two.onum.curlyNeckSerifless' : glyph-proc
		include : OnumMarks.e
		include : TwoShape OnumHeight false

	create-glyph 'two.lnum.curlyNeckSerifed' : glyph-proc
		include : MarkSet.capital
		include : TwoShape CAP true

	create-glyph 'two.onum.curlyNeckSerifed' : glyph-proc
		include : OnumMarks.e
		include : TwoShape OnumHeight true

	create-glyph 'two.lnum.straightNeckFlatHookSerifless' : glyph-proc
		include : MarkSet.capital
		include : TwoStraightNeckShape CAP false true

	create-glyph 'two.onum.straightNeckFlatHookSerifless' : glyph-proc
		include : OnumMarks.e
		include : TwoStraightNeckShape OnumHeight false true

	create-glyph 'two.lnum.straightNeckFlatHookSerifed' : glyph-proc
		include : MarkSet.capital
		include : TwoStraightNeckShape CAP true true

	create-glyph 'two.onum.straightNeckFlatHookSerifed' : glyph-proc
		include : OnumMarks.e
		include : TwoStraightNeckShape OnumHeight true true

	create-glyph 'two.lnum.curlyNeckFlatHookSerifless' : glyph-proc
		include : MarkSet.capital
		include : TwoShape CAP false true

	create-glyph 'two.onum.curlyNeckFlatHookSerifless' : glyph-proc
		include : OnumMarks.e
		include : TwoShape OnumHeight false true

	create-glyph 'two.lnum.curlyNeckFlatHookSerifed' : glyph-proc
		include : MarkSet.capital
		include : TwoShape CAP true true

	create-glyph 'two.onum.curlyNeckFlatHookSerifed' : glyph-proc
		include : OnumMarks.e
		include : TwoShape OnumHeight true true

	select-variant 'two.lnum' [CodeLnum '2'] (follow -- 'two')
	select-variant 'two.onum' [CodeOnum '2'] (follow -- 'two')

	turned 'turnTwo' 0x218A 'two.lnum' Middle (CAP / 2)

	link-reduced-variant 'two/sansSerif.lnum' 'two.lnum' MathSansSerif (follow -- 'two/sansSerif')
	link-reduced-variant 'two/sansSerif.onum' 'two.onum' MathSansSerif (follow -- 'two/sansSerif')

	do "Rum rotunda : compressed 2 plus a forward slash through the base"
		define rumAdws 0.78
		# 2's foot bar plus `/` slash. `xSlashRefLeft` is the 2-body left SB
		# used to place the slash; the bar itself may start further right.
		define rumSlashYTop : 0.34 * XH
		define rumSlashYBot : 0.70 * Descender
		define [RumRotundaSlash xLeft xRight yTop yBot swSlash] : glyph-proc
			local cor : [Math.hypot (xRight - xLeft) (yTop - yBot)] / (yTop - yBot)
			include : spiro-outline
				corner (xRight - [HSwToV : 0.5 * cor * swSlash]) yTop
				corner (xRight + [HSwToV : 0.5 * cor * swSlash]) yTop
				corner (xLeft  + [HSwToV : 0.5 * cor * swSlash]) yBot
				corner (xLeft  - [HSwToV : 0.5 * cor * swSlash]) yBot

		define [TwoBaseWithSlash xBarLeft xBarRight xSlashRefLeft sw] : glyph-proc
			include : HBar.b xBarLeft xBarRight 0 sw
			local xRight : mix xSlashRefLeft xBarRight 0.82
			local xLeft : xRight - 0.20 * (xBarRight - xSlashRefLeft)
			include : RumRotundaSlash xLeft xRight rumSlashYTop rumSlashYBot OverlayStroke

		define [RumRotundaShape top fStraight fSlab fFlat] : glyph-proc
			local df : DivFrame rumAdws
			local hook : Math.min Hook : 0.45 * (df.rightSB - df.leftSB)
			local xBarLeft : if fStraight df.leftSB (df.leftSB + df.mvs / 2)
			# 2 body without its foot serif; compressed left to leave room for the slash.
			if fStraight
				include : TwoStraightNeckArcT dispiro 0 df.mvs top fFlat df.leftSB df.rightSB hook
				include : TwoArcShapeT dispiro 0 0 df.mvs top fFlat df.leftSB df.rightSB hook df.width
			include : TwoBaseWithSlash xBarLeft RightSB df.leftSB df.mvs

		define RumTwoConfig : SuffixCfg.weave
			object
				straightNeck { true }
				curlyNeck    { false }
			object
				""       { false }
				flatHook { true }
			object
				serifless { false }
				serifed   { true }

		foreach { suffix { fStraight fFlat fSlab } } [pairs-of RumTwoConfig] : do
			create-glyph "RumRotunda.\(suffix)" : glyph-proc
				include : MarkSet.capDesc
				include : RumRotundaShape CAP fStraight fSlab fFlat
			create-glyph "rumRotunda.\(suffix)" : glyph-proc
				include : MarkSet.p
				include : RumRotundaShape XH fStraight fSlab fFlat

		select-variant 'RumRotunda' 0xA75C (follow -- 'two')
		select-variant 'rumRotunda' 0xA75D (follow -- 'two')

		# Full-weight letter plus rum-rotunda 2-foot. Advance matches ae/oe
		# (MM), growing if the unscaled letter plus foot needs more.
		define [MakeUmAt src adws] : glyph-proc
			include : refer-glyph src
			local b : include : MeasureGlyphBoundsInY 0 Stroke
			local df : include : DivFrame adws
			include : df.markSet.p
			local xJoin : df.rightSB - [HSwToV : 0.5 * Stroke]
			if b : set xJoin : [mix b.xMax b.xMax 0] - [HSwToV : 0.5 * Stroke]
			if (xJoin > df.rightSB) : set xJoin : df.rightSB - [HSwToV : 0.5 * Stroke]
			include : TwoBaseWithSlash xJoin df.rightSB xJoin Stroke

		define [MakeUm] : lambda [src gr] : glyph-proc
			include : refer-glyph src
			local b : include : MeasureGlyphBoundsInY 0 Stroke
			local xJoin : RightSB - [HSwToV : 0.5 * Stroke]
			if b : set xJoin : [mix b.xMax b.xMax 0] - [HSwToV : 0.5 * Stroke]
			local dfMM : DivFrame para.advanceScaleMM 3
			local foot : dfMM.width / 3
			local aw : Math.max dfMM.width (xJoin + foot + dfMM.leftSB)
			local df : include : DivFrame (aw / Width)
			include : df.markSet.p
			include : TwoBaseWithSlash xJoin df.rightSB xJoin Stroke

		# Tails flatten so the 2-foot can join; serifs stay; serifless uses hooky.
		define [LumLSrc src] : begin
			local suffix : if (src == 'l') [fallback para.variantSelector.l 'serifless'] : src.slice 2
			local mapped : match suffix
				[Just 'serifless']             'hooky'
				[Just 'seriflessDec']          'hookyDec'
				[Just 'tailed']                'flatTailed'
				[Just 'tailedDec']             'flatTailedDec'
				[Just 'tailedSerifed']         'serifedFlatTailed'
				[Just 'diagonalTailed']        'flatTailed'
				[Just 'diagonalTailedDec']     'flatTailedDec'
				[Just 'serifedDiagonalTailed'] 'serifedFlatTailed'
				[Just 'semiTailed']            'flatTailed'
				[Just 'semiTailedDec']         'flatTailedDec'
				[Just 'serifedSemiTailed']     'serifedFlatTailed'
				[Just 'doubleTailed']          'doubleFlatTailed'
				[Just 'doubleTailedDec']       'doubleFlatTailedDec'
				[Just 'doubleSemiTailed']      'doubleFlatTailed'
				[Just 'doubleSemiTailedDec']   'doubleFlatTailedDec'
				[Just 'doubleDiagTailed']      'doubleFlatTailed'
				[Just 'doubleDiagTailedDec']   'doubleFlatTailedDec'
				__                             suffix
			local gn : 'l.' + mapped
			if [query-glyph gn] : return gn
			return src

		derive-glyphs 'dum'     0xA771 'd'     : lambda [src gr] : glyph-proc
			include : MakeUmAt [PackSrc 'd' src] para.advanceScaleM
		derive-glyphs 'lum'     0xA772 'l'     : lambda [src gr] : glyph-proc
			include : MakeUmAt [LumLSrc src] 1
		derive-glyphs 'mum'     0xA773 'm'     : lambda [src gr] : glyph-proc
			include : MakeUmAt [PackSrc 'm' src] para.advanceScaleMM
		derive-glyphs 'num'     0xA774 'n'     : lambda [src gr] : glyph-proc
			include : MakeUmAt [PackSrc 'n' src] para.advanceScaleM
		derive-glyphs 'smcpRum' 0xA776 'smcpR' : lambda [src gr] : glyph-proc
			include : MakeUmAt [PackSrc 'smcpR' src] para.advanceScaleM
		# Rum-rotunda slash through the r ear, not the stem.
		derive-glyphs 'rum' 0xA775 'r' : lambda [src gr] : glyph-proc
			include [refer-glyph src] AS_BASE ALSO_METRICS
			include : MarkSet.e
			local overlay currentGlyph.baseAnchors.overlay
			local lean : fallback currentGlyph.baseAnchors.leaningAbove currentGlyph.baseAnchors.above overlay
			local xStem : mix overlay.x overlay.x 0
			local xLean : mix lean.x lean.x 0
			local xEar : xStem + (xLean - xStem) * (16 / 7)
			local xMid : mix xStem xEar 1
			local yMid : XH - Hook * (2 / 5)
			local dfSlash : DivFrame rumAdws
			local kLen : 3 / 4
			local dx : kLen * 0.20 * (RightSB - dfSlash.leftSB)
			local dy : kLen * (rumSlashYTop - rumSlashYBot)
			include : RumRotundaSlash (xMid - dx / 2) (xMid + dx / 2) (yMid + dy / 2) (yMid - dy / 2) OverlayStroke

	glyph-block-import Letter-Blackboard : BBS BBD
	create-glyph 'mathbb/two' 0x1D7DA : glyph-proc
		include : MarkSet.capital
		include : TwoArcShapeT dispiro 0   BBD BBS CAP
		include : intersection
			TwoArcShapeT dispiro       BBD 0   BBS CAP
			TwoArcShapeT spiro-outline 0   BBD BBS CAP
		include : HBar.b (SB + [HSwToV : 0.5 * BBS]) RightSB 0 BBS
