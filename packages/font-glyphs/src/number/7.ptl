$$include '../meta/macros.ptl'

import [mix clamp fallback SuffixCfg] from "@iosevka/util"
import [MathSansSerif] from "@iosevka/glyph/relation"

glyph-module

glyph-block Digits-Seven : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Digits-Shared : OnumMarks ShiftDown CodeLnum CodeOnum

	define SevenXLeft : mix SB RightSB 0.28
	define SevenStraightInnerX : SevenXLeft + [HSwToV : 0.75 * Stroke]
	define [StraightBody top] : union [HBar.t SB RightSB top] : intersection
		Rect (top - Stroke) 0 SB RightSB
		dispiro
			widths.rhs
			corner RightSB (top - Stroke)
			corner [mix RightSB SevenStraightInnerX 2] [mix (top - Stroke) 0 2]

	define SevenXLeftBend : mix SB RightSB 0.38
	define SevenBendKnotX : SevenXLeftBend + [HSwToV : 0.6 * Stroke]
	define [BendBody top] : union [HBar.t SB RightSB top] : intersection
		MaskBelow (top - Stroke)
		MaskAbove 0
		dispiro
			widths.rhs
			g4 RightSB (top - Stroke)
			g4.down.mid SevenBendKnotX 0 [heading Downward]
			g4 RightSB (-top + Stroke)

	define [CurlyBody top] : union [HBar.t SB (RightSB - HalfStroke) top] : intersection
		MaskBelow top
		MaskAbove 0
		dispiro
			g4.down.start RightSB top [widths.rhs.heading Stroke Downward]
			alsoThru.g2 0.5 0.5
			g4.down.mid SevenBendKnotX 0 [heading Downward]
			alsoThru.g2 0.5 0.5
			g4.down.end RightSB (-top) [widths.rhs.heading Stroke Downward]

	define [SevenSquareYShoulder top] : top - Stroke - [Math.max (0.12 * top) Stroke]
	define [SevenSquareYFoot top] : Math.max (0.14 * top) Stroke
	define [SquareBody top] : begin
		local swH : HSwToV Stroke
		local yShoulder : SevenSquareYShoulder top
		local yFoot : SevenSquareYFoot top
		return : union
			HBar.t SB RightSB top
			VBar.r RightSB yShoulder top
			VBar.l SevenXLeft 0 yFoot
			spiro-outline
				corner (RightSB - swH) yShoulder
				corner RightSB yShoulder
				corner (SevenXLeft + swH) yFoot
				corner SevenXLeft yFoot

	define [SevenVerticalTopYShoulder top] : mix 0 (top - Stroke) 0.76
	define [SevenVerticalYFoot top] : top - [SevenVerticalTopYShoulder top]

	define [VerticalTopBody top] : begin
		local swH : HSwToV Stroke
		local yShoulder : SevenVerticalTopYShoulder top
		return : union
			HBar.t SB RightSB top
			VBar.r RightSB yShoulder top
			spiro-outline
				corner (RightSB - swH) yShoulder
				corner RightSB yShoulder
				corner (SevenXLeft + swH) 0
				corner SevenXLeft 0

	define [VerticalBottomBody top] : begin
		local swH : HSwToV Stroke
		local yFoot : SevenVerticalYFoot top
		return : union
			HBar.t SB RightSB top
			VBar.l SevenXLeft 0 yFoot
			spiro-outline
				corner (RightSB - swH) (top - Stroke)
				corner RightSB (top - Stroke)
				corner (SevenXLeft + swH) yFoot
				corner SevenXLeft yFoot

	define [StartSerif top] : VSerif.dl (SB + (OX - O)) top VJut
	define [StartSerifThick top] : VSerif.dl (SB + (OX - O)) top VJut [AdviceStroke 2.75]

	# Inner/outer of the stem at the serif top, from the same edges as the body.
	define [SevenFootEdges body top] : match body
		[Just "straight"] : begin
			# Straight stem is widths.rhs down the outer edge; ink falls inward.
			# Sample at y = Stroke so the serif centers on the visible junction.
			local yTop : top - Stroke
			local t : Stroke / yTop
			local xOuter0 SevenStraightInnerX
			local thick : Stroke * [DiagCor yTop (RightSB - xOuter0)]
			local xOuter : mix xOuter0 RightSB t
			local xInner : mix (xOuter0 - thick) (RightSB - thick) t
			object xInner xOuter
		([Just "bend"] || [Just "curly"]) : begin
			# Knot is widths.rhs heading down, so it is the outer edge.
			local xOuter SevenBendKnotX
			local xInner : xOuter - [HSwToV Stroke]
			object xInner xOuter
		[Just "verticalTop"] : begin
			local swH : HSwToV Stroke
			local t : Stroke / [SevenVerticalTopYShoulder top]
			local xInner : mix SevenXLeft (RightSB - swH) t
			local xOuter : mix (SevenXLeft + swH) RightSB t
			object xInner xOuter
		__ : begin
			local xInner SevenXLeft
			local xOuter : SevenXLeft + [HSwToV Stroke]
			object xInner xOuter

	define [BottomSerif body] : function [top] : begin
		local [object xInner xOuter] : SevenFootEdges body top
		local xMid : mix xInner xOuter 0.5
		return : HSerif.mb xMid 0 Jut

	define [FullSerif body] : function [top] : union
		StartSerif top
		[BottomSerif body] top

	# Crossbar sits at the digit midline, centered on the stem at that Y.
	define [SevenCrossbarY top] : mix 0 (top - QuarterStroke) 0.5

	define [SevenStemEdges body top y] : match body
		[Just "straight"] : begin
			local yTop : top - Stroke
			local t : clamp 0 1 : y / yTop
			local xOuter0 SevenStraightInnerX
			local thick : Stroke * [DiagCor yTop (RightSB - xOuter0)]
			local xOuter : mix xOuter0 RightSB t
			local xInner : mix (xOuter0 - thick) (RightSB - thick) t
			object xInner xOuter
		[Just "bend"] : begin
			local yTop : top - Stroke
			local t : clamp 0 1 : y / yTop
			local thick : Stroke * [DiagCor yTop (RightSB - SevenBendKnotX)]
			local xOuter : mix SevenBendKnotX RightSB t
			local xInner : xOuter - thick
			object xInner xOuter
		[Just "curly"] : begin
			local t : clamp 0 1 : y / top
			local thick : Stroke * [DiagCor top (RightSB - SevenBendKnotX)]
			local xOuter : mix SevenBendKnotX RightSB t
			local xInner : xOuter - thick
			object xInner xOuter
		[Just "square"] : begin
			local swH : HSwToV Stroke
			local yShoulder : SevenSquareYShoulder top
			local yFoot : SevenSquareYFoot top
			local t : clamp 0 1 : (y - yFoot) / (yShoulder - yFoot)
			local xInner : mix SevenXLeft (RightSB - swH) t
			local xOuter : mix (SevenXLeft + swH) RightSB t
			object xInner xOuter
		[Just "verticalTop"] : begin
			local swH : HSwToV Stroke
			local yShoulder : SevenVerticalTopYShoulder top
			local t : clamp 0 1 : y / yShoulder
			local xInner : mix SevenXLeft (RightSB - swH) t
			local xOuter : mix (SevenXLeft + swH) RightSB t
			object xInner xOuter
		__ : begin
			local swH : HSwToV Stroke
			local yFoot : SevenVerticalYFoot top
			local yTop : top - Stroke
			local t : clamp 0 1 : (y - yFoot) / (yTop - yFoot)
			local xInner : mix SevenXLeft (RightSB - swH) t
			local xOuter : mix (SevenXLeft + swH) RightSB t
			object xInner xOuter

	define [CrossbarOnStem body] : function [top] : begin
		local y : SevenCrossbarY top
		local [object xInner xOuter] : SevenStemEdges body top y
		local xMid : mix xInner xOuter 0.5
		local jut : [HSwToV QuarterStroke] + LongJut * 0.8
		return : HBar.m (xMid - jut) (xMid + jut) y

	local SevenConfig : SuffixCfg.weave
		object # body
			straight              StraightBody
			bend                  BendBody
			curly                 CurlyBody
			square                SquareBody
			verticalTop           VerticalTopBody
			verticalBottom        VerticalBottomBody
		function [body] : object # serif
			serifless             nothing
			serifed               StartSerif
			baseSerifed           [BottomSerif body]
			fullSerifed           [FullSerif body]
		function [body] : object # crossbar
			""                    nothing
			crossbar              [CrossbarOnStem body]

	foreach { suffix { Body Serif Crossbar } } [Object.entries SevenConfig] : do
		create-glyph "seven.lnum.\(suffix)" : glyph-proc
			include : MarkSet.capital
			if Body : include : Body CAP
			if Serif : include : Serif CAP
			if Crossbar : include : Crossbar CAP

		create-glyph "seven.onum.\(suffix)" : glyph-proc
			include : OnumMarks.p
			include : refer-glyph "seven.lnum.\(suffix)"
			include : ShiftDown

	select-variant 'seven.lnum' [CodeLnum '7'] (follow -- 'seven')
	select-variant 'seven.onum' [CodeOnum '7'] (follow -- 'seven')

	link-reduced-variant 'seven/sansSerif.lnum' 'seven.lnum' MathSansSerif (follow -- 'seven/sansSerif')
	link-reduced-variant 'seven/sansSerif.onum' 'seven.onum' MathSansSerif (follow -- 'seven/sansSerif')

	glyph-block-import Letter-Blackboard : BBS BBD
	create-glyph 'mathbb/seven' 0x1D7DF : glyph-proc
		include : MarkSet.capital
		local tr : RightSB - BBS / 2
		local kDiag : DiagCorDs (CAP - BBS) (tr - SevenXLeft) (BBD * 0.75)
		local xTerm : SevenXLeft - 0.25 * kDiag * BBD
		include : union
			HBar.t SB RightSB CAP BBS
			intersection
				Rect CAP 0 0 RightSB
				union
					HBar.b xTerm (xTerm + kDiag * BBD) 0 BBS
					ExtLineCenter tr         (CAP - BBS) (xTerm + kDiag * BBD) 0 BBS 2
					ExtLineCenter (tr - BBD) (CAP - BBS) xTerm                 0 BBS 2
