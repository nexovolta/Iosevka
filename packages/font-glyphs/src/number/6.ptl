$$include '../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from "@iosevka/util"

glyph-module

glyph-block Digits-Six : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Digits-Shared : CodeLnum CodeOnum
	glyph-block-import Letter-Arc-Hook : MakeFlatHook

	glyph-block-export StraightBarSixShape

	# Bowl outer top is locked at 60% of the digit height.
	define [SixBowlOTop charTop] : 0.6 * charTop

	define [SixBowlArches oTop] : begin
		local ada : ArchDepthAClamped oTop 0 SmallArchDepthA SmallArchDepthB
		local adb : ArchDepthBClamped oTop 0 SmallArchDepthA SmallArchDepthB
		return : object
			ada ada
			adb adb
			yMiddleA : YSmoothMidL oTop 0 ada adb
			yMiddleB : YSmoothMidR oTop 0 ada adb

	# Round bowl only, outer top locked at oTop. Stem / hook are unioned on separately.
	define [SixRoundBowl oTop] : glyph-proc
		local arches : SixBowlArches oTop
		include : dispiro
			widths.rhs ShoulderFine
			g4 (SB + OX + [HSwToV (Stroke - ShoulderFine)]) arches.yMiddleA
			Arch.rhs oTop (swBefore -- ShoulderFine)
			g4.down.mid (RightSB - OX) arches.yMiddleB
			Arch.rhs 0
			g4.up.mid (SB + OX) arches.yMiddleA
			flat (SB + OX) (arches.yMiddleA + TINY) [heading Upward]
			curl (SB + OX) oTop [heading Upward]

	# Stem from the bowl top, flattening into a top-right terminal.
	define [SixFlatHookFromBowl] : with-params [top oTop [xStem : SB + OX] [sw Stroke]] : glyph-proc
		local fh : MakeFlatHook SB RightSB top 0 (sw -- sw)
		local midShift : (RightSB - SB) * (-0.05)
		local yTurn : Math.max (oTop + Stroke) (top - SmallArchDepthA)
		include : dispiro
			widths.rhs sw
			flat xStem oTop [heading Upward]
			curl xStem yTurn [heading Upward]
			arcvh.superness DesignParameters.tightHookSuperness
			flat [Math.min (fh.xRHook - TanSlope * sw) : Arch.adjust-x.top (Middle - midShift) sw] top [widths.rhs.heading sw Rightward]
			corner fh.xRHook top

	# Bowl only: b toothless-rounded left stem + round bottom, with b's flat-top
	# (earlessCorner rise 0) into the stem. The 6 stem is drawn separately from oTop up.
	define [SixFlatBowlOBar] : with-params [oTop [left SB] [right RightSB] [sw Stroke]] : glyph-proc
		local arches : SixBowlArches oTop
		include : dispiro
			flat left oTop [widths.lhs.heading sw Downward]
			curl left [Math.min arches.adb (oTop - TINY)]
			Arch.lhs 0 (sw -- sw)
			flatside.ru right 0 oTop arches.ada arches.adb
			arcvh
			flat [Arch.adjust-x.top [mix left right 0.5] (sw -- sw)] oTop
			curl (left + TINY) oTop [heading Leftward]

	# Original closed-6 stem/hook, starting at the top of the bowl.
	define [SixClosedStemFromBowl] : with-params [top oTop [vertical false]] : glyph-proc
		include : dispiro
			widths.rhs
			flat SB oTop [heading Upward]
			if vertical
				curl SB top [heading Upward]
				list
					curl SB (top - SmallArchDepthA) [heading Upward]
					HookEnd top
					g4 (RightSB - OX) (top - Hook)

	glyph-block-export OpenContourSixShape
	define [OpenContourSixShape] : with-params [charTop [flatBowl false]] : glyph-proc
		local oTop : SixBowlOTop charTop
		local arches : SixBowlArches oTop
		if flatBowl : include : union
			SixFlatBowlOBar oTop
			dispiro
				widths.rhs
				flat SB oTop [heading Upward]
				curl SB [mix oTop charTop 0.15] [heading Upward]
				quadControls 0 0.85
				g4 ([mix SB RightSB 0.85] - [HSwToV QuarterStroke]) (charTop - O)
		if [not flatBowl] : include : dispiro
			widths.rhs (ShoulderFine - TINY)
			g4 (SB + OX + [HSwToV (Stroke - ShoulderFine)]) arches.yMiddleA
			Arch.rhs oTop (swBefore -- (ShoulderFine - TINY))
			g4.down.mid (RightSB - OX) arches.yMiddleB
			Arch.rhs 0
			g4.up.mid (SB + OX) arches.yMiddleA
			quadControls 0 0.85
			g4 ([mix SB RightSB 0.85] - [HSwToV QuarterStroke]) (charTop - O) [widths.rhs]

	glyph-block-export ClosedContourSixShape
	define [ClosedContourSixShape] : with-params [top [vertical false] [flatBowl false]] : glyph-proc
		local oTop : SixBowlOTop top
		local arches : SixBowlArches oTop
		if flatBowl : include : union
			SixFlatBowlOBar oTop
			SixClosedStemFromBowl top oTop (vertical -- vertical)
		if [not flatBowl] : include : dispiro
			widths.rhs ShoulderFine
			g4 (SB + OX + [HSwToV (Stroke - ShoulderFine)]) arches.yMiddleA
			Arch.rhs oTop (swBefore -- ShoulderFine)
			g4.down.mid (RightSB - OX) arches.yMiddleB
			Arch.rhs 0
			g4.up.mid (SB + OX) arches.yMiddleA
			flat (SB + OX) (arches.yMiddleA + TINY) [heading Upward]
			if vertical
				curl (SB + OX) top [heading Upward]
				list
					curl (SB + OX) (top - SmallArchDepthA)
					HookEnd top
					g4 (RightSB - OX) (top - Hook)

	# Horizontal-ended parallelogram; italic shear keeps constant width.
	define [SixStraightBarParallelogram xBotL yBot xTopL yTop sw] : begin
		local swH : HSwToV sw
		return : spiro-outline
			corner xBotL         yBot
			corner (xBotL + swH) yBot
			corner (xTopL + swH) yTop
			corner xTopL         yTop

	# xTerminalMix 0.6 = original diagonal bar; 0 = vertical continuation of the left stem.
	glyph-block-export StraightBarSixShape
	define [StraightBarSixShape] : with-params [charTop [sw Stroke] [bbd 0] [xTerminalMix 0.6] [flatBowl false]] : glyph-proc
		local oTop : SixBowlOTop charTop
		local arches : SixBowlArches oTop
		local ymiddlea arches.yMiddleA
		local ymiddleb arches.yMiddleB

		local xMockBarStart   0
		local yMockBarStart : ymiddlea + sw * 0.3
		local xVertical : SB + bbd + OX
		local xDiagonal : [mix SB RightSB 0.6] - [HSwToV : 0.5 * sw]
		local xTerminal0 : mix xVertical xDiagonal (xTerminalMix / 0.6)
		local kDiagBbd : DiagCorDs (charTop - yMockBarStart) (xTerminal0 - xMockBarStart) bbd
		local xTerminal : xTerminal0 + (kDiagBbd * bbd / 2)
		local pStraightBarStart : mix 1 (0.75 - (sw / charTop)) (xTerminalMix / 0.6)
		if flatBowl : include : union
			SixFlatBowlOBar oTop (left -- (SB + bbd)) (right -- RightSB) (sw -- sw)
			SixStraightBarParallelogram (SB + bbd) oTop xTerminal charTop sw
		if [not flatBowl] : include : intersection
			Rect charTop (-charTop) (-Width) (2 * Width)
			dispiro
				widths.rhs (ShoulderFine - TINY)
				g4.up.mid (SB + bbd + OX + [HSwToV (sw - ShoulderFine)]) ymiddlea
				Arch.rhs oTop (sw -- sw) (swBefore -- (ShoulderFine - TINY))
				g4.down.mid (RightSB - OX) ymiddleb
				Arch.rhs 0 (sw -- sw)
				g4.up.mid (SB + bbd + OX) ymiddlea
				flat [mix (xMockBarStart + bbd) xTerminal pStraightBarStart] [mix yMockBarStart charTop pStraightBarStart] [widths.rhs sw]
				curl [mix (xMockBarStart + bbd) xTerminal 2]                 [mix yMockBarStart charTop 2]

		if bbd : include : HBar.t (xTerminal - kDiagBbd * bbd) xTerminal charTop sw
		if bbd : include : intersection
			Rect charTop (-charTop) (-Width) (2 * Width)
			dispiro
				Arch.rhs.centerAt.rtl.b (Middle + bbd / 2) 0 (sw -- sw)
				archv
				g4.up.mid (SB + OX) ymiddlea
				flat [mix xMockBarStart (xTerminal - kDiagBbd * bbd) pStraightBarStart] [mix yMockBarStart charTop pStraightBarStart]
				curl [mix xMockBarStart (xTerminal - kDiagBbd * bbd) 2]                 [mix yMockBarStart charTop 2]

	define [SixBodyClosed fFlatBowl] : glyph-proc
		include : ClosedContourSixShape CAP (flatBowl -- fFlatBowl)
	define [SixBodyOpen fFlatBowl] : glyph-proc
		include : OpenContourSixShape CAP (flatBowl -- fFlatBowl)
	define [SixBodyStraightBar fFlatBowl] : glyph-proc
		include : StraightBarSixShape CAP (flatBowl -- fFlatBowl)
	define [SixBodyClosedFlatHook fFlatBowl] : glyph-proc
		local oTop : SixBowlOTop CAP
		if fFlatBowl : include : union
			SixFlatBowlOBar oTop
			SixFlatHookFromBowl CAP oTop (xStem -- SB)
		if [not fFlatBowl] : include : union
			SixRoundBowl oTop
			SixFlatHookFromBowl CAP oTop
	define [SixBodySteepBar fFlatBowl] : glyph-proc
		include : StraightBarSixShape CAP (xTerminalMix -- 0.28) (flatBowl -- fFlatBowl)
	define [SixBodyVerticalBar fFlatBowl] : glyph-proc
		include : ClosedContourSixShape CAP (vertical -- true) (flatBowl -- fFlatBowl)

	glyph-block-export SixConfig
	define SixConfig : SuffixCfg.weave
		object # body
			closedContour      SixBodyClosed
			openContour        SixBodyOpen
			straightBar        SixBodyStraightBar
			closedFlatHook     SixBodyClosedFlatHook
			steepBar           SixBodySteepBar
			verticalBar        SixBodyVerticalBar
		object # bowl
			""        false
			flatBowl  true

	foreach { suffix { Body fFlatBowl } } [Object.entries SixConfig] : do
		create-glyph "six.lnum.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : Body fFlatBowl

	select-variant 'six.lnum' [CodeLnum '6'] (follow -- 'six')
	alias          'six.onum' [CodeOnum '6'] 'six.lnum'

	glyph-block-import Letter-Blackboard : BBS BBD
	create-glyph 'mathbb/six' 0x1D7DE : glyph-proc
		include : MarkSet.capital
		include : StraightBarSixShape CAP (sw -- BBS) (bbd -- BBD)
