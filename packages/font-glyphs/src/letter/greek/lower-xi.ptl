$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [Box] from "@iosevka/geometry/box"

glyph-module

glyph-block Letter-Greek-Lower-Xi : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Arc-Hook : Flat MakeFlatHook
	glyph-block-import Letter-Shared-Shapes : CyrDescender CyrTailDescender RoundedTailStraightKnots RoundedTailDiagonalKnots RoundedBendTailBot
	glyph-block-import Mark-Adjustment : ExtendBelowBaseAnchors

	define SHAPE-ROUNDED    0
	define SHAPE-FLAT-TOP   1
	define SHAPE-FLAT-HOOK  2

	define TAIL-CURLY            0
	define TAIL-STRAIGHT         1
	define TAIL-DIAGONAL         2
	define TAIL-STRAIGHT-ROUNDED 3
	define TAIL-DIAGONAL-ROUNDED 4

	define pyBar 0.55

	define [LowerXiShape shape tail] : glyph-proc
		local adaTop : ArchDepthAOf : ArchDepth * (1 - pyBar)
		local adbTop : ArchDepthBOf : ArchDepth * (1 - pyBar)
		local adaBot : ArchDepthAOf : ArchDepth * (0 + pyBar)
		local adbBot : ArchDepthBOf : ArchDepth * (0 + pyBar)

		local fineMid : Stroke * CThin
		local fineTop : Stroke * CThinB
		local xBarStart : mix SB RightSB : match shape
			[Just SHAPE-FLAT-TOP] 0.750
			__                   0.625
		local xBarEnd : mix SB RightSB : match shape
			[Just SHAPE-FLAT-TOP] 0.850
			__                   0.750
		local yBarTop : mix Stroke Ascender pyBar
		local yBarBot : yBarTop - Stroke

		local xUpperArcLeft : match shape
			[Just SHAPE-FLAT-TOP] : [mix SB RightSB 0.075] + OX
			__                    :      SB                + 0
		local xLowerArcLeft : match shape
			[Just SHAPE-FLAT-TOP] : [mix SB RightSB 0.025] + OX * 2
			__                    :      SB                + OX * 2

		local box : new Box yBarTop 0 xLowerArcLeft RightSB
		local Arc : Flat box (sw -- Stroke)

		include : match shape
			[Just SHAPE-FLAT-TOP] : HBar.t SB RightSB Ascender
			__                    : glyph-proc

		include : dispiro
			match shape
				[Just SHAPE-FLAT-HOOK] : [MakeFlatHook SB RightSB Ascender 0].hookStartR
				[Just SHAPE-FLAT-TOP] : list
					flat                    xBarEnd    ((Ascender - Stroke) + fineTop) [widths.lhs fineTop]
					curl [Arch.adjust-x.top xBarStart] ((Ascender - Stroke) + fineTop) [widths.lhs fineTop]
					archv 16
				__ : list
					g4   (RightSB + O) (Ascender - Hook) [widths.lhs]
					HookStart Ascender
			g4   xUpperArcLeft [YSmoothMidL Ascender yBarBot adaTop adbTop] [widths.lhs]
			arcvh 16
			flat [Arch.adjust-x.bot xBarStart] (yBarTop - fineMid) [widths.lhs.heading fineMid Rightward]
			curl                    xBarEnd    (yBarTop - fineMid) [widths.lhs.heading fineMid Rightward]
		include : dispiro
			flat                    xBarEnd    (yBarBot + fineMid) [widths.lhs.heading fineMid Leftward]
			curl [Arch.adjust-x.top xBarStart] (yBarBot + fineMid) [widths.lhs.heading fineMid Leftward]
			archv 16
			g4   xLowerArcLeft [mix 0 [YSmoothMidL yBarTop 0 adaBot adbBot] 0.9] [widths.lhs]
			match tail
				[Just TAIL-CURLY] : list
					arcvh 16
					g4   [mix (xLowerArcLeft + [HSwToV Stroke]) (RightSB - [HSwToV Stroke]) 0.6] 0 [heading Rightward]
					archv 16
					g4.down.mid (RightSB - [HSwToV Stroke]) [mix Descender Stroke 0.5] [heading Downward]
					arcvh 16
					flat                    (RightSB - (Stroke - [mix Descender Stroke 0.5]) * 1.1)      (Descender + Stroke)
					curl [Math.min Middle : (RightSB - (Stroke - [mix Descender Stroke 0.5]) * 1.1) - 1] (Descender + Stroke)
				[Just TAIL-STRAIGHT-ROUNDED] : RoundedTailStraightKnots Stroke RightSB [widths.rhs.heading Stroke Rightward]
				[Just TAIL-DIAGONAL-ROUNDED] : RoundedTailDiagonalKnots Stroke RightSB [widths.rhs.heading Stroke Rightward]
				__ : Arc.hookEndR
		include : match tail
			[Just TAIL-STRAIGHT] : CyrDescender.r RightSB 0 RightSB
			[Just TAIL-DIAGONAL] : CyrTailDescender.r RightSB 0 RightSB
			[Just TAIL-STRAIGHT-ROUNDED] : ExtendBelowBaseAnchors [RoundedBendTailBot]
			[Just TAIL-DIAGONAL-ROUNDED] : ExtendBelowBaseAnchors [RoundedBendTailBot]
			__ : begin [glyph-proc]

	create-glyph : glyph-proc
		include : MarkSet.bp
		create-forked-glyph "grek/xi.flatTop" : LowerXiShape SHAPE-FLAT-TOP TAIL-CURLY
		create-forked-glyph "grek/xi.rounded" : LowerXiShape SHAPE-ROUNDED TAIL-CURLY
		create-forked-glyph "grek/xi.flatHook" : LowerXiShape SHAPE-FLAT-HOOK TAIL-CURLY

	create-glyph : glyph-proc
		include : MarkSet.b
		create-forked-glyph "grek/xi.roundedStraightTail" : LowerXiShape SHAPE-ROUNDED  TAIL-STRAIGHT
		create-forked-glyph "grek/xi.flatTopStraightTail" : LowerXiShape SHAPE-FLAT-TOP TAIL-STRAIGHT
		create-forked-glyph "grek/xi.flatHookStraightTail" : LowerXiShape SHAPE-FLAT-HOOK TAIL-STRAIGHT
		create-forked-glyph "grek/xi.roundedDiagonalTail" : LowerXiShape SHAPE-ROUNDED  TAIL-DIAGONAL
		create-forked-glyph "grek/xi.flatTopDiagonalTail" : LowerXiShape SHAPE-FLAT-TOP TAIL-DIAGONAL
		create-forked-glyph "grek/xi.flatHookDiagonalTail" : LowerXiShape SHAPE-FLAT-HOOK TAIL-DIAGONAL
		create-forked-glyph "grek/xi.roundedStraightTailRoundedBend" : LowerXiShape SHAPE-ROUNDED  TAIL-STRAIGHT-ROUNDED
		create-forked-glyph "grek/xi.flatTopStraightTailRoundedBend" : LowerXiShape SHAPE-FLAT-TOP TAIL-STRAIGHT-ROUNDED
		create-forked-glyph "grek/xi.flatHookStraightTailRoundedBend" : LowerXiShape SHAPE-FLAT-HOOK TAIL-STRAIGHT-ROUNDED
		create-forked-glyph "grek/xi.roundedDiagonalTailRoundedBend" : LowerXiShape SHAPE-ROUNDED  TAIL-DIAGONAL-ROUNDED
		create-forked-glyph "grek/xi.flatTopDiagonalTailRoundedBend" : LowerXiShape SHAPE-FLAT-TOP TAIL-DIAGONAL-ROUNDED
		create-forked-glyph "grek/xi.flatHookDiagonalTailRoundedBend" : LowerXiShape SHAPE-FLAT-HOOK TAIL-DIAGONAL-ROUNDED

	select-variant 'grek/xi' 0x3BE
