$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from '@iosevka/util'

glyph-module

glyph-block Letter-Greek-Lower-Delta : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared : CreateTurnedLetter
	glyph-block-import Mark-Above : OgonekAboveShape OgonekAboveTerminal MeasureGlyphBounds
	glyph-block-import Mark-Shared-Metrics : markStroke

	create-glyph 'grek/delta.rounded' : glyph-proc
		include : MarkSet.b

		local yRingTop : Ascender * 0.619 + QuarterStroke
		local xNeck   : mix SB RightSB 0.06

		include : dispiro
			g4   [mix Middle RightSB 0.85] [mix XH Ascender 0.8] [widths.lhs]
			alsoThru 0.5 0.7
			g4   Middle (Ascender - O)
			archv 2
			g4   (xNeck + Stroke) [mix (Ascender - O - Stroke) yRingTop 0.5] [widths.rhs]
			arcvh 2
			g4   Middle yRingTop [heading Rightward]
			alsoThruThem : list {0.25 0.05} {0.5 0.13}
			flatside.rd RightSB 0 yRingTop SmallArchDepthA SmallArchDepthB
			Arch.rhs 0
			flatside.lu SB 0 yRingTop SmallArchDepthA SmallArchDepthB
			arcvh
			g4   Middle (yRingTop - QuarterStroke) [widths.rhs HalfStroke]

	create-glyph 'grek/delta.flatTop' : glyph-proc
		include : MarkSet.b

		local yTop : Ascender - Stroke
		local yMid : XH * 0.875 + QuarterStroke
		local yMid2 : YSmoothMidR yMid 0 SmallArchDepthA SmallArchDepthB
		local yMockBarStart : [mix yMid2 yMid 0.5] + 2.25 * Stroke
		local pStraightBarStart : 0.75 - (Stroke / Ascender)

		include : HBar.t SB RightSB Ascender
		include : intersection [MaskBelow yTop] : dispiro
			widths.lhs ShoulderFine
			flatside.ru (RightSB - [HSwToV : Stroke - ShoulderFine]) 0 yMid SmallArchDepthA SmallArchDepthB
			Arch.lhs yMid (swBefore -- ShoulderFine)
			flatside.ld SB 0 yMid SmallArchDepthA SmallArchDepthB
			Arch.lhs 0
			flat (RightSB - OX) [Math.min SmallArchDepthA yMid2]
			curl (RightSB - OX) [mix yMid2 yMid 0.05]
			flat [mix Width SB pStraightBarStart] [mix yMockBarStart yTop pStraightBarStart]
			curl [mix Width SB 1]                 [mix yMockBarStart yTop 1] [widths.rhs]

	select-variant 'grek/delta' 0x3B4

	alias 'latn/delta' 0x1E9F 'grek/delta'
	create-glyph 'latn/delta.phonotypic' : glyph-proc
		include : MarkSet.b
		local bounds nothing
		local hookWeight 0.5
		# A shallow ogonek would rise above its terminal at heavy weights.
		local hookDepth : Math.max 200 (3 * markStroke)
		local hook : new-glyph : glyph-proc
			include : OgonekAboveShape false hookWeight hookDepth
			set bounds : include : MeasureGlyphBounds
		local sx : (0.55 * (RightSB - SB)) / (bounds.xMax - bounds.xMin)
		local x : Middle - 0.08 * (RightSB - SB)
		local y : XH - 0.2 * Stroke
		local dotBounds nothing
		local dot : new-glyph : glyph-proc
			include : refer-glyph 'tittleAbove'
			set dotBounds : include : MeasureGlyphBounds
		local terminal : OgonekAboveTerminal hookDepth
		# The ogonek's terminal point is the upper edge of its leftward stroke.
		local terminalOffset : terminal.y - 0.5 * hookWeight * markStroke - bounds.yMin
		# This is part of the letter, so its size is independent of mark metrics.
		local dotRadius : 20 + 0.625 * Stroke
		local dotScale : (2 * dotRadius) / (dotBounds.yMax - dotBounds.yMin)
		local terminalY : XH + 140
		local sy : (terminalY - y) / terminalOffset
		local terminalX : x + sx * (terminal.x - bounds.xMin)
		include : union
			OShape XH 0 SB RightSB Stroke SmallArchDepthA SmallArchDepthB
			with-transform [ApparentTranslate (x - sx * bounds.xMin) (y - sy * bounds.yMin)] : with-transform [Italify para.slopeAngle] : with-transform [Scale sx sy] : with-transform [Italify (-para.slopeAngle)] hook
			with-transform [ApparentTranslate (terminalX - dotScale * (dotBounds.xMin + dotBounds.xMax) / 2) (terminalY - dotScale * (dotBounds.yMin + dotBounds.yMax) / 2)] : with-transform [Italify para.slopeAngle] : with-transform [Scale dotScale dotScale] : with-transform [Italify (-para.slopeAngle)] dot
		set-base-anchor 'above' terminalX (terminalY + dotRadius)
	CreateTurnedLetter 'latn/turndelta' 0x18D 'grek/delta' HalfAdvance (XH / 2)

	alias 'cyrl/be.SRB' null 'grek/delta.rounded'
