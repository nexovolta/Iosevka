$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [Point] from "@iosevka/geometry/point"
import [MathSansSerif] from "@iosevka/glyph/relation"
import [DesignParameters] from "../../meta/aesthetics.mjs"

glyph-module

glyph-block Letter-Greek-Upper-Gamma: begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : ExtendAboveBaseAnchors LeaningAnchor
	glyph-block-import Letter-Shared-Metrics : EFMidBarShrinkK EFMidBarPosY
	glyph-block-import Letter-Shared-Shapes : CyrDescender MidHook LegShape
	glyph-block-import Letter-Shared-Shapes : LetterBarOverlay PalatalHook

	define SLAB-NONE             0
	define SLAB-TR               1
	define SLAB-BOTTOM           2
	define SLAB-ALL              3
	define SLAB-BILATERAL-MOTION 4

	define kSB 1.5
	define xGammaBarLeft : mix 0 SB kSB
	define xGammaTopRight : RightSB - 0.75 * OX
	define [GammaShape top bot slabType] : glyph-proc
		include : LeaningAnchor.Below.VBar.l xGammaBarLeft
		include : tagged 'strokeV' : VBar.l xGammaBarLeft bot top
		include : tagged 'strokeH' : HBar.t (xGammaBarLeft - O) xGammaTopRight top
		match slabType
			[Just SLAB-ALL] : begin
				include : tagged 'serifLT' : HSerif.lt xGammaBarLeft  top SideJut
				include : tagged 'serifRT' : VSerif.dr xGammaTopRight top VJut
				include : tagged 'serifLB' : union
					HSerif.lb (xGammaBarLeft + [HSwToV HalfStroke]) bot Jut
					HSerif.rb (xGammaBarLeft + [HSwToV HalfStroke]) bot MidJutSide
			[Just SLAB-BILATERAL-MOTION] : begin
				include : tagged 'serifLT' : HSerif.lt xGammaBarLeft  top SideJut
				include : tagged 'serifRT' : VSerif.dr xGammaTopRight top VJut
			[Just SLAB-BOTTOM] : begin
				include : tagged 'serifLB' : union
					HSerif.lb (xGammaBarLeft + [HSwToV HalfStroke]) bot Jut
					HSerif.rb (xGammaBarLeft + [HSwToV HalfStroke]) bot MidJutSide
			[Just SLAB-TR] : begin
				include : tagged 'serifRT' : VSerif.dr xGammaTopRight top VJut

	define GammaConfig : object
		serifless              { SLAB-NONE             false false }
		topRightSerifed        { SLAB-TR               true  true  }
		bottomSerifed          { SLAB-BOTTOM           false false }
		serifed                { SLAB-ALL              true  true  }
		bilateralMotionSerifed { SLAB-BILATERAL-MOTION false true  }
		capped                 { SLAB-NONE             true  true  }

	foreach { suffix { slabType doST doRM } } [Object.entries GammaConfig] : do
		create-glyph "grek/Gamma.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : GammaShape CAP 0 slabType

		create-glyph "grek/Digamma.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : GammaShape CAP 0 slabType
			local yBar : EFMidBarPosY CAP 0
			local xMidRight : mix Width RightSB : EFMidBarShrinkK [DivFrame 1] doRM
			include : HBar.m xGammaBarLeft xMidRight yBar
			if doRM : begin
				include : tagged 'serifRM' : VSerif.dr xMidRight (yBar + HalfStroke) [mix Stroke VJut 0.5]

		create-glyph "rCap.\(suffix)" : glyph-proc
			include [refer-glyph "grek/Gamma.\(suffix)"] AS_BASE ALSO_METRICS
			eject-contour 'serifRT'
			eject-contour 'strokeH'
			include : dispiro
				widths.lhs
				g4.up.start (xGammaTopRight - OX) (CAP - [Math.min Hook : RHook * (CAP / XH) + HalfStroke]) [heading Upward]
				arcvh nothing DesignParameters.rHookSuperness
				flat [Arch.adjust-x.top [mix xGammaTopRight xGammaBarLeft 0.5]] CAP
				curl (xGammaBarLeft - O) CAP [heading Leftward]

		create-glyph "cyrl/GheDescender.\(suffix)" : glyph-proc
			include [refer-glyph "grek/Gamma.\(suffix)"] AS_BASE ALSO_METRICS
			include : CyrDescender.rSideJut
				x   -- (xGammaBarLeft + [HSwToV Stroke])
				y   -- 0
				jut -- MidJutSide

		create-glyph "cyrl/GheHook.\(suffix)" : glyph-proc
			include [refer-glyph "grek/Gamma.\(suffix)"] AS_BASE ALSO_METRICS
			include : PalatalHook.rSideJut
				x   -- (xGammaBarLeft + [HSwToV Stroke])
				y   -- 0
				jut -- MidJutSide

		create-glyph "cyrl/ghe.upright.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : GammaShape XH 0 slabType

		create-glyph "cyrl/gheDescender.upright.\(suffix)" : glyph-proc
			include [refer-glyph "cyrl/ghe.upright.\(suffix)"] AS_BASE ALSO_METRICS
			include : CyrDescender.rSideJut
				x   -- (xGammaBarLeft + [HSwToV Stroke])
				y   -- 0
				jut -- MidJutSide

		create-glyph "cyrl/gheHook.upright.\(suffix)" : glyph-proc
			include [refer-glyph "cyrl/ghe.upright.\(suffix)"] AS_BASE ALSO_METRICS
			include : PalatalHook.rSideJut
				x   -- (xGammaBarLeft + [HSwToV Stroke])
				y   -- 0
				jut -- MidJutSide

		create-glyph "cyrl/Ge.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : ExtendAboveBaseAnchors (CAP + LongVJut - QuarterStroke)
			include : GammaShape CAP 0 slabType
			eject-contour 'serifRT'
			include : VBar.r xGammaTopRight CAP (CAP + LongVJut - QuarterStroke) VJutStroke

		create-glyph "cyrl/ge.upright.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : ExtendAboveBaseAnchors (XH + LongVJut - QuarterStroke)
			include : GammaShape XH 0 slabType
			eject-contour 'serifRT'
			include : VBar.r xGammaTopRight XH (XH + LongVJut - QuarterStroke) VJutStroke

		create-glyph "cyrl/ge.italic.\(suffix)" : glyph-proc
			include [refer-glyph "cyrl/ge.upright.\(suffix)"] AS_BASE ALSO_METRICS
			eject-contour 'serifLB'
			eject-contour 'strokeV'
			include : LegShape
				ztop -- [Point.fromXY Point.Type.Corner xGammaBarLeft XH]
				zbot -- [Point.fromXY Point.Type.Corner [mix SB 0 : if doST 1.00 0.75] 0]
				xmid -- xGammaBarLeft

		create-glyph "cyrl/GheMidHook.\(suffix)" : glyph-proc
			include [refer-glyph "grek/Gamma.\(suffix)"] AS_BASE ALSO_METRICS
			include : MarkSet.capDesc
			include : MidHook.general
				left   -- (xGammaBarLeft + [HSwToV Stroke])
				right  -- RightSB
				top    -- (CAP * HBarPos + QuarterStroke)
				ada    -- ArchDepthA
				adb    -- ArchDepthB

		create-glyph "cyrl/gheMidHook.\(suffix)" : glyph-proc
			include [refer-glyph "cyrl/ghe.upright.\(suffix)"] AS_BASE ALSO_METRICS
			include : MarkSet.p
			include : MidHook.general
				left   -- (xGammaBarLeft + [HSwToV Stroke])
				right  -- RightSB
				top    -- (XH * HBarPos + QuarterStroke)
				ada    -- (ArchDepthA * (HBarPos ** 0.3))
				adb    -- (ArchDepthB * (HBarPos ** 0.3))
			if para.isItalic : eject-contour 'serifLB'

		create-glyph "paragraphus.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : GammaShape CAP 0 slabType
			eject-contour 'serifRT'
			local xStemMid : xGammaBarLeft + [HSwToV HalfStroke]
			local x1 xGammaTopRight
			local y1 CAP
			local x2 xStemMid
			local y2 : CAP / 2
			local dist : Math.hypot (x2 - x1) (y2 - y1)
			local ux : (x2 - x1) / dist
			local uy : (y2 - y1) / dist
			include : intersection
				MaskLeft xGammaTopRight
				MaskBelow CAP
				dispiro
					widths.center Stroke
					corner (x1 - ux * Stroke) (y1 - uy * Stroke)
					corner x2 y2

	select-variant 'paragraphus' 0x2E4D (follow -- 'grek/Gamma')
	select-variant 'grek/Gamma' 0x393
	link-reduced-variant 'grek/Gamma/sansSerif' 'grek/Gamma' MathSansSerif
	select-variant 'grek/smcpGamma'  0x1D26 (shapeFrom -- 'cyrl/ghe.upright') (follow -- 'grek/Gamma')

	select-variant 'RLongLeg' 0xA7E2 (shapeFrom -- 'rCap') (follow -- 'cyrl/Ge')

	select-variant 'cyrl/Ghe' 0x413 (shapeFrom -- 'grek/Gamma')
	select-variant 'cyrl/ghe.upright'

	select-variant 'cyrl/GheDescender' 0x4F6 (follow -- 'cyrl/Ghe')
	select-variant 'cyrl/gheDescender.upright' (follow -- 'cyrl/ghe.upright')

	select-variant 'cyrl/GheHook' (follow -- 'cyrl/Ghe')
	select-variant 'cyrl/gheHook.upright' (follow -- 'cyrl/ghe.upright')

	select-variant 'cyrl/Ge' 0x490
	select-variant 'cyrl/ge.upright' (follow -- 'cyrl/ge')
	select-variant 'cyrl/ge.italic' (follow -- 'cyrl/ge')

	select-variant 'cyrl/GheMidHook' 0x494 (follow -- 'cyrl/Ghe')
	select-variant 'cyrl/gheMidHook' 0x495 (follow -- 'cyrl/ghe.upright')

	select-variant 'grek/Digamma' 0x3DC

	define LowerDigammaConfig : object
		straight         0
		toothlessCorner  1
		toothlessRounded 2

	foreach { suffix kind } [Object.entries LowerDigammaConfig] : do
		create-glyph "grek/digamma.\(suffix)" : glyph-proc
			include : MarkSet.p
			match kind
				[Just 0] : begin
					include : GammaShape XH Descender SLAB-NONE
					local yBar : EFMidBarPosY XH 0
					local xMidRight : mix Width RightSB : EFMidBarShrinkK [DivFrame 1] SLAB
					include : HBar.m xGammaBarLeft xMidRight yBar
					if SLAB : begin
						include : tagged 'serifRM' : VSerif.dr xMidRight (yBar + HalfStroke) [mix Stroke VJut 0.5]
				[Just 1] : begin
					include : GammaShape XH Descender SLAB-NONE
				[Just 2] : begin
					include : LeaningAnchor.Below.VBar.l xGammaBarLeft
					local xStem : xGammaBarLeft + [HSwToV HalfStroke]
					local yTop : XH - HalfStroke
					local rad : Math.min (0.5 * (xGammaTopRight - xStem)) (0.45 * XH)
					include : dispiro
						widths.center Stroke
						g4.left.start xGammaTopRight yTop [heading Leftward]
						g4 (xStem + rad) yTop [heading Leftward]
						archv
						g4.down.mid xStem (yTop - rad) [heading Downward]
						g4.down.end xStem Descender [heading Downward]

	select-variant 'grek/digamma' 0x3DD
	define [GhaynOverlayBar top] : LetterBarOverlay.l xGammaBarLeft (top * (1 - OverlayPos))

	derive-composites 'cyrl/Ghayn'         0x492 'cyrl/Ghe'         [GhaynOverlayBar CAP]
	derive-composites 'cyrl/ghayn.upright' null  'cyrl/ghe.upright' [GhaynOverlayBar XH]

	derive-composites 'cyrl/GheStrokeHook'         0x4FA 'cyrl/GheHook'         [GhaynOverlayBar CAP]
	derive-composites 'cyrl/gheStrokeHook.upright' null  'cyrl/gheHook.upright' [GhaynOverlayBar XH]

	glyph-block-import Letter-Blackboard : BBS BBD BBBarLeft
	create-glyph 'mathbb/grek/Gamma' 0x213E : glyph-proc
		include : MarkSet.capital
		include : BBBarLeft xGammaBarLeft 0 CAP
		include : HBar.t xGammaBarLeft xGammaTopRight CAP BBS
