$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from "@iosevka/util"
import [Box] from "@iosevka/geometry/box"

glyph-module

glyph-block Letter-Greek-Lower-Final-Sigma : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Arc-Hook : Flat MakeFlatHook
	glyph-block-import Letter-Shared-Shapes : CyrDescender CyrTailDescender RoundedTailStraightKnots RoundedTailDiagonalKnots RoundedBendTailBot
	glyph-block-import Mark-Adjustment : ExtendBelowBaseAnchors

	define TAIL-CURLY                 0
	define TAIL-STRAIGHT              1
	define TAIL-DIAGONAL              2
	define TAIL-STRAIGHT-SHARP-CORNER 3
	define TAIL-DIAGONAL-SHARP-CORNER 4

	define TOP-ROUNDED    0
	define TOP-FLAT-HOOK  1

	define [CurlyTailKnots] : list
		arcvh
		g4 [Arch.adjust-x.bot Middle] 0
		alsoThru 0.5 0.1353
		g4.down.mid (RightSB - [HSwToV Stroke] + OX) [mix Descender Stroke : StrokeWidthBlend 0.5 0.49] [heading Downward]
		arcvh
		flat (RightSB - HookX + OX) (Descender + Stroke)
		curl [Math.min (RightSB - [HSwToV : 1.5 * Stroke]) (RightSB - HookX + OX - 1)] (Descender + Stroke)

	define [FinalSigmaShape tail top] : glyph-proc
		local box : new Box XH 0 SB RightSB
		local Arc : Flat box (sw -- Stroke)
		include : dispiro
			match top
				[Just TOP-FLAT-HOOK] : [MakeFlatHook SB RightSB XH 0].hookStartR
				__ : list
					widths.lhs
					g4 RightSB (XH - Hook)
					HookStart XH
			flatside.ld SB 0 XH SmallArchDepthA SmallArchDepthB
			match tail
				[Just TAIL-CURLY] : CurlyTailKnots
				[Just TAIL-STRAIGHT] : RoundedTailStraightKnots Stroke RightSB [widths.rhs.heading Stroke Rightward]
				[Just TAIL-DIAGONAL] : RoundedTailDiagonalKnots Stroke RightSB [widths.rhs.heading Stroke Rightward]
				__ : Arc.hookEndR
		include : match tail
			([Just TAIL-STRAIGHT] || [Just TAIL-DIAGONAL]) : ExtendBelowBaseAnchors [RoundedBendTailBot]
			[Just TAIL-STRAIGHT-SHARP-CORNER] : CyrDescender.r RightSB 0 RightSB
			[Just TAIL-DIAGONAL-SHARP-CORNER] : CyrTailDescender.r RightSB 0 RightSB
			__ : begin [glyph-proc]

	define [StigmaShape tail] : glyph-proc
		define fine : AdviceStroke 3
		local box : new Box XH 0 SB RightSB
		local Arc : Flat box (sw -- Stroke)
		include : dispiro
			widths.lhs fine
			straight.down.start (RightSB - [HSwToV fine]) (XH + 0.25 * Hook) [heading Downward]
			g2 [mix [Arch.adjust-x.top Middle] (RightSB - [HSwToV fine]) 0.5] (XH - O - Hook * [StrokeWidthBlend 0.05 0.025]) [widths.lhs.heading Stroke Leftward]
			g4 [Arch.adjust-x.top Middle] (XH - O)
			archv 16
			flatside.ld SB 0 XH SmallArchDepthA SmallArchDepthB
			match tail
				[Just TAIL-CURLY] : CurlyTailKnots
				[Just TAIL-STRAIGHT] : RoundedTailStraightKnots Stroke RightSB [widths.rhs.heading Stroke Rightward]
				[Just TAIL-DIAGONAL] : RoundedTailDiagonalKnots Stroke RightSB [widths.rhs.heading Stroke Rightward]
				__ : Arc.hookEndR
		include : match tail
			([Just TAIL-STRAIGHT] || [Just TAIL-DIAGONAL]) : ExtendBelowBaseAnchors [RoundedBendTailBot]
			[Just TAIL-STRAIGHT-SHARP-CORNER] : CyrDescender.r RightSB 0 RightSB
			[Just TAIL-DIAGONAL-SHARP-CORNER] : CyrTailDescender.r RightSB 0 RightSB
			__ : begin [glyph-proc]

	define SigmaTailConfig : object
		curlyTail                    { TAIL-CURLY                 'p' }
		straightTail                 { TAIL-STRAIGHT              'e' }
		diagonalTail                 { TAIL-DIAGONAL              'e' }
		straightTailSharpCorner      { TAIL-STRAIGHT-SHARP-CORNER 'e' }
		diagonalTailSharpCorner      { TAIL-DIAGONAL-SHARP-CORNER 'e' }

	define FinalSigmaConfig : SuffixCfg.weave
		object # top
			""        { TOP-ROUNDED   }
			flatHook  { TOP-FLAT-HOOK }
		object # tail
			curlyTail                    { TAIL-CURLY                 'p' }
			straightTail                 { TAIL-STRAIGHT              'e' }
			diagonalTail                 { TAIL-DIAGONAL              'e' }
			straightTailSharpCorner      { TAIL-STRAIGHT-SHARP-CORNER 'e' }
			diagonalTailSharpCorner      { TAIL-DIAGONAL-SHARP-CORNER 'e' }

	foreach { suffix { { top } { tail mk } } } [Object.entries FinalSigmaConfig] : do
		create-glyph "grek/sigmaFinal.\(suffix)" : glyph-proc
			include : MarkSet.(mk)
			include : FinalSigmaShape tail top

	foreach { suffix { tail mk } } [Object.entries SigmaTailConfig] : do
		create-glyph "grek/stigma.\(suffix)" : glyph-proc
			include : MarkSet.(mk)
			include : StigmaShape tail

	alias 'grek/stigma.flatHookCurlyTail' null 'grek/stigma.curlyTail'
	alias 'grek/stigma.flatHookStraightTail' null 'grek/stigma.straightTail'
	alias 'grek/stigma.flatHookDiagonalTail' null 'grek/stigma.diagonalTail'
	alias 'grek/stigma.flatHookStraightTailSharpCorner' null 'grek/stigma.straightTailSharpCorner'
	alias 'grek/stigma.flatHookDiagonalTailSharpCorner' null 'grek/stigma.diagonalTailSharpCorner'

	select-variant 'grek/sigmaFinal' 0x3C2
	select-variant 'grek/stigma'     0x3DB (follow -- 'grek/sigmaFinal')

	create-glyph 'grek/Stigma' 0x3DA : glyph-proc
		include : MarkSet.capital
		define yAttach : [if SLAB Stroke 0] + XH * 0.2
		include : difference
			dispiro
				widths.lhs
				g4 RightSB (CAP - Hook)
				HookStart CAP
				flatside.ld SB yAttach CAP ArchDepthA ArchDepthB
				arcvh
				g4 [Arch.adjust-x.bot Middle] (yAttach + O)
				archv
				g4 [mix Middle RightSB 2] (yAttach + Hook * 1.5) [heading Upward]
			Rect (yAttach + Hook * 1.5 - O) Descender (Middle + [HSwToV HalfStroke]) VERY-FAR
		include : VBar.m Middle 0 (yAttach + HalfStroke)
		if SLAB : include : HSerif.mb Middle 0 MidJutCenter
