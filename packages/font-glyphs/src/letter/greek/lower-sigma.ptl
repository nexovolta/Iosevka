$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from '@iosevka/util'
import [DesignParameters] from '../../meta/aesthetics.mjs'

glyph-module

glyph-block Letter-Greek-Lower-Sigma : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives

	glyph-block-export SigmaShape
	define [SigmaShape] : with-params [verticalBowl [top XH]] : glyph-proc
		include : MarkSet.[if (top > XH) 'capital' 'e']
		local xStemR : mix SB RightSB 0.92
		local fine : Math.max QuarterStroke : AdviceStroke 8
		local heightScale : top / XH
		local ada : SmallArchDepthA * heightScale
		local adb : SmallArchDepthB * heightScale
		include : dispiro
			widths.lhs
			flat (RightSB + SideJut + [HSwToV : 0.15 * Stroke]) top [heading Leftward]
			curl Middle (top - O) [heading Leftward]
			archv
			flatside.ld SB 0 top ada adb
			Arch.lhs 0
			match verticalBowl
				[Just 1] : list
					flatside.ru xStemR 0 top ada adb 0
					curl xStemR (top - 0.5 * Stroke) [heading Upward]
				__ : list
					flatside.ru RightSB 0 top ada adb 0
					arcvh
					g4.left.end Middle (top - O - (Stroke - fine)) [widths.lhs.heading fine Leftward]

	create-glyph 'grek/sigma.rounded' : glyph-proc
		include : SigmaShape 0
	create-glyph 'grek/sigma.verticalBowl' : glyph-proc
		include : SigmaShape 1
	select-variant 'grek/sigma' 0x3C3
