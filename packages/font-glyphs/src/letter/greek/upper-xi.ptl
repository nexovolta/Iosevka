$$include '../../meta/macros.ptl'

import [mix] from "@iosevka/util"

glyph-module

glyph-block Letter-Greek-Upper-Xi : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared-Metrics : EFVJutLength EFMidBarPosY

	define XiConfig : object
		serifless        { false false false false false false }
		middleSerifed    { false false false false true  true  }
		motionSerifed    { true  false false true  false false }
		topBottomSerifed { true  true  true  true  false false }
		fullSerifed      { true  true  true  true  true  true  }
		diagonalCrossbar        { false false false false false false 1 }
		diagonalCrossbarFalling { false false false false false false (-1) }
		diagonalCrossbarMotionSerifed { true false false true false false 1 }

	foreach { suffix { serifTL serifTR serifBL serifBR serifML serifMR diag } } [Object.entries XiConfig] : do
		create-glyph "grek/Xi.\(suffix)" : glyph-proc
			include : MarkSet.capital
			local xMidLeft  : mix SB RightSB 0.125
			local xMidRight : mix RightSB SB 0.125
			local yBar : EFMidBarPosY CAP 0
			include : HBar.t (SB + OX) (RightSB - OX) CAP
			include : HBar.b (SB + OX) (RightSB - OX) 0
			include : if diag
				DiagonalHBar xMidLeft xMidRight yBar (diag * 0.16 * CAP) Stroke
				HBar.m xMidLeft xMidRight yBar
			local { jutTop jutBot jutMid } : EFVJutLength CAP 0
			if serifTL : include : VSerif.dl (SB      + OX) CAP  jutTop
			if serifTR : include : VSerif.dr (RightSB - OX) CAP  jutTop
			if serifBL : include : VSerif.ul (SB      + OX) 0    jutBot
			if serifBR : include : VSerif.ur (RightSB - OX) 0    jutBot
			if serifML : include : VSerif.ml xMidLeft       yBar jutMid
			if serifMR : include : VSerif.mr xMidRight      yBar jutMid

	select-variant 'grek/Xi' 0x39E
