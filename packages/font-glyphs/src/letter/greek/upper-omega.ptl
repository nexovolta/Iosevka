$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [DesignParameters] from "../../meta/aesthetics.mjs"

glyph-module

glyph-block Letter-Greek-Upper-Omega : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared : CreateAccentedComposition CreateTurnedLetter
	glyph-block-import Letter-Shared : SetGrekUpperTonos

	define [OmegaFootSerifs] : glyph-proc
		local l : SB + 0.75 * OX
		local r : RightSB - 0.75 * OX
		local swVJut : Math.min VJutStroke : VSwToH : 0.625 * ((Middle - [HSwToV HalfStroke]) - l)
		include : VSerif.ul l Stroke VJut swVJut
		include : VSerif.ur r Stroke VJut swVJut

	define [UpperOmegaShape top extend ada adb doSerifs] : glyph-proc
		local fine : Stroke * CThin
		local x1 : mix SB RightSB 0.4
		local x2 : Width - x1
		local yattach : top * extend + Stroke
		include : dispiro
			g4   x1 (yattach - fine) [widths.rhs.heading fine Leftward]
			archv
			flatside.lu SB      (yattach - Stroke) top ada adb 0 [widths.rhs Stroke]
			Arch.rhs top
			flatside.rd RightSB (yattach - Stroke) top ada adb 0
			arcvh
			g4   x2 (yattach - fine) [widths.heading 0 fine Leftward]
		include : VBar.r x1 0 yattach fine
		include : HBar.m SB x1 HalfStroke
		include : VBar.l x2 0 yattach fine
		include : HBar.m x2 RightSB HalfStroke
		if doSerifs : include : OmegaFootSerifs

	define [DisjointOmegaShape top ada adb doSerifs] : glyph-proc
		local extra : if doSerifs VJut 0
		local yOBot : Stroke + extra + [Math.max (top * 0.12) Stroke] + O
		local oAda : ArchDepthAClamped top yOBot ada adb
		local oAdb : ArchDepthBClamped top yOBot ada adb
		include : OShape top yOBot SB RightSB Stroke oAda oAdb
		local l : SB + 0.75 * OX
		local r : RightSB - 0.75 * OX
		include : HBar.b l r 0
		if doSerifs : include : OmegaFootSerifs

	define OmegaConfig : object
		serifless       { 0 false }
		serifed         { 0 true  }
		disjoint        { 1 false }
		disjointSerifed { 1 true  }

	foreach { suffix { fDisjoint doSerifs } } [Object.entries OmegaConfig] : do
		create-glyph "grek/Omega.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : SetGrekUpperTonos 0
			if fDisjoint
				include : DisjointOmegaShape CAP ArchDepthA ArchDepthB doSerifs
				include : UpperOmegaShape CAP 0.08 ArchDepthA ArchDepthB doSerifs

		create-glyph "grek/smcpOmega.\(suffix)" : glyph-proc
			include : MarkSet.e
			if fDisjoint
				include : DisjointOmegaShape XH SmallArchDepthA SmallArchDepthB doSerifs
				include : UpperOmegaShape XH 0.08 SmallArchDepthA SmallArchDepthB doSerifs

		create-glyph "latn/Upsilon.\(suffix)" : glyph-proc
			include : MarkSet.capital
			if fDisjoint
				include : DisjointOmegaShape CAP ArchDepthA ArchDepthB doSerifs
				include : UpperOmegaShape CAP 0.08 ArchDepthA ArchDepthB doSerifs
			include : FlipAround Middle (CAP / 2)

	select-variant 'grek/Omega' 0x3A9
	select-variant 'grek/smcpOmega' 0xAB65 (follow -- 'grek/Omega')
	select-variant 'latn/Upsilon' 0x1B1 (follow -- 'grek/Omega')

	CreateTurnedLetter 'latn/upsilon' 0x28A 'grek/smcpOmega' HalfAdvance (XH / 2)
	CreateAccentedComposition 'latn/upsilonBar' 0x1D7F 'latn/upsilon' 'hStrike'
