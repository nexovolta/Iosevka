$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [DesignParameters] from "../../meta/aesthetics.mjs"

glyph-module

glyph-block Letter-Greek-Upper-Omega : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared : CreateAccentedComposition
	glyph-block-import Letter-Shared : SetGrekUpperTonos
	glyph-block-import Letter-Latin-Upper-T : TLeftX TRightX

	define [UpperOmegaShape top extend ada adb _serifed] : glyph-proc
		local halfSpan : Middle - SB
		local fine : if _serifed [Math.min (Stroke * CThin) [VSwToH : 0.38 * halfSpan]] (Stroke * CThin)
		local x0 : mix SB RightSB 0.4
		local inward : if _serifed [Math.max 0 : Math.min (Middle - [HSwToV : fine / 2] - 0.05 * halfSpan - x0) : HSwToV : 0.55 * Stroke] 0
		local x1 : x0 + inward
		local x2 : Width - x1
		local yattach : if _serifed [Math.min (top * 0.7) (top * 0.32 + Stroke)] (top * extend + Stroke)
		include : dispiro
			g4   x1 (yattach - fine) [widths.rhs.heading fine Leftward]
			archv
			flatside.lu SB      (yattach - Stroke) top ada adb 0 [widths.rhs Stroke]
			Arch.rhs top
			flatside.rd RightSB (yattach - Stroke) top ada adb 0
			arcvh
			g4   x2 (yattach - fine) [widths.heading 0 fine Leftward]
		include : VBar.r x1 0 yattach fine
		include : HBar.m SB x1 HalfStroke
		include : VBar.l x2 0 yattach fine
		include : HBar.m x2 RightSB HalfStroke
		if _serifed : begin
			local serifHeight : Math.min (Stroke + VJut * 0.55) (yattach - Stroke - top * 0.03)
			local serifStroke : Math.min VJutStroke : VSwToH : Math.max TINY (x1 - SB - [HSwToV fine] - 0.14 * halfSpan)
			include : VSerif.ul SB 0 serifHeight serifStroke
			include : VSerif.ur RightSB 0 serifHeight serifStroke

	define [DisjointOmegaShape top doSerifs] : glyph-proc
		local dfT : DivFrame para.advanceScaleT
		local dx : 0.5 * (Width - dfT.width)
		local l : dx + [TLeftX dfT]
		local r : dx + [TRightX dfT]
		local yOBot : CAP - XH
		include : HBar.b l r 0
		if doSerifs : begin
			local swVJut : Math.min VJutStroke : VSwToH : 0.625 * ((dx + dfT.middle - [HSwToV HalfStroke]) - l)
			local serifH : Math.min VJut yOBot
			include : VSerif.ul l 0 serifH swVJut
			include : VSerif.ur r 0 serifH swVJut
		include : with-transform [ApparentTranslate 0 yOBot]
			OShape XH 0 SB RightSB nothing nothing nothing
		if (top < CAP) : include : ScaleAround Middle 0 (top / CAP) (top / CAP)

	define OmegaConfig : object
		serifless       { 0 false }
		disjoint        { 1 false }
		disjointSerifed { 1 true  }
		serifed         { 0 true  }

	foreach { suffix { fDisjoint doSerifs } } [Object.entries OmegaConfig] : do
		create-glyph "grek/Omega.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : SetGrekUpperTonos 0
			if fDisjoint
				include : DisjointOmegaShape CAP doSerifs
				include : UpperOmegaShape CAP 0.08 ArchDepthA ArchDepthB doSerifs

		create-glyph "grek/smcpOmega.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : new-glyph : glyph-proc
				if fDisjoint
					include : DisjointOmegaShape CAP doSerifs
					include : UpperOmegaShape CAP 0.08 ArchDepthA ArchDepthB doSerifs
				include : ScaleAround Middle 0 1 (XH / CAP)

		if [not fDisjoint] : begin
			create-glyph "latn/Upsilon.\(suffix)" : glyph-proc
				include : MarkSet.capital
				include : UpperOmegaShape CAP 0.08 ArchDepthA ArchDepthB doSerifs
				include : FlipAround Middle (CAP / 2)

			create-glyph "latn/upsilon.\(suffix)" : glyph-proc
				include : MarkSet.e
				include : UpperOmegaShape XH 0.08 SmallArchDepthA SmallArchDepthB doSerifs
				include : FlipAround Middle (XH / 2)

	select-variant 'grek/Omega' 0x3A9
	select-variant 'grek/smcpOmega' 0xAB65 (follow -- 'grek/Omega')
	select-variant 'latn/Upsilon' 0x1B1
	select-variant 'latn/upsilon' 0x28A

	CreateAccentedComposition 'latn/upsilonBar' 0x1D7F 'latn/upsilon' 'hStrike'
