$$include '../../meta/macros.ptl'

import [Arcs ShapeConv] from "typo-geom"
import [TaperedOffsetCurve BezToContoursSink GEOMETRY_PRECISION] from "@iosevka/geometry/curve-util"
import [mix linreg clamp fallback SuffixCfg] from "@iosevka/util"

import [maskBits] from "@iosevka/util/mask-bit"

glyph-module

glyph-block Letter-Latin-Lower-Eszet : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared-Shapes : LeftwardDiagTailedBar SerifFrame
	glyph-block-import Letter-Shared-Shapes : FlatHookDepth PalatalHook
	glyph-block-import Letter-Latin-S : AdviceSArchDepth
	glyph-block-import Letter-Latin-Lower-F : ySmallFBarPos

	define TERMINAL-BASELINE   0
	define TERMINAL-DESCENDING 1
	define TERMINAL-TAILED     2
	define TERMINAL-DIAGONAL   3

	define SERIF-NONE          0
	define SERIF-BOT           1
	define SERIF-MID           2
	define SERIF-MID-XH        4
	define SERIF-MID-HALF-ASC  8

	define SERIF-DUAL          : SERIF-BOT + SERIF-MID
	define SERIF-DUAL-XH       : SERIF-BOT + SERIF-MID-XH
	define SERIF-DUAL-HALF-ASC : SERIF-BOT + SERIF-MID-HALF-ASC

	define [EszetSerifs df fTraditional slab] : glyph-proc
		local sf : SerifFrame.fromDf df ySmallFBarPos 0
		if [maskBits slab SERIF-BOT] : include sf.lb.[if fTraditional 'full' 'outer']
		if [maskBits slab SERIF-MID] : include sf.lt.outer

		if [maskBits slab SERIF-MID-XH] : begin
			local sfXH : SerifFrame.fromDf df XH 0
			include sfXH.lt.outer

		if [maskBits slab SERIF-MID-HALF-ASC] : begin
			local sfHalfAsc : SerifFrame.fromDf df ([mix 0 Ascender 0.5] + HalfStroke) 0
			include sfHalfAsc.lt.outer

	define [Traditional fFlathook] : function [slab term] : glyph-proc
		include : MarkSet.bp
		local xHook : [mix SB RightSB 0.75] + [HSwToV HalfStroke]
		local hd : FlatHookDepth [DivFrame 1]
		include : if fFlathook
			dispiro
				widths.lhs
				flat xHook Ascender
				curl (SB + hd.x) Ascender
				archv
				flat SB (Ascender - hd.y)
				curl SB 0 [heading Downward]
			dispiro
				widths.lhs
				g4   xHook (Ascender - Hook)
				HookStart Ascender
				flat SB XH
				curl SB 0 [heading Downward]
		local t : mix 0 Ascender 0.7
		local tm : [mix Descender t 0.625] + HalfStroke
		local tl : [mix SB RightSB 0.35] + [HSwToV HalfStroke]
		include : HBar.t (SB + 1) (RightSB - HalfStroke * 1.2 - OX) t
		include : dispiro
			widths.rhs
			flat tl tm [heading Rightward]
			curl (tl + 1) tm [heading Rightward]
			g2   (RightSB - OX * 1.5) [mix Descender tm 0.70]
			g2   (RightSB - OX * 1.5) [mix Descender tm 0.67]
			alsoThru 0.5 0.75
			g4   ([mix SB RightSB 0.35] + [if term 0.625 0] * [HSwToV Stroke]) Descender
		include : dispiro
			widths.center (Stroke * 1.1)
			corner tl (tm - Stroke) [heading Upward]
			corner (RightSB - HalfStroke * 1.2 - OX) t [heading Upward]

		include : EszetSerifs [DivFrame 1] true slab
		include : match term
			[Just TERMINAL-DESCENDING] : VBar.l SB Descender 0
			[Just TERMINAL-TAILED]     : PalatalHook.lExt SB 0
			[Just TERMINAL-DIAGONAL]   : LeftwardDiagTailedBar SB Descender 0
			__                         : no-shape

	define [Sulzbacher slab term] : glyph-proc
		include : MarkSet.b

		define yMiddle : mix 0 Ascender 0.5
		define xFinal : Math.max
			mix (SB + [HSwToV Stroke]) RightSB 0.1
			mix SB RightSB 0.3
		define xMiddle : Math.max xFinal
			SB + [HSwToV : 1.2 * Stroke]
			RightSB - (yMiddle / 2 + HalfStroke)
		define xMiddleBot : Math.max xMiddle : (xFinal + TINY) + [Math.abs : TanSlope * Stroke]

		define ada : ArchDepthAOf (0.75 * ArchDepth) (0.5 * Width)
		define adb : ArchDepthBOf (0.75 * ArchDepth) (0.5 * Width)

		include : dispiro
			widths.rhs
			flat SB 0 [heading Upward]
			curl SB [Math.max XH : Ascender - SmallArchDepthA]
			Arch.rhs Ascender
			g4   (RightSB + O * 2) [YSmoothMidR Ascender (yMiddle - HalfStroke) ada adb]
			g4.left.end xMiddle (yMiddle - HalfStroke) [heading Leftward]
		include : dispiro
			widths.rhs
			g4.right.start xMiddle (yMiddle + HalfStroke) [heading Rightward]
			archv
			g4   (RightSB - O) [YSmoothMidR (yMiddle + HalfStroke) 0 ada adb]
			arcvh
			flat xMiddleBot 0 [heading Leftward]
			curl xFinal     0 [heading Leftward]

		include : EszetSerifs [DivFrame 1] false slab
		include : match term
			[Just TERMINAL-DESCENDING] : VBar.l SB Descender 0
			[Just TERMINAL-TAILED]     : PalatalHook.lExt SB 0
			[Just TERMINAL-DIAGONAL]   : LeftwardDiagTailedBar SB Descender 0
			__                         : no-shape

	define [LongSSLig slab term] : glyph-proc
		include : MarkSet.b

		define swOuter : AdviceStroke2 2.0 3 Ascender
		define swInner : AdviceStroke2 2.5 3 Ascender
		define sEndX : Math.max
			mix (SB + [HSwToV Stroke]) RightSB 0.1
			mix  SB                    RightSB 0.3
		define sTurnX : Math.max  sEndX      [mix SB    RightSB 0.3]
		define sBotX  : Math.max (sEndX + 1) [mix sEndX RightSB 0.3]
		define sTopX : sTurnX + (RightSB - sBotX)

		define sTopHookX : sTopX + [HSwToV : 0.5 * swInner]
		define archDepth : ArchDepth * (sTopHookX - SB - swInner * 0.5) / (RightSB - SB)
		define mockWidth : sTopHookX + SB
		define ada : ArchDepthAOf archDepth mockWidth
		define adb : ArchDepthBOf archDepth mockWidth

		include : dispiro
			widths.rhs swOuter
			flat SB 0 [heading Upward]
			curl SB [Math.max XH : Ascender - ada]
			Arch.rhs Ascender (swBefore -- swOuter) (sw -- [mix swOuter swInner 0.5]) (swAfter -- swInner)
			g4.down.mid sTopHookX (Ascender - adb + TanSlope * swInner) [widths.rhs.heading swInner Downward]
			alsoThru.g2 0.5 0.5 [widths.center swInner]
			g4   sTurnX [mix (0 + adb) (Ascender - adb) 0.5] [widths.lhs.heading swInner Downward]
			alsoThru.g2 0.5 0.5 [widths.center swInner]
			g4   (RightSB - OX) (0 + adb - 2 * TanSlope * swInner) [widths.rhs.heading swInner Downward]
			arcvh
			flat [Arch.adjust-x.bot ([clamp (sEndX + TINY + TanSlope * swInner) (RightSB - adb) : mix sEndX RightSB 0.375] + TanSlope * swInner) (swInner / 2)] 0
			curl sEndX 0 [heading Leftward]

		include : EszetSerifs [DivFrame 1] false slab
		include : match term
			[Just TERMINAL-DESCENDING] : VBar.l SB Descender 0 swOuter
			[Just TERMINAL-TAILED]     : PalatalHook.lExt SB 0 (sw -- swOuter)
			[Just TERMINAL-DIAGONAL]   : LeftwardDiagTailedBar SB Descender 0 swOuter
			__                         : no-shape

	define EszetConfig : SuffixCfg.weave
		object # body
			traditionalBentHook      [Traditional false]
			traditionalFlatHook      [Traditional true]
			sulzbacher                Sulzbacher
			longSSLig                 LongSSLig
		object # terminal
			""                        TERMINAL-BASELINE
			descending                TERMINAL-DESCENDING
			tailed                    TERMINAL-TAILED
			diagonalTailed            TERMINAL-DIAGONAL
		object # serifs
			serifless                 SERIF-NONE
			middleSerifed             SERIF-MID
			middleSerifedHalfAscender SERIF-MID-HALF-ASC
			middleSerifedXH           SERIF-MID-XH
			bottomSerifed             SERIF-BOT
			dualSerifed               SERIF-DUAL
			dualSerifedXH             SERIF-DUAL-XH
			dualSerifedHalfAscender   SERIF-DUAL-HALF-ASC

	foreach { suffix { Body terminal serif } } [pairs-of EszetConfig] : do
		create-glyph "eszet.\(suffix)" : Body serif terminal

	select-variant 'eszet' 0xDF
	select-variant 'longssHookBottom' 0x1DF95 (shapeFrom -- 'eszet')

	# Middle Scots S: eszett stem and arch only. The zett bowl is replaced
	# by a hanging vertical tilde that finishes slightly above the baseline.
	define [ScotsSTildeClearance _sw] : begin
		local sw : fallback _sw Stroke
		return : Math.max (XH * 0.055) (0.3 * sw)

	# Vertical tilde as a cubic (same construction as TildeShape), first
	# bulge inward, second outward. Amplitude stays on the right side.
	glyph-block-export ScotsHangingTilde
	define [ScotsHangingTilde xJoin yJoin yBot _sw] : glyph-proc
		local sw : fallback _sw Stroke
		local hs : 0.5 * sw
		local xOuter : xJoin - [HSwToV hs]
		local span : Math.max (1.65 * sw) : 0.20 * (RightSB - SB)
		local xInner : Math.max (SB + [HSwToV : 1.85 * sw]) (xOuter - span)
		local height : Math.abs : xOuter - xInner
		local length : Math.abs : yJoin - yBot
		local hsvh : (2 * hs) / [Math.max height 1]
		local hvc : length / [Math.max height 1]
		local tildeWaveY : [linreg 0.116 2.925 0.732 2.375 hsvh] * [linreg 2 1 4.35 1.1 hvc]
		local tildeWaveX 0.51
		define z1 : currentGlyph.gizmo.apply : object [x : 0 + xOuter] [y : 0 + yJoin]
		define z2 : currentGlyph.gizmo.apply : object [x : mix xOuter xInner tildeWaveY] [y : mix yJoin yBot tildeWaveX]
		define z3 : currentGlyph.gizmo.apply : object [x : mix xOuter xInner (1 - tildeWaveY)] [y : mix yJoin yBot (1 - tildeWaveX)]
		define z4 : currentGlyph.gizmo.apply : object [x : 0 + xInner] [y : 0 + yBot]
		define bone : new Arcs.Bez3 z1 z2 z3 z4
		define inner : new TaperedOffsetCurve bone (+hs) (+hs) HVContrast
		define outer : new Arcs.Reverted : new TaperedOffsetCurve bone (-hs) (-hs) HVContrast
		define cs : new BezToContoursSink
		ShapeConv.transferGenericShapeAsBezier {{inner outer}} cs GEOMETRY_PRECISION
		currentGlyph.includeContours cs.contours

	define [ScotsSLeftTerminal fTraditional slab term _sw] : glyph-proc
		local sw : fallback _sw Stroke
		include : EszetSerifs [DivFrame 1] fTraditional slab
		include : match term
			[Just TERMINAL-DESCENDING] : VBar.l SB Descender 0 sw
			[Just TERMINAL-TAILED]     : PalatalHook.lExt SB 0 (sw -- sw)
			[Just TERMINAL-DIAGONAL]   : LeftwardDiagTailedBar SB Descender 0 sw
			__                         : no-shape

	# Flat-top arch with a square top-right so the hanging tilde meets at a
	# sharp corner. The VBar buries the tilde's start cap inside the top bar.
	glyph-block-export ScotsSFlatTopArch
	define [ScotsSFlatTopArch top ada] : glyph-proc
		include : dispiro
			widths.rhs
			flat SB 0 [heading Upward]
			curl SB [Math.max XH : top - ada]
			arcvh
			flat Middle top
			curl (RightSB + O) top [heading Rightward]
		include : VBar.r (RightSB + O) (top - Stroke) (0 + top)

	define [FlatTopScotsS slab term] : glyph-proc
		include : MarkSet.b
		local yBot : ScotsSTildeClearance Stroke
		include : ScotsSFlatTopArch Ascender SmallArchDepthA
		include : ScotsHangingTilde (RightSB + O) (Ascender - HalfStroke) yBot
		include : ScotsSLeftTerminal false slab term

	define MiddleScotsSConfig : SuffixCfg.weave
		object # body
			traditionalBentHook      FlatTopScotsS
			traditionalFlatHook      FlatTopScotsS
			sulzbacher                FlatTopScotsS
			longSSLig                 FlatTopScotsS
		object # terminal
			""                        TERMINAL-BASELINE
			descending                TERMINAL-DESCENDING
			tailed                    TERMINAL-TAILED
			diagonalTailed            TERMINAL-DIAGONAL
		object # serifs
			serifless                 SERIF-NONE
			middleSerifed             SERIF-MID
			middleSerifedHalfAscender SERIF-MID-HALF-ASC
			middleSerifedXH           SERIF-MID-XH
			bottomSerifed             SERIF-BOT
			dualSerifed               SERIF-DUAL
			dualSerifedXH             SERIF-DUAL-XH
			dualSerifedHalfAscender   SERIF-DUAL-HALF-ASC

	foreach { suffix { Body terminal serif } } [pairs-of MiddleScotsSConfig] : do
		create-glyph "middleScotsS.\(suffix)" : Body serif terminal

	select-variant 'middleScotsS' 0xA7D7 (follow -- 'eszet')

glyph-block Letter-Latin-Upper-Eszet : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Latin-Lower-Eszet : ScotsHangingTilde ScotsSFlatTopArch

	define SERIF-NONE    0
	define SERIF-BOTTOM  1
	define SERIF-MOTION  2

	define SERIF-DUAL    : SERIF-BOTTOM + SERIF-MOTION

	define [CapitalEszetSerifs slab] : glyph-proc
		if [maskBits slab SERIF-BOTTOM] : include : HSerif.lb SB 0   SideJut
		if [maskBits slab SERIF-MOTION] : include : HSerif.lt SB CAP SideJut

	define [EszetRoundedShape slab] : glyph-proc
		include : MarkSet.capital

		define yMiddle : mix 0 CAP 0.5
		define yMiddleCap : mix 0 CAP 0.54
		define xFinal : Math.max
			mix (SB + [HSwToV Stroke]) RightSB 0.1
			mix SB RightSB 0.3
		define xMiddle : Math.max xFinal
			SB + [HSwToV : 1.2 * Stroke]
			RightSB - (yMiddle / 2 + HalfStroke)
		define xMiddleBot : Math.max xMiddle : (xFinal + TINY) + [Math.abs : TanSlope * Stroke]

		include : dispiro
			widths.rhs
			flat SB 0 [heading Upward]
			curl SB [Math.max XH : CAP - ArchDepthA]
			Arch.rhs CAP (blendPost -- {})
			g4   (RightSB + O) (CAP - DToothlessRise)
		include : ExtLineRhsToLhs (RightSB + O) (CAP - DToothlessRise) xMiddle (yMiddleCap + HalfStroke)
		include : dispiro
			widths.rhs
			g4   xMiddle (yMiddleCap + HalfStroke) [heading Rightward]
			archv
			g4   (RightSB - O * 2) [YSmoothMidR (yMiddleCap + HalfStroke) 0 ArchDepthA ArchDepthB]
			arcvh
			flat xMiddleBot 0
			curl xFinal 0 [heading Leftward]

		include : CapitalEszetSerifs slab

	define [EszetFlatTopShape slab] : glyph-proc
		include : MarkSet.capital

		define yMiddle : mix 0 CAP 0.5
		define yMiddleCap : mix 0 CAP 0.54
		define xFinal : Math.max
			mix (SB + [HSwToV Stroke]) RightSB 0.1
			mix SB RightSB 0.3
		define xMiddle : Math.max xFinal
			SB + [HSwToV : 1.2 * Stroke]
			RightSB - (yMiddle / 2 + HalfStroke)
		define xMiddleBot : Math.max xMiddle : (xFinal + TINY) + [Math.abs : TanSlope * Stroke]

		include : dispiro
			widths.rhs
			flat SB 0 [heading Upward]
			curl SB [Math.max XH : CAP - ArchDepthA]
			arcvh
			flat Middle CAP
			curl (RightSB + O) CAP [heading Rightward]
		include : ExtLineRhsToLhs (RightSB + O) (CAP - Stroke) xMiddle (yMiddleCap + HalfStroke)
		include : dispiro
			widths.rhs
			g4   xMiddle (yMiddleCap + HalfStroke) [heading Rightward]
			archv
			g4   (RightSB - O * 2) [YSmoothMidR (yMiddleCap + HalfStroke) 0 ArchDepthA ArchDepthB]
			arcvh
			flat xMiddleBot 0
			curl xFinal 0 [heading Leftward]

		include : CapitalEszetSerifs slab

	define [EszetCornerShape slab] : glyph-proc
		include : MarkSet.capital

		define yMiddle : mix 0 CAP 0.5
		define yMiddleCap : mix 0 CAP 0.54
		define xFinal : Math.max
			mix (SB + [HSwToV Stroke]) RightSB 0.1
			mix SB RightSB 0.3
		define xMiddle : Math.max xFinal
			SB + [HSwToV : 1.2 * Stroke]
			RightSB - (yMiddle / 2 + HalfStroke)
		define xMiddleBot : Math.max xMiddle : (xFinal + TINY) + [Math.abs : TanSlope * Stroke]

		include : union
			VBar.l SB 0 CAP
			HBar.t (SB + 1) (RightSB + O) CAP
		include : ExtLineRhsToLhs (RightSB + O) (CAP - Stroke) xMiddle (yMiddleCap + HalfStroke)
		include : dispiro
			widths.rhs
			g4   xMiddle (yMiddleCap + HalfStroke) [heading Rightward]
			archv
			g4   (RightSB - O * 2) [YSmoothMidR (yMiddleCap + HalfStroke) 0 ArchDepthA ArchDepthB]
			arcvh
			flat xMiddleBot 0
			curl xFinal 0 [heading Leftward]

		include : CapitalEszetSerifs slab

	define CapitalEszetConfig : SuffixCfg.combine
		SuffixCfg.weave
			object # body
				rounded    EszetRoundedShape
				flatTop    EszetFlatTopShape
				corner     EszetCornerShape
			function [body] : object # serifs
				serifless               SERIF-NONE
				serifed : match body
					[Just 'corner'] SERIF-DUAL
					__              SERIF-BOTTOM
		object # Exclusive corner serif variants
			cornerMotionSerifed { EszetCornerShape SERIF-MOTION }
			cornerBottomSerifed { EszetCornerShape SERIF-BOTTOM }

	foreach { suffix { Body serif } } [pairs-of CapitalEszetConfig] : do
		create-glyph "Eszet.\(suffix)" : Body serif

	select-variant 'Eszet' 0x1E9E

	define [EszetFlatTopScotsSShape slab] : glyph-proc
		include : MarkSet.capital
		local yBot : Math.max (CAP * 0.045) (0.3 * Stroke)
		include : ScotsSFlatTopArch CAP ArchDepthA
		include : ScotsHangingTilde (RightSB + O) (CAP - HalfStroke) yBot
		include : CapitalEszetSerifs slab

	define CapitalMiddleScotsSConfig : SuffixCfg.combine
		SuffixCfg.weave
			object # body
				rounded    EszetFlatTopScotsSShape
				flatTop    EszetFlatTopScotsSShape
				corner     EszetFlatTopScotsSShape
			function [body] : object # serifs
				serifless               SERIF-NONE
				serifed : match body
					[Just 'corner'] SERIF-DUAL
					__              SERIF-BOTTOM
		object # Exclusive corner serif variants
			cornerMotionSerifed { EszetFlatTopScotsSShape SERIF-MOTION }
			cornerBottomSerifed { EszetFlatTopScotsSShape SERIF-BOTTOM }

	foreach { suffix { Body serif } } [pairs-of CapitalMiddleScotsSConfig] : do
		create-glyph "MiddleScotsS.\(suffix)" : Body serif

	select-variant 'MiddleScotsS' 0xA7D6 (follow -- 'Eszet')
