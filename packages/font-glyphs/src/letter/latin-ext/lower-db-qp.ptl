$$include '../../meta/macros.ptl'

glyph-module

glyph-block Letter-Latin-Lower-DB-QP : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : LeaningAnchor
	glyph-block-import Letter-Shared-Shapes : OBarLeft OBarRight
	glyph-block-import Letter-Latin-Lower-D : DConfig TailedBody FlatBottomBody ToothlessCornerBody ToothlessCornerRTBBody ToothlessRoundedBody
	glyph-block-import Letter-Latin-Lower-B : BConfig BBowlKind
	glyph-block-import Letter-Latin-Lower-Q : QConfig QStem FlatTopBody EarlessCornerBody EarlessRoundedBody RbSerif
	glyph-block-import Letter-Latin-Lower-P : PConfig PBowlKind

	define [PairParams df] : begin
		local subDf : df.slice 3 2 OX
		local sw : df.mvs + 0
		local fine : df.shoulderFine + 0
		local ada : subDf.smallArchDepthA + 0
		local adb : subDf.smallArchDepthB + 0
		local xMidL : df.middle - [HSwToV : 0.5 * sw]
		local xMidR : df.middle + [HSwToV : 0.5 * sw]
		return { sw fine ada adb xMidL xMidR }

	define [CenterStemDf df] : begin
		local { sw fine ada adb xMidL xMidR } : PairParams df
		return : DivFrame.fromParams : object
			width : 0 + xMidR + df.sb
			sb    : 0 + df.sb
			hPack : 0 + 1
			mvs   : 0 + sw
			ox    : 0 + 0

	define [BarOf side] : if (side === 'l') OBarRight OBarLeft

	define [Bowl df side kind fFlat] : begin
		local Bar : BarOf side
		local { sw fine ada adb xMidL xMidR } : PairParams df
		local left : df.leftSB + 0
		local right : df.rightSB + 0
		local x0 : if (side === 'l') left xMidL
		local x1 : if (side === 'l') xMidR right
		local yTerm : if (kind === 'toothlessRounded')
			then Ascender
			: else : if (side === 'r') Descender ada

		if (kind === 'toothed') : return : if fFlat
			then : Bar.earlessCorner (rise -- 0) (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)
			else : Bar.shape (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)

		if (kind === 'flatBottom') : return : if fFlat
			then : Bar.flatTopAndBottom (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)
			else : Bar.toothlessCorner (rise -- 0) (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)

		if (kind === 'toothlessCorner') : return : if fFlat
			then : Bar.toothlessCornerFlat (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)
			else : Bar.toothlessCorner (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)

		if (kind === 'toothlessRounded') : return : if fFlat
			then : Bar.toothlessRoundedFlat (yTerminal -- yTerm) (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)
			else : Bar.toothlessRounded (yTerminal -- yTerm) (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)

		if (kind === 'flatTop') : return : if fFlat
			then : Bar.flatTopAndBottom (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)
			else : Bar.earlessCorner (rise -- 0) (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)

		if (kind === 'earlessCorner') : return : if fFlat
			then : Bar.earlessCornerFlat (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)
			else : Bar.earlessCorner (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)

		if (kind === 'earlessRounded') : return : if fFlat
			then : Bar.earlessRoundedFlat (yTerminal -- yTerm) (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)
			else : Bar.earlessRounded (yTerminal -- yTerm) (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)

		# eared (q/p): same bowls as toothed, but a flat bowl flattens the top.
		return : if fFlat
			then : Bar.toothlessCorner (rise -- 0) (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)
			else : Bar.shape (top -- XH) (bot -- 0) (left -- x0) (right -- x1) (sw -- sw) (fine -- fine) (ada -- ada) (adb -- adb)

	define [DbBowlKind Body] : begin
		if (Body === TailedBody) : return 'toothed'
		if (Body === FlatBottomBody) : return 'flatBottom'
		if (Body === ToothlessCornerBody || Body === ToothlessCornerRTBBody) : return 'toothlessCorner'
		if (Body === ToothlessRoundedBody) : return 'toothlessRounded'
		return 'toothed'

	define [QpBowlKind Body] : begin
		if (Body === FlatTopBody) : return 'flatTop'
		if (Body === EarlessCornerBody) : return 'earlessCorner'
		if (Body === EarlessRoundedBody) : return 'earlessRounded'
		return 'eared'

	define [SelectedCfg config want] : begin
		local found nothing
		foreach { suffix item } [Object.entries config] : do
			if (suffix === want) : set found item
		if [not found] : throw : new Error "Missing config for suffix '\(want)'"
		return found

	foreach { suffix { Body cut fFlat { topSerif bottomSerif } } } [Object.entries DConfig] : do
		create-glyph "db.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleMM 3
			include : df.markSet.b
			local { BodyB cutB fFlatB serifsB } : SelectedCfg BConfig para.variantSelector.b
			local stemDf : CenterStemDf df
			include : Bowl df 'l' [DbBowlKind Body] fFlat
			include : Bowl df 'r' [BBowlKind BodyB] fFlatB
			include : VBar.m df.middle 0 Ascender df.mvs
			if topSerif : include : topSerif stemDf Ascender
			include : LeaningAnchor.Above.At df.middle

	foreach { suffix { Body cut fFlat terminal { sRT sRB } } } [Object.entries QConfig] : do
		create-glyph "qp.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleMM 3
			include : df.markSet.p
			local { BodyP cutP fFlatP serifsP } : SelectedCfg PConfig para.variantSelector.p
			local stemDf : CenterStemDf df
			include : Bowl df 'l' [QpBowlKind Body] fFlat
			include : Bowl df 'r' [PBowlKind BodyP] fFlatP
			include : QStem terminal stemDf XH Descender XH Descender ""
			if (sRB === RbSerif) : include : sRB stemDf Descender
			include : LeaningAnchor.Below.At df.middle

	select-variant 'db' 0x238 (follow -- 'd')
	select-variant 'qp' 0x239 (follow -- 'q')
