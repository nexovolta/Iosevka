$$include '../../meta/macros.ptl'

import [mix clamp fallback] from '@iosevka/util'

glyph-module

glyph-block Letter-Latin-Lower-Eth : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared-Shapes : PalatalHook
	glyph-block-import Symbol-Punctuation-Ampersand : ClosedRotunda
	glyph-block-import Recursive-Build : ForkUpright

	define fine ShoulderFine

	define yMid1 : mix 0 Ascender 0.6
	define yMid2 : YSmoothMidR yMid1 0 SmallArchDepthA SmallArchDepthB
	define yMid3 : mix yMid1 yMid2 0.875

	define [ArcStartKnots _flatY1 _flatY2] : list
		widths.lhs fine
		straight.up.mid (RightSB - OX - [HSwToV : Stroke - fine]) yMid2
		Arch.lhs yMid1 (swBefore -- fine)
		g4 (SB + OX) [YSmoothMidL yMid1 0 SmallArchDepthA SmallArchDepthB]
		Arch.lhs 0
		flat (RightSB - OX) [fallback _flatY1 yMid2]
		curl (RightSB - OX) [fallback _flatY2 yMid3]

	create-glyph 'dInsular.curlyBar' : glyph-proc
		include : MarkSet.b
		include : dispiro
			ArcStartKnots
			quadControls 0 0.8
			g4 (SB + Stroke * 1.1) Ascender [widths.lhs]

	create-glyph 'dInsular.straightBar' : glyph-proc
		include : MarkSet.b
		local yMockBarStart : yMid2 + Stroke * 0.3
		local xTerminal : [mix SB RightSB 0.4] + [HSwToV HalfStroke]
		local pStraightBarStart : 0.75 - Stroke / (Ascender - 0)
		include : intersection [MaskBelow Ascender] : dispiro
			ArcStartKnots
			flat [mix Width xTerminal pStraightBarStart] [mix yMockBarStart CAP pStraightBarStart] [widths.lhs]
			curl [mix Width xTerminal 2]                 [mix yMockBarStart CAP 2]

	create-glyph 'dInsular.closedContour' : glyph-proc
		include : MarkSet.b
		include : dispiro
			ArcStartKnots SmallArchDepthA (Ascender - SmallArchDepthB)
			HookEnd Ascender
			g4 (SB + OX) (Ascender - Hook)

	select-variant 'dInsular' 0xA77A (follow -- 'eth')
	select-variant 'partial'  0x2202 (shapeFrom -- 'dInsular')

	create-glyph 'dRotundaCrossingLoop/uprightSource' : glyph-proc
		include : MarkSet.p
		include : ClosedRotunda Descender

	local useUprightSource : para.slopeAngle || para.isItalic || para.isOblique
	local uprightRotunda
	if (useUprightSource && [query-glyph 'dRotundaCrossingLoop/uprightSource'])
		set uprightRotunda : ForkUpright {'dRotundaCrossingLoop/uprightSource'}

	foreach suffix {'curlyBar' 'straightBar' 'closedContour'} : do
		create-glyph "dRotundaCrossingLoop.\(suffix)" : glyph-proc
			local source : refer-glyph 'dRotundaCrossingLoop/uprightSource'
			if useUprightSource
			: then : begin
				currentGlyph.dependsOn source
				include [uprightRotunda.queryByName 'dRotundaCrossingLoop/uprightSource'] AS_BASE ALSO_METRICS
				include [Italify para.slopeAngle] AS_BASE
			: else : include source AS_BASE ALSO_METRICS

	select-variant 'dRotundaCrossingLoop' 0x1DF93 (follow -- 'eth')

	derive-composites 'eth' 0xF0 'dInsular' : dispiro
		widths.center OverlayStroke
		flat [mix SB RightSB 0.10] [mix XH Ascender (-0.05)]
		curl [mix SB RightSB 0.95] [mix XH Ascender (+0.35)]

	derive-composites 'ethPalatalHook' 0x1DF2F 'eth' : PalatalHook.r
		x -- [mix [Arch.adjust-x.bot Middle] (RightSB - OX) 0.75]
		y -- 0
		yAttach -- [mix O yMid2 : archv.yFromX 0.75]
