$$include '../../meta/macros.ptl'

import [mix clamp fallback] from '@iosevka/util'
import [BOOLE_RESOLUTION] from '@iosevka/geometry/curve-util'
import [Boolean] from 'typo-geom'

extern Infinity

glyph-module

glyph-block Letter-Latin-Lower-Eth : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared-Shapes : PalatalHook
	glyph-block-import Symbol-Punctuation-Ampersand : ClosedRotunda
	glyph-block-import Recursive-Build : ForkUpright
	glyph-block-import Digits-Six : SixConfig

	define [EthCrossbarSegments glyph] : begin
		local contours : Boolean.removeOverlap
			[glyph.geometry.toBezArcs]
			Boolean.PolyFillType.NonZero
			BOOLE_RESOLUTION
		local segments {}
		foreach contour [items-of contours] : foreach arc [items-of contour] : begin
			local a : arc.eval 0
			foreach j [range 1 13] : begin
				local b : arc.eval (j / 12)
				segments.push {a b}
				set a b
		return segments

	define [EthCrossbarCross a b] : a.x * b.y - a.y * b.x

	define [EthCrossbarIntervals segments origin direction] : begin
		local hits {}
		foreach {a b} [items-of segments] : begin
			local edge : object
				x : b.x - a.x
				y : b.y - a.y
			local offset : object
				x : a.x - origin.x
				y : a.y - origin.y
			local denominator : EthCrossbarCross direction edge
			if ([Math.abs denominator] >= 1e-9) : begin
				local u : [EthCrossbarCross offset direction] / denominator
				if (u >= 0 && u < 1) : hits.push : [EthCrossbarCross offset edge] / denominator
		hits.sort : lambda [a b] : a - b
		if (hits.length % 2 !== 0) : throw : new Error 'Unclosed outline while placing eth crossbar'
		local result {}
		for [local i 0] (i + 1 < hits.length) [set i : i + 2] : result.push {hits.(i) hits.(i + 1)}
		return result

	define [EthCrossbarStemAt segments y nearX] : begin
		local origin : object
			x 0
			y : 0 + y
		local direction : object
			x 1
			y 0
		local spans : EthCrossbarIntervals segments origin direction
		if [not spans.length] : return null
		local span : spans.(spans.length - 1)
		if (nearX !== null) : begin
			set span spans.0
			foreach candidate [items-of spans] : begin
				if ([Math.abs ((candidate.0 + candidate.1) / 2 - nearX)] < [Math.abs ((span.0 + span.1) / 2 - nearX)])
					set span candidate
		return : (span.0 + span.1) / 2

	define [EthCrossbarFit glyph segments ascender width thickness fraction] : begin
		local gap : Math.max 1 (width * 0.01)
		local extension : width * 0.19
		local minimumExtension : width * 0.035
		local step : Math.max 2 (thickness * 0.08)
		local y : ascender * fraction
		local x : EthCrossbarStemAt segments y null
		if (x === null) : return null
		local below : EthCrossbarStemAt segments (y - step) x
		local above : EthCrossbarStemAt segments (y + step) x
		if (below === null || above === null) : return null
		local slope : (above - below) / (2 * step)
		local length : Math.hypot 1 slope
		local normal : object
			x : 1 / length
			y : (-slope) / length
		local tangent : object
			x : slope / length
			y : 1 / length
		local leftStem Infinity
		local rightStem : -Infinity
		local leftLimit : -Infinity
		local rightLimit Infinity
		foreach i [range 0 13] : begin
			local offset : thickness * (i / 12 - 0.5)
			local origin : object
				x : x + tangent.x * offset
				y : y + tangent.y * offset
			local spans : EthCrossbarIntervals segments origin normal
			local index : -1
			foreach j [range 0 spans.length] : if (index < 0 && spans.(j).0 <= 0 && spans.(j).1 >= 0)
				set index j
			if (index < 0) : return null
			set leftStem : Math.min leftStem spans.(index).0
			set rightStem : Math.max rightStem spans.(index).1
			if (index > 0) : set leftLimit : Math.max leftLimit (spans.(index - 1).1 + gap)
			if (index + 1 < spans.length) : set rightLimit : Math.min rightLimit (spans.(index + 1).0 - gap)
		local left : Math.max leftLimit (leftStem - extension)
		local right : Math.min rightLimit (rightStem + extension)
		if (leftStem - left < minimumExtension || right - rightStem < minimumExtension) : return null
		local corners {}
		foreach {along across} [items-of {{left (-0.5)} {right (-0.5)} {right 0.5} {left 0.5}}] : begin
			corners.push : glyph.gizmo.unapply : object
				x : x + normal.x * along + tangent.x * thickness * across
				y : y + normal.y * along + tangent.y * thickness * across
		return corners

	define [EthCrossbar glyph ascender width thickness] : begin
		local segments : EthCrossbarSegments glyph
		foreach fraction [items-of {0.76 0.72 0.8 0.68 0.84 0.64 0.88 0.92}] : begin
			local corners : EthCrossbarFit glyph segments ascender width thickness fraction
			if corners : return corners
		throw : new Error "Cannot place an isolated eth crossbar on \(glyph.identifier)"

	define fine ShoulderFine

	define yMid1 : mix 0 Ascender 0.6
	define yMid2 : YSmoothMidR yMid1 0 SmallArchDepthA SmallArchDepthB

	define [CurlyBarShape bowlTop] : glyph-proc
		local mid : YSmoothMidR bowlTop 0 SmallArchDepthA SmallArchDepthB
		include : dispiro
			widths.lhs fine
			straight.up.mid (RightSB - OX - [HSwToV : Stroke - fine]) mid
			Arch.lhs bowlTop (swBefore -- fine)
			g4 (SB + OX) [YSmoothMidL bowlTop 0 SmallArchDepthA SmallArchDepthB]
			Arch.lhs 0
			flat (RightSB - OX) mid
			curl (RightSB - OX) [mix bowlTop mid 0.875]
			quadControls 0 0.8
			g4 (SB + Stroke * 1.1) Ascender [widths.lhs]

	create-glyph 'dInsular.curlyBar' : glyph-proc
		include : MarkSet.b
		include : CurlyBarShape XH
	create-glyph 'dInsular/oldBowl.curlyBar' : glyph-proc
		include : MarkSet.b
		include : CurlyBarShape yMid1

	foreach {suffix {Body fFlatBowl}} [Object.entries SixConfig] : do
		create-glyph "dInsular.\(suffix)" : glyph-proc
			include : MarkSet.b
			include : Body fFlatBowl Ascender XH
			include : FlipAround Middle 0 (-1) 1
		create-glyph "dInsular/oldBowl.\(suffix)" : glyph-proc
			include : MarkSet.b
			include : Body fFlatBowl Ascender
			include : FlipAround Middle 0 (-1) 1

	select-variant 'dInsular' 0xA77A (follow -- 'eth')
	select-variant 'partial'  0x2202 (shapeFrom -- 'dInsular/oldBowl')

	create-glyph 'dRotundaCrossingLoop/uprightSource' : glyph-proc
		include : MarkSet.p
		include : ClosedRotunda Descender

	local useUprightSource : para.slopeAngle || para.isItalic || para.isOblique
	local uprightRotunda
	if (useUprightSource && [query-glyph 'dRotundaCrossingLoop/uprightSource'])
		set uprightRotunda : ForkUpright {'dRotundaCrossingLoop/uprightSource'}

	foreach suffix [{'curlyBar'}.concat : Object.keys SixConfig] : do
		create-glyph "dRotundaCrossingLoop.\(suffix)" : glyph-proc
			local source : refer-glyph 'dRotundaCrossingLoop/uprightSource'
			if useUprightSource
			: then : begin
				currentGlyph.dependsOn source
				include [uprightRotunda.queryByName 'dRotundaCrossingLoop/uprightSource'] AS_BASE ALSO_METRICS
				include [Italify para.slopeAngle] AS_BASE
			: else : include source AS_BASE ALSO_METRICS

	select-variant 'dRotundaCrossingLoop' 0x1DF93 (follow -- 'eth')

	foreach suffix [{'curlyBar'}.concat : Object.keys SixConfig] : do
		create-glyph "eth.\(suffix)" : glyph-proc
			local base : query-glyph "dInsular/oldBowl.\(suffix)"
			include base AS_BASE ALSO_METRICS
			local corners : EthCrossbar base Ascender Width OverlayStroke
			currentGlyph.clearGeometry
			include : union
				begin base
				spiro-outline
					corner corners.0.x corners.0.y
					corner corners.3.x corners.3.y
					corner corners.2.x corners.2.y
					corner corners.1.x corners.1.y

	select-variant 'eth' 0xF0

	derive-composites 'ethPalatalHook' 0x1DF2F 'eth' : PalatalHook.r
		x -- [mix [Arch.adjust-x.bot Middle] (RightSB - OX) 0.75]
		y -- 0
		yAttach -- [mix O yMid2 : archv.yFromX 0.75]
