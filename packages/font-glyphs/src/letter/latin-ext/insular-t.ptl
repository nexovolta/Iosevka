$$include '../../meta/macros.ptl'

import [mix] from '@iosevka/util'

glyph-module

glyph-block Letter-Latin-Insular-T : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Latin-C : CConfig CLetterForm
	glyph-block-import Letter-Shared-Shapes : SerifedArcEnd InwardSlabArcEnd
	glyph-block-import Letter-Arc-Hook : MakeFlatHook MakeCornerHookBase CutArcTerminal DeltaCutEnd VerticalCutExtension
	glyph-block-import Letter-Latin-Upper-T : TConfig TShape TLeftX

	define SLAB-CLASSICAL 1
	define SLAB-INWARD 2
	define SLAB-FLAT-HOOK 4
	define SLAB-CORNER-HOOK 5
	define CUT-VERTICAL 6
	define CUT-DIAGONAL 7

	define InsularTSymConfig : object
		symmetric false
		asymmetric true

	define [InsularTShape top bot ada adb styBot fNoTopBar] : glyph-proc
		if (!fNoTopBar) : include : HBar.t SB RightSB top

		local fine : Stroke * CThinB
		local arc : dispiro
			straight.left.start Middle (top - Stroke + fine) [widths.lhs.heading fine Leftward]
			archv
			flatside.ld SB bot (top - Stroke + fine) ada adb nothing [widths.lhs]
			match styBot
				[Just SLAB-CLASSICAL] : SerifedArcEnd.LtrLhs RightSB bot Stroke Hook
				[Just SLAB-INWARD] : InwardSlabArcEnd.LtrLhs RightSB bot Stroke Hook
				[Just SLAB-FLAT-HOOK] : [MakeFlatHook SB RightSB top bot].hookEndR
				[Just SLAB-CORNER-HOOK] : [MakeCornerHookBase SB RightSB top bot].hookEndR
				[Just CUT-DIAGONAL] : DeltaCutEnd Middle RightSB (bot + O) (bot + 0.2 * Hook) Stroke
				[Just CUT-VERTICAL] : list [HookEnd bot] [g4 (RightSB + [VerticalCutExtension Hook Stroke]) (bot + Hook)]
				__ : list
					HookEnd bot
					g4 RightSB (bot + Hook)
		include : if (styBot === CUT-VERTICAL) [CutArcTerminal arc RightSB top bot Stroke false false] arc
		include : [CLetterForm [DivFrame 1] 0 styBot top bot].botSerif

	foreach {suffix {styTop styBot}} [Object.entries CConfig] : do
		create-glyph "TInsular.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : InsularTShape CAP 0 ArchDepthA ArchDepthB styBot
		create-glyph "tInsular.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : InsularTShape XH 0 SmallArchDepthA SmallArchDepthB styBot

		foreach {tSuffix {adws doST doSB fShort}} [Object.entries TConfig] : do
			create-glyph "TInsular.phonotypic.\(suffix).\(tSuffix)" : glyph-proc
				local df : include : DivFrame adws
				include : df.markSet.capital
				local serifShift : if doST (0.07 * df.width + [HSwToV HalfStroke] / 4) 0
				include : new-glyph : glyph-proc
					include : TShape df CAP doST false nothing fShort
					eject-contour 'strokeV'
					if doST : eject-contour 'serifLT'
				if doST : begin
					include : HBar.t ([TLeftX df] - serifShift) [TLeftX df] CAP
					include : with-transform [ApparentTranslate (-serifShift) 0]
						new-glyph : glyph-proc
							include : TShape df CAP doST false nothing fShort
							eject-contour 'strokeV'
							eject-contour 'strokeLT'
							eject-contour 'strokeRT'
							eject-contour 'serifRT'
				include : with-transform [ApparentTranslate (df.middle - Middle + serifShift) 0]
					InsularTShape CAP 0 ArchDepthA ArchDepthB styBot true

		foreach {sym fAsymmetric} [pairs-of InsularTSymConfig] : do
			create-glyph "tInsular.phonotypic.\(suffix).\(sym)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.b
				local bowl : [CLetterForm df styTop styBot XH 0 (ada -- SmallArchDepthA) (adb -- SmallArchDepthB)].full
				local xShift : if fAsymmetric (0.25 * (df.rightSB - df.leftSB)) 0
				include bowl
				include : difference [VBar.m df.middle (XH - HalfStroke) Ascender] bowl
				include : HBar.m ([mix df.leftSB df.middle 0.5] + xShift) ([mix df.rightSB df.middle 0.5] + xShift) [mix XH Ascender 0.6] [Math.min Stroke : 0.45 * (Ascender - XH)]
		select-variant "tInsular.phonotypic.\(suffix)" (follow -- 't/insularSym')

	select-variant 'TInsular' 0xA786 (follow -- 'C')
	select-multi-dimensional-variant 'TInsular.phonotypic' (follows -- {'C' 'T'})
	select-variant 'tInsular' 0xA787 (follow -- 'c')
	select-variant 'tInsular.phonotypic' (follow -- 'c')
