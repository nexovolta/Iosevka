$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from "@iosevka/util"

glyph-module

glyph-block Letter-Latin-Upper-Thorn : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : LeaningAnchor
	glyph-block-import Letter-Shared-Metrics : BowlXDepth
	glyph-block-import Letter-Shared-Shapes : LetterBarOverlay SerifFrame
	glyph-block-import Letter-Latin-Upper-P : PShape

	define kSB 1.25
	define xThornBarLeft : mix 0 SB kSB

	define [yThornBowlBot top slab] : [mix 0 top 0.19] + [if slab 0.375 0] * Stroke
	define [yThornBowlTop top slab] : top - [yThornBowlBot top slab]

	define [yThornBowlAsymmetricBot top slab] : [mix 0 top 0.25] + [if slab 0.125 0] * Stroke
	define [yThornBowlAsymmetricTop top slab] : top - [mix 0 [yThornBowlAsymmetricBot top slab] 0.7] + [if slab (-0.125) (+0.250)] * Stroke

	glyph-block-export ThornShapeImpl
	define [ThornShapeImpl top slabTop slabBot yBowlBot yBowlTop fOpen] : glyph-proc
		local xTurn : Math.max
			RightSB       - [BowlXDepth yBowlTop yBowlBot xThornBarLeft RightSB Stroke]
			xThornBarLeft + [HSwToV Stroke]

		include : difference
			new-glyph : glyph-proc
				include : dispiro
					widths.rhs
					flat xThornBarLeft yBowlTop [heading Rightward]
					curl [Arch.adjust-x.top xTurn] yBowlTop
					archv
					g4   (RightSB - OX) [YSmoothMidR yBowlTop yBowlBot ArchDepthA ArchDepthB]
					arcvh
					flat [Arch.adjust-x.bot xTurn] yBowlBot
					curl xThornBarLeft yBowlBot [heading Leftward]
				include : VBar.l xThornBarLeft 0 top
				if slabTop : begin
					local sf : SerifFrame top 0 xThornBarLeft RightSB
					if slabBot
						then : include : composite-proc sf.lt.fullSide sf.lb.fullSide
						else : include   sf.lt.outer
			if fOpen
				PShape.OpenGap
					top -- yBowlTop
					bot -- (yBowlBot - 0.5 * Stroke - TINY)
					bp  -- ((yBowlBot + Stroke * PShape.SwBelowBar) / (yBowlTop - Stroke))
					sw  -- Stroke
				no-shape

		include : LeaningAnchor.Above.VBar.l xThornBarLeft
		include : LeaningAnchor.Below.VBar.l xThornBarLeft

	define [ThornShape top slabTop slabBot fOpen] : ThornShapeImpl top slabTop slabBot
		yThornBowlBot top slabBot
		yThornBowlTop top slabBot
		fOpen

	define [ThornAsymmetricShape top slabTop slabBot fOpen] : ThornShapeImpl top slabTop slabBot
		yThornBowlAsymmetricBot top slabBot
		yThornBowlAsymmetricTop top slabBot
		fOpen

	define ThornConfig : SuffixCfg.weave
		object # symmetry
			""            ThornShape
			asymmetric    ThornAsymmetricShape
		object # openness
			""            false
			open          true
		object # serifs
			serifless     { false false }
			motionSerifed { true  false }
			serifed       { true  true  }

	foreach { suffix { Body fOpen { doST doSB } } } [Object.entries ThornConfig] : do
		create-glyph "Thorn.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : Body CAP doST doSB fOpen

		if (Body !== ThornAsymmetricShape)
		: then : begin
			create-glyph "ThornStroke.\(suffix)" : glyph-proc
				include : MarkSet.capital
				include : ThornShapeImpl CAP doST doSB
					CAP - [yThornBowlAsymmetricTop CAP doSB]
					CAP - [yThornBowlAsymmetricBot CAP doST]
					fOpen
				include : LetterBarOverlay.l.in
					x   -- xThornBarLeft
					top -- (CAP - [if doST Stroke 0])
					bot -- (CAP - [yThornBowlAsymmetricBot CAP doST])

		: else : begin
			create-glyph "ThornStrokeBottom.\(suffix)" : glyph-proc
				include [refer-glyph "Thorn.\(suffix)"] AS_BASE ALSO_METRICS
				include : LetterBarOverlay.l.in
					x   -- xThornBarLeft
					bot -- [if doSB Stroke 0]
					top -- [yThornBowlAsymmetricBot CAP doSB]

	select-variant 'Thorn' 0xDE
	select-variant 'grek/Sho' 0x3F7 (shapeFrom -- 'Thorn') (follow -- 'Thorn')
	select-variant 'ThornStroke' 0xA764
	select-variant 'ThornStrokeBottom' 0xA766
