$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [maskOffBits] from "@iosevka/util/mask-bit"

glyph-module

glyph-block Letter-Latin-Upper-AA-AO : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Above : MeasureGlyphBounds
	glyph-block-import Letter-Latin-Lower-AE-OE : SubDfAndShift

	# After overlapping A+V / A+Y, the ink no longer fills the MM frame evenly.
	# Shift the finished digraph so its bounds sit on the advance midpoint.
	define [CenterDigraphInFrame df] : glyph-proc
		local b : include : MeasureGlyphBounds
		if [not b] : return nothing
		local xShift : df.middle - [mix b.xMin b.xMax 0.5]
		if ([Math.abs xShift] > 1e-6) : currentGlyph.applyTransform [ApparentTranslate xShift 0] true

	do "A glyphs"
		glyph-block-import Letter-Latin-Upper-A : AShape AConfig

		define [AHalfShape pShift df top fStraightBar slabKind] : begin
			local { subDf shift } : SubDfAndShift pShift df
			return : with-transform [ApparentTranslate shift 0]
				AShape.Letter subDf fStraightBar slabKind top df.mvs

		define [AHalfShapeMask pShift df top fStraightBar slabKind] : begin
			local { subDf shift } : SubDfAndShift pShift df
			return : with-transform [ApparentTranslate shift 0]
				AShape.Mask subDf fStraightBar top df.mvs

		define SLAB-NONE    0
		define SLAB-TOP     1
		define SLAB-LEFT    2
		define SLAB-RIGHT   4

		define ALetters : object
			""   { 0xA732 para.advanceScaleMM 'capital' CAP }
			smcp { null   para.advanceScaleM  'e'       XH  }

		foreach { prefix { code adws mk height } } [Object.entries ALetters] : do
			foreach { suffix { bodyShape slabKind } } [Object.entries AConfig] : do
				define skLeft  : maskOffBits slabKind SLAB-RIGHT
				define skRight : maskOffBits slabKind SLAB-LEFT

				create-glyph "\(prefix)AA/left.\(suffix)" : glyph-proc
					define df : include : DivFrame adws 3.5
					include : df.markSet.(mk)
					set-base-anchor 'cvDecompose' 0 0
					include : AHalfShape 0 df height bodyShape skLeft
					local { subDf } : SubDfAndShift 0 df
					set-base-anchor 'aBar' subDf.middle [AShape.BarPos bodyShape skLeft height]

				create-glyph "\(prefix)AA/left/mask.\(suffix)" : glyph-proc
					define df : include : DivFrame adws 3.5
					include : df.markSet.(mk)
					set-base-anchor 'cvDecompose' 0 0
					include : AHalfShapeMask 0 df height bodyShape skLeft

				create-glyph "\(prefix)AA/right.\(suffix)" : glyph-proc
					define df : DivFrame adws 3.5
					set-width 0
					include : df.markSet.(mk)
					set-mark-anchor 'cvDecompose' 0 0 0 0
					include : AHalfShape 1 df height bodyShape skRight

				create-glyph "\(prefix)AA/right/mask.\(suffix)" : glyph-proc
					define df : DivFrame adws 3.5
					set-width 0
					include : df.markSet.(mk)
					set-mark-anchor 'cvDecompose' 0 0 0 0
					include : AHalfShapeMask 1 df height bodyShape skRight

				if (!prefix) : begin
					create-glyph "AU/A.\(suffix)" : glyph-proc
						define df : include : DivFrame adws 3.5
						local subDf : df.slice 3 2
						include : AShape.LetterBottomRightRemoved subDf bodyShape slabKind CAP df.mvs
					create-glyph "AU/A/mask.\(suffix)" : glyph-proc
						define df : include : DivFrame adws 3.5
						local subDf : df.slice 3 2
						include : union
							MaskAbove : [AShape.BarPos bodyShape slabKind CAP] - df.mvs
							MaskLeft  : subDf.width / 2
						include : AShape.LetterBottomRightRemoved subDf bodyShape slabKind CAP df.mvs

			select-variant "\(prefix)AA/left"       (follow -- 'A')
			select-variant "\(prefix)AA/left/mask"  (follow -- 'A')
			select-variant "\(prefix)AA/right"      (follow -- 'A')
			select-variant "\(prefix)AA/right/mask" (follow -- 'A')

			derive-multi-part-glyphs "\(prefix)AA" code
				list "\(prefix)AA/left" "\(prefix)AA/left/mask" "\(prefix)AA/right" "\(prefix)AA/right/mask"
				function [srcs gr] : glyph-proc
					define df : DivFrame adws 3.5
					define topSerifGap : Math.max (0.1 * (df.rightSB - df.leftSB)) : AdviceStroke 6
					define { left leftMask right rightMask } srcs

					include [refer-glyph left] AS_BASE ALSO_METRICS
					include : difference
						refer-glyph right
						refer-glyph leftMask
						difference
							intersection
								MaskAbove (height - Stroke)
								with-transform [ApparentTranslate topSerifGap 0] [refer-glyph leftMask]
							with-transform [ApparentTranslate (OX - TINY) 0] [refer-glyph rightMask]

	do "AO"
		derive-multi-part-glyphs 'AO' 0xA734 { "AA/left" "AA/left/mask" "AO/O" }
			function [srcs gr] : glyph-proc
				define df : DivFrame para.advanceScaleMM 3.5
				define topSerifGap : Math.max (0.1 * (df.rightSB - df.leftSB)) : AdviceStroke 6
				define { left leftMask right } srcs
				include [refer-glyph left] AS_BASE ALSO_METRICS
				include : difference [refer-glyph right] [refer-glyph leftMask]

	do "U subglyphs"
		glyph-block-import Letter-Latin-U : UShapeGroup CapitalUConfigT

		define df : DivFrame para.advanceScaleMM 3.5
		define { subDf shift } : SubDfAndShift 1 df
		define sg : UShapeGroup subDf.archDepthA subDf.archDepthB

		foreach { suffix { { Base } { Slabs fLTSlab } } } [Object.entries : CapitalUConfigT sg] : do
			create-glyph "AU/U.\(suffix)" : glyph-proc
				include : with-transform [ApparentTranslate shift 0]
					union [Base subDf CAP df.mvs] [Slabs subDf CAP df.mvs]

		select-variant 'AU/U'

	do "AU"
		select-variant 'AU/A'      (follow -- 'A')
		select-variant 'AU/A/mask' (follow -- 'A')
		derive-multi-part-glyphs 'AU' 0xA736 { "AU/A" "AU/A/mask" "AU/U" }
			function [srcs gr] : glyph-proc
				define df : include : DivFrame para.advanceScaleMM 3.5
				local { subDf shift } : SubDfAndShift 1 df
				include : df.markSet.capital
				define { left mask right } srcs
				include [refer-glyph left]
				include : difference [refer-glyph right]
					intersection [refer-glyph mask] [MaskLeft (subDf.width / 2 + shift)]

	do "AV"
		glyph-block-import Letter-Latin-V : VShape VSquareTopShape VSerifs VCornerHalfWidth

		define dfAV : DivFrame para.advanceScaleMM 3.5
		define { subDfAV shiftAV0 } : SubDfAndShift 1 dfAV
		# V's vertex sits on A's right foot so the two right-going diagonals are one line.
		define shiftAV : subDfAV.rightSB - subDfAV.middle

		define AVVConfig : object
			straightSerifless  { true  0 }
			curlySerifless     { false 0 }
			squareTopSerifless { true  1 }

		foreach { suffix { fStraightBar fSquareTop } } [Object.entries AVVConfig] : do
			create-glyph "AV/V.\(suffix)" : glyph-proc
				include : with-transform [ApparentTranslate shiftAV 0] : glyph-proc
					if fSquareTop : include : VSquareTopShape subDfAV CAP dfAV.mvs
					if [not fSquareTop] : include : VShape subDfAV fStraightBar CAP (sw -- dfAV.mvs)
					include : NeedSlab SLAB : VSerifs subDfAV fStraightBar CAP dfAV.mvs
					eject-contour 'serifLT'
					eject-contour 'strokeDown'

		select-variant 'AV/V' (follow -- 'V/sansSerif')
		derive-multi-part-glyphs 'AV' 0xA738 { "AA/left" "AV/V" }
			function [srcs gr] : glyph-proc
				define df : include : DivFrame para.advanceScaleMM 3.5
				include : df.markSet.capital
				define { left right } srcs
				include [refer-glyph left]
				include [refer-glyph right]
				include : CenterDigraphInFrame df

		derive-multi-part-glyphs 'AVBar' 0xA73A { "AA/left" "AV/V" }
			function [srcs gr] : glyph-proc
				define df : include : DivFrame para.advanceScaleMM 3.5
				include : df.markSet.capital
				local { subDf } : SubDfAndShift 1 df
				local shift : subDf.rightSB - subDf.middle
				define { left right } srcs
				include [refer-glyph left]
				include [refer-glyph right]
				local leftG : query-glyph left
				local yBar : begin [leftG.gizmo.unapply leftG.baseAnchors.aBar].y
				local yOverlay : yBar - df.mvs / 2
				local cornerHW : VCornerHalfWidth * (df.mvs / Stroke)
				local t : yOverlay / CAP
				local xLeft : shift + [mix (subDf.middle - cornerHW) subDf.leftSB t]
				local xRight : shift + [mix (subDf.middle + cornerHW) subDf.rightSB t]
				include : HOverlayBar xLeft xRight yOverlay
				include : CenterDigraphInFrame df

	do "AY"
		glyph-block-import Letter-Latin-Lower-Y : NonCursiveYShapeT NonCursiveYConfig
		glyph-block-import Letter-Shared-Shapes : SerifFrame

		define dfAY : DivFrame para.advanceScaleMM 3.5
		define { subDfAY shiftAY0 } : SubDfAndShift 1 dfAY
		define shiftAY : subDfAY.rightSB - subDfAY.middle
		define slabAutoY { false SLAB false }

		foreach { suffix { { straightBar fSquareTop } bottomShape slabKind } } [Object.entries NonCursiveYConfig] : do
			if [not fSquareTop] : begin
				create-glyph "AY/Y.\(suffix)" : glyph-proc
					local YShape : NonCursiveYShapeT straightBar bottomShape slabAutoY 0 subDfAY.width subDfAY.leftSB dfAY.mvs
					include : with-transform [ApparentTranslate shiftAY 0] : glyph-proc
						include : YShape.SmallYShape CAP Descender
						eject-contour 'leftHalf'
						include : NeedSlab SLAB : glyph-proc
							local sf : SerifFrame.fromDf subDfAY CAP Descender
							include sf.rt.full

		select-variant 'AY/Y' (follow -- 'y/nonCursive')
		derive-multi-part-glyphs 'AY' 0xA73C { "AA/left" "AY/Y" }
			function [srcs gr] : glyph-proc
				define df : include : DivFrame para.advanceScaleMM 3.5
				include : df.markSet.capDesc
				define { left right } srcs
				include [refer-glyph left]
				include [refer-glyph right]
				include : CenterDigraphInFrame df

	do "Rha"
		glyph-block-import Letter-Shared-Shapes : SerifFrame WithSerifOverflowMask
		glyph-block-import Letter-Latin-Upper-P : PShape PConfig
		glyph-block-import Letter-Latin-X : XConfig XLetterForm XSerifs
		glyph-block-import Letter-Latin-Lower-AE-OE : BuildRha

		foreach { suffix { fGap slabs } } [Object.entries PConfig] : do
			local fSlabBot : slabs && slabs !== PShape.SlabMotion

			create-glyph "cyrl/Rha/Er.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleM 3
				include : df.markSet.capital
				set-base-anchor 'cvDecompose' 0 0
				local subDf : df.sliceFine 3 2 0.575

				include : difference
					PShape CAP (df -- subDf) (slab -- slabs)
					if fGap
						PShape.OpenGap (df -- subDf) (top -- CAP) (bot -- [if fSlabBot df.mvs 0])
						no-shape

		foreach { suffix { { stroke1 stroke2 } { desc } { serifShape fMaskBase } } } [Object.entries XConfig] : do
			define [letterShape df top bot turn tension] : glyph-proc
				local lf : XLetterForm [df.bodyBox top bot] stroke1 stroke2 turn tension (sw -- df.mvs)
				include : WithSerifOverflowMask fMaskBase [df.bodyBox top bot] : lf.rightHalf fMaskBase
				if serifShape : begin
					local sf : SerifFrame.fromDf df top bot
					include : match serifShape
						[Just XSerifs.Full] : composite-proc sf.rt.full sf.rb.full
						[Just XSerifs.BilateralMotion] : composite-proc sf.rb.outer
						__ : glyph-proc

			if (!desc) : begin
				create-glyph "cyrl/Rha/Kha.\(suffix)" : glyph-proc
					local df : DivFrame para.advanceScaleM 3
					set-width 0
					set-mark-anchor 'cvDecompose' 0 0
					include : letterShape df CAP 0 0.1 0.28

		select-variant 'cyrl/Rha/Er' (follow -- 'cyrl/Er')
		select-variant 'cyrl/Rha/Kha'
		derive-multi-part-glyphs 'cyrl/Rha' 0x516 { "cyrl/Rha/Er" "cyrl/Rha/Kha" } BuildRha
