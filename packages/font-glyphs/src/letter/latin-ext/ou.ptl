$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from '@iosevka/util'

glyph-module

glyph-block Letter-Latin-OU : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Latin-U : UShapeGroup CapitalUConfigT SmallUConfigT
	glyph-block-import Letter-Shared-Shapes : uBowl

	define [OuShape top yBar yGapLT yGapRT ada adb] : glyph-proc
		local stroke : AdviceStroke2 2 3 (top - 0)
		local fine : stroke * CThin
		include : OShape (yBar + stroke / 2 + O) 0 SB RightSB stroke ada adb

		local xGapMT : 0.1 * (Width - 0)
		local xLeft : clamp
			SB + [HSwToV : 1.125 * stroke] + TINY + [Math.abs : TanSlope * stroke]
			mix SB RightSB 0.45
			Arch.adjust-x.top (Middle - xGapMT / 2) (sw -- stroke)
		local xRight : clamp
			mix SB RightSB 0.55
			RightSB - [HSwToV : 1.125 * stroke] - TINY - [Math.abs : TanSlope * stroke]
			Arch.adjust-x.top (Middle + xGapMT / 2) (sw -- stroke)
		include : dispiro
			widths.lhs stroke
			g4.left.start xLeft (top - yGapLT)
			archv
			g4.down.mid SB [YSmoothMidL (top - yGapLT) (yBar - stroke / 2) ada adb]
			Arch.lhs (yBar + stroke / 2 - fine) (swBefore -- stroke) (sw -- fine) (swAfter -- stroke) (o -- 0)
			g4.up.mid RightSB [YSmoothMidR (top - yGapRT) (yBar - stroke / 2) ada adb] [widths.lhs stroke]
			arcvh
			g4.left.end xRight (top - yGapRT)

	create-glyph 'OU' 0x222 : glyph-proc
		include : MarkSet.capital
		include : OuShape CAP [mix 0 CAP HBarPos] (0.05 * (CAP - 0)) 0 ArchDepthA ArchDepthB

	create-glyph 'smcpOU' 0x1D15 : glyph-proc
		include : MarkSet.e
		include : OuShape XH [mix 0 XH HBarPos] 0 0 ArchDepthA ArchDepthB

	create-glyph 'ou' 0x223 : glyph-proc
		include : MarkSet.b
		include : OuShape Ascender [mix 0 Ascender : mix HBarPos (XH / CAP) 0.5] 0 0 SmallArchDepthA SmallArchDepthB

	define [PhonotypicOuShape df top ada adb] : glyph-proc
		local sw : AdviceStroke2 2 3 top
		local fine : sw * CThin
		local yBar : mix 0 top HBarPos
		local yBase : yBar + sw / 2 - fine
		local depth : Math.max TINY : (top - yBase) * 0.65
		include : union
			OShape (yBar + sw / 2 + O) 0 df.leftSB df.rightSB sw ada adb
			uBowl.toothlessRounded
				left    -- df.leftSB
				right   -- df.rightSB
				top     -- top
				bottom  -- yBase
				stroke  -- sw
				ada     -- [Math.min ada depth]
				adb     -- [Math.min adb depth]

	foreach {suffix {{Base} cut {Slabs}}} [Object.entries : CapitalUConfigT [UShapeGroup ArchDepthA ArchDepthB]] : do
		create-glyph "OU.phonotypic.\(suffix)" : glyph-proc
			local df : include : DivFrame 1
			include : df.markSet.capital
			include : PhonotypicOuShape df CAP ArchDepthA ArchDepthB
			include : Slabs df CAP Stroke
			eject-contour 'serifRB'

		create-glyph "smcpOU.phonotypic.\(suffix)" : glyph-proc
			local df : include : DivFrame 1
			include : df.markSet.e
			include : PhonotypicOuShape df XH ArchDepthA ArchDepthB
			include : Slabs df XH Stroke
			eject-contour 'serifRB'

	foreach {suffix {{Base} cut Slabs}} [Object.entries : SmallUConfigT [UShapeGroup SmallArchDepthA SmallArchDepthB]] : do
		create-glyph "ou.phonotypic.\(suffix)" : glyph-proc
			local df : include : DivFrame 1
			include : df.markSet.e
			include : PhonotypicOuShape df XH SmallArchDepthA SmallArchDepthB
			include : Slabs df XH Stroke
			eject-contour 'serifRB'

	select-variant 'OU.phonotypic' (follow -- 'U')
	select-variant 'smcpOU.phonotypic' (follow -- 'U')
	select-variant 'ou.phonotypic' (follow -- 'u')
