$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from '@iosevka/util'

import [maskBit maskBits] from '@iosevka/util/mask-bit'

glyph-module

glyph-block Letter-Latin-Long-S : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : LeaningAnchor
	glyph-block-import Mark-Above : CenterInkInFrame
	glyph-block-import Letter-Shared : CreateAccentedComposition
	glyph-block-import Letter-Shared-Shapes : JCurlyTailShape FlatHookDepth LetterBarOverlay DiagTail
	glyph-block-import Letter-Shared-Shapes : PalatalHook RetroflexHook
	glyph-block-import Letter-Latin-Lower-F : StdSmallFBarLeftPos StdSmallFBarLeftPos0 ySmallFBarPos
	glyph-block-import Letter-Latin-Lower-F : SmallFDiagonalTail
	glyph-block-import Letter-Latin-Lower-I : Casual CasualTopBetween CasualBottom
	glyph-block-import Letter-Latin-Rams-Horn : RamsHornShape
	glyph-block-import Letter-Arc-Hook : CornerHookDepth CornerHookOffset CornerHookOutset

	define SLAB_SERIFLESS       0
	define SLAB_BOTTOM          1
	define SLAB_MIDDLE          2
	define SLAB_MIDDLE_XH       4
	define SLAB_MIDDLE_HALF_ASC 8

	define SLAB_DOUBLE          : SLAB_BOTTOM + SLAB_MIDDLE
	define SLAB_DOUBLE_XH       : SLAB_BOTTOM + SLAB_MIDDLE_XH
	define SLAB_DOUBLE_HALF_ASC : SLAB_BOTTOM + SLAB_MIDDLE_HALF_ASC

	glyph-block-export LongSUpperHalf LongSLowerHalf
	define [LongSUpperHalf sign x top bottom hookX hookY _sw fCorner _stemSw] : glyph-proc
		local hd : FlatHookDepth [DivFrame 1]
		local sw : fallback _sw Stroke
		local xTip : x + sign * (hookX + [if fCorner ([CornerHookOffset sw] + [CornerHookOutset sw]) 0])
		include : dispiro
			widths.center sw
			flat (xTip - sign * [if fCorner [HSwToV : sw / 2] 0]) (top - sw / 2) : if (fCorner && para.isItalic) [heading [if (sign > 0) Leftward Rightward]] nothing
			curl (x + sign * [Math.min (hd.x - [HSwToV : 0.25 * sw]) (hookX - TINY - [if fCorner ([HSwToV sw] - [CornerHookOffset sw]) 0])]) (top - sw / 2) [widths.center sw]
			archv.superness DesignParameters.tightHookSuperness
			flat x (top - sw / 2 - [Math.min hd.y hookY])
			curl x bottom [widths.center.heading [fallback _stemSw sw] Downward]
		if fCorner : include : [if (sign > 0) VBar.r VBar.l] xTip (top - [CornerHookDepth Hook sw]) top sw

	define [LongSLowerHalf sign x top bottom hookX hookY _sw fCorner] : glyph-proc
		local hd : FlatHookDepth [DivFrame 1]
		local sw : fallback _sw Stroke
		local xTip : x - sign * (hookX + [if fCorner ([CornerHookOffset sw] + [CornerHookOutset sw]) 0])
		include : dispiro
			widths.center sw
			flat (xTip + sign * [if fCorner [HSwToV : sw / 2] 0]) (bottom + sw / 2) : if (fCorner && para.isItalic) [heading [if (sign > 0) Rightward Leftward]] nothing
			curl (x - sign * [Math.min (hd.x - [HSwToV : 0.25 * sw]) (hookX - TINY - [if fCorner ([HSwToV sw] - [CornerHookOffset sw]) 0])]) (bottom + sw / 2) [widths.center sw]
			archv.superness DesignParameters.tightHookSuperness
			flat x (bottom + sw / 2 + [Math.min hd.y hookY])
			curl x top [heading Upward]
		if fCorner : include : [if (sign > 0) VBar.l VBar.r] xTip bottom (bottom + [CornerHookDepth Hook sw]) sw

	glyph-block-export LongSShape
	define [LongSShape top bottom hookx hooky fine fCorner] : union
		LongSUpperHalf (+1) Middle top [mix top bottom 0.5] hookx hooky fine fCorner
		LongSLowerHalf (+1) Middle [mix top bottom 0.5] bottom hookx hooky fine fCorner

	define [StandardSerifs m0 fSlab _kSerif] : glyph-proc
		local m : m0 + [HSwToV HalfStroke]
		local serifLength : Math.max Jut : mix [HSwToV HalfStroke] MidJutCenter : fallback _kSerif 1
		local xSerifPos : mix m Middle (serifLength / Width)
		if [maskBits fSlab SLAB_BOTTOM] : include : tagged 'serifLB' : HSerif.mb xSerifPos 0 serifLength
		if [maskBits fSlab SLAB_MIDDLE] : include : tagged 'serifLM' : intersection
			MaskLeft (m + TINY)
			HSerif.mt xSerifPos ySmallFBarPos serifLength
		if [maskBits fSlab SLAB_MIDDLE_XH] : include : tagged 'serifLM' : intersection
			MaskLeft (m + TINY)
			HSerif.mt xSerifPos XH serifLength
		if [maskBits fSlab SLAB_MIDDLE_HALF_ASC] : include : tagged 'serifLM' : intersection
			MaskLeft (m + TINY)
			HSerif.mt xSerifPos ([mix 0 Ascender 0.5] + HalfStroke) serifLength

	define [LongSBentHookBase y0 m fSlab _kSerif] : glyph-proc
		local xTerminal : RightSB + RBalance2 + [Math.max 0 : m - [StdSmallFBarLeftPos0]]
		include : dispiro
			widths.lhs
			g4   xTerminal (Ascender - Hook)
			HookStart Ascender
			flat m (Ascender - ArchDepthA)
			curl m 0 [heading Downward]
		include : LeaningAnchor.Above.Hook m xTerminal
		set-base-anchor 'overlay' (m + [HSwToV : 0.65 * Stroke]) [mix 0 Ascender OverlayPos]
		include : StandardSerifs m fSlab _kSerif

	define [LongSBentHookOverlayBar m] : LetterBarOverlay.m.in
		x   -- (m + [HSwToV HalfStroke])
		bot -- ([mix 0 XH 0.75] - Stroke)
		top -- (Ascender - Stroke)
		py  -- OverlayPos

	define [LongSSymmetricOverlayBar m] : LetterBarOverlay.m.in
		x   -- m
		bot -- ([mix 0 XH 0.75] - Stroke)
		top -- (Ascender - Stroke)
		py  -- OverlayPos

	define [LongSFlatHookNoTailShape m yBot fSlab _kSerif fCorner] : glyph-proc
		local hd : FlatHookDepth [DivFrame 1]
		local xTip : RightSB + [if fCorner ([CornerHookOffset Stroke] + [CornerHookOutset Stroke]) 0]
		include : dispiro
			widths.lhs
			flat xTip Ascender : if (fCorner && para.isItalic) [heading Leftward] nothing
			curl [Math.min (RightSB - TINY) (m + hd.x)] Ascender
			archv
			flat m (Ascender - hd.y)
			curl m yBot [heading Downward]
		if fCorner : include : VBar.r xTip (Ascender - [CornerHookDepth Hook Stroke]) Ascender
		include : LeaningAnchor.Above.Hook m RightSB
		set-base-anchor 'overlay' (m + [HSwToV : 0.65 * Stroke]) [mix 0 Ascender OverlayPos]
		include : StandardSerifs m fSlab _kSerif

	# Non-descending variants
	define SerifSuffixes : object
		'Serifless'                 {SLAB_SERIFLESS        1.0}
		'MiddleSerifed'             {SLAB_MIDDLE           0.5}
		'MiddleSerifedXH'           {SLAB_MIDDLE_XH        0.5}
		'MiddleSerifedHalfAscender' {SLAB_MIDDLE_HALF_ASC  0.5}
		'BottomSerifed'             {SLAB_BOTTOM           0.5}
		'DoubleSerifed'             {SLAB_DOUBLE           0.5}
		'DoubleSerifedXH'           {SLAB_DOUBLE_XH        0.5}
		'DoubleSerifedHalfAscender' {SLAB_DOUBLE_HALF_ASC  0.5}

	foreach {suffix {serifStyle pShift}} [Object.entries SerifSuffixes] : do
		create-glyph "longs.bentHook\(suffix)" : glyph-proc
			include : MarkSet.b
			local m : Middle - JBalance - [HSwToV HalfStroke]
			include : LongSBentHookBase 0 m serifStyle
			create-forked-glyph "longsBar.bentHook\(suffix)" : LongSBentHookOverlayBar m

		create-glyph "longs.flatHook\(suffix)" : glyph-proc
			include : MarkSet.b
			local m : Middle - pShift * (JBalance + [HSwToV HalfStroke])
			include : LongSFlatHookNoTailShape m 0 serifStyle
			create-forked-glyph "longsBar.flatHook\(suffix)" : LongSBentHookOverlayBar m

		create-glyph "longs.flatHookExt\(suffix)" : glyph-proc
			include [refer-glyph "longs.flatHook\(suffix)"] AS_BASE ALSO_METRICS
			include : HBar.t RightSB [mix 0 Width 2] Ascender

		create-glyph "longs.cornerHook\(suffix)" : glyph-proc
			include : MarkSet.b
			local m : Middle - pShift * (JBalance + [HSwToV HalfStroke])
			include : LongSFlatHookNoTailShape m 0 serifStyle nothing true
			create-forked-glyph "longsBar.cornerHook\(suffix)" : LongSBentHookOverlayBar m

		create-glyph "longs.cornerHookExt\(suffix)" : glyph-proc
			include [refer-glyph "longs.cornerHook\(suffix)"] AS_BASE ALSO_METRICS
			include : HBar.t RightSB [mix 0 Width 2] Ascender

	# Descending and Tailed variants
	define SerifSuffixesDescending : object
		'Serifless'                 {SLAB_SERIFLESS        1.0}
		'MiddleSerifed'             {SLAB_MIDDLE           0.5}
		'MiddleSerifedXH'           {SLAB_MIDDLE_XH        0.5}
		'MiddleSerifedHalfAscender' {SLAB_MIDDLE_HALF_ASC  0.5}

	foreach {suffix {serifStyle pShift}} [Object.entries SerifSuffixesDescending] : do
		create-glyph "longs.flatHookDescending\(suffix)" : glyph-proc
			include : MarkSet.bp
			local m : Middle - pShift * (JBalance + [HSwToV HalfStroke])
			include : LongSFlatHookNoTailShape m Descender false
			include : StandardSerifs m serifStyle
			create-forked-glyph "longsBar.flatHookDescending\(suffix)" : LongSBentHookOverlayBar m

		create-glyph "longs.flatHookExtDescending\(suffix)" : glyph-proc
			include [refer-glyph "longs.flatHookDescending\(suffix)"] AS_BASE ALSO_METRICS
			include : HBar.t RightSB [mix 0 Width 2] Ascender

		create-glyph "longs.flatHookTailed\(suffix)" : glyph-proc
			include : MarkSet.bp
			currentGlyph.copyBaseAnchorIfAbsent 'leaningAbove' 'above'
			include : LongSShape Ascender Descender (HookX + QuarterStroke) Hook
			include : StandardSerifs (Middle - [HSwToV HalfStroke]) serifStyle
			create-forked-glyph "longsBar.flatHookTailed\(suffix)" : LongSSymmetricOverlayBar Middle

		create-glyph "longs.flatHookExtTailed\(suffix)" : glyph-proc
			include [refer-glyph "longs.flatHookTailed\(suffix)"] AS_BASE ALSO_METRICS
			include : HBar.t (Middle + HookX + (0.25 - TanSlope) * Stroke) [mix 0 Width 2] Ascender

		create-glyph "longs.flatHookDiagonalTailed\(suffix)" : glyph-proc
			include : MarkSet.bp
			currentGlyph.copyBaseAnchorIfAbsent 'leaningAbove' 'above'
			include : union
				intersection [MaskAbove 0]
					LongSShape Ascender Descender (HookX + QuarterStroke) Hook
				SmallFDiagonalTail [DivFrame 1] (Middle - [HSwToV HalfStroke])
				StandardSerifs (Middle - [HSwToV HalfStroke]) serifStyle
			create-forked-glyph "longsBar.flatHookDiagonalTailed\(suffix)" : LongSSymmetricOverlayBar Middle

		create-glyph "longs.flatHookExtDiagonalTailed\(suffix)" : glyph-proc
			include [refer-glyph "longs.flatHookDiagonalTailed\(suffix)"] AS_BASE ALSO_METRICS
			include : HBar.t (Middle + HookX + (0.25 - TanSlope) * Stroke) [mix 0 Width 2] Ascender

		create-glyph "longs.cornerHookDescending\(suffix)" : glyph-proc
			include : MarkSet.bp
			local m : Middle - pShift * (JBalance + [HSwToV HalfStroke])
			include : LongSFlatHookNoTailShape m Descender false nothing true
			include : StandardSerifs m serifStyle
			create-forked-glyph "longsBar.cornerHookDescending\(suffix)" : LongSBentHookOverlayBar m

		create-glyph "longs.cornerHookExtDescending\(suffix)" : glyph-proc
			include [refer-glyph "longs.cornerHookDescending\(suffix)"] AS_BASE ALSO_METRICS
			include : HBar.t RightSB [mix 0 Width 2] Ascender

		create-glyph "longs.cornerHookTailed\(suffix)" : glyph-proc
			include : MarkSet.bp
			currentGlyph.copyBaseAnchorIfAbsent 'leaningAbove' 'above'
			include : LongSShape Ascender Descender (HookX + QuarterStroke) Hook nothing true
			include : StandardSerifs (Middle - [HSwToV HalfStroke]) serifStyle
			create-forked-glyph "longsBar.cornerHookTailed\(suffix)" : LongSSymmetricOverlayBar Middle

		create-glyph "longs.cornerHookExtTailed\(suffix)" : glyph-proc
			include [refer-glyph "longs.cornerHookTailed\(suffix)"] AS_BASE ALSO_METRICS
			include : HBar.t (Middle + HookX + (0.25 - TanSlope) * Stroke) [mix 0 Width 2] Ascender

		create-glyph "longs.cornerHookDiagonalTailed\(suffix)" : glyph-proc
			include : MarkSet.bp
			currentGlyph.copyBaseAnchorIfAbsent 'leaningAbove' 'above'
			include : union
				intersection [MaskAbove 0]
					LongSShape Ascender Descender (HookX + QuarterStroke) Hook nothing true
				SmallFDiagonalTail [DivFrame 1] (Middle - [HSwToV HalfStroke])
				StandardSerifs (Middle - [HSwToV HalfStroke]) serifStyle
			create-forked-glyph "longsBar.cornerHookDiagonalTailed\(suffix)" : LongSSymmetricOverlayBar Middle

		create-glyph "longs.cornerHookExtDiagonalTailed\(suffix)" : glyph-proc
			include [refer-glyph "longs.cornerHookDiagonalTailed\(suffix)"] AS_BASE ALSO_METRICS
			include : HBar.t (Middle + HookX + (0.25 - TanSlope) * Stroke) [mix 0 Width 2] Ascender

		create-glyph "longs.bentHookDescending\(suffix)" : glyph-proc
			include : MarkSet.bp
			local m : StdSmallFBarLeftPos true
			include : LongSBentHookBase (XH / 2) m SLAB_SERIFLESS
			include : VBar.l m Descender 0
			include : StandardSerifs m serifStyle
			create-forked-glyph "longsBar.bentHookDescending\(suffix)" : LongSBentHookOverlayBar m

		create-glyph "longs.bentHookTailed\(suffix)" : glyph-proc
			include : MarkSet.bp
			local m : StdSmallFBarLeftPos true
			include : LongSBentHookBase (XH / 2) m SLAB_SERIFLESS
			include : LongSLowerHalf (+1) (m + [HSwToV HalfStroke]) (XH / 2 - O) Descender (HookX + QuarterStroke) Hook Stroke
			include : StandardSerifs m serifStyle
			create-forked-glyph "longsBar.bentHookTailed\(suffix)" : LongSBentHookOverlayBar m

		create-glyph "longs.bentHookDiagonalTailed\(suffix)" : glyph-proc
			include : MarkSet.bp
			local m : StdSmallFBarLeftPos true
			include : LongSBentHookBase (XH / 2) m SLAB_SERIFLESS
			include : SmallFDiagonalTail [DivFrame 1] m
			include : StandardSerifs m serifStyle
			create-forked-glyph "longsBar.bentHookDiagonalTailed\(suffix)" : LongSBentHookOverlayBar m

	select-variant 'longs' 0x17F
	select-variant 'longs/compLigLeft' (shapeFrom -- 'longs')
	select-variant 'longsBar' 0x1E9D

	define [NarrowEsh] : glyph-proc
		local df : DivFrame para.advanceScaleF
		set-width df.width
		include : CenterInkInFrame df

	create-glyph 'esh.compact' : glyph-proc
		include [refer-glyph 'longs.flatHookTailedSerifless'] AS_BASE ALSO_METRICS
		include : NarrowEsh
	create-glyph 'esh.cornerHooked' : glyph-proc
		include [refer-glyph 'longs.cornerHookTailedSerifless'] AS_BASE ALSO_METRICS
		include : NarrowEsh
	create-glyph 'esh.sshaped' : glyph-proc
		include : MarkSet.bp
		local xMid Middle
		local xLeft : Middle - [Math.max HookX LongJut]
		local xRight : Middle + [Math.max HookX LongJut]
		include : union
			VBar.m xMid Descender Ascender Stroke
			HBar.t xMid xRight Ascender Stroke
			HBar.b xLeft xMid Descender Stroke
		include : LeaningAnchor.Above.At xMid
		include : LeaningAnchor.Below.At xMid
		set-base-anchor 'overlay' xMid [mix Descender Ascender OverlayPos]
		include : NarrowEsh

	define EshTailConfig : object
		flatTailed     'flat'
		diagonalTailed 'diagonal'
		tailed         'tailed'
	foreach {suffix kind} [pairs-of EshTailConfig] : do
		create-glyph "esh.\(suffix)" : glyph-proc
			include : MarkSet.bp
			include : with-transform [ScaleAround Middle 0 (-1) 1]
				Casual [DivFrame 1] Ascender Descender Middle kind kind Stroke
			include : LeaningAnchor.Above.At Middle
			include : LeaningAnchor.Below.At Middle
			set-base-anchor 'overlay' Middle [mix Descender Ascender OverlayPos]
			include : NarrowEsh

	select-variant 'esh' 0x283

	define [EshUpperTerminal df sign x top bot kind] : match kind
		[Just 'cornerHooked'] : LongSUpperHalf sign x top bot (HookX + QuarterStroke) Hook Stroke true
		[Just 'sshaped'] : union
			VBar.m x bot top Stroke
			HBar.t [Math.min x (x + sign * [Math.max HookX LongJut])] [Math.max x (x + sign * [Math.max HookX LongJut])] top Stroke
		__ : if (sign > 0)
			with-transform [ScaleAround x 0 (-1) 1] : CasualTopBetween df top (2 * bot - top) x kind Stroke
			CasualTopBetween df top (2 * bot - top) x kind Stroke

	define [EshLowerTerminal df sign x top bot kind] : match kind
		[Just 'cornerHooked'] : LongSLowerHalf sign x top bot (HookX + QuarterStroke) Hook Stroke true
		[Just 'sshaped'] : union
			VBar.m x bot top Stroke
			HBar.b [Math.min x (x - sign * [Math.max HookX LongJut])] [Math.max x (x - sign * [Math.max HookX LongJut])] bot Stroke
		__ : if (sign > 0)
			with-transform [ScaleAround x 0 (-1) 1] : CasualBottom df top bot x kind Stroke
			CasualBottom df top bot x kind Stroke

	define [IsShape top bot _kind] : glyph-proc
		local sw : 1 * Stroke
		local xStem : mix SB RightSB 0.40
		local xLeft : xStem - [HSwToV : 0.5 * sw]
		local hookx : HookX + QuarterStroke
		local xLoopR : RightSB - OX
		local minLoopH : Math.max (xLoopR - xLeft) : 2 * sw + [AdviceStroke 3]
		local yBar : Math.min [mix 0 top 0.56] (top - minLoopH)
		local yJoin : mix yBar top 0.55
		include : union
			if _kind [intersection [MaskBelow yJoin] [EshLowerTerminal [DivFrame 1] (+1) xStem yJoin bot _kind]] [LongSLowerHalf (+1) xStem yJoin bot hookx Hook sw]
			dispiro
				widths.lhs sw
				flat (xLeft - hookx) yBar [heading Rightward]
				curl [mix xLeft xLoopR 0.5] yBar
				archv
				g4 (xLoopR - O) [mix yBar top 0.5]
				Arch.lhs top (sw -- sw)
				g4 xLeft [mix top yBar 0.5]
				flat xLeft [mix yBar yJoin 0.5] [heading Downward]
				curl xLeft yBar [heading Downward]

	create-glyph 'Is.compact' : glyph-proc
		include : MarkSet.capital
		include : IsShape CAP 0

	create-glyph 'is.compact' : glyph-proc
		include : MarkSet.bp
		include : IsShape Ascender Descender

	glyph-block-export IsLoopVertical
	define [IsLoopVertical xLeft xRight top yBar bot sw] : glyph-proc
		local xLoopR : xRight - OX
		local yJoin : mix yBar top 0.55
		include : dispiro
			widths.lhs sw
			flat xLeft yBar [heading Rightward]
			curl [mix xLeft xLoopR 0.5] yBar
			archv
			g4 (xLoopR - O) [mix yBar top 0.5]
			Arch.lhs top (sw -- sw)
			g4 xLeft [mix top yBar 0.5]
			flat xLeft [mix yBar yJoin 0.5] [heading Downward]
			curl xLeft bot [heading Downward]

	define [LongSTopLoop bottomStyle serifStyle] : glyph-proc
		include : MarkSet.bp
		local baseScale : clamp 1 1.12 : StrokeWidthBlend 1 1.12
		local hasTail : (bottomStyle == 'tailed') || (bottomStyle == 'diagonalTailed')
		# Give the tail room before compressing the design back to the cell.
		local designScale : if hasTail 1.45 baseScale
		local designWidth : Width * designScale
		local sw : AdviceStroke2 2 3 Ascender
		local xStem : mix SB (designWidth - SB) : if hasTail 0.24 0.10
		local yBar : 0.67 * XH
		local yLoopTop : Ascender - 0.01 * XH
		local yLoopBottom : 0.64 * XH
		local loopScale : if hasTail
			clamp 0.64 0.74 : StrokeWidthBlend 0.64 0.74
			clamp 0.68 0.77 : StrokeWidthBlend 0.68 0.77
		local df : DivFrame (loopScale * designScale) 2
		local shift : designWidth - SB - df.rightSB
		local refDf : DivFrame (0.68 * designScale) 2
		local loopBase : Math.min [refDf.adviceStroke 3.5] [AdviceStroke2 3.5 3.5 (yLoopTop - yLoopBottom)]
		local loopSw : loopBase * [clamp 1 1.20 : StrokeWidthBlend 1 1.20]
		local loopFine : loopBase * [clamp 1 1.10 : StrokeWidthBlend 1 1.10]
		local stemSw : Math.max loopSw (Stroke * designScale)
		local xBarRight : xStem - [HSwToV : 0.5 * loopSw] + TINY
		local barLength : Math.min (xBarRight - 0.04 * Width) ([Math.max Jut [HSwToV sw]] + 0.06 * Width)
		local angle : 3 * Math.PI / 180
		local cosine : Math.cos angle
		local sine : Math.sin angle
		local xArm : df.leftSB + 0.75 * OX + [HSwToV : 0.4 * loopSw]
		local xJoin : shift + df.middle + (xArm - df.middle) * cosine
		local yJoin : yLoopTop + (xArm - df.middle) * sine + [if para.isItalic (0.02 * loopSw + 2) (-0.02 * loopSw + [clamp 0 3 : StrokeWidthBlend 0 3])]
		local yStemBottom : if (bottomStyle == 'nonDescending') 0 : if (bottomStyle == 'descending') Descender : if (bottomStyle == 'tailed') (0.5 * XH) 0
		local tailX : Math.max (0.05 * Width) : Math.min (HookX + QuarterStroke) (xStem - [HSwToV : 0.5 * stemSw] + 0.06 * Width)
		include : with-transform [Scale (1 / designScale) 1] : union
			if [maskBits serifStyle (SLAB_MIDDLE + SLAB_MIDDLE_XH + SLAB_MIDDLE_HALF_ASC)]
				no-shape
				HSerif.lt xBarRight yBar barLength sw
			LongSUpperHalf (+1) xStem yJoin yStemBottom (xJoin - xStem) (0.35 * XH) loopSw false stemSw
			StandardSerifs (xStem - [HSwToV HalfStroke]) serifStyle
			if (bottomStyle == 'tailed')
				LongSLowerHalf (+1) xStem (0.5 * XH - O) Descender tailX Hook stemSw false
				no-shape
			if (bottomStyle == 'diagonalTailed')
				dispiro
					widths.center stemSw
					flat xStem TINY [heading Downward]
					DiagTail.L xStem Descender ([Math.max (0.25 * stemSw) ([DiagTail.StdDepth [DivFrame 1] stemSw] - 0.5 * stemSw - 0.18 * Width)]) stemSw
				no-shape
			with-transform [Translate (shift + df.middle) yLoopTop]
				with-transform [Rotate angle]
					with-transform [Translate (-df.middle) (-yLoopTop)]
						RamsHornShape df yLoopTop yLoopBottom false false false loopSw nothing loopFine (designScale / baseScale)

	define TopLoopBottomStyles : object
		'Descending' 'descending'
		'Tailed' 'tailed'
		'DiagonalTailed' 'diagonalTailed'
	foreach topSuffix {'bentHook' 'flatHook' 'cornerHook'} : do
		foreach {suffix {serifStyle pShift}} [Object.entries SerifSuffixes] : do
			create-glyph "longsTopLoop.\(topSuffix)\(suffix)" : LongSTopLoop 'nonDescending' serifStyle
		foreach {suffix {serifStyle pShift}} [Object.entries SerifSuffixesDescending] : do
			foreach {bottomSuffix bottomStyle} [Object.entries TopLoopBottomStyles] : do
				create-glyph "longsTopLoop.\(topSuffix)\(bottomSuffix)\(suffix)" : LongSTopLoop bottomStyle serifStyle

	select-variant 'longsTopLoop' 0x1DF96 (follow -- 'longs')

	create-glyph 'is/phoneticRight' : glyph-proc
		include : MarkSet.b
		local sw Stroke
		local xStem : mix SB RightSB 0.40
		local xLeft : xStem - [HSwToV : 0.5 * sw]
		include : IsLoopVertical xLeft RightSB Ascender (XH - sw) 0 sw

	create-glyph 'eshBaseline.compact' : glyph-proc
		include : MarkSet.b
		include : LongSShape Ascender 0 (HookX + QuarterStroke) Hook
		include : NarrowEsh

	create-glyph 'eshHookBase.compact' : glyph-proc
		include : MarkSet.b
		include : LongSShape Ascender 0 (HookX + QuarterStroke) Hook

	define EshRelatedConfig : object
		cornerHooked 'cornerHooked'
		sshaped 'sshaped'
		flatTailed 'flat'
		diagonalTailed 'diagonal'
		tailed 'tailed'
	foreach {suffix kind} [pairs-of EshRelatedConfig] : do
		create-glyph "eshBaseline.\(suffix)" : glyph-proc
			include : MarkSet.b
			local join : Ascender / 2
			include : union
				EshUpperTerminal [DivFrame 1] (+1) Middle Ascender join kind
				EshLowerTerminal [DivFrame 1] (+1) Middle join 0 kind
			include : NarrowEsh

		create-glyph "eshHookBase.\(suffix)" : glyph-proc
			include [refer-glyph 'eshHookBase.compact'] AS_BASE ALSO_METRICS
			currentGlyph.clearGeometry
			local join : Ascender / 2
			include : union
				EshUpperTerminal [DivFrame 1] (+1) Middle Ascender join kind
				LongSLowerHalf (+1) Middle join 0 (HookX + QuarterStroke) Hook

	select-variant 'eshBaseline' 0xAB4D (follow -- 'esh')
	select-variant 'eshHookBase' (follow -- 'esh')

	define [CreateEshHooked name unicode source hook] : begin
		derive-multi-part-glyphs name unicode {source} : function [srcs] : glyph-proc
			local base : refer-glyph srcs.0
			include base AS_BASE ALSO_METRICS
			currentGlyph.clearGeometry
			include : union base hook
			include : NarrowEsh

	CreateEshHooked 'eshRTail' 0x1D98 'eshHookBase' : RetroflexHook.l
		x -- (Middle - (HookX + QuarterStroke))
		y -- 0
		yOverflow -- Stroke

	derive-multi-part-glyphs 'eshPalatalHook' 0x1D8B {'esh'} : function [srcs] : glyph-proc
		local base : query-glyph srcs.0
		local stem : base.gizmo.unapply base.baseAnchors.overlay
		include base AS_BASE ALSO_METRICS
		currentGlyph.clearGeometry
		include : union
			refer-glyph srcs.0
			PalatalHook.r
				x       -- (stem.x + RightSB - Middle)
				y       -- 0
				xLink   -- stem.x
				refSw   -- [AdviceStroke 3]
				maskOut -- [intersection [MaskBelow 0] [MaskLeft : stem.x + [HSwToV : HalfStroke + [AdviceStroke 12]]]]
		include : NarrowEsh

	define [EshCurlyTailShape upper] : begin
		local fine : AdviceStroke 3.5
		local m : Middle - FBalance
		# The full j stem preserves the curl's interpolation at heavy weights.
		return : union upper [JCurlyTailShape m XH (m + RightSB - Middle + [HSwToV : 0.5 * fine])]

	create-glyph 'eshCurlyTail.compact' : glyph-proc
		include : MarkSet.bp
		local m : Middle - FBalance
		include : EshCurlyTailShape : LongSUpperHalf (+1) m Ascender 0 (HookX + QuarterStroke) Hook

	create-glyph 'reveshLoop.compact' : glyph-proc
		include : MarkSet.bp
		local fine : AdviceStroke 4
		include : dispiro
			widths.center fine
			g4.down.start Middle (Ascender - fine * 1.5) [heading Downward]
			arcvh
			g4   (Middle - fine * 1) (Ascender - fine * 2.5) [heading Leftward]
			archv
			g4   (Middle - fine * 2) (Ascender - fine * 1.5) [heading Upward]
			arcvh
			g4   (Middle - fine * 1) (Ascender - fine * 0.5) [heading Rightward]
			archv
			flat Middle (Ascender - fine * 1.5) [widths.center.heading Stroke Downward]
			curl Middle (Descender + Hook) [heading Downward]
			arcvh
			straight.right.end (Middle + HookX) (Descender + O + HalfStroke)
		include : NarrowEsh

	define [ReversedEshLoopTop bot] : begin
		local fine : AdviceStroke 4
		return : dispiro
			widths.center fine
			g4.down.start Middle (Ascender - fine * 1.5) [heading Downward]
			arcvh
			g4   (Middle - fine * 1) (Ascender - fine * 2.5) [heading Leftward]
			archv
			g4   (Middle - fine * 2) (Ascender - fine * 1.5) [heading Upward]
			arcvh
			g4   (Middle - fine * 1) (Ascender - fine * 0.5) [heading Rightward]
			archv
			flat Middle (Ascender - fine * 1.5) [widths.center.heading Stroke Downward]
			curl Middle bot [heading Downward]

	foreach {suffix kind} [pairs-of EshRelatedConfig] : do
		create-glyph "eshCurlyTail.\(suffix)" : glyph-proc
			include [refer-glyph 'eshCurlyTail.compact'] AS_BASE ALSO_METRICS
			currentGlyph.clearGeometry
			include : EshCurlyTailShape : EshUpperTerminal [DivFrame 1] (+1) (Middle - FBalance) Ascender 0 kind

		create-glyph "dotlessiStretchedHookLeftRTail.\(suffix)" : glyph-proc
			local df : DivFrame para.advanceScaleI
			local join : XH / 2
			local base : refer-glyph 'dotlessiStretchedHookLeftRTail.compact'
			include base AS_BASE ALSO_METRICS
			local stemAnchor : currentGlyph.gizmo.unapply currentGlyph.baseAnchors.overlay
			currentGlyph.clearGeometry
			include : intersection base [MaskBelow join]
			include : intersection [MaskAbove join] : EshUpperTerminal df (-1) stemAnchor.x XH join kind

		create-glyph "reveshLoop.\(suffix)" : glyph-proc
			local join : mix Descender Ascender 0.5
			include : MarkSet.bp
			include : union
				ReversedEshLoopTop (join - TINY)
				intersection [MaskBelow (join + TINY)] : EshLowerTerminal [DivFrame 1] (-1) Middle (join + TINY) Descender kind
			include : NarrowEsh

		create-glyph "Is.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : IsShape CAP 0 kind
		create-glyph "is.\(suffix)" : glyph-proc
			include : MarkSet.bp
			include : IsShape Ascender Descender kind

	select-variant 'eshCurlyTail' 0x286
	select-variant 'dotlessiStretchedHookLeftRTail' 0x285
	select-variant 'reveshLoop' 0x1AA
	select-variant 'Is' 0xA76C
	select-variant 'is' 0xA76D
	CreateAccentedComposition 'eshDblBar'          0x1DF0B 'esh'          'dblBarOver'
	CreateAccentedComposition 'eshDblBarCurlyTail' 0x1DF0C 'eshCurlyTail' 'dblBarOver'
