$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"

glyph-module

glyph-block Letter-Latin-Yogh : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared-Shapes : SerifedArcStart InwardSlabArcStart ArcStartSerif
	glyph-block-import Letter-Cyrillic-Ze : CyrZe

	define SLAB-NONE       0
	define SLAB-CLASSICAL  1
	define SLAB-INWARD     2

	define [PhantomBotYOfUpperHalf top bot kSplit] : [mix bot top kSplit] - QuarterStroke
	define [TopYOfLowerHalf top bot kSplit] : [mix bot top kSplit] + 0.06 * Stroke

	define [UpperHalfT sink slab offset top bot kSplit] : begin
		local py : PhantomBotYOfUpperHalf top bot kSplit
		local yRightHalf : YSmoothMidR top py
		local yBottomTerminal : mix top py 1.2
		return : sink
			match slab
				[Just SLAB-CLASSICAL] : SerifedArcStart.LtrRhs SB (top - offset) Stroke Hook
				[Just SLAB-INWARD] : InwardSlabArcStart.LtrRhs SB (top - offset) Stroke Hook
				__ : list [g4 SB (top - Hook) [widths.rhs]] [HookStart (top - offset)]
			g4 (RightSB - offset) yRightHalf
			alsoThruThem {{0.5 0.8} {0.75 0.92}} important
			[if (sink == dispiro) g4 corner] ([mix SB RightSB 0.1] + QuarterStroke) yBottomTerminal

	define [LowerHalfT sink top bot kSplit] : begin
		local pyt : mix bot [TopYOfLowerHalf top bot kSplit] 1.2
		local pyb : mix bot [TopYOfLowerHalf top bot kSplit] 0.2

		return : sink
			Arch.rhs.centerAt.ltr.t Middle pyt
			archv
			g4 RightSB [YSmoothMidR pyt pyb]
			alsoThruThem {{0.25 [StrokeWidthBlend 0.63 0.66]} {0.5 [StrokeWidthBlend 0.84 0.85]}} important
			g4 (SB + [HSwToV : 0.1 * Stroke]) (bot + O)

	glyph-block-export YoghShape
	define [YoghShape slab top bot kSplit] : glyph-proc
		include : UpperHalfT dispiro slab 0 top bot kSplit
		include : difference
			LowerHalfT dispiro top bot kSplit
			UpperHalfT spiro-outline slab 0.1 top bot kSplit

		include : match slab
			[Just SLAB-CLASSICAL] : ArcStartSerif.L SB top Stroke Hook
			[Just SLAB-INWARD] : ArcStartSerif.InwardL SB top Stroke Hook
			__ : no-shape

	# Et: Cyrillic ze upper (hook + waist bar) joined to a yogh lower bowl.
	# Lowercase uses the same [XH, Descender] span as yogh; stroke weight stays
	# on the x-height so the ze top does not thin out.
	define [EtShape slab top bot hook ada adb] : glyph-proc
		local ze : CyrZe slab SLAB-NONE top bot
			hook   -- hook
			barPos -- OverlayPos
			ada    -- ada
			adb    -- adb
			stroke -- [AdviceStroke2 2 3 : top - [Math.max bot 0]]
		define [object stroke midx midy fine] : ze.Dim
		include : ze.UpperShape
		include : ze.AutoStartSerifL
		local pyt : mix bot [TopYOfLowerHalf top bot OverlayPos] 1.2
		local pyb : mix bot [TopYOfLowerHalf top bot OverlayPos] 0.2
		include : dispiro
			flat midx (midy - (stroke / 2 - fine)) [widths.heading 0 fine Rightward]
			curl Middle (midy - (stroke / 2 - fine)) [heading Rightward]
			archv
			g4 RightSB [YSmoothMidR pyt pyb] [widths.rhs stroke]
			alsoThruThem {{0.25 [StrokeWidthBlend 0.63 0.66]} {0.5 [StrokeWidthBlend 0.84 0.85]}} important
			g4 (SB + [HSwToV : 0.1 * stroke]) (bot + O)

	define Config : object
		serifless               { SLAB-NONE      }
		unilateralSerifed       { SLAB-CLASSICAL }
		unilateralInwardSerifed { SLAB-INWARD    }

	foreach { suffix { slabTop } } [Object.entries Config] : do
		create-glyph "Yogh.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : YoghShape slabTop CAP 0 OverlayPos
		create-glyph "yogh.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : YoghShape slabTop XH Descender OverlayPos
		create-glyph "Et.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : EtShape slabTop CAP 0 Hook ArchDepthA ArchDepthB
		create-glyph "et.\(suffix)" : glyph-proc
			include : MarkSet.p
			include : EtShape slabTop XH Descender SHook SmallArchDepthA SmallArchDepthB

	select-variant 'Yogh' 0x21C (follow -- 'cyrl/Ze/topSerif')
	select-variant 'yogh' 0x21D (follow -- 'cyrl/ze/topSerif')
	select-variant 'Et'   0xA76A (follow -- 'cyrl/Ze/topSerif')
	select-variant 'et'   0xA76B (follow -- 'cyrl/ze/topSerif')
