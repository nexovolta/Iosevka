$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"


glyph-module

glyph-block Letter-Latin-Middle-Welsh-V : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives

	define [MiddleWelshVShape top pL pR _xR _xEnd _xScale] : glyph-proc
		local xR : fallback _xR (RightSB - O)
		local xEnd : fallback _xEnd [mix SB RightSB 0.75]
		local xScale : fallback _xScale 1
		define [ScaleX x] : Middle + xScale * (x - Middle)
		include : dispiro
			widths.lhs
			g4 Middle (top - O / 2)
			g4.down.mid [ScaleX : SB + O] [mix 0 top (pL * SmallArchDepthB / (SmallArchDepthA + SmallArchDepthB))]
			Arch.lhs 0
			g4 [ScaleX xR] [mix 0 top (pR * SmallArchDepthA / (SmallArchDepthA + SmallArchDepthB))]
			g4 [ScaleX xEnd] [mix 0 top pR]

	create-glyph 'VMiddleWelsh' 0x1EFC : glyph-proc
		include : MarkSet.capital
		include : MiddleWelshVShape CAP 0.75 0.625

	create-glyph 'vMiddleWelsh' 0x1EFD : glyph-proc
		include : MarkSet.capital
		include : MiddleWelshVShape Ascender 0.625 0.625

	define [ConShape top pR] : glyph-proc
		include : MiddleWelshVShape top 0.75 pR [mix SB RightSB 0.86] [mix SB RightSB 0.6] 1.12

	create-glyph 'Con' 0xA76E : glyph-proc
		include : MarkSet.capital
		include : ConShape CAP 0.68
		include : FlipAround Middle (CAP / 2)
		include : ApparentTranslate (-0.066 * Width) 0

	create-glyph 'con' 0xA76F : glyph-proc
		include : MarkSet.p
		include : ConShape (XH - Descender) 0.68
		include : ApparentTranslate 0 Descender
		include : FlipAround Middle ((XH + Descender) / 2)
		include : ApparentTranslate (-0.066 * Width) 0