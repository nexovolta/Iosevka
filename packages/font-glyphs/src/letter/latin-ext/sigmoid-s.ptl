$$include '../../meta/macros.ptl'

import [mix fallback] from "@iosevka/util"

glyph-module

glyph-block Letter-Latin-Sigmoid-S : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared-Shapes : SerifedArcStart InwardSlabArcStart
	glyph-block-import Letter-Arc-Hook : MakeFlatHook
	glyph-block-import Letter-Latin-S : AdviceSArchDepth SNeck SAutoSlabStart

	define SLAB-NONE      0
	define SLAB-CLASSICAL 1
	define SLAB-INWARD    2
	define SLAB-FLAT-HOOK 4

	define SigmoidSConfig : object
		serifless               SLAB-NONE
		unilateralSerifed       SLAB-CLASSICAL
		unilateralInwardSerifed SLAB-INWARD
		flatHook                SLAB-FLAT-HOOK

	# Full Latin S as the spine. The lower terminal is extended to the S
	# crossing like the inner curl of an asymmetric 8 (clipped to the spine).
	# Outlines are built in design space; italic is the gizmo skew of that.
	glyph-block-export SigmoidSShape
	define [SigmoidSShape top styTop hook _ess] : begin
		local df : DivFrame 1
		local sw : df.adviceStroke2 2 3 top
		local fine : df.adviceStroke2 3 4 top
		local ess : [fallback _ess EssUpper] * (sw / Stroke)
		# sign 0: no TanSlope sag; italic is the gizmo skew of upright.
		local archDepth : AdviceSArchDepth top 0 sw
		local l : df.leftSB + OX
		local r : df.rightSB - OX
		local xBot : mix df.leftSB df.rightSB 0.5
		local yCurl : 0.6 * top
		local yBowl : Math.max archDepth : 0.40 * top

		define [SSpine kty] : list
			kty (df.rightSB) (top - hook) [widths.lhs sw]
			g4 (df.leftSB) (top - archDepth)
			~~~ [SNeck df top sw ess]
			g4 r archDepth [widths.rhs sw]
			arcvh
			kty xBot O

		define [CoSpineMask xFar] : spiro-outline
			corner xFar (2 * top)
			corner (df.rightSB) (2 * top)
			SSpine corner
			corner xBot (0 - top)
			corner xFar (0 - top)

		return : glyph-proc
			include : union
				difference
					dispiro
						straight.left.start r (yCurl + 0.5 * sw) [widths.lhs fine]
						g4.down.mid l yBowl [widths.lhs sw]
						g4.right.mid xBot O
					CoSpineMask (2 * df.width)
					MaskAbove (top - archDepth)
				dispiro
					match styTop
						[Just SLAB-CLASSICAL] : SerifedArcStart.RtlLhs df.rightSB top sw hook
						[Just SLAB-INWARD] : InwardSlabArcStart.RtlLhs df.rightSB top sw hook
						[Just SLAB-FLAT-HOOK] : [MakeFlatHook df.leftSB df.rightSB top 0 (sw -- sw)].hookStartR
						__ : list
							g4 (df.rightSB) (top - hook) [widths.lhs sw]
							HookStart top (sw -- sw)
					g4 (df.leftSB) (top - archDepth)
					~~~ [SNeck df top sw ess]
					g4 r archDepth [widths.rhs sw]
					arcvh
					g4.left.mid xBot O
			include : SAutoSlabStart df styTop top sw hook

	foreach { suffix styTop } [Object.entries SigmoidSConfig] : do
		create-glyph "SigmoidS.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : SigmoidSShape CAP styTop Hook EssUpper
		create-glyph "sigmoidS.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : SigmoidSShape XH styTop SHook EssLower

	select-variant 'SigmoidS' 0xA7D8
	select-variant 'sigmoidS' 0xA7D9
