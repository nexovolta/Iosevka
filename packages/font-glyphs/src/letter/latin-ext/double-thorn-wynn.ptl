$$include '../../meta/macros.ptl'

import [mix fallback SuffixCfg] from "@iosevka/util"

glyph-module

glyph-block Letter-Latin-Double-Thorn-Wynn : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : LeaningAnchor
	glyph-block-import Letter-Shared-Shapes : SerifFrame SerifedArcStart
	glyph-block-import Letter-Latin-Upper-B : BShape
	glyph-block-import Letter-Latin-Yogh : LowerHalfT
	glyph-block-import Letter-Cyrillic-Ze : CyrZe CLOSED-STEM FLAT-CONNECTION

	define xThornStem : mix 0 SB 1.25

	define [SerifLT x top bot] : return [SerifFrame top 0 x RightSB].lt.outer
	define [SerifLB x top bot] : return [SerifFrame top bot x RightSB].lb.fullSide
	define [MotionSerif x top bot] : SerifLT x top bot
	define [FullSerifs x top bot] : composite-proc [SerifLT x top bot] [SerifLB x top bot]

	# Thorn's single bowl sits in the middle of the stem, not from the cap.
	define [yThornBowlBot top] : mix 0 top 0.19
	define [yThornBowlTop top] : top - [yThornBowlBot top]

	# B bowls in Thorn's mid-stem band, plus a through stem.
	define [DoubleThornShape xStem stemBot stemTop bowlBot bowlTop] : glyph-proc
		local h : bowlTop - bowlBot
		include : with-transform [ApparentTranslate (xStem - SB) bowlBot]
			BShape h (stroke -- Stroke) (serifTop -- false) (serifBot -- false)
		include : VBar.l xStem stemBot stemTop
		include : LeaningAnchor.Above.VBar.l xStem
		include : LeaningAnchor.Below.VBar.l xStem

	# Lower thorn: closed-stem Cyrillic ze bowls (like ɞ) on a through stem.
	define [DoubleThornLowerShape xStem stemBot stemTop bowlBot bowlTop hook ada adb slabTop slabBot] : glyph-proc
		local ze : CyrZe slabTop slabBot bowlTop bowlBot
			left      -- xStem
			right     -- RightSB
			blend     -- 0.7
			hook      -- hook
			xOverflow -- 0
			ada       -- ada
			adb       -- adb
		define [object stroke] : ze.Dim
		include : ze.Shape
		include : VBar.l xStem stemBot stemTop stroke
		include : LeaningAnchor.Above.VBar.l xStem
		include : LeaningAnchor.Below.VBar.l xStem

	# Two bowls on a through stem, joined like yogh: the lower half is clipped
	# to the upper's down-curve so the middle is one smooth stroke into the stem.
	define [DoubleWynnUpper sink offset bowlTop bowlBot] : begin
		local py : [mix bowlBot bowlTop OverlayPos] - QuarterStroke
		local yRight : YSmoothMidR bowlTop py
		local yBottomTerminal : mix bowlTop py 1.2
		local xEnd : SB + [HSwToV : 0.1 * Stroke]
		local startKnots : SerifedArcStart.LtrRhs SB (bowlTop - offset) Stroke [Math.max Hook : 0.15 * (bowlTop - bowlBot)] Stroke
		return : sink
			~~~ startKnots
			g4 (RightSB - offset) yRight
			alsoThruThem {{0.5 0.8} {0.75 0.92}} important
			[if (sink == dispiro) g4 corner] xEnd yBottomTerminal

	define [DoubleWynnShape stemBot stemTop bowlBot bowlTop] : glyph-proc
		include : VBar.l SB stemBot stemTop
		include : intersection [MaskRight SB] : union
			DoubleWynnUpper dispiro 0 bowlTop bowlBot
			difference
				LowerHalfT dispiro bowlTop bowlBot OverlayPos
				DoubleWynnUpper spiro-outline 0.1 bowlTop bowlBot
		include : LeaningAnchor.Above.VBar.l SB
		include : LeaningAnchor.Below.VBar.l SB

	define Config : object
		serifless     { no-shape    }
		motionSerifed { MotionSerif }
		serifed       { FullSerifs  }

	foreach { suffix { Serifs } } [Object.entries Config] : do
		create-glyph "ThornDouble.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : DoubleThornShape xThornStem 0 CAP [yThornBowlBot CAP] [yThornBowlTop CAP]
			include : Serifs xThornStem CAP 0

		create-glyph "WynnDouble.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : DoubleWynnShape 0 CAP [mix 0 CAP 0.18] CAP
			include : Serifs SB CAP 0

		create-glyph "wynnDouble.\(suffix)" : glyph-proc
			include : MarkSet.p
			include : DoubleWynnShape Descender XH ([mix Descender XH 0.15] + HalfStroke) XH
			include : Serifs SB XH Descender

	define ThornDoubleLowerConfig : SuffixCfg.weave
		object # body
			""          { CLOSED-STEM     CLOSED-STEM }
			flatTop     { FLAT-CONNECTION CLOSED-STEM }
			flatBottom  { CLOSED-STEM     FLAT-CONNECTION }
		object # serifs
			serifless     { no-shape    }
			motionSerifed { MotionSerif }
			serifed       { FullSerifs  }

	foreach { suffix { {slabTop slabBot} { Serifs } } } [Object.entries ThornDoubleLowerConfig] : do
		create-glyph "thornDouble.\(suffix)" : glyph-proc
			include : MarkSet.bp
			include : DoubleThornLowerShape SB Descender Ascender 0 XH SHook SmallArchDepthA SmallArchDepthB slabTop slabBot
			include : Serifs SB Ascender Descender

	select-variant 'ThornDouble' 0xA7D2
	select-variant 'thornDouble' 0xA7D3
	select-variant 'WynnDouble'  0xA7D4
	select-variant 'wynnDouble'  0xA7D5
