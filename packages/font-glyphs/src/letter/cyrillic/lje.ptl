$$include '../../meta/macros.ptl'

import [mix] from "@iosevka/util"

glyph-module

glyph-block Letter-Cyrillic-Lje : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Cyrillic-Yeri : YeriConfig

	define [CyrLjeRightHalf Yeri df top] : glyph-proc
		local sw : df.mvs + 0
		local jut : Math.min
			Jut - [HSwToV : 0.5 * (Stroke - sw)]
			mix [HSwToV : 0.5 * sw] Jut ((2 / df.hPack) * df.adws)
		include : Yeri top
			left   -- (df.middle - [HSwToV : 0.5 * sw])
			right  -- (df.rightSB - O)
			stroke -- sw
			jut    -- jut

	foreach { suffix { Uc Lc BGRc } } [Object.entries YeriConfig] : do
		create-glyph "cyrl/Lje/rightHalf.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleMM 3
			include : df.markSet.capital
			include : CyrLjeRightHalf Uc df CAP

		create-glyph "cyrl/lje/rightHalf.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleMM 3
			include : df.markSet.e
			include : CyrLjeRightHalf Lc df XH

	select-variant 'cyrl/Lje/rightHalf'
	select-variant 'cyrl/lje/rightHalf'

	derive-composites 'cyrl/Lje' 0x409 'cyrl/Lje/leftHalf' 'cyrl/Lje/rightHalf'
	derive-composites 'cyrl/lje' 0x459 'cyrl/lje/leftHalf' 'cyrl/lje/rightHalf'
