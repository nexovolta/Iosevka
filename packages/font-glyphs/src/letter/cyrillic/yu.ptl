$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"

glyph-module

glyph-block Letter-Cyrillic-Yu : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared : CreateAccentedComposition
	glyph-block-import Letter-Shared-Shapes : uBowl
	glyph-block-import Letter-Cyrillic-Iotated : Iotation IotationSerifConfig IotationSerifFromSelector
	glyph-block-import Mark-Adjustment : ExtendBelowBaseAnchors
	glyph-block-import Letter-Latin-C : CLetterForm
	glyph-block-import Letter-Latin-Lower-H : HDigraphBody HDigraphConfig
	glyph-block-import Letter-Latin-Long-S : LongSUpperHalf LongSLowerHalf

	define SLAB-ALL        1
	define SLAB-LOWER      2
	define SLAB-BULGARIAN  3

	define [CyrYuShape df slabType top oTop ada adb serifType] : glyph-proc
		local sw : df.adviceThinnerStroke 2 0.75
		local gap : 0.375 * (df.rightSB - df.leftSB) - [HSwToV : 0.25 * sw] + sw / 16
		local subDf : DivFrame [Math.min ((df.width - gap) / Width) (0.75 * df.adws)] 2

		local shift : df.width - subDf.width
		include : with-transform [ApparentTranslate shift 0]
			OShape oTop 0 subDf.leftSB subDf.rightSB sw (ada * 0.75 * df.adws) (adb * 0.75 * df.adws)

		include : Iotation.[if (slabType === SLAB-BULGARIAN) 'ascender' 'full'] df top
			hBarRight -- (((subDf.leftSB + OX) + [HSwToV : 0.5 * sw]) + shift)
			hBarY     -- (oTop / 2)
			fCapital  -- (slabType === SLAB-ALL)
			swRef     -- sw
			serifType -- serifType

	foreach { suffix serifType } [Object.entries IotationSerifConfig] : do
		create-glyph "cyrl/Yu.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleM 3
			include : df.markSet.capital
			include : CyrYuShape df SLAB-ALL CAP CAP ArchDepthA ArchDepthB serifType

		create-glyph "cyrl/yu.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleM 3
			include : df.markSet.e
			include : CyrYuShape df SLAB-LOWER XH XH SmallArchDepthA SmallArchDepthB serifType

		create-glyph "cyrl/yu.BGR.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleM 3
			include : df.markSet.b
			include : CyrYuShape df SLAB-BULGARIAN Ascender XH SmallArchDepthA SmallArchDepthB serifType

	select-variant 'cyrl/Yu' 0x42E
	select-variant 'cyrl/yu' 0x44E
	select-variant 'cyrl/yu.BGR' (follow -- 'cyrl/yu')

	define [CyrRevYuShape df top oTop ada adb fTailed] : glyph-proc
		local sw : df.adviceThinnerStroke 2 0.75
		local gap : 0.375 * (df.rightSB - df.leftSB) - [HSwToV : 0.25 * sw] + sw / 16
		local subDf : DivFrame [Math.min ((df.width - gap) / Width) (0.75 * df.adws)] 2

		include : OShape oTop 0 subDf.leftSB subDf.rightSB sw (ada * 0.75 * df.adws) (adb * 0.75 * df.adws)

		include : Iotation.RevShape df top
			hBarLeft   -- ((subDf.rightSB - OX) - [HSwToV : 0.5 * sw])
			hBarY      -- (oTop / 2)
			swRef      -- sw
			fTailed    -- fTailed
			serifType  -- [IotationSerifFromSelector : if (top === CAP) 'cyrl/Yu' 'cyrl/yu']

	define YuRevConfig : object
		straight  false
		tailed    true

	foreach { suffix fTailed } [Object.entries YuRevConfig] : do
		if [not fTailed] : create-glyph "cyrl/revYu.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleM 3
			include : df.markSet.capital
			include : CyrRevYuShape df CAP CAP ArchDepthA ArchDepthB fTailed
		create-glyph "cyrl/revyu.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleM 3
			include : df.markSet.e
			include : CyrRevYuShape df XH XH SmallArchDepthA SmallArchDepthB fTailed

	select-variant 'cyrl/revYu' 0xA654
	select-variant 'cyrl/revyu' 0xA655

	define [OiSubDf df sw] : begin
		local gap : 0.375 * (df.rightSB - df.leftSB) - [HSwToV : 0.25 * sw] + sw / 16
		return : DivFrame [Math.min ((df.width - gap) / Width) (0.75 * df.adws)] 2

	# o with a sigma-like top bar reaching the stem on the right
	define [OShapeWithBar df subDf sw xStemR] : glyph-proc
		include : OShape XH 0 subDf.leftSB subDf.rightSB sw (SmallArchDepthA * 0.75 * df.adws) (SmallArchDepthB * 0.75 * df.adws)
		include : HBar.t subDf.middle xStemR XH (0.88 * sw)

	create-glyph 'latn/oi/base' : glyph-proc
		define df : include : DivFrame para.advanceScaleM 3
		include : df.markSet.e
		local sw : df.adviceThinnerStroke 2 0.75
		local subDf : OiSubDf df sw
		include : OShapeWithBar df subDf sw df.rightSB
		include : VBar.r df.rightSB 0 XH sw
		set-base-anchor 'above' (df.rightSB - [HSwToV : 0.5 * sw]) XH
	CreateAccentedComposition 'latn/oi' 0x1DF5E 'latn/oi/base' 'tittleAbove'

	create-glyph 'latn/ou' 0x1DF5F : glyph-proc
		define df : include : DivFrame para.advanceScaleM 3
		include : df.markSet.e
		local span : df.rightSB - df.leftSB
		local sw : Math.min [df.adviceThinnerStroke 2 0.75] (0.15 * span)
		local hsw : HSwToV sw
		local ada : SmallArchDepthA * 0.75 * df.adws
		local adb : SmallArchDepthB * 0.75 * df.adws
		local gap : 0.08 * span
		local wEach : 0.5 * (df.rightSB - df.leftSB - gap)
		local xO : df.leftSB + wEach
		local xU : xO + gap
		include : OShape XH 0 df.leftSB xO sw ada adb
		include : HBar.t [mix df.leftSB xO 0.5] (xU + hsw) XH (0.88 * sw)
		include : uBowl.shape
			top     -- XH
			bottom  -- 0
			left    -- xU
			right   -- (df.rightSB - hsw)
			stroke  -- sw
			fine    -- (sw * CThin)
			ada     -- ada
			adb     -- adb
			rightY0 -- (XH - [ArchDepthAClamped XH 0 ada adb] + O)
		include : VBar.r df.rightSB 0 XH sw
	create-glyph 'latn/lunateEe' 0x1DF5C : glyph-proc
		define df : include : DivFrame para.advanceScaleM 3
		include : df.markSet.e
		local sw : df.adviceThinnerStroke 2 0.75
		local subDf : DivFrame (0.5 * (df.width + [HSwToV sw]) / Width) 2
		local shift : df.width - subDf.width
		local ada : SmallArchDepthA * 0.75 * df.adws
		local adb : SmallArchDepthB * 0.75 * df.adws
		define [LunateHalf] : intersection [MaskLeft subDf.rightSB] : OShape XH 0 subDf.leftSB [mix subDf.leftSB subDf.rightSB 2] sw ada adb
		include : union [LunateHalf] [with-transform [ApparentTranslate shift 0] : LunateHalf] : HBar.m (subDf.leftSB + [HSwToV : 0.5 * sw]) (df.rightSB - [HSwToV : 0.5 * sw]) (XH / 2) (0.8 * sw)

	# Initial Teaching Alphabet -h digraphs. The h is built on its own sub-frame so only its width
	# is squeezed; the stroke stays at the advised weight.
	foreach { suffix { fFlatHump fTailed HSerifs } } [Object.entries HDigraphConfig] : do
		create-glyph "latn/chStretched.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleM 3
			include : df.markSet.b
			include : ExtendBelowBaseAnchors Descender
			local hDf : DivFrame (0.55 * df.adws) 2
			local sw : Math.min [df.adviceThinnerStroke2 2 3 (Ascender - Descender) 0.65] [df.adviceThinnerStroke 2.75 0.75] [hDf.adviceThinnerStroke 1.3]
			local shift : df.width - hDf.width
			local xStem : hDf.leftSB + shift
			include : with-transform [ApparentTranslate shift 0] : HDigraphBody hDf sw HSerifs true
			local cDf : DivFrame [Math.min 1 df.adws]
			local lf : CLetterForm cDf 0 4 XH Descender
				ada -- [cDf.archDepthAOf SmallArchDepth sw]
				adb -- [cDf.archDepthBOf SmallArchDepth sw]
				sw  -- sw
			include : intersection [MaskLeft (xStem + 0.5 * [HSwToV sw])] [lf.full]

		create-glyph "latn/eshH.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleM 3
			include : df.markSet.bp
			include : ExtendBelowBaseAnchors Descender
			local hDf : DivFrame (0.58 * df.adws) 2
			local sw : Math.min Stroke [df.adviceThinnerStroke 2 0.75] [hDf.adviceThinnerStroke 1.3]
			local hsw : HSwToV sw
			local shift : df.width - hDf.width
			local xHStem : hDf.leftSB + shift
			include : with-transform [ApparentTranslate shift 0] : HDigraphBody hDf sw HSerifs false
			local hookLow : Math.min (HookX + QuarterStroke) (0.45 * (xHStem - df.leftSB))
			local xEsh : df.leftSB + hookLow + 0.5 * hsw
			local yMid : mix Ascender Descender 0.5
			include : LongSUpperHalf (+1) xEsh Ascender yMid (xHStem + 0.5 * hsw - xEsh) Hook sw
			include : LongSLowerHalf (+1) xEsh yMid Descender hookLow Hook sw

	select-variant 'latn/chStretched' 0x1DF5B (follow -- 'h')
	select-variant 'latn/eshH' 0x1DF62 (follow -- 'h')
