$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from '@iosevka/util'

glyph-module

glyph-block Letter-Cyrillic-Upper-Shha : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : LeaningAnchor
	glyph-block-import Letter-Shared-Metrics : EFVJutLength
	glyph-block-import Letter-Shared-Shapes : nShoulder SerifFrame TopHook CyrDescender
	glyph-block-import Letter-Cyrillic-Yeri : YeriBarPos
	glyph-block-import Letter-Cyrillic-Che : CheCapConfig CyrCheShape BODY SERIFS
	glyph-block-import Letter-Latin-Lower-H : HConfig
	glyph-block-import Letter-Shared : CreateSelectorVariants DefineSelectorGlyph

	define SLAB-NONE                   0
	define SLAB-TOP-LEFT               1
	define SLAB-TOP-LEFT-BOTTOM-RIGHT  2
	define SLAB-ALL                    4

	define [CyrShhaShape slabType _stroke _flatHump] : glyph-proc
		local stroke : fallback _stroke Stroke
		local yBarTop : [mix 0 CAP YeriBarPos] + stroke / 2

		include : tagged 'strokeL' : VBar.l SB 0 CAP stroke
		if (_flatHump === null || _flatHump) : then : include : nShoulder.earlessCorner
			left   -- SB
			right  -- RightSB
			top    -- yBarTop
			bottom -- 0
			stroke -- stroke
			ada    -- [ArchDepthAClamped yBarTop 0]
			adb    -- [ArchDepthBClamped yBarTop 0]
			rise   -- [if _flatHump 0 DToothlessRise]
		: else : include : nShoulder.shape
			left   -- (SB + [HSwToV stroke])
			right  -- RightSB
			top    -- yBarTop
			bottom -- 0
			stroke -- stroke
			ada    -- [ArchDepthAClamped yBarTop 0]
			adb    -- [ArchDepthBClamped yBarTop 0]

		local sf : SerifFrame.fromDf [DivFrame 1] CAP 0 (swRef -- stroke)
		include : tagged 'SerifLT' : match slabType
			[Just SLAB-ALL]                   sf.lt.full
			[Just SLAB-TOP-LEFT-BOTTOM-RIGHT] sf.lt.outer
			[Just SLAB-TOP-LEFT]              sf.lt.outer
			__                              : glyph-proc
		include : tagged 'SerifLB' : match slabType
			[Just SLAB-ALL]                   sf.lb.full
			__                              : glyph-proc
		include : tagged 'serifRB' : match slabType
			[Just SLAB-ALL]                   sf.rb.full
			[Just SLAB-TOP-LEFT-BOTTOM-RIGHT] sf.rb.outer
			__                              : glyph-proc

	define ShhaConfig : object
		serifless                 SLAB-NONE
		topLeftSerifed            SLAB-TOP-LEFT
		topLeftBottomRightSerifed SLAB-TOP-LEFT-BOTTOM-RIGHT
		serifed                   SLAB-ALL

	foreach { hSuffix { fFlatHump fTailed hSerifs } } [pairs-of HConfig] : do
		DefineSelectorGlyph 'cyrl/Hwe' hSuffix [DivFrame 1] 'capital'
		foreach { suffix slabType } [pairs-of ShhaConfig] : do
			create-glyph "cyrl/Hwe.\(hSuffix).\(suffix)" : glyph-proc
				include : MarkSet.capital
				include : LeaningAnchor.Above.VBar.l SB
				include : CyrShhaShape slabType Stroke fFlatHump
				eject-contour 'strokeL'
				eject-contour 'SerifLT'
				include : TopHook.toRight.lBarInner SB 0 CAP
		select-variant "cyrl/Hwe.\(hSuffix)" (follow -- 'hCapHookTop')

	foreach { suffix { fFlatHump slabType } } [pairs-of CheCapConfig] : do
		create-glyph "cyrl/Shha.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : LeaningAnchor.Above.VBar.l SB
			if (slabType === SERIFS.TL || slabType === SERIFS.RT || slabType === SERIFS.BILATERAL) : then : begin
				include : with-transform [Italify para.slopeAngle] : with-transform [ScaleAround Middle (CAP / 2) (-1) (-1)] : with-transform [Italify (-para.slopeAngle)]
					CyrCheShape [DivFrame 1] CAP 0.45 BODY.STRAIGHT SERIFS.NONE (fFlatHump -- fFlatHump)
				local sf : SerifFrame.fromDf [DivFrame 1] CAP 0
				include : match slabType
					[Just SERIFS.TL]        sf.lt.outer
					[Just SERIFS.RT]        sf.lt.inner
					[Just SERIFS.BILATERAL] sf.lt.full
			: else : include : with-transform [Italify para.slopeAngle] : with-transform [ScaleAround Middle (CAP / 2) (-1) (-1)] : with-transform [Italify (-para.slopeAngle)] : refer-glyph "cyrl/Che.\(suffix)"

	select-variant 'cyrl/Shha' 0x4BA (follow -- 'cyrl/Che')
	CreateSelectorVariants 'cyrl/Hwe' 0xA694 [Object.keys HConfig] (follow -- 'h')

	select-variant 'cyrl/Shha/descBase' (shapeFrom -- 'cyrl/Shha') (follow -- 'cyrl/Che')
	derive-composites 'cyrl/ShhaDescender' 0x526 'cyrl/Shha/descBase' [CyrDescender.rSideJut RightSB 0]

	do 'Phonotypic TH'
		glyph-block-import Letter-Latin-Upper-T : TConfig

		foreach { suffix { adws doST doSB } } [Object.entries TConfig] : do
			define slabType : if (doST && doSB) SLAB-ALL SLAB-NONE

			create-glyph "latn/The.\(suffix)" : glyph-proc
				include : MarkSet.capital
				local stroke : AdviceStroke2 2 3 CAP
				include : CyrShhaShape slabType stroke null

				local xTopRight : mix SB RightSB 0.9
				include : HBar.t (SB - O) xTopRight CAP stroke

				if doST : begin
					local { jutTop jutBot jutMid } : EFVJutLength CAP 0 YeriBarPos stroke
					local swVJut : VJutStroke * (stroke / Stroke)
					include : tagged 'serifRT' : VSerif.dr xTopRight CAP jutTop swVJut

		select-variant 'latn/The' 0x1DF78 (follow -- 'T')
