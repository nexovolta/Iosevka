$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from "@iosevka/util"
import [DependentSelector] from "@iosevka/glyph/relation"

glyph-module

glyph-block Letter-Cyrillic-De : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : ExtendAboveBaseAnchors ExtendBelowBaseAnchors
	glyph-block-import Letter-Shared : CreateAccentedComposition CreateSelectorVariants
	glyph-block-import Letter-Cyrillic-Ze : CyrZe ZeConfig SLAB-FLAT-HOOK

	glyph-block-export BottomExtension
	local BottomExtension : (-LongVJut) + QuarterStroke

	define SERIF-NONE   0
	define SERIF-MOTION 1
	define SERIF-ALL    2

	define [DeSerifTypeOf _serifType] : fallback _serifType : if SLAB SERIF-ALL SERIF-NONE
	define [DeOverflow left right serifType] : if (serifType !== SERIF-NONE) SideJut : (right - left) * 0.075

	glyph-block-export CyrDeBottom
	define [CyrDeBottom left right _sw _desc _serifType] : glyph-proc
		local serifType : DeSerifTypeOf _serifType
		local descenderOverflow : DeOverflow left right serifType
		local xTopLeft  : mix left right : StrokeWidthBlend 0.15 0.10
		local xTopRight : mix left right : StrokeWidthBlend 0.95 0.96
		local swOuter : fallback _sw Stroke
		local swVJut  : VJutStroke * (swOuter / Stroke)
		local desc : fallback _desc BottomExtension

		include : HBar.b xTopLeft xTopRight 0 swOuter
		include : tagged 'footL' : union
			HBar.b (left - descenderOverflow) xTopLeft 0 swOuter
			VBar.l (left - descenderOverflow) desc TINY swVJut
		include : tagged 'footR' : union
			HBar.b xTopRight (right + descenderOverflow) 0 swOuter
			VBar.r (right + descenderOverflow) desc TINY swVJut

	glyph-block-export CyrDeShape
	define [CyrDeShape fCapital top left right _sw _desc _serifType] : glyph-proc
		local serifType : DeSerifTypeOf _serifType
		local descenderOverflow : DeOverflow left right serifType
		local xTopLeft  : mix left right : StrokeWidthBlend 0.15 0.10
		local xTopRight : mix left right : StrokeWidthBlend 0.95 0.96
		local swOuter : fallback _sw Stroke
		local swInner : Math.min
			[AdviceStroke 2.75] * (swOuter / Stroke)
			VSwToH : 0.375 * (xTopRight - xTopLeft)
		local desc : fallback _desc BottomExtension

		include : CyrDeBottom left right swOuter desc serifType

		include : VBar.r xTopRight 0 top swInner
		include : dispiro
			widths.lhs swInner
			flat xTopLeft top [heading Downward]
			curl xTopLeft [mix top (0 + swOuter + TailY - swInner / 2) 0.75]
			g4   left     (0 + swOuter)

		include : match serifType
			[Just SERIF-ALL] : dispiro
				widths.rhs swOuter
				flat (xTopLeft - descenderOverflow - swOuter * SerifShiftX) top
				curl (xTopRight + descenderOverflow - swOuter * SerifShiftX) top
			[Just SERIF-MOTION] : dispiro
				widths.rhs swOuter
				flat (xTopLeft - descenderOverflow - swOuter * SerifShiftX) top
				curl xTopRight top [heading Rightward]
			__ : HBar.t xTopLeft xTopRight top swOuter

		return : object xTopLeft xTopRight swOuter swInner desc

	glyph-block-import Letter-Latin-Upper-Lambda-Delta : DeltaShape
	glyph-block-import Letter-Latin-Upper-A : ASerifs

	define A-SLAB-TOP 1

	define [CyrDeDeltaFeet serifType df _sw _desc] : glyph-proc
		local sw : fallback _sw Stroke
		local desc : fallback _desc BottomExtension
		local descenderOverflow : DeOverflow df.leftSB df.rightSB serifType
		local swVJut : VJutStroke * (sw / Stroke)
		include : HBar.b (df.leftSB - descenderOverflow) (df.rightSB + descenderOverflow) 0 sw
		include : tagged 'footL' : VBar.l (df.leftSB - descenderOverflow) desc TINY swVJut
		include : tagged 'footR' : VBar.r (df.rightSB + descenderOverflow) desc TINY swVJut

	glyph-block-export CyrDeDeltaLikeShape
	define [CyrDeDeltaLikeShape fBarStraight fSquareBottom top serifType _df _sw _desc] : glyph-proc
		local df : fallback _df [DivFrame 1]
		local sw : fallback _sw Stroke
		local desc : fallback _desc BottomExtension
		include : DeltaShape
			df            -- df
			fBarStraight  -- fBarStraight
			fSquareBottom -- fSquareBottom
			top           -- top
			bottom        -- 0
			sw            -- sw
		if (serifType !== SERIF-NONE) : include : ASerifs df top sw A-SLAB-TOP
		include : CyrDeDeltaFeet serifType df sw desc
		local xTopLeft  : df.middle - [HSwToV : 0.5 * sw]
		local xTopRight : 0 + df.rightSB
		local swOuter   sw
		local swInner   sw
		return : object xTopLeft xTopRight swOuter swInner desc

	define BODY-TRAPEZOID  0
	define BODY-TRIANGULAR 1
	define BODY-CURLY      2
	define BODY-SQUARE     3
	define BODY-CURSIVE    4

	glyph-block-export DeConfig BODY-TRAPEZOID BODY-TRIANGULAR BODY-CURLY BODY-SQUARE BODY-CURSIVE
	glyph-block-export SERIF-NONE SERIF-MOTION SERIF-ALL
	define DeConfig : SuffixCfg.weave
		object
			standard    BODY-TRAPEZOID
			triangular  BODY-TRIANGULAR
			curly       BODY-CURLY
			square      BODY-SQUARE
			cursive     BODY-CURSIVE
		object
			serifless     SERIF-NONE
			motionSerifed SERIF-MOTION
			serifed       SERIF-ALL

	define DeUprightSuffixes {}
	foreach { suffix { bodyType serifType } } [Object.entries DeConfig] : do
		if (bodyType !== BODY-CURSIVE) : DeUprightSuffixes.push suffix

	define [DefineDeSelectorGlyph name selector df mk] : begin
		create-glyph "\(name)/selector.\(selector)" : glyph-proc
			include df
			include : df.markSet.(mk)
			include : ExtendBelowBaseAnchors BottomExtension
			set-base-anchor 'cvDecompose' 0 0
			DependentSelector.set currentGlyph selector

	define [CyrDeBodyShape bodyType fCapital top serifType _sw _desc _df] : match bodyType
		[Just BODY-TRAPEZOID]  : CyrDeShape fCapital top [if _df _df.leftSB SB] [if _df _df.rightSB RightSB] _sw _desc serifType
		[Just BODY-TRIANGULAR] : CyrDeDeltaLikeShape true  false top serifType _df _sw _desc
		[Just BODY-CURLY]      : CyrDeDeltaLikeShape false false top serifType _df _sw _desc
		[Just BODY-SQUARE]     : CyrDeDeltaLikeShape true  true  top serifType _df _sw _desc

	define CyrSoftDeGheConfig : object
		serifless       false
		topRightSerifed true

	define [CyrSoftDeShape vSlab] : function [fCapital df top bodyType serifType _sw _desc] : glyph-proc
		local sw : fallback _sw Stroke
		local xm : if SLAB
			[mix df.leftSB df.rightSB 0.625] + [HSwToV : 0.25 * sw]
			mix df.leftSB df.rightSB : if (df.adws > 1) (2 / 3) (3 / 4)
		local deDf : df.slice 3 2

		local [object xTopRight] : include : match bodyType
			[Just BODY-TRIANGULAR] : CyrDeDeltaLikeShape true  false top serifType deDf sw _desc
			[Just BODY-CURLY]      : CyrDeDeltaLikeShape false false top serifType deDf sw _desc
			[Just BODY-SQUARE]     : CyrDeDeltaLikeShape true  true  top serifType deDf sw _desc
			__                     : CyrDeShape fCapital top df.leftSB xm sw _desc serifType

		local fDeltaLike : (bodyType === BODY-TRIANGULAR) || (bodyType === BODY-CURLY) || (bodyType === BODY-SQUARE)
		local xJoin : if fDeltaLike [deDf.middle + [HSwToV : 0.5 * sw]] xTopRight
		local xTopBarRightEnd : mix df.width df.rightSB : if vSlab 0.250 0.375
		include : HBar.t (xJoin + O) xTopBarRightEnd top sw
		if vSlab : begin
			local swVJut : Math.min (VJutStroke * (sw / Stroke)) : VSwToH : 0.625 * (xTopBarRightEnd - xJoin)
			include : VSerif.dr xTopBarRightEnd top VJut swVJut

	foreach { suffix { bodyType serifType } } [Object.entries DeConfig] : do
		if (bodyType !== BODY-CURSIVE) : begin
			create-glyph "cyrl/De.\(suffix)" : glyph-proc
				include : MarkSet.capital
				include : ExtendBelowBaseAnchors BottomExtension
				include : CyrDeBodyShape bodyType true CAP serifType

			create-glyph "cyrl/de.\(suffix)" : glyph-proc
				include : MarkSet.e
				include : ExtendBelowBaseAnchors BottomExtension
				include : CyrDeBodyShape bodyType false XH serifType

			create-glyph "cyrl/deLongLeg.upright.\(suffix)" : glyph-proc
				include : MarkSet.p
				include : CyrDeBodyShape bodyType false XH serifType nothing Descender

			create-glyph "cyrl/Dwe.\(suffix)" : glyph-proc
				include : MarkSet.capital
				local asc : CAP + LongVJut - QuarterStroke
				include : ExtendAboveBaseAnchors asc
				include : ExtendBelowBaseAnchors BottomExtension
				local de : include : CyrDeBodyShape bodyType true CAP serifType
				include : VBar.l de.xTopLeft (CAP + O) asc [Math.min de.swInner : VJutStroke * (de.swOuter / Stroke)]

			create-glyph "cyrl/dwe.upright.\(suffix)" : glyph-proc
				include : MarkSet.e
				local asc : XH + LongVJut - QuarterStroke
				include : ExtendAboveBaseAnchors asc
				include : ExtendBelowBaseAnchors BottomExtension
				local de : include : CyrDeBodyShape bodyType false XH serifType
				include : VBar.l de.xTopLeft (XH + O) asc [Math.min de.swInner : VJutStroke * (de.swOuter / Stroke)]

			define cyrSoftDeDf : DivFrame para.advanceScaleM 3
			DefineDeSelectorGlyph "cyrl/DeSoft" suffix cyrSoftDeDf 'capital'
			DefineDeSelectorGlyph "cyrl/deSoft" suffix cyrSoftDeDf 'e'
			foreach { suffixGhe cyrSoftDeVSlab } [Object.entries CyrSoftDeGheConfig] : do
				create-glyph "cyrl/DeSoft.\(suffix).\(suffixGhe)" : glyph-proc
					set-width 0
					set-mark-anchor 'cvDecompose' 0 0
					include : ExtendBelowBaseAnchors BottomExtension
					include : [CyrSoftDeShape cyrSoftDeVSlab] true cyrSoftDeDf CAP bodyType serifType cyrSoftDeDf.mvs
				create-glyph "cyrl/deSoft.\(suffix).\(suffixGhe)" : glyph-proc
					set-width 0
					set-mark-anchor 'cvDecompose' 0 0
					include : ExtendBelowBaseAnchors BottomExtension
					include : [CyrSoftDeShape cyrSoftDeVSlab] false cyrSoftDeDf XH bodyType serifType cyrSoftDeDf.mvs
			select-variant "cyrl/DeSoft.\(suffix)" (follow -- 'cyrl/EnGhe/Ghe')
			select-variant "cyrl/deSoft.\(suffix)" (follow -- 'cyrl/enghe/ghe')

			DefineDeSelectorGlyph "cyrl/Dzze" suffix [DivFrame 1] 'capital'
			DefineDeSelectorGlyph "cyrl/dzze.upright" suffix [DivFrame 1] 'e'
			foreach { suffixZe { { desc } { styTop styBot } } } [Object.entries ZeConfig] : do
				define [DzzeDescenderShape de ada adb] : begin
					local df : DivFrame 1
					local zeRight : [mix df.rightSB df.width 0.5] - O * 2
					local zeLeft : mix zeRight de.xTopRight 2
					local sw : AdviceStroke 2.5 (((zeRight - zeLeft) + 2 * df.leftSB) / df.width)
					local zeTop : 0 + sw
					local zeBot : de.desc - 0.5 * sw
					local p : (zeTop - zeBot) / (CAP - 0)
					local ze : CyrZe 3 styBot zeTop zeBot
						left   -- zeLeft
						right  -- zeRight
						hook   -- (Hook * p)
						stroke -- sw
						xo     -- (0.5 * O)
						barPos -- 0.5
						ada    -- (ada * p)
						adb    -- (adb * p)
					return : union [ze.Shape] [ze.AutoEndSerifL]

				if (!desc && (!styTop || styTop == SLAB-FLAT-HOOK)) : begin
					create-glyph "cyrl/Dzze.\(suffix).\(suffixZe)" : glyph-proc
						set-width 0
						set-mark-anchor 'cvDecompose' 0 0
						include : ExtendBelowBaseAnchors BottomExtension
						local de : include : CyrDeBodyShape bodyType true CAP serifType nothing nothing [DivFrame 1]
						eject-contour 'footR'
						include : DzzeDescenderShape de ArchDepthA ArchDepthB
					create-glyph "cyrl/dzze.upright.\(suffix).\(suffixZe)" : glyph-proc
						set-width 0
						set-mark-anchor 'cvDecompose' 0 0
						include : ExtendBelowBaseAnchors BottomExtension
						local de : include : CyrDeBodyShape bodyType false XH serifType nothing nothing [DivFrame 1]
						eject-contour 'footR'
						include : DzzeDescenderShape de SmallArchDepthA SmallArchDepthB
			select-variant "cyrl/Dzze.\(suffix)" (follow -- 'cyrl/Dzze/Ze')
			select-variant "cyrl/dzze.upright.\(suffix)" (follow -- 'cyrl/dzze.upright/ze')

	select-variant 'cyrl/De' 0x414
	select-variant 'cyrl/deLongLeg.upright' (follow -- 'cyrl/De')
	select-variant 'cyrl/Dwe' 0xA680 (follow -- 'cyrl/De')
	select-variant 'cyrl/dwe.upright' (follow -- 'cyrl/De')
	alias 'cyrl/de.upright' null 'cyrl/de.standardSerifless'

	CreateSelectorVariants 'cyrl/DeSoft' 0xA662 DeUprightSuffixes (follow -- 'cyrl/De')
	CreateSelectorVariants 'cyrl/deSoft' 0xA663 DeUprightSuffixes (follow -- 'cyrl/De')
	CreateSelectorVariants 'cyrl/Dzze' 0xA688 DeUprightSuffixes (follow -- 'cyrl/De')
	CreateSelectorVariants 'cyrl/dzze.upright' null DeUprightSuffixes (follow -- 'cyrl/De')

	## Italic
	define [CyrDeItalicKnots df _sw] : begin
		local sw : fallback _sw df.mvs
		local fine : ShoulderFine * (sw / Stroke)

		local yRingTop : Math.min (XH + O) (XH - QuarterStroke)
		local ada : df.archDepthAOf (SmallArchDepth * (yRingTop / XH)) sw
		local adb : df.archDepthBOf (SmallArchDepth * (yRingTop / XH)) sw

		return : list
			straight.up.start ((df.rightSB - OX) - [HSwToV : sw - fine]) (yRingTop - adb) [widths.lhs fine]
			Arch.lhs yRingTop (sw -- sw) (swBefore -- fine)
			flatside.ld df.leftSB  0 yRingTop ada adb
			Arch.lhs 0 (sw -- sw)
			flatside.ru df.rightSB 0 yRingTop ada adb
			quadControls 0 0.8
			g4 (df.leftSB + sw * 1.1) Ascender

	glyph-block-export CyrDeItalicShape
	define [CyrDeItalicShape df _sw] : dispiro
		CyrDeItalicKnots df _sw

	glyph-block-export CyrDeItalicMask
	define [CyrDeItalicMask df _sw] : spiro-outline
		CyrDeItalicKnots df _sw

	create-glyph 'cyrl/de.cursiveSerifless' : glyph-proc
		include : MarkSet.b
		include : CyrDeItalicShape [DivFrame 1]
	alias 'cyrl/de.cursiveMotionSerifed' null 'cyrl/de.cursiveSerifless'
	alias 'cyrl/de.cursiveSerifed' null 'cyrl/de.cursiveSerifless'
	alias 'cyrl/de.cursive' null 'cyrl/de.cursiveSerifless'
	alias 'cyrl/de.italic' null 'cyrl/de.cursiveSerifless'
	select-variant 'cyrl/de' 0x434

	create-glyph 'cyrl/dwe.italic/base' : glyph-proc
		include : MarkSet.b
		include : CyrDeItalicShape [DivFrame 0.95]
		set-base-anchor 'topRight' (RightSB - DotRadius) XH

	CreateAccentedComposition 'cyrl/dwe.italic' null 'cyrl/dwe.italic/base' 'commaTR'

	foreach { suffix { { desc } { styTop styBot } } } [Object.entries ZeConfig] : do
		if (desc && (!styTop || styTop == SLAB-FLAT-HOOK)) : begin
			create-glyph "cyrl/dzze.italic.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleMM 3
				include : df.markSet.bp

				local subDf : df.slice 3 2 OX
				include : CyrDeItalicShape subDf df.mvs

				local shift : df.width - subDf.width
				local ze : CyrZe 1 styBot XH Descender
					left      -- ((subDf.leftSB  + OX) + shift)
					right     -- ((subDf.rightSB - OX) + shift)
					blend     -- 0.7
					hook      -- SHook
					stroke    -- df.mvs
					xOverflow -- 0
					barPos    -- 0.55
					ada       -- SmallArchDepthA
					adb       -- SmallArchDepthB
				include : union [ze.Shape] [ze.AutoEndSerifL]

	select-variant 'cyrl/dzze.italic'  (follow -- 'cyrl/dzze.italic/ze')
