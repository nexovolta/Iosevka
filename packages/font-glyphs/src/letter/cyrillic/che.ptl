$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from "@iosevka/util"
import [DependentSelector] from "@iosevka/glyph/relation"

glyph-module

glyph-block Letter-Cyrillic-Che : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : LeaningAnchor
	glyph-block-import Letter-Shared : CreateAccentedComposition CreateSelectorVariants DefineSelectorGlyph
	glyph-block-import Letter-Shared-Shapes : SerifFrame RightwardTailedBar CyrDescender

	glyph-block-export BODY
	define BODY : object
		STRAIGHT 0
		TAILED   1

	glyph-block-export SERIFS
	define SERIFS : object
		NONE        0
		TL          1
		BR          2
		TL-BR       3
		ALL         4
		TOP         5
		ALL-BGR     6
		TOP-BGR     7

	define flex-params [CheBowl] : begin
		local-parameter : left
		local-parameter : right
		local-parameter : top
		local-parameter : bottom
		local-parameter : ada       -- ArchDepthA
		local-parameter : adb       -- ArchDepthB
		local-parameter : stroke    -- Stroke

		define xMid : [mix left right 0.5] + [HSwToV : 0.2 * stroke]
		define rise : DToothlessRise + 0.25 * stroke
		return : dispiro
			widths.lhs stroke
			flat left top [heading Downward]
			curl left [Math.min (bottom + adb) (top - TINY)]
			Arch.lhs.centerAt.ltr.b xMid bottom (sw -- stroke)
			g4   right (bottom + rise)

	glyph-block-export CyrCheShape
	define [CyrCheShape] : with-params [df top pyBar bodyType slabType [sw df.mvs]] : glyph-proc
		local yBar : mix 0 top : fallback pyBar 0.5

		include : tagged 'strokeR' : match bodyType
			[Just BODY.TAILED] : RightwardTailedBar df.rightSB 0 top sw
			__                 : VBar.r             df.rightSB 0 top sw

		include : CheBowl
			left   -- df.leftSB
			right  -- df.rightSB
			top    -- top
			bottom -- (yBar - sw / 2)
			stroke -- sw

		local sf : SerifFrame.fromDf df top 0
		include : tagged 'serifLT' : match slabType
			[Just SERIFS.ALL]        sf.lt.full
			[Just SERIFS.TOP]        sf.lt.full
			[Just SERIFS.ALL-BGR]    sf.lt.outer
			[Just SERIFS.TOP-BGR]    sf.lt.outer
			[Just SERIFS.TL-BR]      sf.lt.outer
			[Just SERIFS.TL]         sf.lt.outer
			__                       [glyph-proc]
		include : tagged 'SerifRT' : match slabType
			[Just SERIFS.ALL]        sf.rt.full
			[Just SERIFS.TOP]        sf.rt.full
			[Just SERIFS.ALL-BGR]    sf.rt.inner
			[Just SERIFS.TOP-BGR]    sf.rt.inner
			__                       [glyph-proc]
		include : tagged 'SerifRB' : match slabType
			[Just SERIFS.ALL]        sf.rb.fullSide
			[Just SERIFS.ALL-BGR]    sf.rb.fullSide
			[Just SERIFS.TL-BR]      sf.rb.outer
			[Just SERIFS.BR]         sf.rb.outer
			__                       [glyph-proc]

	glyph-block-import Letter-Latin-Lower-M : EarlessCornerDoubleArchSmallMShape
	define [CyrCcheShape] : with-params [df top pyBar bodyType slabType [sw df.mvs]] : glyph-proc
		local yBar : mix 0 top : fallback pyBar 0.5

		include : tagged 'strokeR' : match bodyType
			[Just BODY.TAILED] : RightwardTailedBar df.rightSB 0 top sw
			__                 : VBar.r             df.rightSB 0 top sw

		include : new-glyph : glyph-proc
			include : EarlessCornerDoubleArchSmallMShape df (top - (yBar - sw / 2)) 0 0 0
			eject-contour 'barL'
			include : FlipAround df.middle (top / 2)

		local sf : SerifFrame.fromDf df top 0
		include : tagged 'serifLT' : match slabType
			[Just SERIFS.ALL]      [if sf.enoughSpaceForFullSerifs sf.lt.full sf.lt.outer]
			[Just SERIFS.TOP]      [if sf.enoughSpaceForFullSerifs sf.lt.full sf.lt.outer]
			[Just SERIFS.TL-BR]    sf.lt.outer
			[Just SERIFS.TL]       sf.lt.outer
			__                     [glyph-proc]
		include : tagged 'serifMT' : match slabType
			[Just SERIFS.ALL]      [if sf.enoughSpaceForFullSerifs sf.mt.full [glyph-proc]]
			[Just SERIFS.TOP]      [if sf.enoughSpaceForFullSerifs sf.mt.full [glyph-proc]]
			__                     [glyph-proc]
		include : tagged 'SerifRT' : match slabType
			[Just SERIFS.ALL]      [if sf.enoughSpaceForFullSerifs sf.rt.full sf.rt.outer]
			[Just SERIFS.TOP]      [if sf.enoughSpaceForFullSerifs sf.rt.full sf.rt.outer]
			__                     [glyph-proc]
		include : tagged 'SerifRB' : match slabType
			[Just SERIFS.ALL]      sf.rb.fullSide
			[Just SERIFS.TL-BR]    sf.rb.outer
			[Just SERIFS.BR]       sf.rb.outer
			__                     [glyph-proc]

	define [CyrTcheShape] : with-params [df top pyBar bodyType slabType [sw [AdviceStroke 2.75]] [teSerifs SLAB]] : glyph-proc
		local yBar : mix 0 top : fallback pyBar 0.5

		local left : [mix df.leftSB df.rightSB : if (df.adws > 1) 0.25 0.2] - [HSwToV : 0.25 * sw] + OX
		local right : df.rightSB - OX

		include : tagged 'strokeR' : match bodyType
			[Just BODY.TAILED] : RightwardTailedBar right 0 top sw
			__                 : VBar.r             right 0 top sw

		include : CheBowl
			left   -- left
			right  -- right
			top    -- top
			bottom -- (yBar - sw / 2)
			stroke -- sw

		local xTopBarLeft : df.leftSB - SideJut
		local xTopBarRight : mix xTopBarLeft (left + [HSwToV : 0.5 * sw]) 2

		include : dispiro
			widths.rhs sw
			flat xTopBarLeft  top [if teSerifs [heading Rightward] null]
			curl xTopBarRight top [if teSerifs [heading Rightward] null]

		local sf : SerifFrame top 0 left right (swRef -- sw)
		include : tagged 'SerifRT' : match slabType
			[Just SERIFS.ALL]      sf.rt.outer
			[Just SERIFS.TOP]      sf.rt.outer
			__                     [glyph-proc]
		include : tagged 'SerifRB' : match slabType
			[Just SERIFS.ALL]      sf.rb.fullSide
			[Just SERIFS.TL-BR]    sf.rb.outer
			[Just SERIFS.BR]       sf.rb.outer
			__                     [glyph-proc]

		if teSerifs : begin
			local swVJut : Math.min (VJutStroke * (sw / Stroke)) : VSwToH : 0.625 * (left - xTopBarLeft)
			include : VSerif.dl xTopBarLeft  top VJut swVJut
			include : VSerif.dr xTopBarRight top VJut swVJut

	define CheCapConfig : object
		serifless     SERIFS.NONE
		motionSerifed SERIFS.TL
		serifed       SERIFS.ALL

	foreach { suffix slabType } [Object.entries CheCapConfig] : do
		create-glyph "cyrl/Che.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : LeaningAnchor.Below.VBar.r RightSB
			include : CyrCheShape [DivFrame 1] CAP [if (slabType !== SERIFS.NONE) 0.45 0.35] BODY.STRAIGHT slabType

		create-glyph "cyrl/Cche.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleMM 3
			include : df.markSet.capital
			include : LeaningAnchor.Below.VBar.r df.rightSB
			include : CyrCcheShape df CAP [if (slabType !== SERIFS.NONE) 0.45 0.35] BODY.STRAIGHT slabType

	select-variant 'cyrl/Che' 0x427
	select-variant 'cyrl/Cche' 0xA686 (follow -- 'cyrl/Che')

	define TcheConfig : object
		serifless     { false false }
		motionSerifed { true  false }

	foreach { suffixChe slabType } [Object.entries CheCapConfig] : do
		DefineSelectorGlyph "cyrl/Tche" suffixChe [DivFrame para.advanceScaleT] 'capital'
		foreach { suffixTe { doST doSB } } [Object.entries TcheConfig] : do
			create-glyph "cyrl/Tche.\(suffixChe).\(suffixTe)" : glyph-proc
				set-width 0
				set-mark-anchor 'cvDecompose' 0 0
				local df : DivFrame para.advanceScaleT
				include : LeaningAnchor.Below.VBar.r df.rightSB
				include : CyrTcheShape df CAP [if (slabType !== SERIFS.NONE) 0.45 0.35] BODY.STRAIGHT slabType
					teSerifs -- doST
		select-variant "cyrl/Tche.\(suffixChe)" (follow -- 'T/rTailBase')

	CreateSelectorVariants 'cyrl/Tche' 0xA692 [Object.keys CheCapConfig] (follow -- 'cyrl/Che')

	derive-composites 'cyrl/CheDescender' 0x4B6 'cyrl/Che' [CyrDescender.rSideJut RightSB 0]
	derive-composites 'cyrl/kha/Che' 0x4CB 'cyrl/Che' [CyrDescender.lSideJut (RightSB - [HSwToV Stroke]) 0 (jut -- MidJutSide)]

	glyph-block-export CheConfig
	define CheConfig : SuffixCfg.weave
		object # body
			standard { BODY.STRAIGHT }
			tailed   { BODY.TAILED }
		function [body] : object # serifs
			serifless { SERIFS.NONE SERIFS.NONE }
			motionSerifed : match body
				[Just 'standard'] { SERIFS.TL-BR SERIFS.TL-BR }
				__                { SERIFS.TL    SERIFS.TL }
			serifed : match body
				[Just 'standard'] { SERIFS.ALL SERIFS.ALL-BGR }
				__                { SERIFS.TOP SERIFS.TOP-BGR }

	foreach { suffix { { body } { slabType slabTypeBGR } } } [pairs-of CheConfig] : do
		create-glyph "cyrl/che.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : LeaningAnchor.Below.VBar.r RightSB
			include : CyrCheShape [DivFrame 1] XH [if (slabType !== SERIFS.NONE) 0.45 0.4] body slabType

		create-glyph "cyrl/che.BGR.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : LeaningAnchor.Below.VBar.r RightSB
			include : CyrCheShape [DivFrame 1] XH [if (slabTypeBGR !== SERIFS.NONE) 0.45 0.4] body slabTypeBGR

		create-glyph "cyrl/cche.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleMM 3
			include : df.markSet.e
			include : LeaningAnchor.Below.VBar.r df.rightSB
			include : CyrCcheShape df XH [if (slabType !== SERIFS.NONE) 0.45 0.4] body slabType

		define cyrTcheDf : DivFrame para.advanceScaleT

		DefineSelectorGlyph "cyrl/tche.upright" suffix cyrTcheDf 'e'

		foreach { suffixTe { doST doSB } } [Object.entries TcheConfig] : do
			create-glyph "cyrl/tche.upright.\(suffix).\(suffixTe)" : glyph-proc
				set-width 0
				set-mark-anchor 'cvDecompose' 0 0
				include : LeaningAnchor.Below.VBar.r cyrTcheDf.rightSB
				include : CyrTcheShape cyrTcheDf XH [if (slabType !== SERIFS.NONE) 0.45 0.4] body slabType
					teSerifs -- doST

		select-variant "cyrl/tche.upright.\(suffix)" (follow -- 'T/rTailBase')

	select-variant 'cyrl/che' 0x447
	select-variant 'cyrl/che.BGR' (follow -- 'cyrl/che')

	select-variant 'cyrl/cche' 0xA687 (follow -- 'cyrl/che')

	CreateSelectorVariants 'cyrl/tche.upright' null [Object.keys CheConfig] (follow -- 'cyrl/che')
	CreateAccentedComposition 'cyrl/tche.italic' null 'cyrl/che' 'tildeAbove'

	derive-composites 'cyrl/cheDescender' 0x4B7 'cyrl/che' [CyrDescender.rSideJut RightSB 0]
	derive-composites 'cyrl/kha/che' 0x4CC 'cyrl/che' [CyrDescender.lSideJut (RightSB - [HSwToV Stroke]) 0 (jut -- MidJutSide)]

	define [CheVBarBarShape top pyBar] : begin
		local SwCheVBar : Math.min OverlayStroke : VSwToH : 0.625 * ((RightSB - SB) - [HSwToV : 2 * Stroke])
		local yc : [mix 0 top : fallback pyBar 0.5] + Stroke * 0.1
		return : VBar.m Middle (yc + LongVJut * 0.8) (yc - LongVJut * 0.8) SwCheVBar

	derive-composites 'cyrl/CheVBar' 0x4B8 'cyrl/Che' [CheVBarBarShape CAP : if SLAB 0.45 0.35]
	derive-composites 'cyrl/cheVBar' 0x4B9 'cyrl/che' [CheVBarBarShape XH  : if SLAB 0.45 0.4]
