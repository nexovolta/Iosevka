$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"

glyph-module

glyph-block Letter-Cyrillic-Tse : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared-Shapes : SerifFrame CyrDescender CyrCurlDescender

	define SERIF-NONE   0
	define SERIF-MOTION 1
	define SERIF-ALL    2

	define [CyrTseShape top fRev serifType] : glyph-proc
		include : VBar.l SB      0 top
		include : VBar.r RightSB 0 top
		include : HBar.b SB RightSB 0
		include : if fRev
			CyrDescender.lSideJut SB      0
			CyrDescender.rSideJut RightSB 0
		if (serifType !== SERIF-NONE) : let [sf : SerifFrame.fromDf [DivFrame 1] top 0] : begin
			include : match serifType
				[Just SERIF-MOTION] : begin sf.lt.outer
				__ : glyph-proc
					include sf.lt.full
					include sf.rt.full
					include sf.lb.outer
					include sf.rb.outer

	define TseConfig : object
		serifless     SERIF-NONE
		motionSerifed SERIF-MOTION
		serifed       SERIF-ALL

	foreach { suffix serifType } [Object.entries TseConfig] : do
		create-glyph "cyrl/Tse.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : CyrTseShape CAP false serifType

		create-glyph "cyrl/tse.upright.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : CyrTseShape XH false serifType

		create-glyph "cyrl/revTse.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : CyrTseShape CAP true serifType

		create-glyph "cyrl/revtse.upright.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : CyrTseShape XH true serifType

	select-variant 'cyrl/Tse' 0x426
	select-variant 'cyrl/tse.upright'
	select-variant 'cyrl/revTse' 0xA660 (follow -- 'cyrl/Tse')
	select-variant 'cyrl/revtse.upright' (follow -- 'cyrl/tse.upright')

	define TeTseConfig : object
		serifless     { false false }
		motionSerifed { true  false }

	define [CyrTeTseShape df top teSerifs] : glyph-proc
		local sw : AdviceStroke 2.75
		local left : [mix df.leftSB df.rightSB : if (df.adws > 1) 0.25 0.2] - [HSwToV : 0.25 * sw] + OX
		local right : df.rightSB - OX

		local xTopBarLeft : df.leftSB - SideJut
		local xTopBarRight : mix xTopBarLeft (left + [HSwToV : 0.5 * sw]) 2

		include : dispiro
			widths.rhs sw
			flat xTopBarLeft  top [if teSerifs [heading Rightward] null]
			curl xTopBarRight top [if teSerifs [heading Rightward] null]

		include : VBar.l left  0 top sw
		include : VBar.r right 0 top sw
		include : HBar.b left right 0 sw

		local sf : SerifFrame top 0 left right (swRef -- sw)
		include : CyrDescender.rSideJut right 0 (sideJut -- sf.sideJut)

		if SLAB : begin
			include sf.rt.outer
			include sf.lb.outer
			include sf.rb.outer

		if teSerifs : begin
			local swVJut : Math.min (VJutStroke * (sw / Stroke)) : VSwToH : 0.625 * (left - xTopBarLeft)
			include : VSerif.dl xTopBarLeft  top VJut swVJut
			include : VSerif.dr xTopBarRight top VJut swVJut

	foreach { suffix { doST doSB } } [Object.entries TeTseConfig] : do
		create-glyph "cyrl/TeTse.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleT
			include : df.markSet.capital
			include : CyrTeTseShape df CAP doST

		create-glyph "cyrl/tetse.upright.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleT
			include : df.markSet.e
			include : CyrTeTseShape df XH doST

	select-variant 'cyrl/TeTse' 0x4B4 (follow -- 'T/rTailBase')
	select-variant 'cyrl/tetse.upright' (follow -- 'T/rTailBase')

	define [CyrTsweShape top serifType] : glyph-proc
		include : VBar.l SB 0 top
		include : HBar.b SB RightSB 0
		include : VBar.r RightSB 0 top
		include : CyrCurlDescender.rSideJut RightSB 0
		if (serifType !== SERIF-NONE) : let [sf : SerifFrame.fromDf [DivFrame 1] top 0] : begin
			include : match serifType
				[Just SERIF-MOTION] : begin sf.lt.outer
				__ : glyph-proc
					include sf.lt.full
					include sf.rt.full
					include sf.lb.outer
					include sf.rb.outer

	foreach { suffix serifType } [Object.entries TseConfig] : do
		create-glyph "cyrl/Tswe.\(suffix)" : glyph-proc
			include : MarkSet.capDesc
			include : CyrTsweShape CAP serifType
		create-glyph "cyrl/tswe.upright.\(suffix)" : glyph-proc
			include : MarkSet.p
			include : CyrTsweShape XH serifType

	select-variant 'cyrl/Tswe' 0xA68E (follow -- 'cyrl/Tse')
	select-variant 'cyrl/tswe.upright' (follow -- 'cyrl/tse.upright')
