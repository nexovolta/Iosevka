$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"

glyph-module

glyph-block Letter-Cyrillic-Iotated : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared-Metrics : EFVJutLength
	glyph-block-import Letter-Shared-Shapes : SerifFrame RightwardTailedBar

	define SLAB-NONE     0
	define SLAB-FULL     1
	define SLAB-OUTWARD  2

	define IOTATION-SERIF-NONE   0
	define IOTATION-SERIF-MOTION 1
	define IOTATION-SERIF-ALL    2

	glyph-block-export IotationSerifConfig
	define IotationSerifConfig : object
		serifless     IOTATION-SERIF-NONE
		motionSerifed IOTATION-SERIF-MOTION
		serifed       IOTATION-SERIF-ALL

	define [ResolvedIotationSerifType serifType] : fallback serifType : if SLAB IOTATION-SERIF-ALL IOTATION-SERIF-NONE
	define [IotationItalicReduce fCapital serifType] : [not fCapital] && para.isItalic && (serifType === nothing)

	glyph-block-export IotationSerifFromSelector
	define [IotationSerifFromSelector gn] : begin
		match para.variantSelector.(gn)
			[Just 'motionSerifed'] IOTATION-SERIF-MOTION
			[Just 'serifed']       IOTATION-SERIF-ALL
			__                     IOTATION-SERIF-NONE

	glyph-block-export Iotation
	define Iotation : namespace
		export : define [Shape] : with-params [df top hBarRight [hBarY (top / 2)] [slabTop SLAB-NONE] [slabBottom SLAB-NONE] [swRef df.mvs] [swSerif swRef] [fForceSymmetric false]] : glyph-proc
			include : VBar.l df.leftSB 0 top swRef
			if (hBarRight > df.leftSB) : include : HBar.m df.leftSB hBarRight hBarY swRef
			if (slabTop || slabBottom) : begin
				local sf : SerifFrame.fromDf df top 0 (swRef -- swRef) (swSerif -- swSerif) (fForceSymmetric -- fForceSymmetric)
				include : tagged "serifLT" : match slabTop
					[Just SLAB-FULL]    : begin sf.lt.full
					[Just SLAB-OUTWARD] : begin sf.lt.outer
					__                  : glyph-proc
				include : tagged "serifLB" : match slabBottom
					[Just SLAB-FULL]    : begin sf.lb.full
					[Just SLAB-OUTWARD] : begin sf.lb.outer
					__                  : glyph-proc

		export : define [RevShape] : with-params [df top hBarLeft [hBarY (top / 2)] [slabTop SLAB-NONE] [slabBottom SLAB-NONE] [swRef df.mvs] [swSerif swRef] [fTailed false] [serifType nothing]] : glyph-proc
			include : if fTailed
				RightwardTailedBar df.rightSB 0 top swRef
				VBar.r             df.rightSB 0 top swRef
			if (hBarLeft < df.rightSB) : include : HBar.m hBarLeft df.rightSB hBarY swRef
			local resolved : ResolvedIotationSerifType serifType
			local topSlab : if (serifType !== nothing)
				match resolved
					[Just IOTATION-SERIF-MOTION] SLAB-OUTWARD
					[Just IOTATION-SERIF-ALL]    SLAB-FULL
					__                           SLAB-NONE
				begin slabTop
			local botSlab : if (serifType !== nothing)
				match resolved
					[Just IOTATION-SERIF-ALL] SLAB-FULL
					__                        SLAB-NONE
				begin slabBottom
			if (topSlab || botSlab) : begin
				local sf : SerifFrame.fromDf df top 0 (swRef -- swRef) (swSerif -- swSerif)
				include : tagged "serifRT" : match topSlab
					[Just SLAB-FULL]    : begin sf.rt.full
					[Just SLAB-OUTWARD] : begin sf.rt.outer
					__                  : glyph-proc
				if [not fTailed] : include : tagged "serifRB" : match botSlab
					[Just SLAB-FULL]    : begin sf.rb.full
					[Just SLAB-OUTWARD] : begin sf.rb.outer
					__                  : glyph-proc

		# "Default" version
		export : define [full] : with-params [df top hBarRight hBarY [fCapital false] [swRef df.mvs] [swSerif swRef] [serifType nothing]] : begin
			local resolved : ResolvedIotationSerifType serifType
			local useItalicShape : IotationItalicReduce fCapital serifType
			return : new-glyph : Shape
				df         -- df
				top        -- top
				hBarRight  -- hBarRight
				hBarY      -- hBarY
				slabTop    -- : match resolved
					[Just IOTATION-SERIF-MOTION] SLAB-OUTWARD
					[Just IOTATION-SERIF-ALL]    : if useItalicShape SLAB-OUTWARD SLAB-FULL
					__                           SLAB-NONE
				slabBottom -- : match resolved
					[Just IOTATION-SERIF-ALL] : if useItalicShape SLAB-NONE SLAB-FULL
					__                        SLAB-NONE
				swRef      -- swRef
				swSerif    -- swSerif

		# Outwards only
		export : define [outer] : with-params [df top hBarRight hBarY [fCapital false] [swRef df.mvs] [swSerif swRef] [serifType nothing]] : begin
			local resolved : ResolvedIotationSerifType serifType
			local useItalicShape : IotationItalicReduce fCapital serifType
			return : new-glyph : Shape
				df         -- df
				top        -- top
				hBarRight  -- hBarRight
				hBarY      -- hBarY
				slabTop    -- : match resolved
					[Just IOTATION-SERIF-NONE] SLAB-NONE
					__                         SLAB-OUTWARD
				slabBottom -- : match resolved
					[Just IOTATION-SERIF-ALL] : if useItalicShape SLAB-NONE SLAB-OUTWARD
					__                        SLAB-NONE
				swRef      -- swRef
				swSerif    -- swSerif

		# Iotated A-shaped glyphs
		export : define [A] : with-params [df top hBarRight hBarY [fCapital false] [swRef df.mvs] [swSerif swRef] [serifType nothing]] : begin
			local resolved : ResolvedIotationSerifType serifType
			local useItalicShape : IotationItalicReduce fCapital serifType
			return : new-glyph : Shape
				df         -- df
				top        -- top
				hBarRight  -- hBarRight
				hBarY      -- hBarY
				slabTop    -- : match resolved
					[Just IOTATION-SERIF-MOTION] SLAB-OUTWARD
					[Just IOTATION-SERIF-ALL]    : if useItalicShape SLAB-OUTWARD SLAB-FULL
					__                           SLAB-NONE
				slabBottom -- : match resolved
					[Just IOTATION-SERIF-ALL] : if useItalicShape SLAB-NONE SLAB-OUTWARD
					__                        SLAB-NONE
				swRef      -- swRef
				swSerif    -- swSerif
				fForceSymmetric -- true

		# Used for Bulgarian Lower Yu
		export : define [ascender] : with-params [df top hBarRight hBarY [fCapital false] [swRef df.mvs] [swSerif swRef] [serifType nothing]] : begin
			local resolved : ResolvedIotationSerifType serifType
			local useItalicShape : IotationItalicReduce fCapital serifType
			return : new-glyph : Shape
				df         -- df
				top        -- top
				hBarRight  -- hBarRight
				hBarY      -- hBarY
				slabTop    -- : match resolved
					[Just IOTATION-SERIF-NONE] SLAB-NONE
					__                         SLAB-OUTWARD
				slabBottom -- : match resolved
					[Just IOTATION-SERIF-ALL] : if useItalicShape SLAB-NONE SLAB-FULL
					__                        SLAB-NONE
				swRef      -- swRef
				swSerif    -- swSerif

	do "Iotated A"
		glyph-block-import Letter-Latin-Upper-A : AShape AConfig

		foreach { suffix { bodyShape slabKind } } [Object.entries AConfig] : do
			create-glyph "cyrl/AIotated.\(suffix)" : glyph-proc
				define df : include : DivFrame para.advanceScaleM 3.5
				include : df.markSet.capital

				local sw : df.adviceThinnerStroke 2 0.75
				local gap : (df.rightSB - df.leftSB) / 3
				local subDf : DivFrame [Math.min ((df.width - gap) / Width) (0.75 * df.adws)] 2

				local shift : df.width - subDf.width
				local xIotifiedBarRight : df.leftSB + [HSwToV sw]
				local botGap : Math.max (0.08 * (df.rightSB - df.leftSB)) : AdviceStroke 6
				include : difference
					with-transform [ApparentTranslate shift 0]
						AShape.Letter subDf bodyShape slabKind CAP sw
					intersection
						MaskBelow sw
						MaskLeft [mix xIotifiedBarRight [Math.min (subDf.leftSB + shift) (xIotifiedBarRight + botGap)] 0.5]

				include : difference
					Iotation.A df CAP [mix df.leftSB df.rightSB 0.75] (CAP / 2) (fCapital -- true) (swRef -- sw) (serifType -- [IotationSerifFromSelector 'cyrl/Yu'])
					with-transform [ApparentTranslate shift 0]
						AShape.Mask subDf bodyShape CAP sw

	do "Iotated a"
		glyph-block-import Letter-Latin-Lower-A : DoubleStorey DoubleStoreyConfig SingleStorey SingleStoreyConfig

		foreach { suffix { body xTrailing hookStyle } } [Object.entries DoubleStoreyConfig] : do
			create-glyph "cyrl/aIotated.\(suffix)" : glyph-proc
				define df : include : DivFrame para.advanceScaleM 3
				include : df.markSet.e

				local sw : df.adviceThinnerStroke2 2 3 XH 0.75
				local gap : 0.375 * (df.rightSB - df.leftSB) - [HSwToV : 0.25 * sw] + sw / 16
				local subDf : DivFrame [Math.min ((df.width - gap) / Width) (0.75 * df.adws)] 2

				local shift : df.width - subDf.width
				include : with-transform [ApparentTranslate shift 0]
					body subDf hookStyle sw

				include : difference
					Iotation.full df XH [mix df.leftSB df.rightSB 0.75] (XH / 2) (swRef -- sw) (swSerif -- subDf.mvs) (serifType -- [IotationSerifFromSelector 'cyrl/yu'])
					with-transform [ApparentTranslate shift 0]
						DoubleStorey.Mask body df sw

		foreach { suffix { body bar } } [Object.entries SingleStoreyConfig] : do
			create-glyph "cyrl/aIotated.\(suffix)" : glyph-proc
				define df : include : DivFrame para.advanceScaleM 3
				include : df.markSet.e

				local sw : df.adviceThinnerStroke 2 0.75
				local gap : 0.375 * (df.rightSB - df.leftSB) - [HSwToV : 0.25 * sw] + sw / 16
				local subDf : DivFrame [Math.min ((df.width - gap) / Width) (0.75 * df.adws)] 2

				local shift : df.width - subDf.width
				include : with-transform [ApparentTranslate shift 0]
					body subDf XH bar sw

				include : Iotation.full df XH (((subDf.leftSB + OX) + [HSwToV : 0.5 * sw]) + shift) (XH / 2) (swRef -- sw) (swSerif -- subDf.mvs) (serifType -- [IotationSerifFromSelector 'cyrl/yu'])

	do "Iotated e"
		glyph-block-import Letter-Latin-C : CLetterForm CConfig

		foreach { suffix { styTop styBot } } [Object.entries CConfig] : do
			define [IotatedEShape fCapital fMidSerif df top ada adb] : glyph-proc
				local sw : df.adviceThinnerStroke2 2 3 top 0.75
				local gap : 0.375 * (df.rightSB - df.leftSB) - [HSwToV : 0.25 * sw] + sw / 16
				local subDf : DivFrame [Math.min ((df.width - gap) / Width) (0.75 * df.adws)] 2

				local lf : CLetterForm subDf styTop styBot top 0
					ada -- (ada * 0.75 * df.adws)
					adb -- (adb * 0.75 * df.adws)
					sw  -- sw

				local shift : df.width - subDf.width
				include : with-transform [ApparentTranslate shift 0] : lf.full

				local xMidBarRight : [if (fMidSerif && !fCapital) subDf.middle : mix subDf.rightSB subDf.leftSB 0.35] + shift
				include : Iotation.full df top
					hBarRight -- xMidBarRight
					hBarY     -- (top / 2)
					fCapital  -- fCapital
					swRef     -- sw
					serifType -- [IotationSerifFromSelector : if fCapital 'cyrl/Yu' 'cyrl/yu']

				if fMidSerif : begin
					local { jutTop jutBot jutMid } : EFVJutLength top 0 0.5 sw
						if fCapital Hook nothing
						if fCapital Hook nothing
					local swVJut : Math.min (VJutStroke * (sw / Stroke))
						VSwToH : [if fCapital 0.800 0.625] * ([if fCapital xMidBarRight : (subDf.rightSB - [HSwToV sw]) + shift] - ((subDf.leftSB + [HSwToV sw]) + shift))
					include : VSerif.mr (xMidBarRight + [if fCapital 0 : HSwToV : 0.5 * swVJut]) (top / 2) jutMid swVJut

			create-glyph "cyrl/EIotated.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleM 3
				include : df.markSet.capital
				include : IotatedEShape true false df CAP ArchDepthA ArchDepthB
			create-glyph "cyrl/EIotated.\(suffix)Capped" : glyph-proc
				local df : include : DivFrame para.advanceScaleM 3
				include : df.markSet.capital
				include : IotatedEShape true true df CAP ArchDepthA ArchDepthB

			create-glyph "cyrl/eIotated.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleM 3
				include : df.markSet.e
				include : IotatedEShape false false df XH SmallArchDepthA SmallArchDepthB
			create-glyph "cyrl/eIotated.\(suffix)Capped" : glyph-proc
				local df : include : DivFrame para.advanceScaleM 3
				include : df.markSet.e
				include : IotatedEShape false true df XH SmallArchDepthA SmallArchDepthB

	do "Latin iotated e"
		glyph-block-import Letter-Latin-Lower-E : SmallEConfig

		foreach { suffix { body revbody } } [Object.entries SmallEConfig] : do
			create-glyph "latn/eIotated.\(suffix)" : glyph-proc
				define df : include : DivFrame para.advanceScaleM 3
				include : df.markSet.e

				local sw : df.adviceThinnerStroke2 2 3 XH 0.75
				local gap : 0.375 * (df.rightSB - df.leftSB) - [HSwToV : 0.25 * sw] + sw / 16
				local subDf : DivFrame [Math.min ((df.width - gap) / Width) (0.75 * df.adws)] 2

				local shift : df.width - subDf.width
				include : with-transform [ApparentTranslate shift 0]
					body subDf XH
						stroke -- sw
						hook   -- AHook
						ada    -- (SmallArchDepthA * 0.75 * df.adws)
						adb    -- (SmallArchDepthB * 0.75 * df.adws)

				include : Iotation.full df XH (((subDf.leftSB + OX) + [HSwToV : 0.5 * sw]) + shift) (XH / 2) (swRef -- sw) (serifType -- [IotationSerifFromSelector 'cyrl/yu'])

	select-variant 'cyrl/AIotated' 0xA656 (follow -- 'A')
	select-variant 'cyrl/aIotated' 0xA657 (follow -- 'cyrl/a')
	select-variant 'cyrl/EIotated' 0x464  (follow -- 'cyrl/YeUkrainian')
	select-variant 'cyrl/eIotated' 0x465  (follow -- 'cyrl/yeUkrainian')
	select-variant 'latn/eIotated' 0xAB61 (follow -- 'e')
