$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from '@iosevka/util'

glyph-module

glyph-block Letter-Cyrillic-Yery : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared-Shapes : RightwardTailedBar
	glyph-block-import Letter-Cyrillic-Yeri : YeriConfig
	glyph-block-import Letter-Cyrillic-Yer : CyrYerShape

	define [CyrYeryShape fBackYer] : function [Yeri df top fTailed iSerif] : glyph-proc
		local stroke : if fBackYer
			df.adviceThinnerStroke2 2.75 3 top (7 / 9)
			df.adviceThinnerStroke2 2.00 3 top (3 / 4)
		local jut : Jut - [HSwToV : 0.5 * (Stroke - stroke)]

		local xMiddleSym : mix 0 df.width : if fBackYer (5 / 9) (1 / 2)
		local xMiddle : Math.min
			df.leftSB + ([mix Width df.width : if fBackYer (1 / 3) 0] - SB * 2)
			mix (xMiddleSym + [HSwToV : 0.5 * stroke]) (df.rightSB - [HSwToV stroke]) 0.25

		include : if fBackYer
			CyrYerShape Yeri top
				left   -- df.leftSB
				right  -- xMiddle
				stroke -- stroke
				jut    -- jut
			Yeri top
				left   -- df.leftSB
				right  -- xMiddle
				stroke -- stroke
				jut    -- jut

		include : if fTailed
			RightwardTailedBar df.rightSB 0 top stroke
			VBar.r             df.rightSB 0 top stroke

		local motionI : (iSerif === 'tr') || (iSerif === 'bilateral') || (iSerif === 'explicitTr')
		local explicitI : (iSerif === 'none') || (iSerif === 'bottom') || (iSerif === 'explicitTr') || (iSerif === 'full')
		local doITop : if explicitI
			(iSerif === 'explicitTr') || (iSerif === 'full')
			motionI || (SLAB && Yeri.useFullSerifs)
		local doIBot : [not fTailed] && [if explicitI ((iSerif === 'bottom') || (iSerif === 'full')) ([not motionI] && SLAB)]
		if doITop : include : tagged 'serifRT' : if motionI
			HSerif.lt (df.rightSB - [HSwToV stroke]) top (jut - [HSwToV : 0.5 * stroke]) stroke
			HSerif.mt (df.rightSB - [HSwToV : 0.5 * stroke]) top jut stroke
		if doIBot : include : tagged 'serifRB' : if (iSerif === 'full' || (!explicitI && Yeri.useFullSerifs))
			HSerif.mb (df.rightSB - [HSwToV : 0.5 * stroke]) 0 jut stroke
			HSerif.rb df.rightSB 0 (jut - [HSwToV : 0.5 * stroke]) stroke
		if ((iSerif === 'bilateral') && [not SLAB]) : include : tagged 'serifYeriLT'
			HSerif.lt df.leftSB top (jut - [HSwToV : 0.5 * stroke]) stroke

	define YeryBodies : Object.fromEntries : [Object.entries YeriConfig].map : lambda [entry] : begin
		return {entry.0 {entry.1.0 entry.1.1}}
	define YeryConfig : SuffixCfg.weave
		begin YeryBodies
		object # Tail
			''            false
			tailed        true
		object # I-stem serifs
			''                      'auto'
			topRightMotionSerifed    'tr'
			bilateralMotionSerifed   'bilateral'
			iSerifless               'none'
			iBottomRightSerifed      'bottom'
			iTopRightMotionSerifed   'explicitTr'
			iSerifed                 'full'

	foreach {suffix {{Uc Lc} fTailed iSerif}} [Object.entries YeryConfig] : do
		if [not fTailed] : begin
			create-glyph "cyrl/Yery.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleM 3
				include : df.markSet.capital
				include : [CyrYeryShape false] Uc df CAP fTailed iSerif
			create-glyph "cyrl/YeryBack.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleMM 3
				include : df.markSet.capital
				include : [CyrYeryShape true] Uc df CAP fTailed iSerif

		create-glyph "cyrl/yery.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleM 3
			include : df.markSet.e
			include : [CyrYeryShape false] Lc df XH fTailed iSerif
		create-glyph "cyrl/yeryBack.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleMM 3
			include : df.markSet.e
			include : [CyrYeryShape true] Lc df XH fTailed iSerif

	select-variant 'cyrl/Yery'     0x42B
	select-variant 'cyrl/YeryBack' 0xA650

	select-variant 'cyrl/yery'     0x44B
	select-variant 'cyrl/yeryBack' 0xA651
