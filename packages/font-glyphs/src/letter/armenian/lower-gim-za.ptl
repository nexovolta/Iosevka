$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from "@iosevka/util"
import [DependentSelector] from "@iosevka/glyph/relation"

glyph-module

glyph-block Letter-Armenian-Lower-Gim-Za : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Armenian-Shared-Shapes : ArmenianSerifConfig
	glyph-block-import Letter-Shared-Shapes : OBarRight SerifFrame
	glyph-block-import Letter-Armenian-Shared-Shapes : ArmHBar

	do "Gim"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/gim.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.p
				include : OBarRight.shape
					top   -- XH
					bot   -- 0
					left  -- df.leftSB
					right -- df.rightSB
					sw    -- df.mvs
					fine  -- df.shoulderFine
					ada   -- SmallArchDepthA
					adb   -- SmallArchDepthB
				include : VBar.r df.rightSB Descender XH df.mvs
				include : [ArmHBar.right df fSerif].base
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH Descender
					include : if para.isItalic sf.rb.outer
						composite-proc sf.rt.outer sf.rb.fullSide
		local gimPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topRightMotion 1
			object
				"" 0
				bottomRightMotion 1
				bottomRightFull 2
		foreach { suffix { p0 p1 } } [Object.entries gimPositionedSerifs] : do
			if (p0 || p1) : create-glyph "armn/gim.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/gim.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df XH Descender
				if p0 : include sf.rt.outer
				if p1 : include : if (p1 === 1) sf.rb.outer sf.rb.fullSide
		select-variant 'armn/gim' 0x563

	do "Za"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/za.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.p
				include : OBarRight.shape
					top   -- XH
					bot   -- 0
					left  -- df.leftSB
					right -- df.rightSB
					sw    -- df.mvs
					fine  -- df.shoulderFine
					ada   -- SmallArchDepthA
					adb   -- SmallArchDepthB
				include : VBar.r df.rightSB Descender XH df.mvs
				include : [ArmHBar.right df (fSerif || (SLAB && para.isItalic))].desc
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH Descender
					include sf.rt.outer
		local zaPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topRightMotion 1
		foreach { suffix { p0 } } [Object.entries zaPositionedSerifs] : do
			if (p0) : create-glyph "armn/za.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/za.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df XH Descender
				if p0 : include sf.rt.outer
		select-variant 'armn/za' 0x566
