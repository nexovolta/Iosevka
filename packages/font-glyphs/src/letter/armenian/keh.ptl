$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from '@iosevka/util'
import [DependentSelector] from '@iosevka/glyph/relation'

glyph-module

glyph-block Letter-Armenian-Keh : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Armenian-Shared-Shapes : ArmenianSerifConfig
	glyph-block-import Letter-Shared-Shapes : OBarLeft SerifFrame

	# Common Params
	define barPos : XH / 2
	define highBarPos XH
	define jut Jut

	do "K'eh"
		foreach {suffix fSerif} [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Keh.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.capital
				local barSw : OverlayStroke * (df.mvs / Stroke)
				local oBot : CAP * HBarPos - df.mvs / 2
				include : OBarLeft.earlessRounded
					top   -- CAP
					bot   -- oBot
					left  -- df.leftSB
					right -- df.rightSB
					sw    -- df.mvs
					fine  -- df.shoulderFine
					ada   -- ArchDepthA
					adb   -- ArchDepthB
					yTerminal -- 0
				include : HBar.m (df.leftSB + [HSwToV : 0.5 * df.mvs] - jut) df.rightSB
					mix [if fSerif df.mvs 0] oBot 0.5
					Math.min barSw : 0.5 * (oBot - [if fSerif df.mvs 0])
				if fSerif : begin
					local sf : SerifFrame.fromDf df CAP 0
					include sf.lb.full
		local KehPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				bottomLeftMotion 1
				bottomLeftFull 2
		foreach {suffix {p0}} [Object.entries KehPositionedSerifs] : do
			if (p0) : create-glyph "armn/Keh.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Keh.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df CAP 0
				if p0 : include : if (p0 === 1) sf.lb.outer sf.lb.full
		select-variant 'armn/Keh' 0x554

		foreach {suffix fSerif} [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/keh.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.p
				local barSw : OverlayStroke * (df.mvs / Stroke)
				local oBot : Math.max (0.1 * (XH - Descender)) (barSw + 0.5 * df.mvs)
				include : OBarLeft.shape
					top   -- XH
					bot   -- oBot
					left  -- df.leftSB
					right -- df.rightSB
					sw    -- df.mvs
					fine  -- df.shoulderFine
					ada   -- SmallArchDepthA
					adb   -- SmallArchDepthB
				include : VBar.l df.leftSB Descender XH df.mvs
				include : HBar.b (df.leftSB + [HSwToV : 0.5 * df.mvs] - jut) df.rightSB 0 barSw
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH Descender
					include sf.lt.outer
					if [not para.isItalic] : include sf.lb.fullSide
		local kehPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				topLeftMotion 1
			object
				'' 0
				bottomLeftMotion 1
				bottomLeftFull 2
		foreach {suffix {p0 p1}} [Object.entries kehPositionedSerifs] : do
			if (p0 || p1) : create-glyph "armn/keh.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/keh.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df XH Descender
				if p0 : include sf.lt.outer
				if p1 : include : if (p1 === 1) sf.lb.outer sf.lb.fullSide
		select-variant 'armn/keh' 0x584
