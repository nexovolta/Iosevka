$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from '@iosevka/util'
import [DependentSelector] from '@iosevka/glyph/relation'

glyph-module

glyph-block Letter-Armenian-Eh-Liun-Hiun : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Armenian-Shared-Shapes : ArmenianSerifConfig
	glyph-block-import Letter-Shared-Shapes : SerifFrame
	glyph-block-import Letter-Armenian-Shared-Shapes : ArmHBar

	# Common Params
	define barPos : XH / 2
	define highBarPos XH
	define jut Jut

	do 'Eh'
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Eh.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.capital
				include : VBar.l df.leftSB 0 CAP df.mvs
				include : [ArmHBar.normal : DivFrame (5 / 6)].base
				include : [ArmHBar.normal df].high
				if fSerif : begin
					local sf : SerifFrame.fromDf df CAP 0
					include : composite-proc sf.lt.full sf.lb.outer
		local EhPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				topLeftMotion 1
				topLeftFull 2
			object
				'' 0
				bottomLeftMotion 1
		foreach { suffix { p0 p1 } } [Object.entries EhPositionedSerifs] : do
			if (p0 || p1) : create-glyph "armn/Eh.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Eh.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df CAP 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include sf.lb.outer
		select-variant 'armn/Eh' 0x537

		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/eh.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.b
				include : VBar.l df.leftSB 0 Ascender df.mvs
				include : [ArmHBar.normal : DivFrame (5 / 6)].base
				include : [ArmHBar.normal df].high
				if fSerif : begin
					local sf : SerifFrame.fromDf df Ascender 0
					include sf.lt.outer
					if [not para.isItalic] : include sf.lb.outer
		local ehPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				topLeftMotion 1
				topLeftFull 2
			object
				'' 0
				bottomLeftMotion 1
		foreach { suffix { p0 p1 } } [Object.entries ehPositionedSerifs] : do
			if (p0 || p1) : create-glyph "armn/eh.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/eh.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df Ascender 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include sf.lb.outer
		select-variant 'armn/eh' 0x567

	do 'Liun'
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Liun.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleF
				include : df.markSet.capital
				include : VBar.l df.leftSB 0 CAP df.mvs
				include : [ArmHBar.normal df].base
				if fSerif : begin
					local sf : SerifFrame.fromDf df CAP 0
					include : composite-proc sf.lt.full sf.lb.outer
		local LiunPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				topLeftMotion 1
				topLeftFull 2
			object
				'' 0
				bottomLeftMotion 1
		foreach { suffix { p0 p1 } } [Object.entries LiunPositionedSerifs] : do
			if (p0 || p1) : create-glyph "armn/Liun.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Liun.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame para.advanceScaleF
				local sf : SerifFrame.fromDf df CAP 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include sf.lb.outer
		select-variant 'armn/Liun' 0x53C

		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/liun.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleII
				include : df.markSet.p
				local xMiddle : df.middle - [IBalance2 df]
				local longJut : if (df.adws < 1) (jut * [if fSerif 1.5 1]) LongJut
				include : VBar.m xMiddle Descender XH df.mvs
				include : HBar.b xMiddle (xMiddle + longJut) Descender df.mvs
				if fSerif : include : HSerif.lt xMiddle XH Jut df.mvs
		local liunPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				topCenterFull 2
		foreach { suffix { p0 } } [Object.entries liunPositionedSerifs] : do
			if (p0) : create-glyph "armn/liun.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/liun.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame para.advanceScaleII
				local xMiddle : df.middle - [IBalance2 df]
				if p0 : include : HSerif.mt xMiddle XH Jut df.mvs
		select-variant 'armn/liun' 0x56C

	do 'Hiun'
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Hiun.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.capital
				include : VBar.l df.leftSB 0 CAP df.mvs
				include : [ArmHBar.normal df].high
				if fSerif : begin
					local sf : SerifFrame.fromDf df CAP 0
					include : composite-proc sf.lt.full sf.lb.full
		local HiunPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				topLeftMotion 1
				topLeftFull 2
			object
				'' 0
				bottomLeftMotion 1
				bottomLeftFull 2
		foreach { suffix { p0 p1 } } [Object.entries HiunPositionedSerifs] : do
			if (p0 || p1) : create-glyph "armn/Hiun.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Hiun.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df CAP 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include : if (p1 === 1) sf.lb.outer sf.lb.full
		select-variant 'armn/Hiun' 0x552

		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/hiun.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleF
				include : VBar.l df.leftSB 0 XH df.mvs
				include : [ArmHBar.normal df].base
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					include sf.lt.outer
					if [not para.isItalic] : begin
						include sf.lb.full
		local hiunPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				topLeftMotion 1
				topLeftFull 2
			object
				'' 0
				bottomLeftMotion 1
		foreach { suffix { p0 p1 } } [Object.entries hiunPositionedSerifs] : do
			if (p0 || p1) : create-glyph "armn/hiun.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/hiun.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame para.advanceScaleF
				local sf : SerifFrame.fromDf df XH 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include sf.lb.outer
		select-variant 'armn/hiun' 0x582
