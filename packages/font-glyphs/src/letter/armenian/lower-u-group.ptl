$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [DependentSelector] from "@iosevka/glyph/relation"

glyph-module

glyph-block Letter-Armenian-Lower-U-Group : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Armenian-Shared-Shapes : ArmenianSerifConfig
	glyph-block-import Letter-Shared-Shapes : nShoulder uBowl SerifFrame
	glyph-block-import Letter-Armenian-Shared-Shapes : ArmHBar
	glyph-block-import Letter-Latin-Lower-M : SmallMArches

	# Common Params
	define barPos : XH / 2
	define highBarPos XH
	define jut Jut

	do "Turned Ayb"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/turnayb.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleMM 3
				include : df.markSet.e
				include : SmallMArches df XH 0 0 0
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					include sf.lt.outer
					include : if para.isItalic sf.rb.outer : if sf.enoughSpaceForFullSerifs
						composite-proc sf.lb.full sf.mb.full sf.rb.full
						composite-proc sf.lb.outer sf.rb.outer
		select-variant 'armn/turnayb' 0x560

	do "Ayb"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ayb.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleMM 3
				include : df.markSet.e
				include : SmallMArches df XH 0 0 0
				include : FlipAround df.middle (XH / 2)
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					include : composite-proc sf.lt.outer sf.rb.outer
					if ([not para.isItalic] && sf.enoughSpaceForFullSerifs) : begin
						include : composite-proc sf.mt.left sf.rt.inner
		select-variant 'armn/ayb' 0x561

	do "Ben"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ben.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.p
				include : VBar.l df.leftSB Descender XH df.mvs
				local barPosB : barPos - df.mvs / 2
				include : nShoulder.shape
					top    -- XH
					bottom -- barPosB
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : [ArmHBar.normal df].base
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH Descender
					include sf.lt.outer
					if [not para.isItalic] : include sf.lb.fullSide
		select-variant 'armn/ben' 0x562

	do "Da"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/da.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.p
				include : VBar.l df.leftSB 0 XH df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- Descender
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : [ArmHBar.right df fSerif].base
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					local sf2 : SerifFrame.fromDf df XH Descender
					include sf.lt.outer
					include : if para.isItalic sf2.rb.outer
						composite-proc sf.lb.full sf2.rb.fullSide
		select-variant 'armn/da' 0x564

	do "Ech"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ech.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.b
				local barPosT : barPos + df.mvs / 2
				include : uBowl.shape
					top    -- Ascender
					bottom -- 0
					left   -- df.leftSB
					right  -- (df.rightSB - [HSwToV df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : VBar.r df.rightSB 0 barPosT df.mvs
				include : [ArmHBar.normal df].high
				if fSerif : begin
					local sf : SerifFrame.fromDf df Ascender 0
					include : composite-proc sf.lt.outer sf.rb.outer
		select-variant 'armn/ech' 0x565

	do "Et"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/et.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.b
				include : VBar.l df.leftSB Descender XH df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- 0
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : [ArmHBar.normal df].desc
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH Descender
					local sf2 : SerifFrame.fromDf df XH 0
					include : composite-proc sf.lt.outer
						if para.isItalic sf2.rb.outer sf2.rb.full
		select-variant 'armn/et' 0x568

	do "Ini"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ini.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.bp
				include : VBar.l df.leftSB Descender Ascender df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- 0
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				if fSerif : begin
					local sf : SerifFrame.fromDf df Ascender Descender
					local sf2 : SerifFrame.fromDf df XH 0
					include sf.lt.outer
					include : if para.isItalic sf2.rb.outer
						composite-proc sf.lb.fullSide sf2.rb.full
		select-variant 'armn/ini' 0x56B

	do "Xeh"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/xeh.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleMM 3
				include : df.markSet.bp
				local subDf : df.slice 3 2
				include : VBar.l df.leftSB Descender Ascender df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- (XH / 2 - TINY)
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- (df.middle + [HSwToV : 0.5 * df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
					ada    -- subDf.smallArchDepthA
					adb    -- subDf.smallArchDepthB
				include : uBowl.shape
					top    -- (XH / 2 + TINY)
					bottom -- 0
					left   -- (df.middle - [HSwToV : 0.5 * df.mvs])
					right  -- (df.rightSB - [HSwToV df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
					ada    -- subDf.smallArchDepthA
					adb    -- subDf.smallArchDepthB
				include : VBar.r df.rightSB 0 XH df.mvs
				if fSerif : begin
					local sf : SerifFrame.fromDf df Ascender Descender
					local sf2 : SerifFrame.fromDf df XH 0
					include : composite-proc sf.lt.outer sf2.rb.outer
					if [not para.isItalic] : begin
						include : composite-proc sf.lb.fullSide sf2.rt.inner
		select-variant 'armn/xeh' 0x56D

	do "Ken"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ken.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.bp
				include : uBowl.shape
					top    -- Ascender
					bottom -- 0
					left   -- df.leftSB
					right  -- (df.rightSB - [HSwToV df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : VBar.r df.rightSB Descender XH df.mvs
				if fSerif : begin
					local sf : SerifFrame.fromDf df Ascender 0
					local sf2 : SerifFrame.fromDf df XH Descender
					include sf.lt.outer
					include : if para.isItalic sf2.rb.outer
						composite-proc sf2.rt.inner sf2.rb.fullSide
		select-variant 'armn/ken' 0x56F

	do "Ho"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ho.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.b
				include : VBar.l df.leftSB 0 Ascender df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- 0
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				if fSerif : begin
					local sf : SerifFrame.fromDf df Ascender 0
					include sf.lt.outer
					include : if para.isItalic sf.rb.outer
						composite-proc sf.lb.full sf.rb.full
		select-variant 'armn/ho' 0x570

	do "Ghat"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ghat.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.p
				include : VBar.l df.leftSB 0 XH df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- Descender
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : [ArmHBar.right df fSerif].desc
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					include sf.lt.outer
					if [not para.isItalic] : include sf.lb.full
		select-variant 'armn/ghat' 0x572

	do "Men"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/men.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.b
				include : uBowl.shape
					top    -- XH
					bottom -- 0
					left   -- df.leftSB
					right  -- (df.rightSB - [HSwToV df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : VBar.r df.rightSB 0 Ascender df.mvs
				include : [ArmHBar.right df fSerif].asc
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					local sf2 : SerifFrame.fromDf df Ascender 0
					include : composite-proc sf.lt.outer sf2.rb.outer
		select-variant 'armn/men' 0x574

	do "Nu"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/nu.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.b
				include : uBowl.shape
					top    -- Ascender
					bottom -- 0
					left   -- df.leftSB
					right  -- (df.rightSB - [HSwToV df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : VBar.r df.rightSB 0 XH df.mvs
				include : [ArmHBar.left df fSerif].asc
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					include sf.rb.outer
					if [not para.isItalic] : include sf.rt.inner
		select-variant 'armn/nu' 0x576

	do "Vo"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/vo.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.e
				include : VBar.l df.leftSB 0 XH df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- 0
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					include sf.lt.outer
					include : if para.isItalic sf.rb.outer
						composite-proc sf.lb.full sf.rb.full
		select-variant 'armn/vo' 0x578

	do "Peh"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/peh.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleMM 3
				include : df.markSet.p
				include : SmallMArches df XH 0 0 0
				include : FlipAround df.middle (XH / 2)
				include : VBar.r df.rightSB Descender XH df.mvs
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH Descender
					include : composite-proc sf.lt.outer
						if para.isItalic sf.rb.outer sf.rb.fullSide
					if ([not para.isItalic] && sf.enoughSpaceForFullSerifs) : begin
						include : composite-proc sf.mt.left sf.rt.inner
		select-variant 'armn/peh' 0x57A

	do "Seh"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/seh.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.e
				include : uBowl.shape
					top    -- XH
					bottom -- 0
					left   -- df.leftSB
					right  -- (df.rightSB - [HSwToV df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : VBar.r df.rightSB 0 XH df.mvs
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					include : composite-proc sf.lt.outer sf.rb.outer
					if [not para.isItalic] : include sf.rt.inner
		select-variant 'armn/seh' 0x57D

	do "Vew"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/vew.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.bp
				include : uBowl.shape
					top    -- XH
					bottom -- 0
					left   -- df.leftSB
					right  -- (df.rightSB - [HSwToV df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : VBar.r df.rightSB Descender Ascender df.mvs
				include : [ArmHBar.right df fSerif].desc
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					local sf2 : SerifFrame.fromDf df Ascender Descender
					include : composite-proc sf.lt.outer sf2.rt.inner
		select-variant 'armn/vew' 0x57E

	do "Tiun"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/tiun.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleMM 3
				include : df.markSet.e
				local subDf : df.slice 3 2
				include : uBowl.shape
					top    -- XH
					bottom -- 0
					left   -- df.leftSB
					right  -- (df.middle - [HSwToV : 0.5 * df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
					ada    -- subDf.smallArchDepthA
					adb    -- subDf.smallArchDepthB
				include : VBar.m df.middle 0 XH df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- 0
					left   -- (df.middle + [HSwToV : 0.5 * df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
					ada    -- subDf.smallArchDepthA
					adb    -- subDf.smallArchDepthB
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					include sf.lt.outer
					include : if (para.isItalic || [not sf.enoughSpaceForFullSerifs]) sf.rb.outer
						composite-proc sf.mt.left sf.mb.right sf.rb.full
		select-variant 'armn/tiun' 0x57F

	do "Reh"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/reh.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.b
				include : VBar.l df.leftSB Descender XH df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- 0
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH Descender
					local sf2 : SerifFrame.fromDf df XH 0
					include sf.lt.outer
					include : if para.isItalic sf2.rb.outer
						composite-proc sf.lb.fullSide sf2.rb.full
		select-variant 'armn/reh' 0x580

	do "P'iur"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/piur.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleMM 3
				include : df.markSet.bp
				local subDf : df.slice 3 2
				include : uBowl.shape
					top    -- XH
					bottom -- 0
					left   -- df.leftSB
					right  -- (df.middle - [HSwToV : 0.5 * df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
					ada    -- subDf.smallArchDepthA
					adb    -- subDf.smallArchDepthB
				include : VBar.m df.middle Descender Ascender df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- 0
					left   -- (df.middle + [HSwToV : 0.5 * df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
					ada    -- subDf.smallArchDepthA
					adb    -- subDf.smallArchDepthB
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					local sf2 : SerifFrame.fromDf df Ascender Descender
					include : composite-proc sf.lt.outer sf2.mt.left
						if (para.isItalic || [not sf.enoughSpaceForFullSerifs]) sf.rb.outer sf.rb.full
					if [not para.isItalic] : include sf2.mb.fullCenter
		select-variant 'armn/piur' 0x583

	do "Ew"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ew.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleM 1
				include : df.markSet.b
				local subDf : DivFrame (0.75 * para.advanceScaleM) 2
				include : uBowl.shape
					top    -- Ascender
					bottom -- 0
					left   -- subDf.leftSB
					right  -- (subDf.rightSB - [HSwToV subDf.mvs])
					stroke -- subDf.mvs
					fine   -- subDf.shoulderFine
					ada    -- subDf.smallArchDepthA
					adb    -- subDf.smallArchDepthB
				include : VBar.r subDf.rightSB 0 XH subDf.mvs
				include : HBar.b (subDf.rightSB - [HSwToV : 0.5 * subDf.mvs]) df.rightSB 0 subDf.mvs
				if fSerif : begin
					local sf : SerifFrame.fromDf subDf Ascender 0
					include sf.lt.outer
					if [not para.isItalic] : begin
						local sf2 : SerifFrame.fromDf subDf XH 0
						include sf2.rt.inner
		select-variant 'armn/ew' 0x587
