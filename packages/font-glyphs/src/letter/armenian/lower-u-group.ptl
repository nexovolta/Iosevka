$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from "@iosevka/util"
import [DependentSelector] from "@iosevka/glyph/relation"

glyph-module

glyph-block Letter-Armenian-Lower-U-Group : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Armenian-Shared-Shapes : ArmenianSerifConfig
	glyph-block-import Letter-Shared-Shapes : nShoulder uBowl SerifFrame
	glyph-block-import Letter-Shared : CreateTurnedLetter
	glyph-block-import Letter-Armenian-Shared-Shapes : ArmHBar
	glyph-block-import Letter-Latin-Lower-M : SmallMArches

	# Common Params
	define barPos : XH / 2
	define highBarPos XH
	define jut Jut

	do "Ayb"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ayb.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleMM 3
				include : df.markSet.e
				include : SmallMArches df XH 0 0 0
				include : FlipAround df.middle (XH / 2)
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					include : composite-proc sf.lt.outer sf.rb.outer
					if ([not para.isItalic] && sf.enoughSpaceForFullSerifs) : begin
						include : composite-proc sf.mt.left sf.rt.inner
		local aybPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topLeftMotion 1
				topLeftFull 2
			object
				"" 0
				topCenterFull 2
			object
				"" 0
				topRightMotion 1
				topRightFull 2
			object
				"" 0
				bottomRightMotion 1
		foreach { suffix { p0 p1 p2 p3 } } [Object.entries aybPositionedSerifs] : do
			if (p0 || p1 || p2 || p3) : create-glyph "armn/ayb.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/ayb.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame para.advanceScaleMM 3
				local sf : SerifFrame.fromDf df XH 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include sf.mt.full
				if p2 : include : if (p2 === 1) sf.rt.outer sf.rt.full
				if p3 : include sf.rb.outer
		select-variant 'armn/ayb' 0x561
		CreateTurnedLetter 'armn/turnayb' 0x560 'armn/ayb' HalfAdvance (XH / 2)

	do "Ben"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ben.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.p
				include : VBar.l df.leftSB Descender XH df.mvs
				local barPosB : barPos - df.mvs / 2
				include : nShoulder.shape
					top    -- XH
					bottom -- barPosB
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : [ArmHBar.normal df].base
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH Descender
					include sf.lt.outer
					if [not para.isItalic] : include sf.lb.fullSide
		local benPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topLeftMotion 1
			object
				"" 0
				bottomLeftMotion 1
				bottomLeftFull 2
		foreach { suffix { p0 p1 } } [Object.entries benPositionedSerifs] : do
			if (p0 || p1) : create-glyph "armn/ben.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/ben.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df XH Descender
				if p0 : include sf.lt.outer
				if p1 : include : if (p1 === 1) sf.lb.outer sf.lb.fullSide
		select-variant 'armn/ben' 0x562

	do "Da"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/da.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.p
				include : VBar.l df.leftSB 0 XH df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- Descender
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : [ArmHBar.right df fSerif].base
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					local sf2 : SerifFrame.fromDf df XH Descender
					include sf.lt.outer
					include : if para.isItalic sf2.rb.outer
						composite-proc sf.lb.full sf2.rb.fullSide
		local daPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topLeftMotion 1
			object
				"" 0
				bottomLeftMotion 1
				bottomLeftFull 2
			object
				"" 0
				bottomRightMotion 1
				bottomRightFull 2
		foreach { suffix { p0 p1 p2 } } [Object.entries daPositionedSerifs] : do
			if (p0 || p1 || p2) : create-glyph "armn/da.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/da.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df XH 0
				local sf2 : SerifFrame.fromDf df XH Descender
				if p0 : include sf.lt.outer
				if p1 : include : if (p1 === 1) sf.lb.outer sf.lb.full
				if p2 : include : if (p2 === 1) sf2.rb.outer sf2.rb.fullSide
		select-variant 'armn/da' 0x564

	do "Ech"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ech.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.b
				local barPosT : barPos + df.mvs / 2
				include : uBowl.shape
					top    -- Ascender
					bottom -- 0
					left   -- df.leftSB
					right  -- (df.rightSB - [HSwToV df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : VBar.r df.rightSB 0 barPosT df.mvs
				include : [ArmHBar.normal df].high
				if fSerif : begin
					local sf : SerifFrame.fromDf df Ascender 0
					include : composite-proc sf.lt.outer sf.rb.outer
		local echPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topLeftMotion 1
				topLeftFull 2
			object
				"" 0
				bottomRightMotion 1
		foreach { suffix { p0 p1 } } [Object.entries echPositionedSerifs] : do
			if (p0 || p1) : create-glyph "armn/ech.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/ech.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df Ascender 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include sf.rb.outer
		select-variant 'armn/ech' 0x565

	do "Et"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/et.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.b
				include : VBar.l df.leftSB Descender XH df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- 0
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : [ArmHBar.normal df].desc
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH Descender
					local sf2 : SerifFrame.fromDf df XH 0
					include : composite-proc sf.lt.outer
						if para.isItalic sf2.rb.outer sf2.rb.full
		local etPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topLeftMotion 1
			object
				"" 0
				bottomRightMotion 1
				bottomRightFull 2
		foreach { suffix { p0 p1 } } [Object.entries etPositionedSerifs] : do
			if (p0 || p1) : create-glyph "armn/et.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/et.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df XH Descender
				local sf2 : SerifFrame.fromDf df XH 0
				if p0 : include sf.lt.outer
				if p1 : include : if (p1 === 1) sf2.rb.outer sf2.rb.full
		select-variant 'armn/et' 0x568

	do "Ini"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ini.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.bp
				include : VBar.l df.leftSB Descender Ascender df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- 0
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				if fSerif : begin
					local sf : SerifFrame.fromDf df Ascender Descender
					local sf2 : SerifFrame.fromDf df XH 0
					include sf.lt.outer
					include : if para.isItalic sf2.rb.outer
						composite-proc sf.lb.fullSide sf2.rb.full
		local iniPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topLeftMotion 1
				topLeftFull 2
			object
				"" 0
				bottomLeftMotion 1
				bottomLeftFull 2
			object
				"" 0
				bottomRightMotion 1
				bottomRightFull 2
		foreach { suffix { p0 p1 p2 } } [Object.entries iniPositionedSerifs] : do
			if (p0 || p1 || p2) : create-glyph "armn/ini.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/ini.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df Ascender Descender
				local sf2 : SerifFrame.fromDf df XH 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include : if (p1 === 1) sf.lb.outer sf.lb.fullSide
				if p2 : include : if (p2 === 1) sf2.rb.outer sf2.rb.full
		select-variant 'armn/ini' 0x56B

	do "Xeh"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/xeh.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleMM 3
				include : df.markSet.bp
				local subDf : df.slice 3 2
				include : VBar.l df.leftSB Descender Ascender df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- (XH / 2 - TINY)
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- (df.middle + [HSwToV : 0.5 * df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
					ada    -- subDf.smallArchDepthA
					adb    -- subDf.smallArchDepthB
				include : uBowl.shape
					top    -- (XH / 2 + TINY)
					bottom -- 0
					left   -- (df.middle - [HSwToV : 0.5 * df.mvs])
					right  -- (df.rightSB - [HSwToV df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
					ada    -- subDf.smallArchDepthA
					adb    -- subDf.smallArchDepthB
				include : VBar.r df.rightSB 0 XH df.mvs
				if fSerif : begin
					local sf : SerifFrame.fromDf df Ascender Descender
					local sf2 : SerifFrame.fromDf df XH 0
					include : composite-proc sf.lt.outer sf2.rb.outer
					if [not para.isItalic] : begin
						include : composite-proc sf.lb.fullSide sf2.rt.inner
		local xehPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topLeftMotion 1
				topLeftFull 2
			object
				"" 0
				topRightMotion 1
				topRightFull 2
			object
				"" 0
				bottomLeftMotion 1
				bottomLeftFull 2
			object
				"" 0
				bottomRightMotion 1
		foreach { suffix { p0 p1 p2 p3 } } [Object.entries xehPositionedSerifs] : do
			if (p0 || p1 || p2 || p3) : create-glyph "armn/xeh.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/xeh.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame para.advanceScaleMM 3
				local sf : SerifFrame.fromDf df Ascender Descender
				local sf2 : SerifFrame.fromDf df XH 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include : if (p1 === 1) sf2.rt.outer sf2.rt.full
				if p2 : include : if (p2 === 1) sf.lb.outer sf.lb.fullSide
				if p3 : include sf2.rb.outer
		select-variant 'armn/xeh' 0x56D

	do "Ken"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ken.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.bp
				include : uBowl.shape
					top    -- Ascender
					bottom -- 0
					left   -- df.leftSB
					right  -- (df.rightSB - [HSwToV df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : VBar.r df.rightSB Descender XH df.mvs
				if fSerif : begin
					local sf : SerifFrame.fromDf df Ascender 0
					local sf2 : SerifFrame.fromDf df XH Descender
					include sf.lt.outer
					include : if para.isItalic sf2.rb.outer
						composite-proc sf2.rt.inner sf2.rb.fullSide
		local kenPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topLeftMotion 1
				topLeftFull 2
			object
				"" 0
				topRightMotion 1
				topRightFull 2
			object
				"" 0
				bottomRightMotion 1
				bottomRightFull 2
		foreach { suffix { p0 p1 p2 } } [Object.entries kenPositionedSerifs] : do
			if (p0 || p1 || p2) : create-glyph "armn/ken.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/ken.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df Ascender 0
				local sf2 : SerifFrame.fromDf df XH Descender
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include : if (p1 === 1) sf2.rt.outer sf2.rt.full
				if p2 : include : if (p2 === 1) sf2.rb.outer sf2.rb.fullSide
		select-variant 'armn/ken' 0x56F

	do "Ho"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ho.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.b
				include : VBar.l df.leftSB 0 Ascender df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- 0
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				if fSerif : begin
					local sf : SerifFrame.fromDf df Ascender 0
					include sf.lt.outer
					include : if para.isItalic sf.rb.outer
						composite-proc sf.lb.full sf.rb.full
		local hoPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topLeftMotion 1
				topLeftFull 2
			object
				"" 0
				bottomLeftMotion 1
				bottomLeftFull 2
			object
				"" 0
				bottomRightMotion 1
				bottomRightFull 2
		foreach { suffix { p0 p1 p2 } } [Object.entries hoPositionedSerifs] : do
			if (p0 || p1 || p2) : create-glyph "armn/ho.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/ho.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df Ascender 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include : if (p1 === 1) sf.lb.outer sf.lb.full
				if p2 : include : if (p2 === 1) sf.rb.outer sf.rb.full
		select-variant 'armn/ho' 0x570

	do "Ghat"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/ghat.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.p
				include : VBar.l df.leftSB 0 XH df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- Descender
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : [ArmHBar.right df fSerif].desc
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					include sf.lt.outer
					if [not para.isItalic] : include sf.lb.full
		local ghatPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topLeftMotion 1
			object
				"" 0
				bottomLeftMotion 1
				bottomLeftFull 2
		foreach { suffix { p0 p1 } } [Object.entries ghatPositionedSerifs] : do
			if (p0 || p1) : create-glyph "armn/ghat.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/ghat.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df XH 0
				if p0 : include sf.lt.outer
				if p1 : include : if (p1 === 1) sf.lb.outer sf.lb.full
		select-variant 'armn/ghat' 0x572

	do "Men"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/men.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.b
				include : uBowl.shape
					top    -- XH
					bottom -- 0
					left   -- df.leftSB
					right  -- (df.rightSB - [HSwToV df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : VBar.r df.rightSB 0 Ascender df.mvs
				include : [ArmHBar.right df fSerif].asc
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					local sf2 : SerifFrame.fromDf df Ascender 0
					include : composite-proc sf.lt.outer sf2.rb.outer
		local menPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topLeftMotion 1
				topLeftFull 2
			object
				"" 0
				bottomRightMotion 1
		foreach { suffix { p0 p1 } } [Object.entries menPositionedSerifs] : do
			if (p0 || p1) : create-glyph "armn/men.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/men.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df XH 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include sf.rb.outer
		select-variant 'armn/men' 0x574

	do "Nu"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/nu.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.b
				include : uBowl.shape
					top    -- Ascender
					bottom -- 0
					left   -- df.leftSB
					right  -- (df.rightSB - [HSwToV df.mvs])
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : VBar.r df.rightSB 0 XH df.mvs
				include : [ArmHBar.left df fSerif].asc
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					include sf.rb.outer
					if [not para.isItalic] : include sf.rt.inner
		local nuPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topRightMotion 1
				topRightFull 2
			object
				"" 0
				bottomRightMotion 1
		foreach { suffix { p0 p1 } } [Object.entries nuPositionedSerifs] : do
			if (p0 || p1) : create-glyph "armn/nu.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/nu.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df XH 0
				if p0 : include : if (p0 === 1) sf.rt.outer sf.rt.full
				if p1 : include sf.rb.outer
		select-variant 'armn/nu' 0x576

	do "Vo"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/vo.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.e
				include : VBar.l df.leftSB 0 XH df.mvs
				include : nShoulder.shape
					top    -- XH
					bottom -- 0
					left   -- (df.leftSB + [HSwToV df.mvs])
					right  -- df.rightSB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH 0
					include sf.lt.outer
					include : if para.isItalic sf.rb.outer
						composite-proc sf.lb.full sf.rb.full

		local voSerifConfig : SuffixCfg.weave
			object
				"" false
				topLeftMotion true
			object
				"" 0
				bottomLeftMotion 1
				bottomLeftFull 2
			object
				"" 0
				bottomRightMotion 1
				bottomRightFull 2
		foreach { suffix { topLeft bottomLeft bottomRight } } [Object.entries voSerifConfig] : do
			if (topLeft || bottomLeft || bottomRight) : create-glyph "armn/vo.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/vo.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df XH 0
				if topLeft : include sf.lt.outer
				if bottomLeft : include : if (bottomLeft === 1) sf.lb.outer sf.lb.full
				if bottomRight : include : if (bottomRight === 1) sf.rb.outer sf.rb.full
		select-variant 'armn/vo' 0x578

	do "Peh"
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/peh.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleMM 3
				include : df.markSet.p
				include : SmallMArches df XH 0 0 0
				include : FlipAround df.middle (XH / 2)
				include : VBar.r df.rightSB Descender XH df.mvs
				if fSerif : begin
					local sf : SerifFrame.fromDf df XH Descender
					include : composite-proc sf.lt.outer
						if para.isItalic sf.rb.outer sf.rb.fullSide
					if ([not para.isItalic] && sf.enoughSpaceForFullSerifs) : begin
						include : composite-proc sf.mt.left sf.rt.inner
		local pehPositionedSerifs : SuffixCfg.weave
			object
				"" 0
				topLeftMotion 1
				topLeftFull 2
			object
				"" 0
				topCenterFull 2
			object
				"" 0
				topRightMotion 1
				topRightFull 2
			object
				"" 0
				bottomRightMotion 1
				bottomRightFull 2
		foreach { suffix { p0 p1 p2 p3 } } [Object.entries pehPositionedSerifs] : do
			if (p0 || p1 || p2 || p3) : create-glyph "armn/peh.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/peh.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame para.advanceScaleMM 3
