$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from '@iosevka/util'
import [DependentSelector] from '@iosevka/glyph/relation'

glyph-module

glyph-block Letter-Armenian-Hook-Group : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Armenian-Shared-Shapes : ArmenianSerifConfig
	glyph-block-import Letter-Shared-Shapes : SerifFrame
	glyph-block-import Letter-Armenian-Shared-Shapes : ArmHBar

	define [RightHook df top bot _sw _hook _ada _adb] : glyph-proc
		local sw : fallback _sw df.mvs
		local hook : fallback _hook Hook
		local ada : fallback _ada ArchDepthA
		local adb : fallback _adb ArchDepthB
		local yMidLeft : top - [ArchDepthAClamped top bot ada adb]
		include : dispiro
			widths.lhs sw
			g4 df.rightSB (top - hook)
			HookStart top (sw -- sw)
			flat df.leftSB yMidLeft
			curl df.leftSB bot [heading Downward]

	define [LeftHook df top bot _sw _hook _ada _adb] : glyph-proc
		local sw : fallback _sw df.mvs
		local hook : fallback _hook Hook
		local ada : fallback _ada ArchDepthA
		local adb : fallback _adb ArchDepthB
		local yMidRight : top - [ArchDepthBClamped top bot ada adb]
		include : dispiro
			widths.rhs sw
			g4 df.leftSB (top - hook)
			HookStart top (sw -- sw)
			flat df.rightSB yMidRight
			curl df.rightSB bot [heading Downward]

	do 'Ben'
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Ben.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.capital
				include : RightHook df CAP 0 df.mvs
				include : [ArmHBar.normal df].mid
				if fSerif : begin
					local sf : SerifFrame.fromDf df CAP 0
					include sf.lb.full
		local BenPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				bottomLeftMotion 1
				bottomLeftFull 2
		foreach { suffix { p0 } } [Object.entries BenPositionedSerifs] : do
			if (p0) : create-glyph "armn/Ben.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Ben.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df CAP 0
				if p0 : include : if (p0 === 1) sf.lb.outer sf.lb.full
		select-variant 'armn/Ben' 0x532

	do 'Da'
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Da.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.capital
				include : LeftHook df CAP 0 df.mvs
				include : [ArmHBar.right df fSerif].mid
				if fSerif : begin
					local sf : SerifFrame.fromDf df CAP 0
					include sf.rb.full
		local DaPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				bottomRightMotion 1
				bottomRightFull 2
		foreach { suffix { p0 } } [Object.entries DaPositionedSerifs] : do
			if (p0) : create-glyph "armn/Da.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Da.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df CAP 0
				if p0 : include : if (p0 === 1) sf.rb.outer sf.rb.full
		select-variant 'armn/Da' 0x534

	do 'Ech'
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Ech.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.capital
				include : LeftHook df CAP 0 df.mvs
				include : FlipAround df.middle (CAP / 2)
				include : [ArmHBar.normal df].high
				if fSerif : begin
					local sf : SerifFrame.fromDf df CAP 0
					include sf.lt.full
		local EchPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				topLeftMotion 1
				topLeftFull 2
		foreach { suffix { p0 } } [Object.entries EchPositionedSerifs] : do
			if (p0) : create-glyph "armn/Ech.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Ech.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df CAP 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
		select-variant 'armn/Ech' 0x535

	do 'Et'
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Et.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.capital
				include : RightHook df CAP 0 df.mvs
				include : [ArmHBar.normal df].base
				if fSerif : begin
					local sf : SerifFrame.fromDf df CAP 0
					include sf.lb.outer
		local EtPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				bottomLeftMotion 1
		foreach { suffix { p0 } } [Object.entries EtPositionedSerifs] : do
			if (p0) : create-glyph "armn/Et.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Et.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df CAP 0
				if p0 : include sf.lb.outer
		select-variant 'armn/Et' 0x538

	do 'Ghat'
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Ghat.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.capital
				include : LeftHook df CAP 0 df.mvs
				include : [ArmHBar.right df fSerif].base
				if fSerif : begin
					local sf : SerifFrame.fromDf df CAP 0
					include sf.rb.full
		local GhatPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				bottomRightMotion 1
				bottomRightFull 2
		foreach { suffix { p0 } } [Object.entries GhatPositionedSerifs] : do
			if (p0) : create-glyph "armn/Ghat.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Ghat.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df CAP 0
				if p0 : include : if (p0 === 1) sf.rb.outer sf.rb.full
		select-variant 'armn/Ghat' 0x542

	do 'Nu'
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Nu.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.capital
				include : LeftHook df CAP 0 df.mvs
				include : FlipAround df.middle (CAP / 2)
				include : [ArmHBar.left df fSerif].cap
				if fSerif : begin
					local sf : SerifFrame.fromDf df CAP 0
					include sf.lt.full
		local NuPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				topLeftMotion 1
				topLeftFull 2
		foreach { suffix { p0 } } [Object.entries NuPositionedSerifs] : do
			if (p0) : create-glyph "armn/Nu.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Nu.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df CAP 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
		select-variant 'armn/Nu' 0x546

	do 'Peh'
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Peh.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleM 3
				include : df.markSet.capital
				include : LeftHook df CAP 0 df.mvs Hook df.archDepthA df.archDepthB
				include : VBar.m df.middle (XH / 2) (CAP - 0.5 * df.mvs) df.mvs
				if fSerif : begin
					local sf : SerifFrame.fromDf df CAP 0
					include sf.rb.full
		local PehPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				bottomRightMotion 1
				bottomRightFull 2
		foreach { suffix { p0 } } [Object.entries PehPositionedSerifs] : do
			if (p0) : create-glyph "armn/Peh.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Peh.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame para.advanceScaleM 3
				local sf : SerifFrame.fromDf df CAP 0
				if p0 : include : if (p0 === 1) sf.rb.outer sf.rb.full
		select-variant 'armn/Peh' 0x54A

	do 'Reh'
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Reh.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.capital
				include : RightHook df CAP 0 df.mvs
				if fSerif : begin
					local sf : SerifFrame.fromDf df CAP 0
					include sf.lb.full
		local RehPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				bottomLeftMotion 1
				bottomLeftFull 2
		foreach { suffix { p0 } } [Object.entries RehPositionedSerifs] : do
			if (p0) : create-glyph "armn/Reh.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Reh.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df CAP 0
				if p0 : include : if (p0 === 1) sf.lb.outer sf.lb.full
		select-variant 'armn/Reh' 0x550

	do 'Dram'
		glyph-block-import Letter-Shared-Shapes : LetterBarOverlay
		create-glyph 'armn/Dram' 0x58F : glyph-proc
			local df : include : DivFrame 1
			include : df.markSet.capital
			include : LeftHook df CAP 0 df.mvs
			include : LetterBarOverlay.r df.rightSB (CAP * 0.37)
			include : LetterBarOverlay.r df.rightSB (CAP * 0.60 - OverlayStroke * 0.25)
			if SLAB : begin
				local sf : SerifFrame.fromDf df CAP 0
				include sf.rb.full
