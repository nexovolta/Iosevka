$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from '@iosevka/util'
import [DependentSelector] from '@iosevka/glyph/relation'

glyph-module

glyph-block Letter-Armenian-Upper-Ken-Vew : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Armenian-Shared-Shapes : ArmenianSerifConfig
	glyph-block-import Letter-Shared-Shapes : uBowl SerifFrame
	glyph-block-import Letter-Armenian-Shared-Shapes : ArmHBar

	# Common Params
	define barPos : XH / 2
	define highBarPos XH
	define jut Jut

	do 'Ken'
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Ken.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.capital
				local barPosB : barPos - df.mvs / 2
				include : uBowl.shape
					top    -- CAP
					bottom -- barPosB
					left   -- df.leftSB
					right  -- (df.rightSB - [HSwToV df.mvs])
					ada    -- ArchDepthA
					adb    -- ArchDepthB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : VBar.r df.rightSB 0 highBarPos df.mvs
				if fSerif : begin
					local sf : SerifFrame.fromDf df CAP 0
					local sf2 : SerifFrame.fromDf df highBarPos 0
					include : composite-proc sf.lt.full sf2.rt.full sf.rb.full
		local KenPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				topLeftMotion 1
				topLeftFull 2
			object
				'' 0
				topRightMotion 1
				topRightFull 2
			object
				'' 0
				bottomRightMotion 1
				bottomRightFull 2
		foreach { suffix { p0 p1 p2 } } [Object.entries KenPositionedSerifs] : do
			if (p0 || p1 || p2) : create-glyph "armn/Ken.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Ken.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df CAP 0
				local sf2 : SerifFrame.fromDf df highBarPos 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include : if (p1 === 1) sf2.rt.outer sf2.rt.full
				if p2 : include : if (p2 === 1) sf.rb.outer sf.rb.full
		select-variant 'armn/Ken' 0x53F

	do 'Vew'
		foreach { suffix fSerif } [pairs-of ArmenianSerifConfig] : do
			create-glyph "armn/Vew.\(suffix)" : glyph-proc
				local df : include : DivFrame 1
				include : df.markSet.capital
				local barPosB : barPos - df.mvs / 2
				include : uBowl.shape
					top    -- highBarPos
					bottom -- barPosB
					left   -- df.leftSB
					right  -- (df.rightSB - [HSwToV df.mvs])
					ada    -- ArchDepthA
					adb    -- ArchDepthB
					stroke -- df.mvs
					fine   -- df.shoulderFine
				include : VBar.r df.rightSB 0 CAP df.mvs
				include : [ArmHBar.right df fSerif].base
				if fSerif : begin
					local sf : SerifFrame.fromDf df highBarPos 0
					local sf2 : SerifFrame.fromDf df CAP 0
					include : composite-proc sf.lt.full sf2.rt.full sf.rb.full
		local VewPositionedSerifs : SuffixCfg.weave
			object
				'' 0
				topLeftMotion 1
				topLeftFull 2
			object
				'' 0
				topRightMotion 1
				topRightFull 2
			object
				'' 0
				bottomRightMotion 1
				bottomRightFull 2
		foreach { suffix { p0 p1 p2 } } [Object.entries VewPositionedSerifs] : do
			if (p0 || p1 || p2) : create-glyph "armn/Vew.\(suffix)" : glyph-proc
				include [refer-glyph 'armn/Vew.serifless'] AS_BASE ALSO_METRICS
				local df : DivFrame 1
				local sf : SerifFrame.fromDf df highBarPos 0
				local sf2 : SerifFrame.fromDf df CAP 0
				if p0 : include : if (p0 === 1) sf.lt.outer sf.lt.full
				if p1 : include : if (p1 === 1) sf2.rt.outer sf2.rt.full
				if p2 : include : if (p2 === 1) sf.rb.outer sf.rb.full
		select-variant 'armn/Vew' 0x54E
