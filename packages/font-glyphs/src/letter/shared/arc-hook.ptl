$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from '@iosevka/util'
import [DependentSelector] from '@iosevka/glyph/relation'
import [Box] from '@iosevka/geometry/box'
import [Vec2] from '@iosevka/geometry/point'

glyph-module

glyph-block Letter-Arc-Hook : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared-Shapes : FlatHookDepth
	glyph-block-import Letter-Shared : PackSrc
	glyph-block-import Mark-Adjustment : LeaningAnchor
	glyph-block-import Mark-Above : MeasureGlyphBoundsInY

	glyph-block-export Toothed Toothless Rounded Flat MakeFlatHook MakeCornerHook MakeCornerHookBase CutArcTerminal DeltaCutStart DeltaCutEnd VerticalCutExtension CornerHookOffset CornerHookOutset CornerHookDepth CornerHookDepthShortened CornerHookDepthFitted CornerHookEnd CornerHookStart
	glyph-block-export MakeMidHeightLeftHook MakeMidHeightLeftHookL

	define kHook : 1 / 5

	define [MidHeightLeftHook xStem yTop] : glyph-proc
		local xHook : mix 0 xStem 0.08
		include : dispiro
			widths.rhs
			g4.right.start xHook (yTop - O)
			archv
			straight.down.end (xStem + [HSwToV : 0.5 * Stroke]) [Math.max (yTop * 0.35) (yTop - Hook)] [widths.rhs.heading ShoulderFine Downward]

	define [MakeMidHeightLeftHook prefix yTop] : lambda [src gr] : glyph-proc
		local packed : PackSrc prefix src : if (prefix === 'l') 'pack80' : if (prefix === 't') 'packLeftHook' 'pack75'
		if (prefix !== 'l' && packed === src) : throw : new Error "Cannot find packed left-hook source for \(src)"
		include [refer-glyph packed] AS_BASE ALSO_METRICS
		local letterW : mix currentGlyph.advanceWidth currentGlyph.advanceWidth 0
		currentGlyph.clearGeometry
		local df : include : DivFrame [if (prefix === 'l' || prefix === 't') 1 para.advanceScaleM]
		local shift : Math.max 0 (df.width - letterW)
		if (prefix !== 'l') : currentGlyph.applyTransform [ApparentTranslate shift 0] true
		include : with-transform [ApparentTranslate shift 0] : refer-glyph packed
		local yHook : if (prefix === 'n') (yTop - [Math.max (1.2 * Stroke) (0.24 * XH)]) yTop
		local yAtt : Math.max (yHook * 0.35) (yHook - Hook)
		local b : include : MeasureGlyphBoundsInY (yAtt - Stroke) (yAtt + 0.5 * Stroke)
		local xStem : shift + SB
		if b : set xStem : mix b.xMin b.xMin 0
		local bTop : include : MeasureGlyphBoundsInY (XH - Stroke - O) (XH + O)
		if (bTop && prefix !== 'n') : begin
			if (bTop.xMin < xStem - Stroke / 5) : set yHook : XH - Stroke
		if (yHook < yTop && prefix !== 'n') : begin
			set yAtt : Math.max (yHook * 0.35) (yHook - Hook)
			local bLow : include : MeasureGlyphBoundsInY (yAtt - Stroke) (yAtt + 0.5 * Stroke)
			if bLow : set xStem : mix bLow.xMin bLow.xMin 0
		include : MidHeightLeftHook xStem yHook
		include : LeaningAnchor.Above.At [mix xStem df.width 0.35]
		include : LeaningAnchor.Below.At [mix xStem df.width 0.35]

	define [MakeMidHeightLeftHookL yTop] : lambda [src gr] : glyph-proc
		include [refer-glyph src] AS_BASE ALSO_METRICS
		currentGlyph.clearGeometry
		include : with-transform [ApparentTranslate (kHook * Width) 0] : refer-glyph src
		local yAtt : Math.max (yTop * 0.35) (yTop - Hook)
		local b : include : MeasureGlyphBoundsInY (yAtt - Stroke) (yAtt + 0.5 * Stroke)
		local xStem : kHook * Width + SB
		if b : set xStem : mix b.xMin b.xMin 0
		include : MidHeightLeftHook xStem yTop
		include : LeaningAnchor.Above.At [mix xStem Width 0.35]
		include : LeaningAnchor.Below.At [mix xStem Width 0.35]

	glyph-block-export ArcStartSerifWidth
	define [ArcStartSerifWidth sw] : clamp (sw * 0.875) sw VJutStroke
	define [ArcStartInwardSerifDepth hook sw] : Math.max hook (DToothlessRise + sw)

	define flex-params [Toothed] : namespace
		local-parameter : box
		local-parameter : ada -- SmallArchDepthA
		local-parameter : adb -- SmallArchDepthB
		local-parameter : sw -- Stroke

		local-parameter : fine -- ShoulderFine
		local-parameter : barSw -- [ArcStartSerifWidth sw]
		local-parameter : hook -- Hook

		export : define yLT box.t
		export : define yRT box.t
		export : define yLB box.b
		export : define yRB box.b
		export : define xLArc : box.l + [HSwToV : sw - fine]
		export : define xRArc : box.r - [HSwToV : sw - fine]
		export : define xLHook : box.l + [HSwToV : barSw - fine]
		export : define xRHook : box.r - [HSwToV : barSw - fine]

		export : define [arcStartL] : begin
			return : list
				g4.up.start xLArc (box.t - ada) [widths.rhs.heading fine Upward]
				Arch.rhs box.t (sw -- sw) (swBefore -- fine)
		export : define [arcStartR] : begin
			return : list
				g4.up.start xRArc (box.t - adb) [widths.lhs.heading fine Upward]
				Arch.lhs box.t (sw -- sw) (swBefore -- fine)
		export : define [arcEndL] : begin
			return : list
				Arch.rhs box.b (sw -- sw) (swAfter -- fine)
				g4.up.end xLArc (box.b + adb) [widths.rhs.heading fine Upward]
		export : define [arcEndR] : begin
			return : list
				Arch.lhs box.b (sw -- sw) (swAfter -- fine)
				g4.up.end xRArc (box.b + ada) [widths.lhs.heading fine Upward]

		export : define [hookStartL] : begin
			return : list
				g4.up.start xLHook (box.t - hook) [widths.rhs.heading fine Upward]
				Arch.rhs box.t (sw -- sw) (swBefore -- fine)
		export : define [hookStartR] : begin
			return : list
				g4.up.start xRHook (box.t - hook) [widths.lhs.heading fine Upward]
				Arch.lhs box.t (sw -- sw) (swBefore -- fine)
		export : define [hookEndL] : begin
			return : list
				Arch.rhs box.b (sw -- sw) (swAfter -- fine)
				g4.up.end xLHook (box.b + hook) [widths.rhs.heading fine Upward]
		export : define [hookEndR] : begin
			return : list
				Arch.lhs box.b (sw -- sw) (swAfter -- fine)
				g4.up.end xRHook (box.b + hook) [widths.lhs.heading fine Upward]

		export : define [serifStartL] : begin
			return : tagged 'arcStartSerifL' : VBar.l box.l (box.t - hook) box.t barSw
		export : define [serifStartR] : begin
			return : tagged 'arcStartSerifR' : VBar.r box.r (box.t - hook) box.t barSw
		export : define [serifEndL] : begin
			return : tagged 'arcEndSerifL' : VBar.l box.l (box.b + hook) box.b barSw
		export : define [serifEndR] : begin
			return : tagged 'arcEndSerifR' : VBar.r box.r (box.b + hook) box.b barSw

	define flex-params [Toothless] : namespace
		local-parameter : box
		local-parameter : ada -- SmallArchDepthA
		local-parameter : adb -- SmallArchDepthB
		local-parameter : sw -- Stroke

		local-parameter : rise -- DToothlessRise
		local-parameter : barSw -- [ArcStartSerifWidth sw]
		local-parameter : hook -- Hook

		local serifDepth : Math.max hook (rise + sw)

		export : define yLT : box.t - rise
		export : define yRT : box.t - rise
		export : define yLB : box.b + rise
		export : define yRB : box.b + rise
		export : define xLArc box.l
		export : define xRArc box.r
		export : define xLHook box.l
		export : define xRHook box.r

		export : define [arcStartL] : begin
			return : list
				g4 xLArc (box.t - rise) [widths.rhs sw]
				Arch.rhs box.t (sw -- sw) (blendPre -- {})
		export : define [arcStartR] : begin
			return : list
				g4 xRArc (box.t - rise) [widths.lhs sw]
				Arch.lhs box.t (sw -- sw) (blendPre -- {})
		export : define [arcEndL] : begin
			return : list
				Arch.rhs box.b (sw -- sw) (blendPost -- {})
				g4 xLArc (box.b + rise)
		export : define [arcEndR] : begin
			return : list
				Arch.lhs box.b (sw -- sw) (blendPost -- {})
				g4 xRArc (box.b + rise)

		export : define [hookStartL] : begin
			return : list
				g2 xLHook (box.t - rise) [widths.rhs sw]
				Arch.rhs box.t (sw -- sw) (blendPre -- {})
		export : define [hookStartR] : begin
			return : list
				g2 xRHook (box.t - rise) [widths.lhs sw]
				Arch.lhs box.t (sw -- sw) (blendPre -- {})
		export : define [hookEndL] : begin
			return : list
				Arch.rhs box.b (sw -- sw) (blendPost -- {})
				g4 xLHook (box.b + rise)
		export : define [hookEndR] : begin
			return : list
				Arch.lhs box.b (sw -- sw) (blendPost -- {})
				g4 xRHook (box.b + rise)

		export : define [serifStartL] : begin
			return : tagged 'arcStartSerifL' : VBar.l box.l (box.t - serifDepth) (box.t - rise) barSw
		export : define [serifStartR] : begin
			return : tagged 'arcStartSerifR' : VBar.r box.r (box.t - serifDepth) (box.t - rise) barSw
		export : define [serifEndL] : begin
			return : tagged 'arcEndSerifL' : VBar.l box.l (box.b + serifDepth) (box.b + rise) barSw
		export : define [serifEndR] : begin
			return : tagged 'arcEndSerifR' : VBar.r box.r (box.b + serifDepth) (box.b + rise) barSw

	define flex-params [Rounded] : namespace
		local-parameter : box
		local-parameter : ada -- SmallArchDepthA
		local-parameter : adb -- SmallArchDepthB
		local-parameter : sw -- Stroke

		local-parameter : barSw -- [ArcStartSerifWidth sw]
		local-parameter : hook -- Hook

		export : define yLT : box.t - ada
		export : define yRT : box.t - adb
		export : define yLB : box.b + adb
		export : define yRB : box.b + ada
		export : define xLArc box.l
		export : define xRArc box.r
		export : define xLHook box.l
		export : define xRHook box.r

		export : define [arcStartL] : begin
			return : list
				g4.up.start box.l (box.t - ada) [widths.rhs.heading sw Upward]
				Arch.rhs box.t (sw -- sw)
		export : define [arcStartR] : begin
			return : list
				g4.up.start box.r (box.t - adb) [widths.lhs.heading sw Upward]
				Arch.lhs box.t (sw -- sw)
		export : define [arcEndL] : begin
			return : list
				Arch.rhs box.b (sw -- sw)
				g4.up.end box.l (box.b + adb) [heading Upward]
		export : define [arcEndR] : begin
			return : list
				Arch.lhs box.b (sw -- sw) (blendPost -- {})
				g4.up.end box.r (box.b + ada) [heading Upward]

		export : define [hookStartL] : begin
			return : list
				g4 box.l (box.t - hook) [widths.rhs.heading sw Upward]
				HookStart box.t (sw -- sw)
		export : define [hookStartR] : begin
			return : list
				g4 box.r (box.t - hook) [widths.lhs.heading sw Upward]
				HookStart box.t (sw -- sw)
		export : define [hookEndL] : begin
			return : list
				HookEnd box.b (sw -- sw)
				g4 box.l (box.b + hook) [heading Upward]
		export : define [hookEndR] : begin
			return : list
				HookEnd box.b (sw -- sw)
				g4 box.r (box.b + hook) # Rounded hooks only end with non-level terminal for EndR

		export : define [serifStartL] : return : glyph-proc
		export : define [serifStartR] : return : glyph-proc
		export : define [serifEndL] : return : glyph-proc
		export : define [serifEndR] : return : glyph-proc

	define flex-params [Flat] : namespace
		local-parameter : box
		local-parameter : ada -- SmallArchDepthA
		local-parameter : adb -- SmallArchDepthB
		local-parameter : sw -- Stroke

		local-parameter : slab -- 0
		local-parameter : barSw -- [ArcStartSerifWidth sw]
		local-parameter : hook -- Hook
		local-parameter : midShift -- (box.r - box.l) * (-0.05)
		local-parameter : xShrink -- [HSwToV : 0.25 * barSw]
		local-parameter : fSlantedHookTerminal -- false

		local serifShrink : Math.max 0 (xShrink - [HSwToV : 0.5 * barSw])
		local midX : mix box.l box.r 0.5

		export : define yLT box.t
		export : define yRT box.t
		export : define yLB box.b
		export : define yRB box.b
		export : define xLArc box.l
		export : define xRArc box.r
		export : define xLHook : box.l + xShrink
		export : define xRHook : box.r - xShrink

		export : define [arcStartL] : begin
			return : list
				corner xLArc box.t [widths.rhs.heading sw Rightward]
				curl [Math.max (xLArc + TanSlope * sw) : Arch.adjust-x.top (midX + midShift) sw] box.t [heading Rightward]
				archv
		export : define [arcStartR] : begin
			return : list
				corner xRArc box.t [widths.lhs.heading sw Leftward]
				curl [Math.min (xRArc - TanSlope * sw) : Arch.adjust-x.top (midX - midShift) sw] box.t [heading Leftward]
				archv
		export : define [arcEndL] : begin
			return : list
				arcvh
				flat [Math.max (xLArc + TanSlope * sw) : Arch.adjust-x.bot (midX + midShift) sw] box.b [widths.rhs.heading sw Leftward]
				corner xLArc box.b [heading Leftward]
		export : define [arcEndR] : begin
			return : list
				arcvh
				flat [Math.min (xRArc - TanSlope * sw) : Arch.adjust-x.bot (midX - midShift) sw] box.b [widths.lhs.heading sw Rightward]
				corner xRArc box.b [heading Rightward]
		export : define [hookStartL] : begin
			return : list
				corner xLHook box.t : if (fSlantedHookTerminal && para.isItalic) [widths.rhs.heading sw Rightward] [widths.rhs sw]
				curl [Math.max (xLHook + TanSlope * sw) : Arch.adjust-x.top (midX + midShift) sw] box.t [heading Rightward]
				archv.superness DesignParameters.tightHookSuperness
		export : define [hookStartR] : begin
			return : list
				corner xRHook box.t : if (fSlantedHookTerminal && para.isItalic) [widths.lhs.heading sw Leftward] [widths.lhs sw]
				curl [Math.min (xRHook - TanSlope * sw) : Arch.adjust-x.top (midX - midShift) sw] box.t [heading Leftward]
				archv.superness DesignParameters.tightHookSuperness
		export : define [hookEndL] : begin
			return : list
				arcvh.superness DesignParameters.tightHookSuperness
				flat [Math.max (xLHook + TanSlope * sw) : Arch.adjust-x.bot (midX + midShift) sw] box.b [widths.rhs.heading sw Leftward]
				corner xLHook box.b : if (fSlantedHookTerminal && para.isItalic) [heading Leftward] nothing
		export : define [hookEndR] : begin
			return : list
				arcvh.superness DesignParameters.tightHookSuperness
				flat [Math.min (xRHook - TanSlope * sw) : Arch.adjust-x.bot (midX - midShift) sw] box.b [widths.lhs.heading sw Rightward]
				corner xRHook box.b : if (fSlantedHookTerminal && para.isItalic) [heading Rightward] nothing

		export : define [serifStartL] : begin
			return : if slab
				tagged 'arcStartSerifL' : VBar.l (box.l + serifShrink) (box.t - hook) box.t barSw
				glyph-proc
		export : define [serifStartR] : begin
			return : if slab
				tagged 'arcStartSerifR' : VBar.r (box.r - serifShrink) (box.t - hook) box.t barSw
				glyph-proc
		export : define [serifEndL] : begin
			return : if slab
				tagged 'arcEndSerifL' : VBar.l (box.l + serifShrink) (box.b + hook) box.b barSw
				glyph-proc
		export : define [serifEndR] : begin
			return : if slab
				tagged 'arcEndSerifR' : VBar.r (box.r - serifShrink) (box.b + hook) box.b barSw
				glyph-proc

	define [MakeFlatHook] : with-params [l r t b [sw Stroke]] : Flat [new Box t b l r] (sw -- sw)

	define [DeltaCutTipX xMid xEdge sw] : begin
		local direction : if (xEdge > xMid) 1 (-1)
		return : [mix xMid xEdge 0.95] + direction * [HSwToV : 0.2 * sw]

	define [DeltaCutStart xMid xEdge yPeak yTip sw _widths] : list
		g4 [DeltaCutTipX xMid xEdge sw] yTip _widths
		alsoThru 0.5 0.7
		g4 xMid yPeak
		archv 2

	define [DeltaCutEnd xMid xEdge yPeak yTip sw] : list
		arcvh 2
		g4 xMid yPeak
		alsoThru 0.5 0.3
		g4 [DeltaCutTipX xMid xEdge sw] yTip

	define [VerticalCutExtension hook sw] : HSwToV : Math.max hook sw

	define [CutArcTerminal shape x top bot sw fLeft fTop] : begin
		local depth : Math.min ((top - bot) / 2) ([Math.max Hook SHook] + sw)
		local split : if fTop (top - depth) (bot + depth)
		local endY : if fTop (top + 2 * sw + O) (bot - 2 * sw - O)
		local keepOther : if fTop [MaskBelow split] [MaskAbove split]
		local keepHalf : if fTop [MaskAbove split] [MaskBelow split]
		local keepSide : if fLeft [MaskRightLine x split x endY 1] [MaskLeftLine x split x endY 1]
		return : intersection shape : union keepOther : intersection keepHalf keepSide

	define [CornerHookOffset sw] : HSwToV : 0.25 * sw
	define [CornerHookOutset sw] : if para.isItalic [HSwToV : 0.125 * sw] 0

	define [MakeCornerHookBase] : with-params [l r t b [sw Stroke]] : Flat [new Box t b l r]
		sw -- sw
		xShrink -- ([HSwToV : 0.25 * [ArcStartSerifWidth sw]] - [if para.isItalic 0 [CornerHookOffset sw]] - [CornerHookOutset sw])
		fSlantedHookTerminal -- true

	define [CornerHookDepth hook sw] : ArcStartInwardSerifDepth hook sw

	define [CornerHookDepthShortened depth sw] : if para.isItalic [Math.min depth (sw + 0.75 * [Math.max 0 (depth - sw)])] depth

	define [CornerHookDepthFitted hook sw available] : begin
		local depth : CornerHookDepth hook sw
		return : if para.isItalic [Math.min depth : Math.max sw (available - O - 0.3 * sw)] depth

	define [CornerHookEnd x y depth sw dirBar dirStub] : begin
		local miterDirection : if para.isItalic (-1) 1
		local xOut : x + dirBar * (miterDirection * [CornerHookOffset sw] + [CornerHookOutset sw])
		local stub : if (dirStub > 0) Upward Downward
		local rhs : (dirBar * dirStub) < 0
		local wStub : if rhs [widths.rhs.heading sw stub] [widths.lhs.heading sw stub]
		local miter : new Vec2 (-dirStub * HVContrast) dirBar
		local wCorner : if rhs [widths.rhs.heading sw miter] [widths.lhs.heading sw miter]
		return : list
			corner xOut y wCorner
			corner xOut (y + dirStub * depth) wStub

	define [CornerHookStart x y depth sw dirBar dirStub] : begin
		local miterDirection : if para.isItalic 1 (-1)
		local xOut : x + dirBar * (miterDirection * [CornerHookOffset sw] - [CornerHookOutset sw])
		local stub : if (dirStub > 0) Upward Downward
		local rhs : (dirBar * dirStub) > 0
		local wStub : if rhs [widths.rhs.heading sw stub] [widths.lhs.heading sw stub]
		local miter : new Vec2 (-dirStub * HVContrast) dirBar
		local wCorner : if rhs [widths.rhs.heading sw miter] [widths.lhs.heading sw miter]
		return : list
			corner xOut (y - dirStub * depth) wStub
			corner xOut y wCorner

	define [MakeCornerHook] : with-params [l r t b [sw Stroke] [hook Hook] [endInset 0] [depthLimit VERY-FAR] [extension 0] [shorten false]] : namespace
		local box : new Box t b l r
		local flatHook : MakeFlatHook l r t b (sw -- sw)
		local fh : MakeCornerHookBase l r t b (sw -- sw)
		local depth : Math.min depthLimit : CornerHookDepth hook sw
		if shorten : set depth : CornerHookDepthShortened depth sw
		local w : HSwToV sw

		export : define yLT fh.yLT
		export : define yRT fh.yRT
		export : define yLB fh.yLB
		export : define yRB fh.yRB
		export : define xLArc fh.xLArc
		export : define xRArc fh.xRArc
		export : define xLHook fh.xLHook
		export : define xRHook fh.xRHook
		export : define arcStartL fh.arcStartL
		export : define arcStartR fh.arcStartR
		export : define arcEndL fh.arcEndL
		export : define arcEndR fh.arcEndR
		export : define serifStartL fh.serifStartL
		export : define serifStartR fh.serifStartR
		export : define serifEndL fh.serifEndL
		export : define serifEndR fh.serifEndR

		local midX : mix box.l box.r 0.5
		local midShift : (box.r - box.l) * (-0.05)
		local hookL : if extension [Math.max box.l (flatHook.xLHook - extension)] flatHook.xLHook
		local hookR : if extension [Math.min box.r (flatHook.xRHook + extension)] flatHook.xRHook
		local xGuardL : if para.isItalic (hookL + [CornerHookOffset sw] - [CornerHookOutset sw]) fh.xLHook
		local xGuardR : if para.isItalic (hookR - [CornerHookOffset sw] + [CornerHookOutset sw]) fh.xRHook

		export : define [hookStartL] : begin
			return : list
				~~~ [CornerHookStart hookL box.t depth sw 1 1]
				curl [Math.max (xGuardL + w + TanSlope * sw) : Arch.adjust-x.top (midX + midShift) sw] box.t [heading Rightward]
				archv.superness DesignParameters.tightHookSuperness
		export : define [hookStartR] : begin
			return : list
				~~~ [CornerHookStart hookR box.t depth sw (-1) 1]
				curl [Math.min (xGuardR - w - TanSlope * sw) : Arch.adjust-x.top (midX - midShift) sw] box.t [heading Leftward]
				archv.superness DesignParameters.tightHookSuperness
		export : define [hookEndL] : begin
			local originalFlatX : Math.max (xGuardL + w + TanSlope * sw) : Arch.adjust-x.bot (midX + midShift) sw
			local endX : Math.min (hookL + endInset) (originalFlatX - 0.5 * w)
			local italicClearance : if para.isItalic ([CornerHookOffset sw] + [Math.max 0 : TanSlope * sw]) 0
			local flatLimit : Math.max (endX + w) (box.r - 1.25 * w)
			local flatX : if endInset [Math.max originalFlatX : Math.min (endX + w + italicClearance) flatLimit] originalFlatX
			return : list
				arcvh.superness DesignParameters.tightHookSuperness
				flat flatX box.b [widths.rhs.heading sw Leftward]
				~~~ [CornerHookEnd [if endInset endX hookL] box.b depth sw (-1) 1]
		export : define [hookEndR] : begin
			return : list
				arcvh.superness DesignParameters.tightHookSuperness
				flat [Math.min (xGuardR - w - TanSlope * sw) : Arch.adjust-x.bot (midX - midShift) sw] box.b [widths.lhs.heading sw Rightward]
				~~~ [CornerHookEnd hookR box.b depth sw 1 1]
