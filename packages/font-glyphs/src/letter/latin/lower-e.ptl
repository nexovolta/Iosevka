$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [DependentSelector] from "@iosevka/glyph/relation"

glyph-module

glyph-block Letter-Latin-Lower-E : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared : CreateSelectorVariants DefineSelectorGlyph CreateTurnedLetter
	glyph-block-import Letter-Shared-Shapes : FlatHookDepth RetroflexHook RhoticHookShape
	glyph-block-import Letter-Shared-Shapes : SerifedArcEnd InwardSlabArcEnd ArcEndSerif
	glyph-block-import Mark-Shared-Metrics : markExtend markStroke markStress markFine
	glyph-block-import Mark-Adjustment : ExtendBelowBaseAnchors
	glyph-block-import Letter-Arc-Hook : MakeFlatHook

	define [SmallEHook top stroke hook doSwash] : Math.min hook : if doSwash VERY-FAR
		mix stroke ([mix 0 top DesignParameters.eBarPos] - stroke / 2) 0.554

	define SLAB-NONE       0
	define SLAB-CLASSICAL  1
	define SLAB-INWARD     2
	define SLAB-FLAT-HOOK  4

	define [SmallESerifedTerminalShape df top stroke hook tailSlab isClockwise] : begin
		local doSwash : !isClockwise && para.isItalic && (para.slopeAngle > 0)
		return : match tailSlab
			[Just SLAB-CLASSICAL] : SerifedArcEnd.LtrLhs df.rightSB 0 stroke hook
			[Just SLAB-INWARD] : InwardSlabArcEnd.LtrLhs df.rightSB 0 stroke hook
			[Just SLAB-FLAT-HOOK] : [MakeFlatHook df.leftSB df.rightSB top 0 (sw -- stroke)].hookEndR
			__ : list
				HookEnd 0 (sw -- stroke) (suppressSwash -- isClockwise)
				g4 (df.rightSB - [if doSwash 0 0.5] * OX) [SmallEHook top stroke hook doSwash]

	define [SmallETerminalSerif df top stroke hook tailSlab isClockwise] : match tailSlab
		[Just SLAB-CLASSICAL] : ArcEndSerif.R       df.rightSB 0 stroke hook
		[Just SLAB-INWARD]    : ArcEndSerif.InwardR df.rightSB 0 stroke hook
		__                    : no-shape

	define [RevSmallESerifedTerminalShape df top stroke hook tailSlab isCounterClockwise] : begin
		local doSwash : !isCounterClockwise && para.isItalic && (para.slopeAngle < 0)
		return : match tailSlab
			[Just SLAB-CLASSICAL] : SerifedArcEnd.RtlRhs df.leftSB 0 stroke hook
			[Just SLAB-INWARD] : InwardSlabArcEnd.RtlRhs df.leftSB 0 stroke hook
			[Just SLAB-FLAT-HOOK] : [MakeFlatHook df.leftSB df.rightSB top 0 (sw -- stroke)].hookEndL
			__ : list
				HookEnd 0 (sw -- stroke) (suppressSwash -- isCounterClockwise)
				g4 (df.leftSB + [if doSwash 0 0.5] * OX) [SmallEHook top stroke hook doSwash]

	define [RevSmallETerminalSerif df top stroke hook tailSlab isCounterClockwise] : match tailSlab
		[Just SLAB-CLASSICAL] : ArcEndSerif.L       df.leftSB 0 stroke hook
		[Just SLAB-INWARD]    : ArcEndSerif.InwardL df.leftSB 0 stroke hook
		__                    : no-shape

	define flex-params [SmallEShape] : glyph-proc
		local-parameter : df
		local-parameter : top
		local-parameter : stroke   -- [AdviceStroke2 2 3 top]
		local-parameter : hook     -- AHook
		local-parameter : bbd      -- 0
		local-parameter : ada      -- SmallArchDepthA
		local-parameter : adb      -- SmallArchDepthB
		local-parameter : turned   -- false
		local-parameter : styTop   -- nothing
		local-parameter : styBot   -- nothing

		local tailSlab : if turned styTop styBot
		local cw : turned && (tailSlab != nothing)

		local yBarBottom : [mix 0 top DesignParameters.eBarPos] - stroke / 2

		include : HBar.b ((df.leftSB + OX) + stroke / 2 + bbd) ((df.rightSB - OX) - stroke / 2) yBarBottom stroke
		local path : include : dispiro
			widths.lhs stroke
			flat (df.rightSB - OX) yBarBottom [heading Upward]
			curl (df.rightSB - OX) [Math.max (top - adb) (yBarBottom + TINY)]
			Arch.lhs top (sw -- stroke)
			flatside.ld df.leftSB 0 top ada adb
			SmallESerifedTerminalShape df top stroke hook tailSlab cw

		include : SmallETerminalSerif df top stroke hook tailSlab cw

		if turned : include : FlipAround df.middle (top / 2)

		return path.rhsKnots.[path.rhsKnots.length - 1]

	define flex-params [RevSmallEShape] : glyph-proc
		local-parameter : df
		local-parameter : top
		local-parameter : stroke   -- [AdviceStroke2 2 3 top]
		local-parameter : hook     -- AHook
		local-parameter : ada      -- SmallArchDepthA
		local-parameter : adb      -- SmallArchDepthB
		local-parameter : turned   -- false
		local-parameter : styTop   -- nothing
		local-parameter : styBot   -- nothing

		local tailSlab : if turned styTop styBot
		local ccw : turned && (tailSlab != nothing)

		local yBarBottom : [mix 0 top DesignParameters.eBarPos] - stroke / 2

		include : HBar.b ((df.leftSB + OX) + stroke / 2) ((df.rightSB - OX) - stroke / 2) yBarBottom stroke
		include : dispiro
			widths.rhs stroke
			flat (df.leftSB + OX) yBarBottom [heading Upward]
			curl (df.leftSB + OX) [Math.max (top - ada) (yBarBottom + TINY)]
			Arch.rhs top (sw -- stroke)
			flatside.rd df.rightSB 0 top ada adb
			RevSmallESerifedTerminalShape df top stroke hook tailSlab ccw

		include : RevSmallETerminalSerif df top stroke hook tailSlab ccw

		if turned : include : FlipAround df.middle (top / 2)

	define flex-params [SmallERoundedShape] : glyph-proc
		local-parameter : df
		local-parameter : top
		local-parameter : stroke   -- [AdviceStroke2 2 3 top]
		local-parameter : hook     -- AHook
		local-parameter : ada      -- SmallArchDepthA
		local-parameter : adb      -- SmallArchDepthB
		local-parameter : turned   -- false
		local-parameter : styTop   -- nothing
		local-parameter : styBot   -- nothing

		local tailSlab : if turned styTop styBot
		local cw : turned && (tailSlab != nothing)

		local yBarBottom : [mix 0 top (DesignParameters.eBarPos * [if para.isItalic 1 0.95])] - stroke / 2
		local xStart : df.leftSB + [HSwToV : 0.125 * stroke]
		local extraCurliness : if para.isItalic (0.1 * (top - yBarBottom)) 0
		local ada2 : ArchDepthAOf : (1 - DesignParameters.eBarPos) * SmallArchDepth
		local adb2 : ArchDepthBOf : (1 - DesignParameters.eBarPos) * SmallArchDepth
		local path : include : dispiro
			widths.lhs stroke
			[if para.isItalic g2   flat]      xStart                                      yBarBottom
			[if para.isItalic virt curl] [mix xStart df.rightSB (0.475 + 0.1 * TanSlope)] yBarBottom [if para.isItalic nothing [heading Rightward]]
			archv
			g4 ((df.rightSB - OX) - 0.5 * (df.width / HalfUPM) * extraCurliness) [YSmoothMidR top yBarBottom ada2 adb2]
			Arch.lhs top (sw -- stroke)
			flatside.ld df.leftSB 0 top ada adb
			SmallESerifedTerminalShape df top stroke hook tailSlab cw

		include : SmallETerminalSerif df top stroke hook tailSlab cw

		if turned : include : FlipAround df.middle (top / 2)

		return path.rhsKnots.[path.rhsKnots.length - 1]

	define flex-params [RevSmallERoundedShape] : glyph-proc
		local-parameter : df
		local-parameter : top
		local-parameter : stroke   -- [AdviceStroke2 2 3 top]
		local-parameter : hook     -- AHook
		local-parameter : ada      -- SmallArchDepthA
		local-parameter : adb      -- SmallArchDepthB
		local-parameter : turned   -- false
		local-parameter : styTop   -- nothing
		local-parameter : styBot   -- nothing

		local tailSlab : if turned styTop styBot
		local ccw : turned && (tailSlab != nothing)

		local yBarBottom : [mix 0 top (DesignParameters.eBarPos * [if para.isItalic 1 0.95])] - stroke / 2
		local xStart : df.rightSB - [HSwToV : 0.125 * stroke]
		local extraCurliness : if para.isItalic (0.1 * (top - yBarBottom)) 0
		local ada2 : ArchDepthAOf : (1 - DesignParameters.eBarPos) * SmallArchDepth
		local adb2 : ArchDepthBOf : (1 - DesignParameters.eBarPos) * SmallArchDepth
		include : dispiro
			widths.rhs stroke
			[if para.isItalic g2          flat]      xStart                                     (yBarBottom + (2/3) * extraCurliness)
			[if para.isItalic g2.left.mid curl] [mix xStart df.leftSB (0.475 - 0.1 * TanSlope)] (yBarBottom - (1/3) * extraCurliness) [heading Leftward]
			archv
			g4 (df.leftSB + OX) [YSmoothMidL top yBarBottom ada2 adb2]
			Arch.rhs top (sw -- stroke)
			flatside.rd df.rightSB 0 top ada adb
			RevSmallESerifedTerminalShape df top stroke hook tailSlab ccw

		include : RevSmallETerminalSerif df top stroke hook tailSlab ccw

		if turned : include : FlipAround df.middle (top / 2)

	glyph-block-export AbkCheLeftFlourish
	define flex-params [AbkCheLeftFlourish] : glyph-proc
		local-parameter : df
		local-parameter : yBarBottom
		local-parameter : xJoin
		local-parameter : xClip
		local-parameter : stroke -- Stroke
		local-parameter : fDown  -- false
		local-parameter : xLeft  -- nothing

		local hd : FlatHookDepth df
		local xHook : fallback xLeft : df.leftSB - [HSwToV : 0.25 * stroke]
		# Keep enough room for the hook turn so a flat bar remains before the dip.
		local xTurn : Math.min (xHook + hd.x - [HSwToV : 0.5 * stroke]) [mix xHook xClip 0.55]
		local yBar : yBarBottom + 0.5 * stroke
		local flourish : intersection [MaskLeft xClip] : dispiro
			widths.lhs stroke
			flat xHook (yBarBottom + Hook) [heading Downward]
			curl xHook (yBarBottom + [Math.min Hook hd.y] - 0.25 * stroke) [heading Downward]
			arcvh
			flat [Math.max (xHook + TINY) xTurn] yBarBottom
			curl xJoin yBarBottom
		include : with-transform [if fDown [FlipAround 0 yBar 1 (-1)] [Translate 0 0]] flourish
		if fDown : begin
			local yFlourishBot : yBarBottom + stroke - Hook
			if (yFlourishBot < 0) : include : ExtendBelowBaseAnchors yFlourishBot

	define flex-params [AbkCheShape] : glyph-proc
		local-parameter : fDesc
		local-parameter : Body
		local-parameter : df
		local-parameter : top
		local-parameter : stroke   -- [df.adviceThinnerStroke2 2 3 top 0.75]
		local-parameter : hook     -- AHook
		local-parameter : ada      -- SmallArchDepthA
		local-parameter : adb      -- SmallArchDepthB
		local-parameter : styTop   -- nothing
		local-parameter : styBot   -- nothing
		local-parameter : fDown    -- false

		local gap : 0.375 * (df.rightSB - df.leftSB) - [HSwToV : 0.25 * stroke] + stroke / 16
		local subDf : DivFrame [Math.min ((df.width - gap) / Width) (0.75 * df.adws)] 2
		include : Body subDf top
			stroke   -- stroke
			hook     -- hook
			ada      -- (ada * 0.75 * df.adws)
			adb      -- (adb * 0.75 * df.adws)
			styTop   -- styTop
			styBot   -- styBot
		if fDesc : begin
			local desc : (-LongVJut) + QuarterStroke
			include : ExtendBelowBaseAnchors desc
			include : difference
				VBar.m subDf.middle desc (O + stroke) (VJutStroke * (subDf.mvs / Stroke))
				OShapeOutline.NoOvershoot top 0 subDf.leftSB subDf.rightSB stroke
		local shift : df.width - subDf.width
		include : Translate shift 0

		local yBarBottom : [mix 0 top DesignParameters.eBarPos] - stroke / 2
		local xJoin : subDf.middle + shift
		local xClip : subDf.leftSB + shift
		include : AbkCheLeftFlourish df yBarBottom
			xJoin  -- xJoin
			xClip  -- xClip
			stroke -- stroke
			fDown  -- fDown

	glyph-block-export SmallEConfig
	define SmallEConfig : object
		flatCrossbar         { SmallEShape        RevSmallEShape        SLAB-NONE      }
		rounded              { SmallERoundedShape RevSmallERoundedShape SLAB-NONE      }
		flatCrossbarFlatHook { SmallEShape        RevSmallEShape        SLAB-FLAT-HOOK }
		roundedFlatHook      { SmallERoundedShape RevSmallERoundedShape SLAB-FLAT-HOOK }

	glyph-block-export SchwaConfig
	define SchwaConfig : object
		flatCrossbar         { SmallEShape        RevSmallEShape        SLAB-NONE      }
		flatCrossbarSerifed  { SmallEShape        RevSmallEShape        SLAB-CLASSICAL }
		flatCrossbarFlatHook { SmallEShape        RevSmallEShape        SLAB-FLAT-HOOK }
		rounded              { SmallERoundedShape RevSmallERoundedShape SLAB-NONE      }
		roundedSerifed       { SmallERoundedShape RevSmallERoundedShape SLAB-CLASSICAL }
		roundedFlatHook      { SmallERoundedShape RevSmallERoundedShape SLAB-FLAT-HOOK }

	foreach { suffix { Body RevBody tailSlab } } [Object.entries SmallEConfig] : do
		create-glyph "e.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : Body [DivFrame 1] XH
				hook   -- AHook
				ada    -- SmallArchDepthA
				adb    -- SmallArchDepthB
				styBot -- tailSlab

		create-glyph "eOgonek.\(suffix)" : glyph-proc
			include : MarkSet.e
			local lastKnot : include : Body [DivFrame 1] XH
				hook   -- AHook
				ada    -- SmallArchDepthA
				adb    -- SmallArchDepthB
				styBot -- tailSlab
			include : refer-glyph 'ogonekTR/spacer'

			# Connected Ogonek shape
			local fine : AdviceStroke 8
			local depth : (-Descender) - markStroke
			local extL : (7 / 16) * depth + 0.25 * markStress
			local extR : Math.max (0.0625 * markExtend) (TanSlope * (1.5 * markStroke))
			local beginCoSlope : if para.isItalic 0.2 0

			set-base-anchor 'trailing' (RightSB + extR) ((-depth) + 0.5 * O - markStroke)
			set-base-anchor 'belowBraceL' (RightSB - extL - [HSwToV : 0.25 * markStroke]) ((-0.75) * depth)
			set-base-anchor 'belowBraceR' (RightSB - 0.75 * extL) ((-0.75) * depth)

			local turnSlope : 0.5 * ((markStroke - fine) / markStroke - (ArchDepthB - ArchDepth) / ArchDepth)

			include : intersection
				MaskBelow lastKnot.y
				dispiro
					g4 lastKnot.x lastKnot.y [widths.rhs fine]
					g4 (lastKnot.x - beginCoSlope * TINY) (lastKnot.y - TINY)
					alsoThruThem.computed { (1/3) (2/3) } : object
						rx       : function [rt] rt
						deltaX   : function [rt] 0
						ry       : function [rt] : (11/48) + (5/8) * rt
						deltaY   : function [rt] : (-0.25) * [mix fine markStroke rt]
						modifier : function [rt] : widths.rhs [mix fine markStroke : rt ** 2]
					g4.down.mid (RightSB - extL) ((-0.75) * depth) [widths.rhs.heading markStroke {.x HVContrast .y turnSlope}]
					arcvh [widths.rhs markStroke]
					g4 (RightSB + [mix (-extL) (+extR) (11/16)]) ((-depth) + O) [heading Rightward]
					g4 (RightSB + extR) ((-depth) + 0.5 * O) [heading Rightward]

		create-glyph "eNotch.\(suffix)" : glyph-proc
			include : MarkSet.e
			local lastKnot : include : Body [DivFrame 1] XH
				hook   -- AHook
				ada    -- SmallArchDepthA
				adb    -- SmallArchDepthB
				styBot -- tailSlab
			local sw : AdviceStroke 4
			local ry : Math.min (lastKnot.y - sw) [mix 0 XH 0.08]
			local rx : Math.min ry
			include : dispiro
				g4.down.start lastKnot.x lastKnot.y [widths.rhs sw]
				arcvh
				g4 (lastKnot.x + rx) (lastKnot.y - ry + O)
				archv
				g4.up.end (lastKnot.x + rx * 2) lastKnot.y

		create-glyph "eRetroflexHook.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : Body [DivFrame 1] XH
				hook   -- AHook
				ada    -- SmallArchDepthA
				adb    -- SmallArchDepthB
				styBot -- SLAB-CLASSICAL
			include : RetroflexHook.r
				x       -- RightSB
				y       -- 0
				yAttach -- DToothlessRise

		create-glyph "reve.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : RevBody [DivFrame 1] XH
				hook   -- AHook
				ada    -- SmallArchDepthA
				adb    -- SmallArchDepthB
				styBot -- tailSlab

		create-glyph "eBar.\(suffix)" : glyph-proc
			include [refer-glyph "e.\(suffix)"] AS_BASE ALSO_METRICS
			local yBar : mix Stroke ([mix 0 XH DesignParameters.eBarPos] - HalfStroke) 0.5
			include : HBar.m [mix SB 0 0.7] [mix RightSB Width 0.7] yBar [Math.min (yBar - Stroke) : AdviceStroke 5]

		define abkCheDf : DivFrame para.advanceScaleM 3

		create-glyph "cyrl/abk/Che.\(suffix)" : glyph-proc
			local df : include abkCheDf
			include : df.markSet.capital
			include : AbkCheShape false Body df CAP
				hook   -- Hook
				ada    -- ArchDepthA
				adb    -- ArchDepthB
				styTop -- tailSlab
				styBot -- tailSlab
		create-glyph "cyrl/abk/che.\(suffix)" : glyph-proc
			local df : include abkCheDf
			include : df.markSet.e
			include : AbkCheShape false Body df XH
				hook   -- AHook
				ada    -- SmallArchDepthA
				adb    -- SmallArchDepthB
				styTop -- tailSlab
				styBot -- tailSlab
		create-glyph "cyrl/abk/CheDescender.\(suffix)" : glyph-proc
			local df : include abkCheDf
			include : df.markSet.capDesc
			include : AbkCheShape true Body df CAP
				hook   -- Hook
				ada    -- ArchDepthA
				adb    -- ArchDepthB
				styTop -- tailSlab
				styBot -- tailSlab
		create-glyph "cyrl/abk/cheDescender.\(suffix)" : glyph-proc
			local df : include abkCheDf
			include : df.markSet.p
			include : AbkCheShape true Body df XH
				hook   -- AHook
				ada    -- SmallArchDepthA
				adb    -- SmallArchDepthB
				styTop -- tailSlab
				styBot -- tailSlab

		create-glyph "eFlourish.\(suffix)" : glyph-proc
			local df : include abkCheDf
			include : df.markSet.e
			include : AbkCheShape false Body df XH
				hook   -- AHook
				ada    -- SmallArchDepthA
				adb    -- SmallArchDepthB
				styTop -- tailSlab
				styBot -- tailSlab
				fDown  -- true

	select-variant 'e' 'e'

	select-variant 'eOgonek'        0x119  (follow -- 'e')
	select-variant 'eRetroflexHook' 0x1D92 (follow -- 'e')
	select-variant 'eNotch'         0x2C78
	select-variant 'eBar'           0xAB33 (follow -- 'e')
	select-variant 'eFlourish'      0xAB34 (follow -- 'e')

	select-variant     'reve'  0x258 (follow -- 'e')
	CreateTurnedLetter 'turne' 0x1DD 'e' HalfAdvance (XH / 2)

	define rhoticDf : DivFrame para.advanceScaleM 1

	foreach { suffix { Body RevBody terminalSlab } } [Object.entries SchwaConfig] : do

		DefineSelectorGlyph "Schwa" suffix [DivFrame 1] 'capital'
		DefineSelectorGlyph "schwa" suffix [DivFrame 1] 'e'
		DefineSelectorGlyph "schwaRhoticHook"    suffix rhoticDf 'e'
		DefineSelectorGlyph "schwaRetroflexHook" suffix rhoticDf 'e'

		create-glyph "Schwa.\(suffix)" : glyph-proc
			set-width 0
			set-mark-anchor 'cvDecompose' 0 0
			include : Body [DivFrame 1] CAP
				hook   -- Hook
				ada    -- ArchDepthA
				adb    -- ArchDepthB
				turned -- true
				styTop -- terminalSlab

		create-glyph "schwa.\(suffix)" : glyph-proc
			set-width 0
			set-mark-anchor 'cvDecompose' 0 0
			include : Body [DivFrame 1] XH
				hook   -- AHook
				ada    -- SmallArchDepthA
				adb    -- SmallArchDepthB
				turned -- true
				styTop -- terminalSlab

		create-glyph "schwaRhoticHook.\(suffix)" : glyph-proc
			set-width 0
			set-mark-anchor 'cvDecompose' 0 0
			local subDf : DivFrame (0.75 * para.advanceScaleM) 2
			local stroke : subDf.adviceStroke2 2 3 XH
			include : Body subDf XH
				stroke -- stroke
				hook   -- AHook
				ada    -- [subDf.archDepthAOf SmallArchDepth stroke]
				adb    -- [subDf.archDepthBOf SmallArchDepth stroke]
				turned -- true
				styTop -- terminalSlab
			include : RhoticHookShape (subDf.rightSB - [HSwToV : 1.25 * markFine]) rhoticDf.width [mix 0 XH DesignParameters.eBarPos] [mix 0 XH 0.2]

		create-glyph "schwaRetroflexHook.\(suffix)" : glyph-proc
			set-width 0
			set-mark-anchor 'cvDecompose' 0 0
			local subDf : DivFrame (0.75 * para.advanceScaleM) 2
			local stroke : subDf.adviceStroke2 2 3 XH
			include : Body subDf XH
				stroke -- stroke
				hook   -- AHook
				ada    -- [subDf.archDepthAOf SmallArchDepth stroke]
				adb    -- [subDf.archDepthBOf SmallArchDepth stroke]
				turned -- true
				styTop -- terminalSlab
			include : RetroflexHook.r
				x       -- [mix RightSB rhoticDf.width 0.5]
				y       -- 0
				yAttach -- ([mix 0 XH DesignParameters.eBarPos] - HalfStroke)
				xLink   -- (subDf.rightSB - [HSwToV : 0.5 * stroke])
				refSw   -- [AdviceStroke 4]

	CreateSelectorVariants 'Schwa' 0x18F [Object.keys SchwaConfig] (follow -- 'schwa')
	CreateSelectorVariants 'schwa' 0x259 [Object.keys SchwaConfig]

	CreateSelectorVariants 'schwaRhoticHook'    0x25A  [Object.keys SchwaConfig] (follow -- 'schwa')
	CreateSelectorVariants 'schwaRetroflexHook' 0x1D95 [Object.keys SchwaConfig] (follow -- 'schwa')

	alias 'cyrl/ye' 0x435 'e'

	alias 'cyrl/Schwa' 0x4D8 'Schwa'
	alias 'cyrl/schwa' 0x4D9 'schwa'

	select-variant 'cyrl/abk/Che' 0x4BC (follow -- 'e')
	select-variant 'cyrl/abk/che' 0x4BD (follow -- 'e')
	select-variant 'cyrl/abk/CheDescender' 0x4BE (follow -- 'e')
	select-variant 'cyrl/abk/cheDescender' 0x4BF (follow -- 'e')

	glyph-block-import Letter-Blackboard : BBS BBD
	create-glyph 'mathbb/e' 0x1D556 : glyph-proc
		include : MarkSet.e
		include : SmallEShape [DivFrame 1] XH
			stroke -- BBS
			hook   -- AHook
			bbd    -- BBD
			ada    -- SmallArchDepthA
			adb    -- SmallArchDepthB
		include : intersection
			OShapeOutline.NoOvershoot XH 0 SB RightSB BBS
			union
				VBar.l ((SB + OX) + BBD) 0 XH BBS
				VBar.r ((RightSB - OX) - BBD) [mix 0 XH DesignParameters.eBarPos] XH BBS
