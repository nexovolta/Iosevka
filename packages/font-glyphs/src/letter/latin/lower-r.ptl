$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from "@iosevka/util"
import [MathSansSerif] from "@iosevka/glyph/relation"

glyph-module

glyph-block Letter-Latin-Lower-R : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : LeaningAnchor
	glyph-block-import Mark-Above : MeasureGlyphBounds
	glyph-block-import Letter-Shared : CreateAccentedComposition CreateTurnedLetter
	glyph-block-import Letter-Shared-Shapes : CurlyTail FlatHookDepth PalatalHook RetroflexHook
	glyph-block-import Letter-Shared-Shapes : StemCutY ApplyDiagCut
	glyph-block-import Letter-Latin-Upper-T : TShape

	local dfN : DivFrame 1
	local dfF : DivFrame para.advanceScaleF 1 0.75

	# Modes
	define RMode : object
		Standard           0
		StandardSerifed    1
		NarrowHook         2
		NarrowHookSerifed  3
		Hookless           4
		HooklessSerifed    5
		CornerHook         6
		CornerHookSerifed  7
		Earless            8
		EarlessSerifed     9
		Half              10
		HalfStretch       11

	define [RDim df mode _stroke _strokeBar _fine _sign] : namespace
		local stroke    : fallback _stroke    Stroke
		local strokeBar : fallback _strokeBar stroke
		local strokeA   : mix strokeBar stroke 0.5
		local fine      : fallback _fine : ShoulderFine * (strokeA / Stroke)
		local sign      : Math.sign : fallback _sign (+1)
		local { rBalanceMultiplier rHookMultiplier rHookSwMultiplier rSerifLeftExtender } : match mode
			[Just RMode.Standard]          {  1                 1       (1 / 2)  (1 / 3) }
			[Just RMode.StandardSerifed]   { (4 / 3)           (2 / 3)  (3 / 4)  (2 / 3) }
			[Just RMode.NarrowHook]        {  1                 1       (1 / 2)  (1 / 3) }
			[Just RMode.NarrowHookSerifed] { (4 / 3)           (2 / 3)  (3 / 4)  (2 / 3) }
			[Just RMode.Hookless]          { (2 * df.adws - 1)  0        0       (1 / 3) }
			[Just RMode.HooklessSerifed]   { (2 * df.adws - 1)  0        0       (1 / 3) }
			[Just RMode.CornerHook]        { (5 / 8)            0        0       (1 / 3) }
			[Just RMode.CornerHookSerifed] { (4 / 3)            0        0       (2 / 3) }
			[Just RMode.Earless]           {  1                 1       (1 / 2)  (1 / 3) }
			[Just RMode.EarlessSerifed]    { (4 / 3)            1       (1 / 2)  (2 / 3) }
			[Just RMode.Half]              {  1                 0        0        0      }
			[Just RMode.HalfStretch]       {  1                 1       (1 / 2)   0      }

		export : local rBarLeftX : match mode
			[Just RMode.Half] : mix df.leftSB (df.middle - [HSwToV : 0.5 * strokeBar] - [IBalance2 df]) rBalanceMultiplier
			[Just RMode.HalfStretch] : df.middle - [HSwToV : 0.5 * strokeBar]
			__                : df.leftSB + RBalance * rBalanceMultiplier
		export : local rBarRightX : df.width - rBarLeftX

		local rTopLeftSerifX : rBarLeftX + [HSwToV : 0.5 * strokeBar]
		local rTopRightSerifX : df.width - rTopLeftSerifX
		export : local rTopSerifJut : match mode
			([Just RMode.Half] || [Just RMode.HalfStretch]) : Math.max ([HSwToV : 0.5 * strokeBar] + SideJut) : mix (MidJutCenter - [IBalance df]) (rTopLeftSerifX - df.leftSB) rSerifLeftExtender
			__                : [HSwToV : 0.5 * strokeBar] + SideJut + RBalance * rSerifLeftExtender
		export : local [rTopLeftSerif  y] : tagged 'serifLT' : HSerif.lt rTopLeftSerifX  y rTopSerifJut strokeA
		export : local [rTopRightSerif y] : tagged 'serifRT' : HSerif.rt rTopRightSerifX y rTopSerifJut strokeA

		local rBottomLeftSerifX : match mode
			([Just RMode.Half] || [Just RMode.HalfStretch]) : rTopLeftSerifX + [IBalance df]
			__                : begin rTopLeftSerifX
		local rBottomRightSerifX : df.width - rBottomLeftSerifX
		export : local rBottomSerifJutOut : match mode
			([Just RMode.Half] || [Just RMode.HalfStretch]) : rTopSerifJut + [IBalance df]
			__                : begin rTopSerifJut
		export : local rBottomSerifJutIn : mix [HSwToV : 0.5 * strokeBar] rBottomSerifJutOut : match mode
			([Just RMode.Half] || [Just RMode.HalfStretch]) : begin 1.0
			__                : begin 1.2
		export : local [rBottomLeftSerif y] : tagged 'serifLB' : union
			HSerif.lb rBottomLeftSerifX y rBottomSerifJutOut strokeA
			HSerif.rb rBottomLeftSerifX y rBottomSerifJutIn  strokeA
		export : local [rBottomRightSerif y] : tagged 'serifRB' : union
			HSerif.lb rBottomRightSerifX y rBottomSerifJutIn  strokeA
			HSerif.rb rBottomRightSerifX y rBottomSerifJutOut strokeA

		local rHookRightXFull : match mode
			([Just RMode.NarrowHook] || [Just RMode.NarrowHookSerifed]) : mix
				rBarLeftX + [HSwToV strokeBar]
				df.rightSB + RBalance2 * rBalanceMultiplier - (OX - O)
				mix 0.85 1.15 : if (para.advanceScaleF < 1) ((1 - df.adws) / (1 - para.advanceScaleF)) 0
			[Just RMode.Half] : Math.max
				rBarLeftX + [HSwToV : strokeBar + 0.125 * stroke] + TINY + [Math.abs : TanSlope * stroke]
				[Arch.adjust-x.top (rBarLeftX + [HSwToV : 0.5 * strokeBar] + HookX) (sw -- strokeA)] - OXHook
			[Just RMode.HalfStretch] : df.rightSB + RBalance2 * rBalanceMultiplier - (OX - O)
			__ : df.rightSB + RBalance2 * rBalanceMultiplier - (OX - O)
		export : local rArchMiddleX : match mode
			([Just RMode.Standard]        || [Just RMode.NarrowHook])        : mix (rBarLeftX + [HSwToV : strokeBar - fine]) rHookRightXFull (0.54 + sign * 2 * TanSlope * strokeBar / Width)
			([Just RMode.StandardSerifed] || [Just RMode.NarrowHookSerifed]) : mix (rBarLeftX + [HSwToV : strokeBar - fine]) rHookRightXFull (0.59 + sign * 2 * TanSlope * strokeBar / Width)
			([Just RMode.Hookless]        || [Just RMode.HooklessSerifed])   : mix df.width rHookRightXFull : Math.max 1.01 (1.25 * [mix 1 para.advanceScaleF 2])
			([Just RMode.CornerHook]      || [Just RMode.CornerHookSerifed]) : rHookRightXFull - [HSwToV : 0.5 * strokeBar]
			__                                                               : mix rBarLeftX rHookRightXFull 0.5
		export : local rArchCoMiddleX : df.width - rArchMiddleX
		local pMixIn : match mode
			([Just RMode.StandardSerifed] || [Just RMode.NarrowHookSerifed] || [Just RMode.CornerHook] || [Just RMode.CornerHookSerifed]) : begin
				0.65 + sign * 4 * TanSlope * strokeA / Width + 0.25 * strokeA / Width
			__ : begin
				0.65 + sign * 4 * TanSlope * strokeA / Width
		local rMiddleIn : [mix (rBarLeftX + [HSwToV strokeBar]) (rHookRightXFull - [HSwToV : 1.05 * strokeA]) pMixIn] - sign * CorrectionOMidS
		export : local rSkew : clamp 0 HVContrast ((rArchMiddleX - rMiddleIn) / stroke - sign * TanSlope)
		export : local rHookRightX : match mode
			[Just RMode.Hookless]        : rArchMiddleX + TINY
			[Just RMode.HooklessSerifed] : mix df.width rHookRightXFull df.adws
			__                           : begin rHookRightXFull
		export : local rHookLeftX : df.width - rHookRightX
		export : local rHookDepthY : RHook * rHookMultiplier + stroke * rHookSwMultiplier
		export : local rCorX : match mode
			([Just RMode.CornerHook] || [Just RMode.CornerHookSerifed]) : begin 0
			__ : CorrectionOMidS * [linreg 72 0.75 108 1 stroke]
		export : local rArchTopShiftY : match mode
			([Just RMode.Hookless] || [Just RMode.HooklessSerifed]) : O * [clamp 0 1 : StrokeWidthBlend 0 16]
			__ : begin 0
		local rArchDepth : match mode
			([Just RMode.Earless] || [Just RMode.EarlessSerifed]) : begin SmallArchDepth
			[Just RMode.Half]                                     : begin Hook
			[Just RMode.HalfStretch]                              : begin Hook
			__                                                    : 0.47 * (XH - 0)
		export : local rArchDepthA : ArchDepthAClamped XH 0
			ArchDepthAOf rArchDepth
			ArchDepthBOf rArchDepth
		export : local rArchDepthB : ArchDepthBClamped XH 0
			ArchDepthAOf rArchDepth
			ArchDepthBOf rArchDepth

		export : define [setMarks top bottom doTopSerif doBottomSerif] : glyph-proc
			include : LeaningAnchor.Below.VBar.l rBarLeftX strokeBar
			include : LeaningAnchor.Above.Hook [if doTopSerif (rTopLeftSerifX - rTopSerifJut) rBarLeftX] rHookRightX
			set-base-anchor 'overlay' (rBarLeftX + [HSwToV : 0.5 * strokeBar]) [mix bottom top 0.5]
			set-base-anchor 'hooktopAttach' (rBarLeftX + [HSwToV : 0.5 * strokeBar]) top
			local xAtt : if doBottomSerif (rBottomLeftSerifX + rBottomSerifJutIn) (rBarLeftX + [HSwToV strokeBar])
			local xPos : xAtt + [if doBottomSerif 0 : PalatalHook.adviceGap Stroke]
			set-base-anchor 'palatalHookAttach' xAtt bottom
			set-base-anchor 'palatalHookPos'    xPos bottom
			currentGlyph.copyBaseAnchorIfAbsent 'leaningAbove' 'above'
			currentGlyph.copyBaseAnchorIfAbsent 'leaningBelow' 'below'

		export : define [setTurnedMarks top bottom doTopSerif doBottomSerif] : glyph-proc
			include : LeaningAnchor.Above.VBar.r rBarRightX strokeBar
			include : LeaningAnchor.Below.Hook [if doTopSerif (rTopRightSerifX + rTopSerifJut) rBarRightX] rHookLeftX
			set-base-anchor 'overlay' (rBarRightX - [HSwToV : 0.5 * strokeBar]) [mix bottom top 0.5]
			local xAtt : if doTopSerif (rTopRightSerifX + rTopSerifJut) rBarRightX
			local xPos : xAtt + [if doTopSerif 0 : if doBottomSerif (rTopSerifJut - [HSwToV : 0.5 * strokeBar]) SideJut]
			set-base-anchor 'palatalHookAttach' xAtt bottom
			set-base-anchor 'palatalHookPos'    xPos bottom
			currentGlyph.copyBaseAnchorIfAbsent 'leaningAbove' 'above'
			currentGlyph.copyBaseAnchorIfAbsent 'leaningBelow' 'below'

		export : define [setReversedMarks top bottom doTopSerif doBottomSerif] : glyph-proc
			include : LeaningAnchor.Below.VBar.r rBarRightX strokeBar
			include : LeaningAnchor.Above.Hook [if doTopSerif (rTopRightSerifX + rTopSerifJut) rBarRightX] rHookLeftX
			set-base-anchor 'overlay' (rBarRightX - [HSwToV : 0.5 * strokeBar]) [mix bottom top 0.5]
			set-base-anchor 'hooktopAttach' (rBarRightX - [HSwToV : 0.5 * strokeBar]) top
			local xAtt : if doBottomSerif (rBottomRightSerifX + rBottomSerifJutOut) rBarRightX
			local xPos : xAtt + [if doBottomSerif 0 : PalatalHook.adviceGap Stroke]
			set-base-anchor 'palatalHookAttach' xAtt bottom
			set-base-anchor 'palatalHookPos'    xPos bottom
			currentGlyph.copyBaseAnchorIfAbsent 'leaningAbove' 'above'
			currentGlyph.copyBaseAnchorIfAbsent 'leaningBelow' 'below'

		export : define [setInvertedMarks top bottom doTopSerif doBottomSerif] : glyph-proc
			include : LeaningAnchor.Above.VBar.l rBarLeftX strokeBar
			include : LeaningAnchor.Below.Hook [if doTopSerif (rTopLeftSerifX - rTopSerifJut) rBarLeftX] rHookRightX
			set-base-anchor 'overlay' (rBarLeftX + [HSwToV : 0.5 * strokeBar]) [mix bottom top 0.5]
			set-base-anchor 'palatalHookAttach' rHookRightX (bottom + rHookDepthY)
			set-base-anchor 'palatalHookPos'    rHookRightX  bottom
			currentGlyph.copyBaseAnchorIfAbsent 'leaningAbove' 'above'
			currentGlyph.copyBaseAnchorIfAbsent 'leaningBelow' 'below'

	define [RLeftBar x bot top cut _sw] : begin
		local sw : fallback _sw Stroke
		local y : StemCutY (bot -- bot) (top -- top) (cut -- [fallback cut ''])
		return : union
			tagged 'strokeL' : VBar.l x y.bot y.top sw
			ApplyDiagCut (cut -- [fallback cut '']) (side -- 'l') (x -- x) (bot -- bot) (top -- top) (sw -- sw)

	define SmallRShape : namespace
		export : define [Standard df md top bottom doTopSerif doBottomSerif cut] : glyph-proc
			define [object rBarLeftX rBottomLeftSerif rTopLeftSerif rArchMiddleX rSkew rHookRightX rHookDepthY rCorX rArchDepthA] : RDim df md nothing nothing nothing (+1)
			include : dispiro
				widths.lhs
				g4.up.start rHookRightX (top - rHookDepthY) [heading Upward]
				arcvh 32 DesignParameters.rHookSuperness
				g4.left.mid (rArchMiddleX - rCorX) (top - O) [widths.lhs.heading Stroke {.x (-rSkew) .y (-1)}]
				archv 32
				straight.down.end (rBarLeftX + [HSwToV : Stroke - ShoulderFine]) [Math.max (bottom + TINY) (top - rArchDepthA)] [widths.lhs.heading ShoulderFine Downward]
			include : RLeftBar rBarLeftX bottom top cut
			if doBottomSerif : include : rBottomLeftSerif bottom
			if doTopSerif    : include : rTopLeftSerif    top

		define [HooklessShapeImpl doHookSerif] : function [df md top bottom doTopSerif doBottomSerif cut] : glyph-proc
			define [object rBarLeftX rBottomLeftSerif rTopLeftSerif rArchMiddleX rHookRightX rCorX rArchTopShiftY rArchDepthA] : RDim df md nothing nothing nothing (+1)
			define [ArcKnots] : list
				flat (rHookRightX  - rCorX) (top - rArchTopShiftY) [if doHookSerif [heading Leftward] null]
				curl (rArchMiddleX - rCorX) (top - rArchTopShiftY) [if doHookSerif [heading Leftward] null]
				archv
				straight.down.end (rBarLeftX + [HSwToV : Stroke - ShoulderFine]) [Math.max (bottom + TINY) (top - rArchDepthA)] [widths.lhs.heading ShoulderFine Downward]
			include : dispiro
				widths.lhs (Stroke - rArchTopShiftY)
				ArcKnots
			include : RLeftBar rBarLeftX bottom top cut
			if doHookSerif : include : intersection
				VSerif.dr (rHookRightX - rCorX) top VJut
				spiro-outline
					ArcKnots
					corner (rBarLeftX + [HSwToV : Stroke - ShoulderFine]) bottom
					corner VERY-FAR bottom
					corner VERY-FAR top
			if doBottomSerif : include : rBottomLeftSerif bottom
			if doTopSerif    : include : rTopLeftSerif    top

		export : define [Hookless   df md top bottom ts bs cut] : [HooklessShapeImpl false] df md top bottom ts bs cut
		export : define [CornerHook df md top bottom ts bs cut] : [HooklessShapeImpl true]  df md top bottom ts bs cut

		export : define [FlatTop df md top bottom doTopSerif doBottomSerif cut] : glyph-proc
			define [object rBarLeftX rArchMiddleX rHookRightX rHookDepthY rBottomLeftSerif rTopLeftSerif] : RDim df md nothing nothing nothing (+1)
			include : dispiro
				widths.lhs
				g4.up.start rHookRightX (top - rHookDepthY) [heading Upward]
				arcvh nothing DesignParameters.rHookSuperness
				flat [Arch.adjust-x.top rArchMiddleX] top
				curl (rBarLeftX - O) top [heading Leftward]
			include : RLeftBar rBarLeftX bottom top cut
			if doBottomSerif : include : rBottomLeftSerif bottom
			if doTopSerif    : include : rTopLeftSerif    top

		define [EarlessCornerShapeImpl offsetY0] : function [df md top bottom doTopSerif doBottomSerif cut] : glyph-proc
			define [object rBarLeftX rArchMiddleX rHookRightX rHookDepthY rBottomLeftSerif] : RDim df md nothing nothing nothing (+1)
			include : dispiro
				widths.lhs
				g4.up.start rHookRightX (top - rHookDepthY) [heading Upward]
				arcvh nothing DesignParameters.rHookSuperness
				g4.left.mid (rArchMiddleX - CorrectionOMidS) (top - O) [heading Leftward]
				g4   rBarLeftX (top - DToothlessRise)
			include : RLeftBar rBarLeftX bottom (top - offsetY0) cut
			if doBottomSerif : include : rBottomLeftSerif bottom

		export : define [EarlessCorner    df md top bottom ts bs cut] : [EarlessCornerShapeImpl DToothlessRise] df md top bottom ts bs cut
		export : define [EarlessCornerHTB df md top bottom ts bs cut] : [EarlessCornerShapeImpl 0]              df md top bottom ts bs cut

		export : define [EarlessRounded df md top bottom doTopSerif doBottomSerif cut] : glyph-proc
			define [object rBarLeftX rHookRightX rHookDepthY rBottomLeftSerif rArchDepthA] : RDim df md nothing nothing nothing (+1)
			local y : StemCutY (bot -- bottom) (top -- top) (cut -- [fallback cut ''])
			include : dispiro
				widths.lhs
				g4   [Math.max rHookRightX : rBarLeftX + [HSwToV : 2.25 * Stroke]] (top - rHookDepthY)
				HookStart top
				flat rBarLeftX [Math.max (y.bot + TINY + [HSwToV : Math.abs : TanSlope * Stroke]) (top - rArchDepthA)]
				curl rBarLeftX y.bot [heading Downward]
			include : ApplyDiagCut (cut -- [fallback cut '']) (side -- 'l') (x -- rBarLeftX) (bot -- bottom) (top -- top)
			if doBottomSerif : include : rBottomLeftSerif bottom

		define [HooklessFlapImpl doHookSerif] : function [df md top bottom doTopSerif doBottomSerif] : glyph-proc
			define [object rBarLeftX rBottomLeftSerif rArchMiddleX rHookRightX rCorX rArchTopShiftY rArchDepthA] : RDim df md nothing nothing nothing (+1)
			define [ArcKnots] : list
				flat (rHookRightX  - rCorX) (top - rArchTopShiftY) [if doHookSerif [heading Leftward] null]
				curl (rArchMiddleX - rCorX) (top - rArchTopShiftY) [if doHookSerif [heading Leftward] null]
				archv
				flat rBarLeftX [Math.max (bottom + TINY + [HSwToV : Math.abs : TanSlope * Stroke]) (top - rArchDepthA)] [widths.lhs]
				curl rBarLeftX bottom [heading Downward]
			include : dispiro
				widths.lhs (Stroke - rArchTopShiftY)
				ArcKnots
			if doHookSerif : include : intersection
				VSerif.dr (rHookRightX - rCorX) top VJut
				spiro-outline
					ArcKnots
					corner (rBarLeftX + TINY) bottom
					corner VERY-FAR bottom
					corner VERY-FAR top
			if doBottomSerif : include : rBottomLeftSerif bottom

		export : define [HooklessFlap   df md top bottom ts bs] : [HooklessFlapImpl false] df md top bottom ts bs
		export : define [CornerHookFlap df md top bottom ts bs] : [HooklessFlapImpl true]  df md top bottom ts bs

	define SmallRevRShape : namespace
		export : define [Standard df md top bottom doTopSerif doBottomSerif] : glyph-proc
			define [object rBarRightX rBottomRightSerif rTopRightSerif rArchCoMiddleX rSkew rHookLeftX rHookDepthY rCorX rArchDepthB] : RDim df md nothing nothing nothing (-1)
			include : dispiro
				widths.rhs
				g4.up.start rHookLeftX (top - rHookDepthY) [heading Upward]
				arcvh 32 DesignParameters.rHookSuperness
				g4.right.mid (rArchCoMiddleX - rCorX) (top - O) [widths.rhs.heading Stroke {.x (-rSkew) .y (+1)}]
				archv 32
				straight.down.end (rBarRightX - [HSwToV : Stroke - ShoulderFine]) [Math.max (bottom + TINY) (top - rArchDepthB)] [widths.rhs.heading ShoulderFine Downward]
			include : tagged 'strokeR' : VBar.r rBarRightX bottom top
			if doBottomSerif : include : rBottomRightSerif bottom
			if doTopSerif    : include : rTopRightSerif    top

		export : define [Half df md top bottom doTopSerif doBottomSerif] : glyph-proc
			define [object rBarRightX rBottomRightSerif rTopRightSerif rHookLeftX rArchDepthB] : RDim df md nothing nothing nothing (-1)
			include : dispiro
				widths.rhs
				g4.right.start rHookLeftX (top - O)
				archv
				straight.down.end (rBarRightX - [HSwToV : Stroke - ShoulderFine]) [Math.max (bottom + TINY) (top - rArchDepthB)] [widths.rhs.heading ShoulderFine Downward]
			include : tagged 'strokeR' : VBar.r rBarRightX bottom top
			if doBottomSerif : include : rBottomRightSerif bottom
			if doTopSerif    : include : rTopRightSerif    top

		define [HooklessShapeImpl doHookSerif] : function [df md top bottom doTopSerif doBottomSerif] : glyph-proc
			define [object rBarRightX rBottomRightSerif rTopRightSerif rArchCoMiddleX rHookLeftX rCorX rArchTopShiftY rArchDepthB] : RDim df md nothing nothing nothing (-1)
			define [ArcKnots] : list
				flat (rHookLeftX     - rCorX) (top - rArchTopShiftY) [if doHookSerif [heading Rightward] null]
				curl (rArchCoMiddleX - rCorX) (top - rArchTopShiftY) [if doHookSerif [heading Rightward] null]
				archv
				straight.down.end (rBarRightX - [HSwToV : Stroke - ShoulderFine]) [Math.max (bottom + TINY) (top - rArchDepthB)] [widths.rhs.heading ShoulderFine Downward]
			include : dispiro
				widths.rhs (Stroke - rArchTopShiftY)
				ArcKnots
			include : tagged 'strokeR' : VBar.r rBarRightX bottom top
			if doHookSerif : include : intersection
				VSerif.dl (rHookLeftX - rCorX) top VJut
				spiro-outline
					ArcKnots
					corner (rBarRightX - [HSwToV : Stroke - ShoulderFine]) bottom
					corner (-VERY-FAR) bottom
					corner (-VERY-FAR) top
			if doBottomSerif : include : rBottomRightSerif bottom
			if doTopSerif    : include : rTopRightSerif    top

		export : define [Hookless   df md top bottom ts bs] : [HooklessShapeImpl false] df md top bottom ts bs
		export : define [CornerHook df md top bottom ts bs] : [HooklessShapeImpl true]  df md top bottom ts bs

		export : define [FlatTop df md top bottom doTopSerif doBottomSerif] : glyph-proc
			define [object rBarRightX rArchCoMiddleX rHookLeftX rHookDepthY rBottomRightSerif rTopRightSerif] : RDim df md nothing nothing nothing (-1)
			include : dispiro
				widths.rhs
				g4.up.start rHookLeftX (top - rHookDepthY) [heading Upward]
				arcvh nothing DesignParameters.rHookSuperness
				flat [Arch.adjust-x.top rArchCoMiddleX] top
				curl (rBarRightX + O) top [heading Rightward]
			include : tagged 'strokeR' : VBar.r rBarRightX bottom top
			if doBottomSerif : include : rBottomRightSerif bottom
			if doTopSerif    : include : rTopRightSerif    top

		define [EarlessCornerShapeImpl offsetY0] : function [df md top bottom doTopSerif doBottomSerif] : glyph-proc
			define [object rBarRightX rArchCoMiddleX rHookLeftX rHookDepthY rBottomRightSerif] : RDim df md nothing nothing nothing (-1)
			include : dispiro
				widths.rhs
				g4.up.start rHookLeftX (top - rHookDepthY) [heading Upward]
				arcvh nothing DesignParameters.rHookSuperness
				g4.right.mid (rArchCoMiddleX - CorrectionOMidS) (top - O) [heading Rightward]
				g4   rBarRightX (top - DToothlessRise)
			include : tagged 'strokeR' : VBar.r rBarRightX bottom (top - offsetY0)
			if doBottomSerif : include : rBottomRightSerif bottom

		export : define [EarlessCorner    df md top bottom ts bs] : [EarlessCornerShapeImpl DToothlessRise] df md top bottom ts bs
		export : define [EarlessCornerHTB df md top bottom ts bs] : [EarlessCornerShapeImpl 0]              df md top bottom ts bs

		export : define [EarlessRounded df md top bottom doTopSerif doBottomSerif] : glyph-proc
			define [object rBarRightX rHookLeftX rHookDepthY rBottomRightSerif rArchDepthB] : RDim df md nothing nothing nothing (-1)
			include : dispiro
				widths.rhs
				g4   [Math.min rHookLeftX : rBarRightX - [HSwToV : 2.25 * Stroke]] (top - rHookDepthY)
				HookStart top
				flat rBarRightX [Math.max (bottom + TINY + [HSwToV : Math.abs : TanSlope * Stroke]) (top - rArchDepthB)]
				curl rBarRightX bottom [heading Downward]
			if doBottomSerif : include : rBottomRightSerif bottom

		define [HooklessFlapImpl doHookSerif] : function [df md top bottom doTopSerif doBottomSerif] : glyph-proc
			define [object rBarRightX rBottomRightSerif rArchCoMiddleX rHookLeftX rCorX rArchTopShiftY rArchDepthB] : RDim df md nothing nothing nothing (-1)
			define [ArcKnots] : list
				flat (rHookLeftX     - rCorX) (top - rArchTopShiftY) [if doHookSerif [heading Rightward] null]
				curl (rArchCoMiddleX - rCorX) (top - rArchTopShiftY) [if doHookSerif [heading Rightward] null]
				archv
				flat rBarRightX [Math.max (bottom + TINY + [HSwToV : Math.abs : TanSlope * Stroke]) (top - rArchDepthB)] [widths.rhs]
				curl rBarRightX bottom [heading Downward]
			include : dispiro
				widths.rhs (Stroke - rArchTopShiftY)
				ArcKnots
			if doHookSerif : include : intersection
				VSerif.dl (rHookLeftX - rCorX) top VJut
				spiro-outline
					ArcKnots
					corner (rBarRightX - TINY) bottom
					corner (-VERY-FAR) bottom
					corner (-VERY-FAR) top
			if doBottomSerif : include : rBottomRightSerif bottom

		export : define [HooklessFlap   df md top bottom ts bs] : [HooklessFlapImpl false] df md top bottom ts bs
		export : define [CornerHookFlap df md top bottom ts bs] : [HooklessFlapImpl true]  df md top bottom ts bs

	define SmallRConfig : SuffixCfg.weave
		object # ear
			""               "eared"
			flatTop          "flatTop"
			earlessCorner    "earlessCorner"
			earlessCornerHTB "earlessCornerHTB"
			earlessRounded   "earlessRounded"
		function [ear] : begin
			if (!ear) : return : object
				""            { SmallRShape.Standard         dfN RMode.Standard   RMode.StandardSerifed   }
				hookless      { SmallRShape.Hookless         dfN RMode.Hookless   RMode.HooklessSerifed   }
				cornerHooked  { SmallRShape.CornerHook       dfN RMode.CornerHook RMode.CornerHookSerifed }
				compact       { SmallRShape.Hookless         dfF RMode.Hookless   RMode.HooklessSerifed   }
				narrowHook    { SmallRShape.Standard         dfF RMode.NarrowHook RMode.NarrowHookSerifed }
				# `rFlap` variants
				earlessRoundedHookless     { SmallRShape.HooklessFlap   dfN RMode.Hookless   RMode.HooklessSerifed   }
				earlessRoundedCornerHooked { SmallRShape.CornerHookFlap dfN RMode.CornerHook RMode.CornerHookSerifed }
				earlessRoundedCompact      { SmallRShape.HooklessFlap   dfF RMode.Hookless   RMode.HooklessSerifed   }
				earlessRoundedNarrowHook   { SmallRShape.EarlessRounded dfF RMode.NarrowHook RMode.NarrowHookSerifed }
			if (ear === 'flatTop') : return : object
				""            { SmallRShape.FlatTop          dfN RMode.Earless    RMode.EarlessSerifed    }
			if (ear === 'earlessCorner') : return : object
				""            { SmallRShape.EarlessCorner    dfN RMode.Earless    RMode.EarlessSerifed    }
			if (ear === 'earlessCornerHTB') : return : object
				""            { SmallRShape.EarlessCornerHTB dfN RMode.Earless    RMode.EarlessSerifed    }
			return : object
				""            { SmallRShape.EarlessRounded   dfN RMode.Earless    RMode.EarlessSerifed    }
		function [ear body] : begin
			if (ear === 'earlessCorner' || ear === 'earlessCornerHTB' || ear === 'earlessRounded') : return : object
				""         ""
			if (body === 'earlessRoundedHookless' || body === 'earlessRoundedCornerHooked' || body === 'earlessRoundedCompact' || body === 'earlessRoundedNarrowHook') : return : object
				""         ""
			return : object
				""         ""
				topCut     "topCut"
		object # Serifs
			serifless        { false false }
			topSerifed       { true  false }
			baseSerifed      { false true  }
			serifed          { true  true  }

	foreach { suffix { ear { Body df modeSans modeSerifed } cut { doTS doBS } } } [pairs-of SmallRConfig] : do
		define mode : if (doTS || doBS) modeSerifed modeSans

		create-glyph "r.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.e

			define [object setMarks] : RDim df mode
			include : setMarks XH 0 doTS doBS

			include : Body df mode XH 0 doTS doBS cut

		create-glyph "rLongLeg.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.p

			define [object setMarks] : RDim df mode
			include : setMarks XH Descender doTS doBS

			include : Body df mode XH Descender doTS doBS cut

		create-glyph "rCapLongLeg.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.capDesc

			define [object setMarks] : RDim df mode
			include : setMarks CAP Descender doTS doBS

			include : Body df mode CAP Descender doTS doBS cut

		create-glyph "fInsular.\(suffix)" : glyph-proc
			include [refer-glyph "rLongLeg.\(suffix)"] AS_BASE ALSO_METRICS
			define [object rBarLeftX rHookRightX] : RDim df mode
			include : HBar.b (rBarLeftX - O) (rHookRightX - [Math.max (0.15 * (df.rightSB - df.leftSB)) : HSwToV QuarterStroke]) 0

		create-glyph "FInsular.\(suffix)" : glyph-proc
			include [refer-glyph "rCapLongLeg.\(suffix)"] AS_BASE ALSO_METRICS
			define [object rBarLeftX rHookRightX] : RDim df mode
			include : HBar.b (rBarLeftX - O) (rHookRightX - [Math.max (0.15 * (df.rightSB - df.leftSB)) : HSwToV QuarterStroke]) 0

		create-glyph "rPalatalHook.\(suffix)" : glyph-proc
			include [refer-glyph "r.\(suffix)"] AS_BASE ALSO_METRICS
			local attach : currentGlyph.gizmo.unapply currentGlyph.baseAnchors.palatalHookAttach
			local pos : currentGlyph.gizmo.unapply currentGlyph.baseAnchors.palatalHookPos
			include : PalatalHook.r (x -- pos.x) (y -- pos.y) (xLink -- attach.x)

		create-glyph "turnr.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.e

			define [object setTurnedMarks] : RDim df mode
			include : setTurnedMarks XH 0 doTS doBS

			include : new-glyph : composite-proc
				refer-glyph "r.\(suffix)"
				FlipAround df.middle (XH / 2)

		create-glyph "turnrLongLeg.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.b

			define [object setTurnedMarks] : RDim df mode
			include : setTurnedMarks Ascender 0 doTS doBS

			include : new-glyph : composite-proc
				refer-glyph "rLongLeg.\(suffix)"
				FlipAround df.middle (XH / 2)

		if [not doTS] : begin
			create-glyph "turnrPalatalHook.\(suffix)" : glyph-proc
				include [refer-glyph "turnr.\(suffix)"] AS_BASE ALSO_METRICS
				local attach : currentGlyph.gizmo.unapply currentGlyph.baseAnchors.palatalHookAttach
				local pos : currentGlyph.gizmo.unapply currentGlyph.baseAnchors.palatalHookPos
				include : PalatalHook.r (x -- pos.x) (y -- pos.y) (xLink -- attach.x)

			create-glyph "turnrRTail.\(suffix)" : glyph-proc
				include [refer-glyph "turnr.\(suffix)"] AS_BASE ALSO_METRICS
				eject-contour 'serifLT'
				define [object rBarRightX] : RDim df mode
				include : RetroflexHook.rExt rBarRightX 0

			create-glyph "turnrLongLegRTail.\(suffix)" : glyph-proc
				include [refer-glyph "turnrLongLeg.\(suffix)"] AS_BASE ALSO_METRICS
				eject-contour 'serifLT'
				define [object rBarRightX] : RDim df mode
				include : RetroflexHook.rExt rBarRightX 0

		if [not doBS] : begin
			create-glyph "rRTail.\(suffix)" : glyph-proc
				include [refer-glyph "r.\(suffix)"] AS_BASE ALSO_METRICS
				eject-contour 'serifLB'
				define [object rBarLeftX] : RDim df mode
				include : RetroflexHook.lExt rBarLeftX 0

			create-glyph "rRTailPalatalHook.\(suffix)" : glyph-proc
				set-width df.width
				include : df.markSet.e

				define [object rBarLeftX setMarks] : RDim df mode
				include : setMarks XH 0 doTS doBS

				local hd : FlatHookDepth df
				local tailLength : LongJut * 1.05 * [mix 1 df.adws 0.75]
				define xFinal : rBarLeftX + [Math.max (tailLength + [HSwToV HalfStroke]) (hd.x + 1)] + HalfStroke * TanSlope
				include : Body df mode XH (0 + hd.y) doTS doBS cut
				include : dispiro
					widths.center
					flat (rBarLeftX + [HSwToV HalfStroke]) (0 + hd.y + TINY + [HSwToV : Math.abs : TanSlope * HalfStroke]) [heading Downward]
					curl (rBarLeftX + [HSwToV HalfStroke]) (0 + hd.y)
					arcvh.superness DesignParameters.tightHookSuperness
					flat (rBarLeftX + hd.x) (0 + HalfStroke)
					curl xFinal             (0 + HalfStroke) [heading Rightward]
				include : PalatalHook.r xFinal 0 (yOverflow -- Stroke)

			create-glyph "rCrossedTail.\(suffix)" : glyph-proc
				set-width df.width
				include : df.markSet.e

				define [object rBarLeftX setMarks] : RDim df mode
				include : setMarks XH 0 doTS doBS

				local fine : AdviceStroke 4
				local rinner : XH * 0.15 - fine * 0.75
				local m2 : rBarLeftX + [HSwToV : AdviceStroke 3] - (RightSB - SB) / 2 - [HSwToV : 0.5 * fine]
				local x2 : rBarLeftX + [HSwToV : AdviceStroke 2] + SideJut
				local y2 : rinner * 2 + fine - O
				include : Body df mode XH (y2 + O) doTS doBS cut
				include : dispiro
					widths.rhs
					straight.down.start (rBarLeftX + [HSwToV Stroke]) y2 [heading Downward]
					CurlyTail.f fine 0 m2 x2

			create-glyph "turnrHookTop.\(suffix)" : glyph-proc
				set-width df.width
				include : df.markSet.b

				define [object setTurnedMarks] : RDim df mode
				include : setTurnedMarks Ascender 0 doTS doBS

				include : new-glyph : composite-proc
					refer-glyph "rRTail.\(suffix)"
					FlipAround df.middle (XH / 2)

	select-variant 'r' 'r'
	link-reduced-variant 'r/sansSerif' 'r' MathSansSerif
	select-variant 'turnr'        0x279 (follow -- 'r')
	select-variant 'turnrLongLeg' 0x27A (follow -- 'r')
	select-variant 'turnrRTail'   0x27B (follow -- 'r/hookTopBase')
	select-variant 'rLongLeg'     0x27C (follow -- 'r')
	select-variant 'rRTail'       0x27D (follow -- 'r/rTailBase')
	select-variant 'rFlap'        0x27E (shapeFrom -- 'r')

	select-variant 'rPalatalHook' 0x1D89 (follow -- 'r')
	select-variant 'turnrHookTop' 0x2C79 (follow -- 'r/rTailBase')
	select-variant 'rCrossedTail' 0xAB49 (follow -- 'r/rTailBase')

	select-variant 'turnrLongLegRTail' 0x1DF08 (follow -- 'r/hookTopBase')
	select-variant 'turnrPalatalHook'  0x1DF15 (follow -- 'r/ascBase')
	select-variant 'rFlapPalatalHook'  0x1DF16 (follow -- 'rFlap') (shapeFrom -- 'rPalatalHook')
	select-variant 'rRTailPalatalHook' 0x1DF37 (follow -- 'r/rTailBase')

	select-variant 'SInsular' 0xA784 (follow -- 'r/rTailBase') (shapeFrom -- 'rCapLongLeg')
	select-variant 'sInsular' 0xA785 (follow -- 'r/rTailBase') (shapeFrom -- 'rLongLeg')
	select-variant 'FInsular' 0xA77B (follow -- 'r/rTailBase')
	select-variant 'fInsular' 0xA77C (follow -- 'r/rTailBase')

	CreateAccentedComposition 'turnrBar' 0x1DF50 'turnr' 'barOver'

	glyph-block-export MidHeightRightHookXFromStem
	define [MidHeightRightHookXFromStem g] : begin [g.gizmo.unapply (g.baseAnchors.hooktopAttach || g.baseAnchors.overlay)].x

	define [LFlapStemX xOrig rGn dfOuter] : begin
		local rRef : query-glyph rGn
		local xRStem : begin [rRef.gizmo.unapply (rRef.baseAnchors.hooktopAttach || rRef.baseAnchors.overlay)].x
		local xRHook : begin [rRef.gizmo.unapply (rRef.baseAnchors.leaningAbove || rRef.baseAnchors.above)].x
		local spread : Math.max TINY : xRHook - xRStem + [HSwToV HalfStroke]
		local k : Math.min 1 : (dfOuter.rightSB - xOrig - [HSwToV HalfStroke] - O) / spread
		return : xOrig - k * spread

	define [LFlapStemXForGlyph xOrig rGn dfOuter xRStem] : if para.isQuasiProportional xRStem : LFlapStemX xOrig rGn dfOuter

	define [LFlapLOverlay lGn xShift] : with-transform [Translate xShift 0] : refer-glyph lGn

	define [LFlapBody lGn xShift xStem] : glyph-proc
		local rLeanAbove : currentGlyph.gizmo.unapply currentGlyph.baseAnchors.leaningAbove
		local yHookTop : XH + O
		local yHookBot : rLeanAbove.y - O
		local xStemRight : xStem + [HSwToV HalfStroke] + O
		include : union
			intersection [MaskAbove yHookTop] : LFlapLOverlay lGn xShift
			intersection [MaskBelow yHookBot] : LFlapLOverlay lGn xShift
			intersection [MaskAbove yHookBot] [MaskBelow yHookTop] [MaskLeft xStemRight] : LFlapLOverlay lGn xShift

	link-reduced-variant 'lFlap/r' 'r'
	derive-multi-part-glyphs 'lFlap' 0x1DF11 { 'l' 'lFlap/r' } : lambda [srcs gr] : glyph-proc
		local { l r } srcs
		local df : DivFrame 1
		include : df.markSet.b

		local lRef : query-glyph l
		local xOrig : begin [lRef.gizmo.unapply (lRef.baseAnchors.hooktopAttach || lRef.baseAnchors.overlay)].x
		local lOverlay : lRef.gizmo.unapply lRef.baseAnchors.overlay

		include [refer-glyph r] AS_BASE ALSO_METRICS
		local xRStem : MidHeightRightHookXFromStem currentGlyph
		local xStem : LFlapStemXForGlyph xOrig r df xRStem
		local xShift : xStem - xOrig
		include : Translate (xStem - xRStem) 0

		eject-contour 'strokeL'
		eject-contour 'serifLT'
		eject-contour 'serifLB'

		include : LFlapBody l xShift xStem

		include : LeaningAnchor.Above.At xStem
		include : LeaningAnchor.Below.At xStem
		set-base-anchor 'overlay' (lOverlay.x + xShift) lOverlay.y
		set-base-anchor 'hooktopAttach' xStem XH

		local b : include : MeasureGlyphBounds
		if b : begin
			local xCenterShift : df.middle - [mix b.xMin b.xMax 0.5]
			if ([Math.abs xCenterShift] > 1e-6) : currentGlyph.applyTransform [ApparentTranslate xCenterShift 0] true

	define HalfRShape : namespace
		export : define [Standard df md top bottom doTopSerif doBottomSerif cut] : glyph-proc
			define [object rBarLeftX rBottomLeftSerif rTopLeftSerif rHookRightX rArchDepthA] : RDim df md
			include : dispiro
				widths.lhs
				g4.left.start rHookRightX (top - O)
				archv
				straight.down.end (rBarLeftX + [HSwToV : Stroke - ShoulderFine]) [Math.max (bottom + TINY) (top - rArchDepthA)] [widths.lhs.heading ShoulderFine Downward]
			include : RLeftBar rBarLeftX bottom top cut
			if doBottomSerif : include : rBottomLeftSerif bottom
			if doTopSerif    : include : rTopLeftSerif    top

		export : define [FlatTop df md top bottom doTopSerif doBottomSerif cut _sw] : glyph-proc
			define [object rBarLeftX rBottomLeftSerif rTopLeftSerif rHookRightX rHookDepthY] : RDim df md
			local sw : fallback _sw Stroke
			local xHookRight : rHookRightX + 0.12 * HookX
			local yHookDepth : rHookDepthY + 0.10 * RHook
			local xArchMid : mix rBarLeftX xHookRight 0.5
			include : dispiro
				widths.lhs sw
				g4.up.start xHookRight (top - yHookDepth) [heading Upward]
				arcvh nothing DesignParameters.rHookSuperness
				flat [Arch.adjust-x.top xArchMid] top
				curl (rBarLeftX - O) top [heading Leftward]
			include : RLeftBar rBarLeftX bottom top cut sw
			if doBottomSerif : include : rBottomLeftSerif bottom
			if doTopSerif    : include : rTopLeftSerif    top

		export : define [EarlessCorner df md top bottom doTopSerif doBottomSerif cut] : glyph-proc
			define [object rBarLeftX rBottomLeftSerif rHookRightX] : RDim df md
			include : dispiro
				widths.lhs
				g4.left.start rHookRightX (top - O)
				g4   rBarLeftX (top - DToothlessRise)
			include : RLeftBar rBarLeftX bottom (top - DToothlessRise) cut
			if doBottomSerif : include : rBottomLeftSerif bottom

		export : define [EarlessRounded df md top bottom doTopSerif doBottomSerif cut] : glyph-proc
			define [object rBarLeftX rBottomLeftSerif rHookRightX rArchDepthA] : RDim df md
			local y : StemCutY (bot -- bottom) (top -- top) (cut -- [fallback cut ''])
			include : dispiro
				widths.lhs
				g4.left.start rHookRightX (top - O)
				archv
				flat rBarLeftX [Math.max (y.bot + TINY + [HSwToV : Math.abs : TanSlope * Stroke]) (top - rArchDepthA)]
				curl rBarLeftX y.bot [heading Downward]
			include : ApplyDiagCut (cut -- [fallback cut '']) (side -- 'l') (x -- rBarLeftX) (bot -- bottom) (top -- top)
			if doBottomSerif : include : rBottomLeftSerif bottom

	define HalfRConfig : SuffixCfg.weave
		object # Body
			""               HalfRShape.Standard
			flatTop          HalfRShape.FlatTop
			earlessCorner    HalfRShape.EarlessCorner
			earlessRounded   HalfRShape.EarlessRounded
		function [body] : begin
			if (body === HalfRShape.EarlessCorner || body === HalfRShape.EarlessRounded) : return : object
				""         ""
			return : object
				""         ""
				topCut     "topCut"
		object # Serifs
			serifless      { false false }
			topSerifed     { true  false }
			baseSerifed    { false true  }
			serifed        { true  true  }

	define [HalfRHookOnly Body df _mode] : glyph-proc
		local md : fallback _mode RMode.Half
		include : [if (Body === HalfRShape.EarlessRounded) HalfRShape.Standard Body] df md XH 0 false false
		eject-contour 'strokeL'

	# Flat-top extra hook: same TR arc as the body, no stem. Curl into the first
	# hook's flat top so the join is a clip, not a vertical cap / T-junction.
	define [FlatTopExtraHook df _sw] : glyph-proc
		define [object rBarLeftX rHookRightX rHookDepthY] : RDim df RMode.Half
		local sw : fallback _sw : Stroke * [StrokeWidthBlend 0.8 0.6]
		local xHookRight : rHookRightX + 0.12 * HookX
		local yHookDepth : rHookDepthY + 0.10 * RHook
		local xArchMid : mix rBarLeftX xHookRight 0.5
		include : dispiro
			widths.lhs sw
			g4.up.start xHookRight (XH - yHookDepth) [heading Upward]
			arcvh nothing DesignParameters.rHookSuperness
			flat [Arch.adjust-x.top xArchMid] XH
			curl (rBarLeftX - O) XH [heading Leftward]

	define [doubleRHookShift dim Body] : Math.max TINY : dim.rHookRightX - dim.rBarLeftX - [HSwToV Stroke]

	define [doubleRHalfDf pairWidth Body] : begin
		local dfI : DivFrame para.advanceScaleI
		local dim : RDim dfI RMode.Half
		local xShift0 : doubleRHookShift dim Body
		local k : Math.min 1 (pairWidth / (dfI.width + xShift0))
		DivFrame (k * para.advanceScaleI)

	define [MaskedExtraHalfRHook Body df xShift rBarLeftX] : glyph-proc
		define [object rArchDepthA] : RDim df RMode.Half
		define [extra] : with-transform [ApparentTranslate xShift 0] : HalfRHookOnly Body df
		# Mask the extra stem side only; do not square-cut the inner at XH - Stroke.
		include : difference [extra] : intersection
			MaskBelow (XH - rArchDepthA)
			MaskLeft (rBarLeftX + xShift + [HSwToV Stroke])

	define [MaskedFlippedHalfRHook Body df rBarLeftX _mode] : glyph-proc
		local md : fallback _mode RMode.Half
		define [object rArchDepthA] : RDim df md
		local xStemC : rBarLeftX + [HSwToV : 0.5 * Stroke]
		define [extra] : with-transform [FlipAround xStemC 0 (-1) 1] : HalfRHookOnly Body df md
		include : difference [extra] : intersection
			MaskBelow (XH - rArchDepthA)
			MaskRight rBarLeftX

	foreach { suffix { Body cut { doTS doBS } } } [pairs-of HalfRConfig] : do
		create-glyph "rHalf.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleI
			include : df.markSet.e

			define [object setMarks] : RDim df RMode.Half
			include : setMarks XH 0 doTS doBS

			include : Body df RMode.Half XH 0 doTS doBS cut

		create-glyph "rHalfPalatalHook.\(suffix)" : glyph-proc
			include [refer-glyph "rHalf.\(suffix)"] AS_BASE ALSO_METRICS
			local attach : currentGlyph.gizmo.unapply currentGlyph.baseAnchors.palatalHookAttach
			local pos : currentGlyph.gizmo.unapply currentGlyph.baseAnchors.palatalHookPos
			include : PalatalHook.r (x -- pos.x) (y -- pos.y) (xLink -- attach.x)

		create-glyph "rDouble.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleM
			include : df.markSet.e
			local dfHalf : if (Body === HalfRShape.FlatTop) [DivFrame para.advanceScaleI] [doubleRHalfDf df.width Body]

			define [object rBarLeftX rHookRightX setMarks] : RDim dfHalf RMode.Half
			local hookSw : Stroke * [StrokeWidthBlend 0.8 0.6]
			local xHookRight : if (Body === HalfRShape.FlatTop) (rHookRightX + 0.12 * HookX) rHookRightX
			local xArchMid : mix rBarLeftX xHookRight 0.5
			local xShift : Math.max TINY : if (Body === HalfRShape.FlatTop) (xHookRight - xArchMid - [HSwToV : 0.4 * hookSw]) (rHookRightX - rBarLeftX - [HSwToV Stroke])
			include : setMarks XH 0 doTS doBS
			if (Body === HalfRShape.FlatTop)
			: then : include : Body dfHalf RMode.Half XH 0 doTS doBS cut hookSw
			: else : include : Body dfHalf RMode.Half XH 0 doTS doBS cut
			if (Body === HalfRShape.FlatTop)
			: then : include : with-transform [ApparentTranslate xShift 0] : FlatTopExtraHook dfHalf
			: else : include : MaskedExtraHalfRHook Body dfHalf xShift rBarLeftX
			include : LeaningAnchor.Above.Hook rBarLeftX (xHookRight + xShift)
			set-base-anchor 'overlay' df.middle [mix 0 XH 0.5]

		create-glyph "rDoubleCrossedTail.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleM
			include : df.markSet.e
			local dfHalf : if (Body === HalfRShape.FlatTop) [DivFrame para.advanceScaleI] [doubleRHalfDf df.width Body]

			define [object rBarLeftX rHookRightX setMarks] : RDim dfHalf RMode.Half
			local hookSw : Stroke * [StrokeWidthBlend 0.8 0.6]
			local xHookRight : if (Body === HalfRShape.FlatTop) (rHookRightX + 0.12 * HookX) rHookRightX
			local xArchMid : mix rBarLeftX xHookRight 0.5
			local xShift : Math.max TINY : if (Body === HalfRShape.FlatTop) (xHookRight - xArchMid - [HSwToV : 0.4 * hookSw]) (rHookRightX - rBarLeftX - [HSwToV Stroke])
			include : setMarks XH 0 doTS false

			local fine : AdviceStroke 4
			local rinner : XH * 0.15 - fine * 0.75
			local m2 : rBarLeftX + [HSwToV : AdviceStroke 3] - (RightSB - SB) / 2 - [HSwToV : 0.5 * fine]
			local x2 : rBarLeftX + [HSwToV : AdviceStroke 2] + SideJut
			local y2 : rinner * 2 + fine - O
			if (Body === HalfRShape.FlatTop)
			: then : include : Body dfHalf RMode.Half XH (y2 + O) doTS false cut hookSw
			: else : include : Body dfHalf RMode.Half XH (y2 + O) doTS false cut
			if (Body === HalfRShape.FlatTop)
			: then : include : with-transform [ApparentTranslate xShift 0] : FlatTopExtraHook dfHalf
			: else : include : MaskedExtraHalfRHook Body dfHalf xShift rBarLeftX
			include : dispiro
				widths.rhs
				straight.down.start (rBarLeftX + [HSwToV Stroke]) y2 [heading Downward]
				CurlyTail.f fine 0 m2 x2
			include : LeaningAnchor.Above.Hook rBarLeftX (xHookRight + xShift)

		create-glyph "rMidHeightLeftHook.\(suffix)" : glyph-proc
			local df : include : DivFrame 1
			include : df.markSet.e
			define [object rBarLeftX] : RDim df RMode.HalfStretch
			# Stem at center; each hook fills half the cell (stretched to SB).
			# Skip r top serifs so they do not collide with the hooks.
			if (Body === HalfRShape.FlatTop)
			: then : include : TShape df XH false doBS
			: else : begin
				local hookBody : if (Body === HalfRShape.EarlessCorner) HalfRShape.Standard Body
				include : hookBody df RMode.HalfStretch XH 0 false doBS cut
				include : MaskedFlippedHalfRHook hookBody df rBarLeftX RMode.HalfStretch
			include : LeaningAnchor.Above.At df.middle
			include : LeaningAnchor.Below.At df.middle
			set-base-anchor 'overlay' df.middle [mix 0 XH 0.5]
			set-base-anchor 'hooktopAttach' df.middle XH

	select-variant 'rHalf' 0xAB47
	select-variant 'rDouble' 0xAB48 (follow -- 'rHalf')
	select-variant 'rDoubleCrossedTail' 0xAB4A (follow -- 'rHalf')
	select-variant 'rMidHeightLeftHook' 0x1DF28 (follow -- 'rHalf')
	CreateTurnedLetter 'turnrMidHeightLeftHook' 0x1DF57 'rMidHeightLeftHook' HalfAdvance (XH / 2)

	define PigtailRBodies : object
		standard     { SmallRShape.Standard   SmallRevRShape.Standard   RMode.Standard   }
		hookless     { SmallRShape.Hookless   SmallRevRShape.Hookless   RMode.Hookless   }
		cornerHooked { SmallRShape.CornerHook SmallRevRShape.CornerHook RMode.CornerHook }
		narrowHook   { SmallRShape.Standard   SmallRevRShape.Standard   RMode.NarrowHook }
		half         { HalfRShape.Standard    SmallRevRShape.Half       RMode.Half       }

	define [PigtailAttachHook Body md fRev xStem _doTS] : glyph-proc
		local doTS : fallback _doTS false
		local df dfF
		define [object rBarLeftX rBarRightX] : RDim df md nothing nothing nothing [if fRev (-1) (+1)]
		local xR : mix (rBarLeftX + [HSwToV HalfStroke]) (rBarRightX - [HSwToV HalfStroke]) [if fRev 1 0]
		include : new-glyph : glyph-proc
			include : Body df md XH 0 doTS false
			if fRev
			: then : begin
				eject-contour 'serifRB'
				if [not doTS] : eject-contour 'serifRT'
			: else : begin
				eject-contour 'serifLB'
				if [not doTS] : eject-contour 'serifLT'
			include : FlipAround df.middle (XH / 2)
			include : ApparentTranslate (xStem - (df.width - xR)) 0

	define DotlessIPigtailUprightConfig : object
		serifless          { false false 0.0 false }
		hooky              { false true  1.0 false }
		hookyBottom        { true  false 0.0 false }
		zshaped            { true  true  1.0 false }
		zshapedAsymmetric  { true  true  0.5 false }
		centerSerifed      { true  true  1.0 false }
		reverseHooky       { false true  1.0 true  }
		sshaped            { true  true  1.0 true  }
		sshapedAsymmetric  { true  true  0.5 true  }

	define DotlessIPigtailItalicConfig : object
		serifless                       { false false 0.0 false }
		hooky                           { false true  1.0 false }
		baseSerifed                     { true  false 0.0 false }
		serifed                         { true  true  1.0 false }
		serifedAsymmetric               { true  true  0.5 false }
		centerSerifed                   { true  true  1.0 false }
		reverseHooky                    { false true  1.0 true  }
		topRightSerifed                 { true  true  1.0 true  }
		topRightBaseSerifed             { true  true  1.0 true  }
		topRightBaseSerifedAsymmetric   { true  true  0.5 true  }

	glyph-block-import Letter-Latin-Lower-I : CasualTop

	define PigtailCasualTopConfig : object
		topTailed  'tailed'
		topFlat    'flat'
		topSemi    'semi'
		topDiag    'diagonal'

	define [PigtailUprightStem iSuffix Body md] : glyph-proc
		local df : include dfF
		include : df.markSet.e
		local casualKind : fallback PigtailCasualTopConfig.(iSuffix) nothing
		if casualKind : begin
			local dimCasual : RDim df RMode.NarrowHook
			include : dimCasual.setTurnedMarks XH 0 false false
			local rBarRightX : fallback dimCasual.rBarRightX 0
			local xStem : rBarRightX - [HSwToV HalfStroke]
			include : difference
				PigtailAttachHook Body md false xStem
				MaskAbove (XH / 2 + HalfStroke)
			include : CasualTop df XH xStem casualKind
			set-base-anchor 'overlay' xStem [mix 0 XH 0.5]
		: else : begin
			local { doTS doBS kJut fRight } : fallback DotlessIPigtailUprightConfig.(iSuffix) { false false 0.0 false }
			local mode : if doTS RMode.NarrowHookSerifed RMode.NarrowHook
			local dimSerif : RDim df mode
			include : dimSerif.setTurnedMarks XH 0 doTS false
			local rBarRightX : fallback dimSerif.rBarRightX 0
			local rTopSerifJut : fallback dimSerif.rTopSerifJut 0
			local xStem : rBarRightX - [HSwToV HalfStroke]
			set-base-anchor 'overlay' xStem [mix 0 XH 0.5]
			include : PigtailAttachHook Body md false xStem doTS
			if doBS : begin
				local jut : Math.max Jut : mix [HSwToV HalfStroke] rTopSerifJut kJut
				if (iSuffix === 'centerSerifed')
				: then : include : tagged 'serifMT' : HSerif.mt rBarRightX XH jut
				: else : begin
					if fRight
					: then : include : tagged 'serifRT' : HSerif.rt rBarRightX XH jut
					: else : include : tagged 'serifLB' : HSerif.lt xStem XH jut

	define [PigtailItalicStem iSuffix RevBody md] : glyph-proc
		local df : include dfF
		include : df.markSet.e
		local casualKind : fallback PigtailCasualTopConfig.(iSuffix) nothing
		if casualKind : begin
			local dimCasual : RDim df RMode.NarrowHook nothing nothing nothing (-1)
			include : dimCasual.setInvertedMarks XH 0 false false
			local rBarLeftX : fallback dimCasual.rBarLeftX 0
			local xStem : rBarLeftX + [HSwToV HalfStroke]
			include : difference
				PigtailAttachHook RevBody md true xStem
				MaskAbove (XH / 2 + HalfStroke)
			include : CasualTop df XH xStem casualKind
			set-base-anchor 'overlay' xStem [mix 0 XH 0.5]
		: else : begin
			local { doTS doBS kJut fRight } : fallback DotlessIPigtailItalicConfig.(iSuffix) { false false 0.0 false }
			local mode : if (doTS || doBS) RMode.NarrowHookSerifed RMode.NarrowHook
			local dimSerif : RDim df mode nothing nothing nothing (-1)
			include : dimSerif.setInvertedMarks XH 0 doTS doBS
			local rBarLeftX : fallback dimSerif.rBarLeftX 0
			local rTopSerifJut : fallback dimSerif.rTopSerifJut 0
			local xStem : rBarLeftX + [HSwToV HalfStroke]
			set-base-anchor 'overlay' xStem [mix 0 XH 0.5]
			include : PigtailAttachHook RevBody md true xStem doTS
			if doBS : begin
				local jut : Math.max Jut : [mix [HSwToV HalfStroke] rTopSerifJut kJut] - [if doTS [IBalance df] 0]
				if (iSuffix === 'centerSerifed')
				: then : include : tagged 'serifMT' : HSerif.mt rBarLeftX XH jut
				: else : begin
					if fRight
					: then : include : tagged 'serifRT' : HSerif.rt rBarLeftX XH jut
					: else : include : tagged 'serifRB' : HSerif.lt xStem XH jut

	local bakedIUpright : fallback para.variantSelector.('dotlessiPigtail.upright') 'serifless'
	local bakedIItalic  : fallback para.variantSelector.('dotlessiPigtail.italic')  'serifless'

	foreach { rSuffix { Body RevBody md } } [Object.entries PigtailRBodies] : do
		create-glyph "dotlessiPigtail.upright.\(rSuffix)" : glyph-proc
			include : PigtailUprightStem bakedIUpright Body md
		create-glyph "dotlessiPigtail.italic.\(rSuffix)" : glyph-proc
			include : PigtailItalicStem bakedIItalic RevBody md

	select-variant 'dotlessiPigtail.upright' (follow -- 'dotlessiPigtail/r')
	select-variant 'dotlessiPigtail.italic'  (follow -- 'dotlessiPigtail/r')

	glyph-block-import Letter-Blackboard : BBS BBD BBBarRight
	define [BBRShape df md] : glyph-proc
		define [object rBarLeftX rArchMiddleX rSkew rHookRightX rHookDepthY rCorX rArchDepthA] : RDim df md BBS [VSwToH BBD] ShoulderFine
		include : dispiro
			widths.lhs BBS
			g4.up.start rHookRightX (XH - rHookDepthY) [heading Upward]
			arcvh nothing DesignParameters.rHookSuperness
			g4.left.mid (rArchMiddleX - rCorX) (XH - O) [widths.lhs.heading BBS {.x (-rSkew) .y (-1)}]
			archv
			straight.down.end (rBarLeftX + BBD - [HSwToV ShoulderFine]) [Math.max (0 + TINY) (XH - rArchDepthA)] [widths.lhs.heading ShoulderFine Downward]
		include : BBBarRight (rBarLeftX + BBD) 0 XH
		set-base-anchor 'overlay' [mix (rBarLeftX - [HSwToV BBS]) (rBarLeftX + BBD) 0.5] [mix 0 XH 0.5]

	create-glyph 'mathbb/r' 0x1D563 : glyph-proc
		include : MarkSet.e
		include : BBRShape [DivFrame 1] RMode.Standard
