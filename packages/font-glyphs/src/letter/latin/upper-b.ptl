$$include '../../meta/macros.ptl'

import [mix fallback SuffixCfg joinCamel] from '@iosevka/util'
import [MathSansSerif] from '@iosevka/glyph/relation'

glyph-module

glyph-block Letter-Latin-Upper-B : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : LeaningAnchor
	glyph-block-import Letter-Shared-Metrics : BowlXDepth
	glyph-block-import Letter-Shared-Shapes : LetterBarOverlay SerifFrame LeftHook PalatalHook
	glyph-block-import Letter-Latin-Lower-E : EFlourishHook

	glyph-block-export BShape
	define BArcMix 0.93

	define BBarPos 0.52
	define TallCyrVeBarPos 0.55
	define AsymmetricBBarPos 0.60
	define BigTopBBarPos 0.40

	define [BTopArcShift pos] : if (pos == AsymmetricBBarPos)
		(-0.05) * (RightSB - SB)
		if (pos == BigTopBBarPos) ((1 - BArcMix) * (RightSB - SB)) 0
	define [BTopArcInnerShift pos] : if (pos == AsymmetricBBarPos)
		(-0.10) * (RightSB - SB)
		if (pos == BigTopBBarPos) (0.05 * (RightSB - SB)) 0

	define [BBottomArcShift pos left right] : if (pos == BigTopBBarPos) ((BArcMix - 1 - 0.05) * (right - left)) 0

	define [BShapeArcsT sink offset] : function [] : with-params [top stroke barPos topArcShift topArcInnerShift [df [DivFrame 1]] [diag 0]] : glyph-proc
		local bowl : mix stroke top barPos
		local mockBowlDepth : BowlXDepth top (bowl - stroke) df.leftSB df.rightSB stroke
		local curveLeftBot : [mix df.width df.rightSB 1.5] - mockBowlDepth + topArcInnerShift
		local curveLeftTop : Math.min curveLeftBot : [mix df.width df.rightSB 1.5] - OX - stroke * 1.375 + topArcInnerShift

		local adaBot : ArchDepthAOf (ArchDepth * 0.9) df.width
		local adbBot : ArchDepthBOf (ArchDepth * 0.9) df.width
		local adaTop : ArchDepthAOf (ArchDepth * 0.9 - (curveLeftBot - curveLeftTop)) df.width
		local adbTop : ArchDepthBOf (ArchDepth * 0.9 - (curveLeftBot - curveLeftTop)) df.width

		local xTopArcRight : [mix df.leftSB df.rightSB BArcMix] - OX * 2 + topArcShift
		local yTopArcRight : YSmoothMidR top (bowl - stroke) adaTop adbTop
		local xBotArcRight : df.rightSB - OX * 2 + [BBottomArcShift barPos df.leftSB df.rightSB]
		local yBotArcRight : YSmoothMidR bowl 0 adaBot adbBot

		local fine : stroke * CThin
		local xTurnMin : Math.min [Arch.adjust-x.bot curveLeftTop (sw -- stroke)] [Arch.adjust-x.top curveLeftBot (sw -- stroke)]
		local join : if diag [BrokenBarJoin df.leftSB df.width stroke xTurnMin bowl diag] null

		include : sink
			widths.rhs stroke
			flat (df.leftSB - O) (top - offset) [heading Rightward]
			curl [Arch.adjust-x.top curveLeftTop (sw -- stroke)] (top - offset)
			archv
			g4 (xTopArcRight - offset) yTopArcRight
			arcvh
			flat [if diag [Math.max join.minTurn [Arch.adjust-x.bot curveLeftTop (sw -- stroke)]] [Arch.adjust-x.bot curveLeftTop (sw -- stroke)]] (bowl - fine + offset) [widths.rhs fine]
			curl [if diag join.xCut (df.leftSB - O)] (bowl - fine + offset) [heading Leftward]

		include : sink
			widths.rhs fine
			flat [if diag join.xCut (df.leftSB - O)] (bowl - stroke + fine - offset) [heading Rightward]
			curl [if diag [Math.max join.minTurn [Arch.adjust-x.top curveLeftBot (sw -- stroke)]] [Arch.adjust-x.top curveLeftBot (sw -- stroke)]] (bowl - stroke + fine - offset)
			archv
			g4 (xBotArcRight - offset) yBotArcRight [widths.rhs stroke]
			arcvh
			flat [Arch.adjust-x.bot curveLeftBot (sw -- stroke)] (0 + offset)
			curl (df.leftSB - O) (0 + offset) [heading Leftward]

		return : object bowl join

	define flex-params [BShape] : glyph-proc
		local-parameter : top
		local-parameter : stroke -- [AdviceStroke2 2 3 (top - 0)]
		local-parameter : barPos -- BBarPos
		local-parameter : topArcShift -- 0
		local-parameter : topArcInnerShift -- 0
		local-parameter : serifTop -- false
		local-parameter : serifBot -- false
		local-parameter : df -- [DivFrame 1]
		local-parameter : diag -- 0

		include : VBar.l df.leftSB 0 top stroke
		local dims : include : [BShapeArcsT dispiro 0] top
			stroke -- stroke
			barPos -- barPos
			topArcShift -- topArcShift
			topArcInnerShift -- topArcInnerShift
			df -- df
			diag -- diag

		if diag : include dims.join.shape

		set-base-anchor 'strike' df.middle (dims.bowl - 0.5 * stroke)

		local sf : SerifFrame.fromDf df top 0
		if serifTop : include sf.lt.outer
		if serifBot : include sf.lb.outer

	define flex-params [BShapeMask] : glyph-proc
		local-parameter : top
		local-parameter : stroke -- [AdviceStroke2 2 3 (top - 0)]
		local-parameter : barPos -- BBarPos
		local-parameter : topArcShift -- 0
		local-parameter : topArcInnerShift -- 0
		local-parameter : df -- [DivFrame 1]

		include : [BShapeArcsT spiro-outline 1] top
			stroke -- stroke
			barPos -- barPos
			topArcShift -- topArcShift
			topArcInnerShift -- topArcInnerShift
			df -- df

	define [InterruptShape bp] : function [top sw _st _sb _df] : begin
		local df : fallback _df : DivFrame 1
		local bowl : mix sw top bp
		return : VBar.l
			df.leftSB + [HSwToV sw]
			bowl - sw - TINY
			bowl + TINY
			[VSwToH : 0.20 * (df.rightSB - df.leftSB)] * ([AdviceStroke 5] / Stroke)

	define [StdShape top sw st sb _df] : BShape top
		stroke -- sw
		barPos -- BBarPos
		serifTop -- st
		serifBot -- sb
		df -- [fallback _df : DivFrame 1]
	define [StdShapeInterrupted top sw st sb _df] : difference
		StdShape top sw st sb _df
		[InterruptShape BBarPos] top sw st sb _df
	define [StdShapeBroken diag] : function [top sw st sb _df] : BShape top
		stroke -- sw
		barPos -- BBarPos
		serifTop -- st
		serifBot -- sb
		df -- [fallback _df : DivFrame 1]
		diag -- diag
	define StdShapeBrokenRising : StdShapeBroken 1
	define StdShapeBrokenFalling : StdShapeBroken (-1)
	define [StdMask top sw _df] : BShapeMask top
		stroke -- sw
		barPos -- BBarPos
		df -- [fallback _df : DivFrame 1]

	define [AsymmetricShape top sw st sb _df] : begin
		local df : fallback _df : DivFrame 1
		return : BShape top
			stroke -- [fallback sw : AdviceStroke2 2 3 (top - 0)]
			barPos -- AsymmetricBBarPos
			topArcShift -- ((-0.05) * (df.rightSB - df.leftSB))
			topArcInnerShift -- ((-0.10) * (df.rightSB - df.leftSB))
			serifTop -- st
			serifBot -- sb
			df -- df
	define [AsymmetricShapeInterrupted top sw st sb _df] : difference
		AsymmetricShape top sw st sb _df
		[InterruptShape AsymmetricBBarPos] top sw st sb _df
	define [AsymmetricShapeBroken diag] : function [top sw st sb _df] : begin
		local df : fallback _df : DivFrame 1
		return : BShape top
			stroke -- [fallback sw : AdviceStroke2 2 3 (top - 0)]
			barPos -- AsymmetricBBarPos
			topArcShift -- ((-0.05) * (df.rightSB - df.leftSB))
			topArcInnerShift -- ((-0.10) * (df.rightSB - df.leftSB))
			serifTop -- st
			serifBot -- sb
			df -- df
			diag -- diag
	define AsymmetricShapeBrokenRising : AsymmetricShapeBroken 1
	define AsymmetricShapeBrokenFalling : AsymmetricShapeBroken (-1)
	define [AsymmetricMask top sw _df] : begin
		local df : fallback _df : DivFrame 1
		return : BShapeMask top
			stroke -- [fallback sw : AdviceStroke2 2 3 (top - 0)]
			barPos -- AsymmetricBBarPos
			topArcShift -- ((-0.05) * (df.rightSB - df.leftSB))
			topArcInnerShift -- ((-0.10) * (df.rightSB - df.leftSB))
			df -- df

	define [BigTopShapeT diag] : function [top sw st sb _df] : begin
		local df : fallback _df : DivFrame 1
		return : BShape top
			stroke -- [fallback sw : AdviceStroke2 2 3 (top - 0)]
			barPos -- BigTopBBarPos
			topArcShift -- ((1 - BArcMix) * (df.rightSB - df.leftSB))
			topArcInnerShift -- (0.05 * (df.rightSB - df.leftSB))
			serifTop -- st
			serifBot -- sb
			df -- df
			diag -- diag
	define BigTopShape : BigTopShapeT 0
	define [BigTopShapeInterrupted top sw st sb _df] : difference
		BigTopShape top sw st sb _df
		[InterruptShape BigTopBBarPos] top sw st sb _df
	define [BigTopMask top sw _df] : begin
		local df : fallback _df : DivFrame 1
		return : BShapeMask top
			stroke -- [fallback sw : AdviceStroke2 2 3 (top - 0)]
			barPos -- BigTopBBarPos
			topArcShift -- ((1 - BArcMix) * (df.rightSB - df.leftSB))
			topArcInnerShift -- (0.05 * (df.rightSB - df.leftSB))
			df -- df

	### Cyrillic Lower Ve

	define [RoundedTopCyrVeArcsT sink offset] : function [] : with-params [top stroke barPos topArcShift topArcInnerShift rise [diag 0] [earCorner false]] : glyph-proc
		local bowl : mix stroke top barPos
		local mockBowlDepth : BowlXDepth top (bowl - stroke) SB RightSB stroke
		local curveLeftBot : [mix Width RightSB 1.5] - mockBowlDepth + topArcInnerShift
		local curveLeftTop : Math.min curveLeftBot : [mix Width RightSB 1.5] - OX - stroke * 1.375 + topArcInnerShift

		local adaBot : ArchDepthAOf : ArchDepth * 0.9
		local adbBot : ArchDepthBOf : ArchDepth * 0.9
		local adaTop : ArchDepthAOf : ArchDepth * 0.9 - (curveLeftBot - curveLeftTop)
		local adbTop : ArchDepthBOf : ArchDepth * 0.9 - (curveLeftBot - curveLeftTop)

		local xTopArcRight : [mix SB RightSB BArcMix] - OX * 2 + topArcShift
		local yTopArcRight : YSmoothMidR top (bowl - stroke) adaTop adbTop
		local xBotArcRight : RightSB - OX * 2 + [BBottomArcShift barPos SB RightSB]
		local yBotArcRight : YSmoothMidR bowl 0 adaBot adbBot

		local fine : stroke * CThin
		local xTurnMin : Math.min [Arch.adjust-x.bot curveLeftTop (sw -- stroke)] [Arch.adjust-x.top curveLeftBot (sw -- stroke)]
		local join : if diag [BrokenBarJoin SB Width stroke xTurnMin bowl diag] null

		include : sink
			widths.lhs fine
			flat [if diag join.xCut (SB + offset - O)] (bowl - fine + offset) [heading Rightward]
			curl [if diag [Math.max join.minTurn [Arch.adjust-x.bot curveLeftTop (sw -- stroke)]] [Arch.adjust-x.bot curveLeftTop (sw -- stroke)]] (bowl - fine + offset)
			archv
			g4 (xTopArcRight - offset) yTopArcRight [widths.lhs stroke]
			if earCorner
				list
					Arch.lhs (top - offset) (sw -- stroke) (blendPost -- {})
					g4 (SB + offset) (top - DToothlessRise - offset) [widths.lhs stroke]
				list
					Arch.lhs (top - offset) (sw -- stroke)
					flat (SB + offset) (top - [ArchDepthAClamped top 0 adaTop adbBot]) [widths.lhs.heading stroke Downward]
					curl (SB + offset) (0 + rise + offset) [heading Downward]

		include : sink
			widths.rhs fine
			flat [if diag join.xCut (SB + offset - O)] (bowl - stroke + fine - offset) [heading Rightward]
			curl [if diag [Math.max join.minTurn [Arch.adjust-x.top curveLeftBot (sw -- stroke)]] [Arch.adjust-x.top curveLeftBot (sw -- stroke)]] (bowl - stroke + fine - offset)
			archv
			g4 (xBotArcRight - offset) yBotArcRight [widths.rhs stroke]
			if rise
				list
					Arch.rhs (0 + offset) (sw -- stroke) (blendPost -- {})
					g4 (SB + offset) (0 + rise + offset) [widths.rhs stroke]
				list
					arcvh
					flat [Arch.adjust-x.bot curveLeftBot (sw -- stroke)] (0 + offset)
					curl (SB + offset - O) (0 + offset) [heading Leftward]

		return : object bowl join

	define flex-params [RoundedTopCyrVeShape] : glyph-proc
		local-parameter : top
		local-parameter : stroke -- [AdviceStroke2 2 3 (top - 0)]
		local-parameter : barPos -- BBarPos
		local-parameter : topArcShift -- 0
		local-parameter : topArcInnerShift -- 0
		local-parameter : rise -- 0
		local-parameter : serifTop -- false
		local-parameter : serifBot -- false
		local-parameter : diag -- 0
		local-parameter : earCorner -- false

		local dims : include : [RoundedTopCyrVeArcsT dispiro 0] top
			stroke -- stroke
			barPos -- barPos
			topArcShift -- topArcShift
			topArcInnerShift -- topArcInnerShift
			rise -- rise
			diag -- diag
			earCorner -- earCorner

		if diag : include dims.join.shape
		if earCorner : include : VBar.l SB (0 + rise) (top - DToothlessRise) stroke

		set-base-anchor 'strike' Middle (dims.bowl - 0.5 * stroke)

		local sf : SerifFrame.fromDf [DivFrame 1] top 0
		if (serifBot && !rise) : include sf.lb.outer

	define flex-params [RoundedTopCyrVeShapeMask] : glyph-proc
		local-parameter : top
		local-parameter : stroke -- [AdviceStroke2 2 3 (top - 0)]
		local-parameter : barPos -- BBarPos
		local-parameter : topArcShift -- 0
		local-parameter : topArcInnerShift -- 0
		local-parameter : rise -- 0

		include : [RoundedTopCyrVeArcsT spiro-outline 1] top
			stroke -- stroke
			barPos -- barPos
			topArcShift -- topArcShift
			topArcInnerShift -- topArcInnerShift
			rise -- rise

	define [RoundedTopShape top sw st sb] : RoundedTopCyrVeShape top
		stroke -- sw
		barPos -- [if (top > XH) TallCyrVeBarPos BBarPos]
		serifTop -- st
		serifBot -- sb
	define [RoundedTopShapeInterrupted top sw st sb] : difference
		RoundedTopShape top sw st sb
		[InterruptShape : if (top > XH) TallCyrVeBarPos BBarPos] top sw st sb
	define [RoundedTopShapeBroken diag rise] : function [top sw st sb] : RoundedTopCyrVeShape top
		stroke -- sw
		barPos -- [if (top > XH) TallCyrVeBarPos BBarPos]
		rise -- rise
		serifTop -- st
		serifBot -- sb
		diag -- diag
	define [RoundedTopMask top sw] : RoundedTopCyrVeShapeMask top
		stroke -- sw
		barPos -- [if (top > XH) TallCyrVeBarPos BBarPos]

	define [RoundedTopShapeBGR top sw st sb] : RoundedTopCyrVeShape top
		stroke -- sw
		barPos -- [if (top > XH) TallCyrVeBarPos BBarPos]
		rise -- DToothlessRise
		serifTop -- st
		serifBot -- sb
	define [RoundedTopShapeBGRInterrupted top sw st sb] : difference
		RoundedTopShapeBGR top sw st sb
		[InterruptShape : if (top > XH) TallCyrVeBarPos BBarPos] top sw st sb
	define [RoundedTopBGRMask top sw] : RoundedTopCyrVeShapeMask top
		stroke -- sw
		barPos -- [if (top > XH) TallCyrVeBarPos BBarPos]
		rise -- DToothlessRise

	create-glyph : glyph-proc
		include : MarkSet.e
		local stroke : AdviceStroke2 2 3 (XH - 0)
		create-forked-glyph 'smcpB.roundedTopSerifless' : RoundedTopShape XH stroke false false
		create-forked-glyph 'smcpB.roundedTopUnilateralBottomSerifed' : RoundedTopShape XH stroke false true
		create-forked-glyph 'smcpB.roundedTopInterruptedSerifless' : RoundedTopShapeInterrupted XH stroke false false
		create-forked-glyph 'smcpB.roundedTopInterruptedUnilateralBottomSerifed' : RoundedTopShapeInterrupted XH stroke false true
		create-forked-glyph 'smcpB.roundedTopBrokenRisingSerifless' 			 : [RoundedTopShapeBroken 1 0] XH stroke false false
		create-forked-glyph 'smcpB.roundedTopBrokenRisingUnilateralBottomSerifed' : [RoundedTopShapeBroken 1 0] XH stroke false true
		create-forked-glyph 'smcpB.roundedTopBrokenFallingSerifless' 			 : [RoundedTopShapeBroken (-1) 0] XH stroke false false
		create-forked-glyph 'smcpB.roundedTopBrokenFallingUnilateralBottomSerifed' : [RoundedTopShapeBroken (-1) 0] XH stroke false true
	create-glyph : glyph-proc
		include : MarkSet.b
		local stroke : AdviceStroke2 2 3 (Ascender - 0)
		create-forked-glyph 'smcpB.roundedTopTall' : RoundedTopShapeBGR Ascender stroke false false
		create-forked-glyph 'smcpB.roundedTopInterruptedTall' : RoundedTopShapeBGRInterrupted	 Ascender stroke false false
		create-forked-glyph 'smcpB.roundedTopBrokenRisingTall' : [RoundedTopShapeBroken 1 DToothlessRise] Ascender stroke false false
		create-forked-glyph 'smcpB.roundedTopBrokenFallingTall' : [RoundedTopShapeBroken (-1) DToothlessRise] Ascender stroke false false

	define [CursiveCyrVeArcsT sink offset] : function [] : with-params [top stroke barPos topArcShift topArcInnerShift [diag 0]] : glyph-proc
		local bowl : mix stroke top barPos
		local mockBowlDepth : BowlXDepth top (bowl - stroke) SB RightSB stroke
		local curveLeftBot : [mix Width RightSB 1.5] - mockBowlDepth + topArcInnerShift
		local curveLeftTop : Math.min curveLeftBot : [mix Width RightSB 1.5] - OX - stroke * 1.375 + topArcInnerShift

		local adaBot : ArchDepthAOf : ArchDepth * 0.9
		local adbBot : ArchDepthBOf : ArchDepth * 0.9
		local adaTop : ArchDepthAOf : ArchDepth * 0.9 - (curveLeftBot - curveLeftTop)
		local adbTop : ArchDepthBOf : ArchDepth * 0.9 - (curveLeftBot - curveLeftTop)

		local xTopArcRight : [mix SB RightSB BArcMix] - OX * 2 + topArcShift
		local yTopArcRight : YSmoothMidR top (bowl - stroke) adaTop adbTop
		local xBotArcRight : RightSB - OX * 2 + [BBottomArcShift barPos SB RightSB]
		local yBotArcRight : YSmoothMidR bowl 0 adaBot adbBot

		local fine : stroke * CThin
		local xTurnMin : Math.min [Arch.adjust-x.bot curveLeftTop (sw -- stroke)] [Arch.adjust-x.top curveLeftBot (sw -- stroke)]
		local join : if diag [BrokenBarJoin SB Width stroke xTurnMin bowl diag] null

		include : sink
			widths.lhs fine
			flat [if diag join.xCut (SB + offset - O)] (bowl - fine + offset) [heading Rightward]
			curl [if diag [Math.max join.minTurn [Arch.adjust-x.bot curveLeftTop (sw -- stroke)]] [Arch.adjust-x.bot curveLeftTop (sw -- stroke)]] (bowl - fine + offset)
			archv
			g4 (xTopArcRight - offset) yTopArcRight [widths.lhs stroke]
			Arch.lhs (top - offset) (sw -- stroke)
			flatside.ld (SB + offset) 0 top adaTop adbBot 0 [widths.lhs.heading stroke Downward]
			Arch.lhs (0 + offset) (sw -- stroke)
			g4 (xBotArcRight - offset) yBotArcRight [widths.lhs stroke]
			arcvh
			flat [if diag [Math.max join.minTurn [Arch.adjust-x.top curveLeftBot (sw -- stroke)]] [Arch.adjust-x.top curveLeftBot (sw -- stroke)]] (bowl - stroke + fine - offset) [widths.lhs fine]
			curl [if diag join.xCut (SB + offset - O)] (bowl - stroke + fine - offset) [heading Leftward]

		return : object bowl join

	define flex-params [CursiveCyrVeShape] : glyph-proc
		local-parameter : top
		local-parameter : stroke -- [AdviceStroke2 2 3 (top - 0)]
		local-parameter : barPos -- BBarPos
		local-parameter : topArcShift -- 0
		local-parameter : topArcInnerShift -- 0
		local-parameter : serifTop -- false
		local-parameter : serifBot -- false
		local-parameter : diag -- 0

		local dims : include : [CursiveCyrVeArcsT dispiro 0] top
			stroke -- stroke
			barPos -- barPos
			topArcShift -- topArcShift
			topArcInnerShift -- topArcInnerShift
			diag -- diag

		if diag : include dims.join.shape

		set-base-anchor 'strike' Middle (dims.bowl - 0.5 * stroke)

	define flex-params [CursiveCyrVeShapeMask] : glyph-proc
		local-parameter : top
		local-parameter : stroke -- [AdviceStroke2 2 3 (top - 0)]
		local-parameter : barPos -- BBarPos
		local-parameter : topArcShift -- 0
		local-parameter : topArcInnerShift -- 0

		include : [CursiveCyrVeArcsT spiro-outline 1] top
			stroke -- stroke
			barPos -- barPos
			topArcShift -- topArcShift
			topArcInnerShift -- topArcInnerShift

	define [CursiveShape top sw st sb] : CursiveCyrVeShape top
		stroke -- sw
		barPos -- [if (top > XH) TallCyrVeBarPos BBarPos]
		serifTop -- st
		serifBot -- sb
	define [CursiveShapeInterrupted top sw st sb] : difference
		CursiveShape top sw st sb
		[InterruptShape : if (top > XH) TallCyrVeBarPos BBarPos] top sw st sb
	define [CursiveShapeBroken diag] : function [top sw st sb] : CursiveCyrVeShape top
		stroke -- sw
		barPos -- [if (top > XH) TallCyrVeBarPos BBarPos]
		serifTop -- st
		serifBot -- sb
		diag -- diag
	define [CursiveMask top sw] : CursiveCyrVeShapeMask top
		stroke -- sw
		barPos -- [if (top > XH) TallCyrVeBarPos BBarPos]

	create-glyph : glyph-proc
		include : MarkSet.e
		local stroke : AdviceStroke2 2 3 (XH - 0)
		create-forked-glyph 'smcpB.cursive' : CursiveShape XH stroke false false
		create-forked-glyph 'smcpB.cursiveInterrupted' : CursiveShapeInterrupted XH stroke false false
		create-forked-glyph 'smcpB.cursiveBrokenRising' : [CursiveShapeBroken 1] XH stroke false false
		create-forked-glyph 'smcpB.cursiveBrokenFalling' : [CursiveShapeBroken (-1)] XH stroke false false
	create-glyph : glyph-proc
		include : MarkSet.b
		local stroke : AdviceStroke2 2 3 (Ascender - 0)
		create-forked-glyph 'smcpB.cursiveTall' : CursiveShape Ascender stroke false false
		create-forked-glyph 'smcpB.cursiveInterruptedTall' : CursiveShapeInterrupted Ascender stroke false false
		create-forked-glyph 'smcpB.cursiveBrokenRisingTall' : [CursiveShapeBroken 1] Ascender stroke false false
		create-forked-glyph 'smcpB.cursiveBrokenFallingTall' : [CursiveShapeBroken (-1)] Ascender stroke false false

	foreach {suffix barPos} {{'bigTopBowl' BigTopBBarPos} {'smallTopBowl' AsymmetricBBarPos}} : begin
		create-glyph "smcpB.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : BShape XH (barPos -- barPos) (topArcShift -- [BTopArcShift barPos]) (topArcInnerShift -- [BTopArcInnerShift barPos])
		create-glyph "smcpB.\(suffix)Tall" : glyph-proc
			include : MarkSet.b
			include : BShape Ascender (barPos -- barPos) (topArcShift -- [BTopArcShift barPos]) (topArcInnerShift -- [BTopArcInnerShift barPos])
		create-glyph "smcpB.\(suffix)BGRTall" : glyph-proc
			include : MarkSet.b
			include : RoundedTopCyrVeShape Ascender
				barPos -- barPos
				topArcShift -- [BTopArcShift barPos]
				topArcInnerShift -- [BTopArcInnerShift barPos]
				rise -- DToothlessRise

	define [VeMatrixShape ear tooth diag closed barPos top] : glyph-proc
		local sw : AdviceStroke2 2 3 top
		local mid : [mix sw top barPos] - sw / 2
		local outerShift : BTopArcShift barPos
		local innerShift : BTopArcInnerShift barPos
		local upper : new-glyph : glyph-proc
			if (ear === 'flatTop' || ear === 'flatTopSerifed')
				include : BShape top (stroke -- sw) (barPos -- barPos) (topArcShift -- outerShift) (topArcInnerShift -- innerShift) (diag -- diag)
				include : RoundedTopCyrVeShape top (stroke -- sw) (barPos -- barPos) (topArcShift -- outerShift) (topArcInnerShift -- innerShift) (diag -- diag) (earCorner -- [ear === 'earlessCorner'])
		local lower : new-glyph : glyph-proc
			match tooth
				[Just 'rounded'] : include : CursiveCyrVeShape top (stroke -- sw) (barPos -- barPos) (topArcShift -- outerShift) (topArcInnerShift -- innerShift) (diag -- diag)
				[Just 'corner'] : include : RoundedTopCyrVeShape top (stroke -- sw) (barPos -- barPos) (topArcShift -- outerShift) (topArcInnerShift -- innerShift) (diag -- diag) (rise -- DToothlessRise)
				__ : include : BShape top (stroke -- sw) (barPos -- barPos) (topArcShift -- outerShift) (topArcInnerShift -- innerShift) (diag -- diag)
		include : difference
			union
				intersection [begin upper] [MaskAbove mid]
				intersection [begin lower] [MaskBelow mid]
			if (diag || closed) [no-shape] [[InterruptShape barPos] top sw]
		local sf : SerifFrame.fromDf [DivFrame 1] top 0 (swRef -- sw)
		if (ear === 'flatTopSerifed') : include sf.lt.outer
		if (tooth === 'flatBottomSerifed') : include sf.lb.outer
		set-base-anchor 'strike' Middle mid

	foreach ear {'earlessRounded' 'earlessCorner' 'flatTop' 'flatTopSerifed'} : foreach tooth {'rounded' 'corner' 'flatBottom' 'flatBottomSerifed'} : foreach {cross diag closed} {
			{'closed' 0 true}
			{'open' 0 false}
			{'brokenRising' 1 false}
			{'brokenFalling' (-1) false}
		} : foreach {symmetry pos} {
			{'symmetricBowls' BBarPos}
			{'bigBottomBowl' AsymmetricBBarPos}
			{'bigTopBowl' BigTopBBarPos}
		} : foreach {height top} {{'short' XH} {'tall' Ascender}} : begin
			local suffix : joinCamel [joinCamel [joinCamel [joinCamel [joinCamel 'matrix' ear] tooth] cross] symmetry] height
			create-glyph "smcpB.\(suffix)" : glyph-proc
				if (height === 'short') : include : MarkSet.e
				if (height === 'tall') : include : MarkSet.b
				include : VeMatrixShape ear tooth diag closed pos top

	define [BOverlayBar top bp] : begin
		local stroke : AdviceStroke2 2 3 (top - 0)
		local bowl : mix stroke top bp
		return : dispiro
			widths.rhs stroke
			flat [mix 0 SB 0.3] bowl
			curl [mix Width RightSB 0.3] bowl

	define [BahtBar sw] : begin
		local asc : CAP + ([mix XH Ascender 0.5] - XH)
		local desc : mix 0 Descender 0.5
		local xMid : mix SB RightSB 0.48
		return : VBar.m xMid asc desc sw
	define [BitcoinBar sw] : begin
		local asc : CAP + ([mix XH Ascender 0.5] - XH)
		local desc : mix 0 Descender 0.5
		local xMid : mix SB RightSB 0.48
		local gap : Math.max
			AdviceStroke 4
			(RightSB - SB) / 6
		return : union
			VBar.m (xMid - gap / 2 - [HSwToV : 0.5 * sw]) asc desc sw
			VBar.m (xMid + gap / 2 + [HSwToV : 0.5 * sw]) asc desc sw

	glyph-block-export BConfig
	define BConfig : SuffixCfg.weave
		object # body
			standard {StdShape StdMask BBarPos false false}
			standardInterrupted {StdShapeInterrupted StdMask BBarPos true false}
			standardBrokenRising {StdShapeBrokenRising StdMask BBarPos true false}
			standardBrokenFalling {StdShapeBrokenFalling StdMask BBarPos true false}
			bigBottomBowl {AsymmetricShape AsymmetricMask AsymmetricBBarPos false true }
			bigBottomBowlInterrupted {AsymmetricShapeInterrupted AsymmetricMask AsymmetricBBarPos true true }
			bigBottomBowlBrokenRising {AsymmetricShapeBrokenRising AsymmetricMask AsymmetricBBarPos true true }
			bigBottomBowlBrokenFalling {AsymmetricShapeBrokenFalling AsymmetricMask AsymmetricBBarPos true true }
			bigTopBowl {BigTopShape BigTopMask BigTopBBarPos false true }
			bigTopBowlInterrupted {BigTopShapeInterrupted BigTopMask BigTopBBarPos true true }
			bigTopBowlBrokenRising {[BigTopShapeT 1] BigTopMask BigTopBBarPos true true }
			bigTopBowlBrokenFalling {[BigTopShapeT (-1)] BigTopMask BigTopBBarPos true true }
		object # serifs
			serifless {false false}
			unilateralSerifed {true false}
			bilateralSerifed {true true }

	foreach {suffix {{body mask bp fGap fAsymmetric} {ts bs}}} [Object.entries BConfig] : do
		local fMotion : ts && !bs
		local swCap : AdviceStroke2 2 3 (CAP - 0)
		local swXH : AdviceStroke2 2 3 (XH - 0)
		local swCurrency : AdviceStroke2 3.5 3 (CAP - 0)

		create-glyph "B.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : body CAP swCap ts bs

		if (!fMotion) : create-glyph "BHookLeft.\(suffix)" : glyph-proc
			include [refer-glyph "B.\(suffix)"] AS_BASE ALSO_METRICS
			eject-contour 'serifLT'
			include : LeftHook SB CAP

		create-glyph "BStroke.\(suffix)" : glyph-proc
			include [refer-glyph "B.\(suffix)"] AS_BASE ALSO_METRICS
			include : LetterBarOverlay.l.in SB swCap ([mix swCap CAP bp] - swCap)
				space -- {0 (RightSB - [HSwToV swCap])}

		create-glyph "BFlourish.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleM 3
			include : df.markSet.capital
			local bodyK : 0.66 * df.adws
			local swA : df.adviceThinnerStroke2 2 3 CAP bodyK
			local swB : df.adviceThinnerStroke 2.75 bodyK
			local sw : Math.min swA swB
			local subDf : DivFrame bodyK 2
			local shift : df.width - subDf.width
			include : with-transform [ApparentTranslate shift 0] : glyph-proc
				include : body CAP sw ts bs subDf
			local xStem : subDf.leftSB + shift
			local bowl : mix sw CAP bp
			include : EFlourishHook df bowl
				xClip -- xStem
				xJoin -- (subDf.middle + shift)
				stroke -- sw

		if (!fGap) : create-glyph "BBar.\(suffix)" : glyph-proc
			include [refer-glyph "B.\(suffix)"] AS_BASE ALSO_METRICS
			include : BOverlayBar CAP bp

		if (!fAsymmetric) : begin
			create-glyph "smcpB.\(suffix)" : glyph-proc
				include : MarkSet.e
				include : body XH swXH ts bs

			if (!fGap) : create-glyph "smcpBBar.\(suffix)" : glyph-proc
				include [refer-glyph "smcpB.\(suffix)"] AS_BASE ALSO_METRICS
				include : BOverlayBar XH bp

		create-glyph "currency/baht.\(suffix)" : union
			body CAP swCurrency ts bs
			intersection
				BahtBar [AdviceStroke 5]
				mask CAP swCap
			difference
				BahtBar [AdviceStroke 2]
				mask CAP swCap

		create-glyph "currency/bitcoin.\(suffix)" : union
			body CAP swCurrency ts bs
			difference
				BitcoinBar [AdviceStroke 5]
				mask CAP swCap

		if (!bs) : create-glyph "latn/Beta.\(suffix)" : glyph-proc
			include : MarkSet.capDesc
			include : LeaningAnchor.Below.VBar.l SB
			include [refer-glyph "B.\(suffix)"]
			eject-contour 'serifLB'
			include : VBar.l SB Descender 0
			if SLAB : begin
				local sf : SerifFrame.fromDf [DivFrame 1] CAP Descender
				include sf.lb.fullSide

	select-variant 'B' 'B'
	link-reduced-variant 'B/sansSerif' 'B' MathSansSerif
	select-variant 'BHookLeft' 0x181
	select-variant 'BStroke' 0x243 (follow -- 'B')
	select-variant 'BFlourish' 0xA796 (follow -- 'B')
	select-variant 'BBar'
	select-variant 'smcpB' 0x299
	select-variant 'smcpBBar' 0x1D03

	select-variant 'currency/baht' 0xE3F (follow -- 'B')
	select-variant 'currency/bitcoin' 0x20BF (follow -- 'B')

	alias 'grek/Beta' 0x392 'B'
	alias-reduced-variant 'grek/Beta/sansSerif' 'grek/Beta' 'B/sansSerif' MathSansSerif
	select-variant 'latn/Beta' 0xA7B4

	alias 'cyrl/Ve' 0x412 'B'
	select-variant 'cyrl/ve' 0x432 (shapeFrom -- 'smcpB')
	select-variant 'cyrl/ve.BGR' (shapeFrom -- 'smcpB')

	glyph-block-import Letter-Blackboard : BBS BBD
	create-glyph 'mathbb/B' 0x1D539 : glyph-proc
		include : MarkSet.capital
		include : difference
			union [BShape CAP (stroke -- BBS)] : intersection [BShapeMask CAP (stroke -- BBS)] : union
				VBar.r ((RightSB - OX * 2) - BBD) 0 [mix 0 CAP BBarPos] BBS
				VBar.r (([mix SB RightSB BArcMix] - OX * 2) - BBD) [mix 0 CAP BBarPos] CAP BBS
				VBar.l (SB + BBD) 0 CAP BBS
			Rect (CAP - BBS) (0 + BBS) (SB + [HSwToV BBS]) (SB + BBD)

	### Greek Lower Beta

	define [BetaStandardShape flatBottom diag _barPos _closed] : glyph-proc
		local stroke : AdviceStroke2 2 3 (Ascender - 0)
		include : LeaningAnchor.Below.VBar.l SB stroke

		local barPos : fallback _barPos TallCyrVeBarPos
		local bowl : mix stroke Ascender barPos
		local mockBowlDepth : BowlXDepth Ascender (bowl - stroke) SB RightSB stroke
		local curveLeftBot : [mix Width RightSB 1.5] - mockBowlDepth + [BTopArcInnerShift barPos]
		local curveLeftTop : Math.min curveLeftBot : [mix Width RightSB 1.5] - OX - stroke * 1.375 + [BTopArcInnerShift barPos]

		local adaBot : ArchDepthAOf : ArchDepth * 0.9
		local adbBot : ArchDepthBOf : ArchDepth * 0.9
		local adaTop : ArchDepthAOf : ArchDepth * 0.9 - (curveLeftBot - curveLeftTop)
		local adbTop : ArchDepthBOf : ArchDepth * 0.9 - (curveLeftBot - curveLeftTop)

		local xTopArcRight : [mix SB RightSB BArcMix] - OX * 2 + [BTopArcShift barPos]
		local yTopArcRight : YSmoothMidR Ascender (bowl - stroke) adaTop adbTop
		local xBotArcRight : RightSB - OX * 2 + [BBottomArcShift barPos SB RightSB]
		local yBotArcRight : YSmoothMidR bowl 0 adaBot adbBot

		local fine : stroke * CThin
		local shoulderFine : ShoulderFine * (stroke / Stroke)
		local xTurnMin : Math.min [Arch.adjust-x.bot curveLeftTop (sw -- stroke)] [Arch.adjust-x.top curveLeftBot (sw -- stroke)]
		local join : if diag [BrokenBarJoin SB Width stroke xTurnMin bowl diag] null

		include : difference
			union
				dispiro
					widths.lhs fine
					flat [if diag join.xCut (SB - O)] (bowl - fine) [heading Rightward]
					curl [if diag [Math.max join.minTurn [Arch.adjust-x.bot curveLeftTop (sw -- stroke)]] [Arch.adjust-x.bot curveLeftTop (sw -- stroke)]] (bowl - fine)
					archv
					g4 xTopArcRight yTopArcRight [widths.lhs stroke]
					Arch.lhs Ascender (sw -- stroke)
					flat SB (Ascender - adaTop) [widths.lhs.heading stroke Downward]
					curl SB Descender [heading Downward]
				if flatBottom
					dispiro
						widths.lhs stroke
						flat (SB + TINY) 0 [heading Rightward]
						curl [Arch.adjust-x.bot curveLeftBot (sw -- stroke)] 0
						archv
						g4 xBotArcRight yBotArcRight [widths.lhs stroke]
						arcvh
						flat [if diag [Math.max join.minTurn [Arch.adjust-x.top curveLeftBot (sw -- stroke)]] [Arch.adjust-x.top curveLeftBot (sw -- stroke)]] (bowl - stroke + fine) [widths.lhs fine]
						curl [if diag join.xCut (SB - O)] (bowl - stroke + fine) [heading Leftward]
					dispiro
						widths.lhs shoulderFine
						g4.down.start (SB + [HSwToV : stroke - shoulderFine]) adbBot [heading Downward]
						Arch.lhs 0 (sw -- stroke) (swBefore -- shoulderFine)
						g4 xBotArcRight yBotArcRight [widths.lhs stroke]
						arcvh
						flat [if diag [Math.max join.minTurn [Arch.adjust-x.top curveLeftBot (sw -- stroke)]] [Arch.adjust-x.top curveLeftBot (sw -- stroke)]] (bowl - stroke + fine) [widths.lhs fine]
						curl [if diag join.xCut (SB - O)] (bowl - stroke + fine) [heading Leftward]
				if diag join.shape [no-shape]
			if (diag || _closed) [no-shape] [[InterruptShape barPos] Ascender stroke]

		set-base-anchor 'palatalHookAttach'
			mix [Arch.adjust-x.bot [mix (SB + [HSwToV : stroke - shoulderFine]) xBotArcRight 0.5] (sw -- stroke)] xBotArcRight 0.75
			mix O yBotArcRight [archv.yFromX 0.75]

	create-glyph 'grek/beta.standard' : glyph-proc
		include : MarkSet.bp
		include : BetaStandardShape false

	create-glyph 'grek/beta.flatBottom' : glyph-proc
		include : MarkSet.bp
		include : BetaStandardShape true

	create-glyph 'grek/beta.bigTopBowl' : glyph-proc
		include : MarkSet.bp
		include : BetaStandardShape false 0 BigTopBBarPos
	create-glyph 'grek/beta.smallTopBowl' : glyph-proc
		include : MarkSet.bp
		include : BetaStandardShape false 0 AsymmetricBBarPos

	foreach {suffix flatBottom diag} {
		{'brokenRising' false 1}
		{'brokenFalling' false (-1)}
		{'flatBottomBrokenRising' true 1}
		{'flatBottomBrokenFalling' true (-1)}
	} : create-glyph "grek/beta.\(suffix)" : glyph-proc
		include : MarkSet.bp
		include : BetaStandardShape flatBottom diag

	foreach {body serif cursive} {
		{'descending' 0 false}
		{'descendingSerifed' 1 false}
		{'descendingMotionSerifed' 2 false}
		{'cursive' 0 true}
	} : foreach {cross diag closed} {
		{'closed' 0 true}
		{'open' 0 false}
		{'brokenRising' 1 false}
		{'brokenFalling' (-1) false}
	} : foreach {symmetry pos} {
		{'symmetricBowls' TallCyrVeBarPos}
		{'bigBottomBowl' AsymmetricBBarPos}
		{'bigTopBowl' BigTopBBarPos}
	} : begin
		local suffix : joinCamel [joinCamel [joinCamel 'matrix' body] cross] symmetry
		create-glyph "grek/beta.\(suffix)" : glyph-proc
			include : MarkSet.bp
			if cursive
				include : difference
					CursiveCyrVeShape Ascender (barPos -- pos) (topArcShift -- [BTopArcShift pos]) (topArcInnerShift -- [BTopArcInnerShift pos]) (diag -- diag)
					if (diag || closed) [no-shape] [[InterruptShape pos] Ascender [AdviceStroke2 2 3 Ascender]]
				include : BetaStandardShape false diag pos closed
			if serif : begin
				local sf : SerifFrame.fromDf [DivFrame 1] Ascender Descender
				if (serif === 1) : include sf.lb.fullSide
				if (serif === 2) : include sf.lb.outer
		create-glyph "latn/beta.\(suffix)" : glyph-proc
			include [refer-glyph "grek/beta.\(suffix)"] AS_BASE ALSO_METRICS

	alias 'grek/beta.cursive' null 'smcpB.cursiveInterruptedTall'
	alias 'grek/betaSymbol' 0x3D0 'smcpB.cursiveInterruptedTall'

	select-variant 'grek/beta' 0x3B2

	alias 'grek/beta.UPPH' null 'grek/beta.standard'
	foreach suffix {'standard' 'brokenRising' 'brokenFalling' 'bigTopBowl' 'smallTopBowl'} : create-glyph "latn/beta.\(suffix)" : glyph-proc
		include [refer-glyph "grek/beta.\(suffix)"] AS_BASE ALSO_METRICS
		include : NeedSlab SLAB
			NeedNotItalic [SerifFrame.fromDf [DivFrame 1] XH Descender].lb.fullSide
	select-variant 'latn/beta' 0xA7B5 (follow -- 'latn/beta')

	derive-glyphs 'latn/betaPalatalHook' 0x1DF3B 'latn/beta' : lambda [src gr] : glyph-proc
		include [refer-glyph src] AS_BASE ALSO_METRICS
		local tinyGap : Math.max (Width / 32) : AdviceStroke 24
		local xMask : Math.max
			SB + [HSwToV Stroke] + 2 * tinyGap
			SB + [HSwToV HalfStroke] + MidJutSide + tinyGap
		local attach : currentGlyph.gizmo.unapply (currentGlyph.baseAnchors.palatalHookAttach || currentGlyph.baseAnchors.bottomRight)
		include : PalatalHook.r attach.x 0
			yAttach -- attach.y
			maskOut -- [intersection [MaskBelow 0] [MaskLeft xMask]]

	create-glyph 'cyrl/veRounded' 0x1C80 : glyph-proc
		include : MarkSet.e
		local fine : AdviceStroke 4
		local r0 : 0.2 * (RightSB - SB)

		local ry : r0 + 0.25 * fine
		local rx : r0 + [HSwToV : 0.25 * fine]

		local cx : RightSB - rx
		local cyt : XH - 1.375 * ry
		local cyb : XH - cyt

		include : dispiro
			g4 (cx + rx - OX) [YSmoothMidR.cr cyt ry] [widths.lhs fine]
			Arch.lhs (cyt + ry) (sw -- fine)
			g4 (cx - rx + OX) [YSmoothMidL.cr cyt ry]
			Arch.lhs (cyt - ry) (sw -- fine)
			g4 (cx + rx - OX) [YSmoothMidR.cr cyt ry]
			Arch.lhs XH (swBefore -- fine)
			flatside.ld SB 0 XH SmallArchDepthA SmallArchDepthB 0
			Arch.lhs 0 (swAfter -- fine)
			g4 (cx + rx - OX) [YSmoothMidR.cr cyb ry] [widths.lhs fine]
			Arch.lhs (cyb + ry) (sw -- fine)
			g4 (cx - rx + OX) [YSmoothMidL.cr cyb ry]
			Arch.lhs (cyb - ry) (sw -- fine)
			g4 (cx + rx - OX) [YSmoothMidR.cr cyb ry]
