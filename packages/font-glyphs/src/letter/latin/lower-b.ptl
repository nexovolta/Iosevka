$$include '../../meta/macros.ptl'

import [mix fallback SuffixCfg] from "@iosevka/util"
import [MathSansSerif] from "@iosevka/glyph/relation"

glyph-module

glyph-block Letter-Latin-Lower-B : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : LeaningAnchor ExtendBelowBaseAnchors
	glyph-block-import Letter-Shared : CreateAccentedComposition
	glyph-block-import Letter-Shared-Shapes : OBarLeft TopHook
	glyph-block-import Letter-Shared-Shapes : LetterBarOverlay PalatalHook
	glyph-block-import Letter-Latin-C : CLetterForm

	define SLAB-NONE      0
	define SLAB-FLAT-HOOK 4

	# Always flat at the top (C joins here). Bottom follows the `b` spur variant.
	define [FlourishFlatTopKnots left right top sw] : list
		arcvh
		flat [Arch.adjust-x.top [mix left right 0.5] (sw -- sw)] top
		curl (left + TINY) top [heading Leftward]

	define [FlourishBowl] : with-params [Body top bot left right sw ada adb] : begin
		local fine : ShoulderFine * (sw / Stroke)
		if (Body === ToothedBody || Body === BottomCutBody || Body === FlatTopBody) : begin
			# Toothed / bottom-cut / flat-top spur at the baseline; flat into the stem at XH.
			return : OBarLeft.earlessCorner
				rise  -- 0
				top   -- top
				bot   -- bot
				left  -- left
				right -- right
				sw    -- sw
				fine  -- fine
				ada   -- ada
				adb   -- adb
		if (Body === ToothlessCornerBody) : begin
			return : dispiro
				widths.lhs sw
				g4 left (bot + DToothlessRise)
				Arch.lhs bot (sw -- sw) (blendPre -- {})
				flatside.ru right bot top ada adb
				FlourishFlatTopKnots left right top sw
		if (Body === ToothlessRoundedBody) : begin
			return : dispiro
				widths.lhs sw
				flat left (bot + adb + TINY) [heading Downward]
				curl left (bot + adb)
				Arch.lhs bot (sw -- sw)
				flatside.ru right bot top ada adb
				FlourishFlatTopKnots left right top sw
		# FlatBottomBody / FlatTopAndBottomBody: both ends flat into the stem.
		return : dispiro
			widths.lhs sw
			flat (left + TINY) bot [heading Rightward]
			curl [Arch.adjust-x.bot [mix left right 0.5] (sw -- sw)] bot
			archv
			flatside.ru right bot top ada adb
			FlourishFlatTopKnots left right top sw

	define [FlourishStemBot Body sw] : begin
		if (Body === BottomCutBody) : return (0.5 * sw)
		if (Body === ToothlessCornerBody) : return DToothlessRise
		return 0

	define [ToothedBody yTop] : union
		OBarLeft.shape
		VBar.l SB 0 yTop

	define [BottomCutBody yTop] : union
		OBarLeft.shape
		VBar.l SB HalfStroke yTop
		spiro-outline
			corner  SB                    0
			corner  SB                    HalfStroke
			corner (SB + [HSwToV Stroke]) HalfStroke

	define [FlatBottomBody yTop] : union
		OBarLeft.toothlessCorner (rise -- 0)
		VBar.l SB 0 yTop

	define [FlatTopBody yTop] : union
		OBarLeft.earlessCorner (rise -- 0)
		VBar.l SB 0 yTop

	define [FlatTopAndBottomBody yTop] : union
		OBarLeft.flatTopAndBottom
		VBar.l SB 0 yTop

	define [ToothlessCornerBody yTop] : union
		OBarLeft.toothlessCorner
		VBar.l SB DToothlessRise yTop

	define [ToothlessRoundedBody yTop] : begin
		return : OBarLeft.toothlessRounded (yTerminal -- yTop)

	define [LTSerifs] : tagged 'serifLT' : HSerif.lt SB Ascender SideJut
	define [LBSerifs] : tagged 'serifLB' : HSerif.lb SB 0 SideJut
	define [FullSerifs] : composite-proc [LTSerifs] [LBSerifs]

	define BConfig : SuffixCfg.weave
		object # body
			""                ToothedBody
			bottomCut         BottomCutBody
			flatBottom        FlatBottomBody
			flatTop           FlatTopBody
			flatTopAndBottom  FlatTopAndBottomBody
			toothlessCorner   ToothlessCornerBody
			toothlessRounded  ToothlessRoundedBody
		object # serifs
			serifless       { no-shape   false  }
			motionSerifed   { LTSerifs   true   }
			bottomSerifed   { LBSerifs   false  }
			serifed         { FullSerifs true   }

	foreach { suffix { Body { Serifs doST } } } [Object.entries BConfig] : do
		local yOverlay : mix XH (Ascender - [if doST Stroke 0]) 0.5
		create-glyph "b.\(suffix)" : glyph-proc
			include : MarkSet.b
			include : Body Ascender
			include : Serifs
			include : LeaningAnchor.Above.VBar.l SB
			set-base-anchor 'overlayOnExtension' (SB + [HSwToV HalfStroke]) yOverlay
			set-base-anchor 'overlay' Middle (XH / 2)
			set-base-anchor 'strike'  Middle (XH / 2)

		create-glyph "bStroke.\(suffix)" : glyph-proc
			include [refer-glyph "b.\(suffix)"] AS_BASE ALSO_METRICS
			include : LetterBarOverlay.l.in SB XH (Ascender - [if doST Stroke 0])

		create-glyph "bSlash.\(suffix)" : glyph-proc
			include [refer-glyph "b.\(suffix)"] AS_BASE ALSO_METRICS
			include : dispiro
				widths.center OverlayStroke
				flat [mix SB 0       0.700] (yOverlay - 0.10 * (Ascender - 0))
				curl [mix SB RightSB 0.625] (yOverlay + 0.05 * (Ascender - 0))

		create-glyph "latn/be.\(suffix)" : glyph-proc
			include : MarkSet.b
			include : Body Ascender
			include : Serifs
			local xTopRight : mix SB RightSB 0.9
			include : HBar.t (SB - O) xTopRight Ascender
			if doST : include : VSerif.dr xTopRight Ascender [Math.min VJut : mix Stroke (Ascender - XH) 0.5]
			include : LeaningAnchor.Above.At [mix SB xTopRight 0.5]

		if [not doST] : create-glyph "bHookTop.\(suffix)" : glyph-proc
			include : MarkSet.b
			include : Body XH
			include : Serifs
			include : TopHook.toRight.lBarInner SB (XH / 2) Ascender
			include : LeaningAnchor.Above.VBar.l SB

		create-glyph "bFlourish.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleMM 3
			include : df.markSet.b
			include : ExtendBelowBaseAnchors Descender
			local swA : df.adviceThinnerStroke2 2 3 (Ascender - Descender) 0.65
			local swB : df.adviceThinnerStroke 2.75 0.75
			local sw : Math.min swA swB
			# Body 66% of small-m width; left flourish 33%.
			local bodyK : 0.66 * df.adws
			local subDf : DivFrame bodyK 2
			local shift : df.width - subDf.width
			local xLeft : subDf.leftSB + 0
			local xRight : subDf.rightSB + 0
			local ada : subDf.smallArchDepthA + 0
			local adb : subDf.smallArchDepthB + 0
			local ink : HSwToV sw
			local yStemBot : FlourishStemBot Body sw
			include : with-transform [ApparentTranslate shift 0] : glyph-proc
				include : union
					FlourishBowl Body XH 0 xLeft xRight sw ada adb
					VBar.l xLeft yStemBot Ascender sw
					if (Body === BottomCutBody)
						spiro-outline
							corner xLeft                    0
							corner xLeft                    yStemBot
							corner (xLeft + [HSwToV sw])    yStemBot
						no-shape
				if (Serifs === LTSerifs || Serifs === FullSerifs) : include : tagged 'serifLT' : HSerif.lt xLeft Ascender SideJut sw
				if (Serifs === LBSerifs || Serifs === FullSerifs) : include : tagged 'serifLB' : HSerif.lb xLeft 0 SideJut sw
				include : LeaningAnchor.Above.VBar.l xLeft
			local xStem : xLeft + shift
			# C on a 1-em frame so the bowl, not the flourish, keeps m-width in Aile/Etoile.
			local cDf : DivFrame [Math.min 1 df.adws]
			local lf : CLetterForm cDf SLAB-NONE SLAB-FLAT-HOOK XH Descender
				ada -- [cDf.archDepthAOf SmallArchDepth sw]
				adb -- [cDf.archDepthBOf SmallArchDepth sw]
				sw  -- sw
			include : intersection [MaskLeft (xStem + 0.5 * ink)] [lf.full]

	select-variant 'b' 'b'
	link-reduced-variant 'b/sansSerif' 'b' MathSansSerif

	select-variant 'bStroke' 0x180 (follow -- 'b')
	select-variant 'bFlourish' 0xA797 (follow -- 'b')
	CreateAccentedComposition 'bBar' null 'b' 'hStrike'

	select-variant 'bSlash' 0x2422 (follow -- 'b')
	select-variant 'latn/be' 0x183 (follow -- 'b')

	select-variant 'bHookTop' 0x253

	derive-composites 'bPalatalHook' 0x1D80 'b' : PalatalHook.r
		x -- [mix [Arch.adjust-x.bot Middle] RightSB 0.75]
		y -- 0
		yAttach -- [mix O SmallArchDepthA : archv.yFromX 0.75]

	derive-multi-part-glyphs 'bDot' 0x1E03 {'b' 'dotAbove'} : lambda [srcs gr] : glyph-proc
		local { base mark } srcs
		include : refer-glyph mark
		include : Translate (Width + [HSwToV HalfStroke]) 0
		include [refer-glyph base] AS_BASE
		include : LeaningAnchor.Above.VBar.l Middle

	glyph-block-import Letter-Blackboard : BBS BBD BBBarLeft
	create-glyph 'mathbb/b' 0x1D553 : glyph-proc
		include : MarkSet.b
		include : BBBarLeft SB 0 Ascender
		include : intersection
			OShapeOutline.NoOvershoot XH 0 (SB + BBD + [HSwToV BBS]) RightSB
			VBar.r (RightSB - BBD - OX) 0 XH BBS
		include : OBarLeft.shape
			left -- (SB + BBD)
			sw   -- BBS
