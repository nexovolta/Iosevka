$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from "@iosevka/util"
import [Box] from "@iosevka/geometry/box"
import [MathSansSerif] from "@iosevka/glyph/relation"

glyph-module

glyph-block Letter-Latin-X : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared-Shapes : SerifFrame WithSerifOverflowMask
	glyph-block-import Letter-Shared-Shapes : DiagTail
	glyph-block-import Letter-Shared-Shapes : CyrDescender PalatalHook
	glyph-block-import Letter-Latin-K : KLegs KInnerRtSerif
	glyph-block-import Letter-Latin-V : VExtendedRtFull VExtendedRbFull VExtendedRbOuter
	glyph-block-import Mark-Adjustment : LeaningAnchor
	glyph-block-import Mark-Above : RingDims

	glyph-block-export HalfXStrand
	define [HalfXStrand stb fSlab _xOuter yOuter xCenter yCenter turn pStraight tension _sw _pConn] : glyph-proc
		local sw : fallback _sw Stroke
		local sbCor : if stb ([StrokeWidthBlend 1 6] * OX * ([Math.abs (yOuter - yCenter)] / CAP)) 0
		local xOuter : _xOuter + ([HSwToV : 0.5 * sw] + [Math.max (-SideJut) sbCor]) * [if (xCenter > _xOuter) 1 (-1)]

		if stb : begin
			local hst : (0.5 * sw) * [DiagCor (yCenter - yOuter) (xCenter - xOuter) 0 0]
			local hse : (0.5 * sw) * [Math.min 0.97 ([AdviceStroke 3] / Stroke)]
			local xOuterAdjusted : _xOuter + ([HSwToV hst] + [Math.max (-SideJut) sbCor]) * [if (xCenter > _xOuter) 1 (-1)]
			include : dispiro
				corner xOuterAdjusted yOuter [widths.heading hst hst [if (yOuter < yCenter) Upward Downward]]
				corner xCenter yCenter [widths.center : 2 * hse]

		: else : begin
			local height : Math.abs (yOuter - yCenter)
			local slabClearance : if fSlab ((sw / Stroke) * [AdviceStroke2 2 3 height]) 0
			local turnyOuter : mix yOuter     yCenter : if fSlab [Math.max turn (slabClearance / height)] turn
			local cyOuter    : mix turnyOuter yCenter tension
			local straightXOuter : mix xOuter  xCenter pStraight
			local straightYOuter : mix cyOuter yCenter pStraight
			local xCenterAdj : mix xCenter xOuter  : fallback _pConn 0
			local yCenterAdj : mix yCenter cyOuter : fallback _pConn 0
			include : dispiro
				widths.center sw
				flat xOuter yOuter     [heading [if (yOuter < yCenter) Upward Downward]]
				curl xOuter turnyOuter [heading [if (yOuter < yCenter) Upward Downward]]
				quadControls 0 ((cyOuter - turnyOuter) / (straightYOuter - turnyOuter)) 24
				flat straightXOuter straightYOuter
				curl xCenterAdj     yCenterAdj

	glyph-block-export XStrand
	define [XStrand stb slab xLeft yLeft xRight yRight turn pStraight tension _sw] : glyph-proc
		local xMid : mix xLeft xRight 0.5
		local yMid : mix yLeft yRight 0.5

		include : HalfXStrand stb slab xLeft  yLeft  xMid yMid turn pStraight tension _sw (-0.001)
		include : HalfXStrand stb slab xRight yRight xMid yMid turn pStraight tension _sw (-0.001)

	define [XChanceryStrand sign fSlab leftX leftY rightX rightY fHalf _sw] : begin
		local sw : fallback _sw Stroke
		local blendK1X : StrokeWidthBlend 0.58 0.65
		local blendK1Y   0.2
		local blendK2X   0.78
		local blendK2Y : StrokeWidthBlend 0.5 0.4

		local pStraightX : StrokeWidthBlend 0.3 0.35
		local pStraightY : StrokeWidthBlend 0.2 0.25
		local fine : [AdviceStroke 3] * (sw / Stroke)
		local slab : if fSlab SideJut 0

		return : dispiro
			if fHalf
				flat [mix leftX rightX 0.5] [mix leftY rightY 0.5] [widths.center fine]
				list
					flat (leftX - slab) (leftY - sign * sw / 2) [widths.center.heading sw Rightward]
					curl (leftX + TINY) (leftY - sign * sw / 2) [widths.center.heading sw Rightward]
					alsoThruThem {{blendK1X blendK1Y} {blendK2X blendK2Y}}
					flat   [mix leftX rightX pStraightX] [mix leftY rightY pStraightY] [widths.center : mix sw fine 0.5]
					corner [mix leftX rightX 0.5]        [mix leftY rightY 0.5]        [widths.center fine]
			curl [mix leftX rightX (1 - pStraightX)] [mix leftY rightY (1 - pStraightY)] [widths.center : mix sw fine 0.5]
			alsoThruThem {{(1 - blendK2X) (1 - blendK2Y)} {(1 - blendK1X) (1 - blendK1Y)}}
			flat (rightX - TINY) (rightY + sign * sw / 2) [widths.center.heading sw Rightward]
			curl (rightX + slab) (rightY + sign * sw / 2) [widths.center.heading sw Rightward]

	glyph-block-export XCursiveHalfShape
	define flex-params [XCursiveHalfShape] : glyph-proc
		local-parameter : top
		local-parameter : bottom
		local-parameter : left
		local-parameter : right
		local-parameter : swMid    -- [AdviceStroke 2.75]
		local-parameter : swEnd    -- [AdviceStroke 3.00]
		local-parameter : swCoEnd  -- [AdviceStroke 2.00]
		local-parameter : setMark  -- false
		local-parameter : flatTail -- false

		local ada : ArchDepthAOf (ArchDepth * 0.8) (Width / 2)
		local adb : ArchDepthBOf (ArchDepth * 0.8) (Width / 2)
		local adws : (right - left) / (RightSB - Middle)
		local divHook : Math.min adws 1

		local fineMid : 0.55 * swMid
		local xMidBarRightEdge : left + [HSwToV swMid] / 2
		local xUpperTurn : mix (right - [HSwToV swEnd]) xMidBarRightEdge 0.5
		local upperHookDepth : Math.max (swEnd * 2) ([Math.sqrt divHook] * (Hook + swEnd * 0.125))
		local upperHookStraightDepth : Math.min
			upperHookDepth - swEnd * 1.125
			Math.max 1 : upperHookDepth / 5 - swEnd / 4
		local upperHalf : include : dispiro
			flat (xMidBarRightEdge - [HSwToV fineMid]) ([mix bottom top 0.5] + O) [widths.rhs.heading fineMid Upward]
			curl (xMidBarRightEdge - [HSwToV fineMid]) (top - ada)
			Arch.rhs top (sw -- swEnd) (swBefore -- fineMid)
			flat (right - OX) (top - upperHookDepth + upperHookStraightDepth) [heading Downward]
			curl (right - OX) (top - upperHookDepth) [heading Downward]

		local rIn : Math.max (0.4 * (right - left) - [HSwToV : 0.5 * swMid]) : AdviceStroke 16
		local flatHookDepth : 1.3 * (right - left) - (0.5 - TanSlope) * swEnd - 1.5 * (rIn + 0.5 * swMid)
		local lowerHalf : include : if flatTail
			dispiro
				flat (xMidBarRightEdge - [HSwToV fineMid]) ([mix bottom top 0.5] - O) [widths.lhs fineMid]
				curl (xMidBarRightEdge - [HSwToV fineMid]) (bottom + [Math.min adb (swMid + rIn)])
				arcvh
				flat (xMidBarRightEdge + adws * (0.5 * swMid + rIn) + 0.25 * TanSlope * (0.5 * swMid + rIn)) bottom [widths.lhs.heading swCoEnd Rightward]
				curl right bottom
			dispiro
				flat (xMidBarRightEdge - [HSwToV : 0.5 * fineMid]) ([mix bottom top 0.5] - O) [widths.center fineMid]
				curl (xMidBarRightEdge) (bottom + [Math.min adb (swMid + rIn)]) [widths.rhs fineMid]
				arcvh 16
				DiagTail.F 1 (xMidBarRightEdge + TanSlope * rIn) bottom rIn 50 flatHookDepth swCoEnd

		if setMark : begin
			define lowerHalfLastKnot lowerHalf.rhsKnots.(lowerHalf.rhsKnots.length - 1)
			set-base-anchor 'palatalHookAttach' lowerHalfLastKnot.x lowerHalfLastKnot.y

	define STROKE-STRAIGHT       0
	define STROKE-CURLY          1
	define STROKE-CHANCERY       2
	define STROKE-CURSIVE        3
	define STROKE-CURSIVE-FLAT   4
	define STROKE-H-SHAPED       5
	define STROKE-H-SHAPED-CURLY 6

	define [HShapedCurlyLegs left right stroke top xBar] : glyph-proc
		local yMid : top / 2
		include : intersection
			Rect top 0 left VERY-FAR
			dispiro
				g4.down.start right top [widths.rhs.heading stroke Downward]
				bezControls 0.0 0.3 0.5 0.65 8
				g4 xBar yMid [widths.rhs stroke]
		include : intersection
			Rect top 0 left VERY-FAR
			dispiro
				g4.up.start (right - O) 0 [widths.lhs.heading stroke Upward]
				quadControls 0 0.3 8
				g4 xBar yMid [widths.lhs stroke]

	define [HShapedXHalf fCurly left right sw height xBar] : glyph-proc
		if fCurly
		: then : include : HShapedCurlyLegs left right sw height xBar
		: else : begin
			local legs : KLegs.Symmetric 0
			include : legs false left right sw height false 0

	define [HShapedXShape box sw fCurly] : glyph-proc
		local height : box.t - box.b
		local mid box.xMid
		local fine : [AdviceStroke 3.5] * (sw / Stroke)
		local barHalf : [HSwToV : 0.5 * sw] + fine
		local legsLeft : mid - [HSwToV : 0.5 * sw] - Width / 32
		include : union
			HShapedXHalf fCurly legsLeft box.r sw height (mid + barHalf)
			with-transform [FlipAround mid (height / 2)] : HShapedXHalf fCurly legsLeft box.r sw height (mid + barHalf)
		include : HBar.m (mid - barHalf) (mid + barHalf) (height / 2) sw
		include : ApparentTranslate 0 box.b

	# Stretch the left-bottom K-leg to botLong. Do not add a vertical stem.
	# rhs + Upward matches the 180-flip of the right-top K-leg (stroke fills inward).
	define [HShapedLongLeftBottom fCurly box sw height mid botRel] : glyph-proc
		local fineBar : [AdviceStroke 3.5] * (sw / Stroke)
		local barHalf : [HSwToV : 0.5 * sw] + fineBar
		local xBarL : mid - barHalf
		local yMid : height / 2
		if fCurly
		: then : include : intersection
			MaskBelow (yMid + sw)
			MaskLeft  (mid + TINY)
			dispiro
				g4.up.start box.l botRel [widths.rhs.heading sw Upward]
				bezControls 0.0 0.3 0.5 0.65 8
				g4 xBarL yMid [widths.rhs sw]
		: else : begin
			local fine : [AdviceStroke 3] * (sw / Stroke)
			local ox : ((-4) * OX - sw / 3) * (XH / height)
			local kshRight : box.r + Width / 32
			local xOuter : 2 * mid - (kshRight - ox)
			include : intersection
				MaskBelow (yMid + sw)
				MaskLeft  (mid + TINY)
				dispiro
					widths.rhs sw
					flat xOuter botRel
					curl xBarL yMid [widths.rhs fine]

	define [HShapedXShapeLongLeft box sw fCurly botLong] : glyph-proc
		local height : box.t - box.b
		local mid box.xMid
		local fine : [AdviceStroke 3.5] * (sw / Stroke)
		local barHalf : [HSwToV : 0.5 * sw] + fine
		local legsLeft : mid - [HSwToV : 0.5 * sw] - Width / 32
		local yMid : height / 2
		local botRel : botLong - box.b
		include : union
			HShapedXHalf fCurly legsLeft box.r sw height (mid + barHalf)
			with-transform [FlipAround mid yMid] : intersection
				MaskBelow (yMid + TINY)
				HShapedXHalf fCurly legsLeft box.r sw height (mid + barHalf)
			HShapedLongLeftBottom fCurly box sw height mid botRel
		include : HBar.m (mid - barHalf) (mid + barHalf) yMid sw
		include : ApparentTranslate 0 box.b

	glyph-block-export XLetterForm
	define flex-params [XLetterForm] : namespace
		local-parameter : box
		local-parameter : stroke1
		local-parameter : stroke2
		local-parameter : turn
		local-parameter : tension
		local-parameter : sw             -- Stroke
		local-parameter : swCursiveMid   -- ([AdviceStroke 2.75] * (sw / Stroke))
		local-parameter : swCursiveEnd   -- ([AdviceStroke 3.00] * (sw / Stroke))
		local-parameter : swCursiveCoEnd -- ([AdviceStroke 2.00] * (sw / Stroke))

		export : define [base fSlab] : glyph-proc
			include : match stroke1
				[Just STROKE-STRAIGHT] : XStrand true  fSlab box.l box.b box.r box.t turn 0.4 tension sw
				[Just STROKE-CURLY]    : XStrand false fSlab box.l box.b box.r box.t turn 0.4 tension sw
				[Just STROKE-CHANCERY] : XChanceryStrand (-1) fSlab box.l box.b box.r box.t false sw
				([Just STROKE-H-SHAPED] || [Just STROKE-H-SHAPED-CURLY]) : HShapedXShape box sw (stroke1 === STROKE-H-SHAPED-CURLY)
				([Just STROKE-CURSIVE] || [Just STROKE-CURSIVE-FLAT]) : composite-proc
					XCursiveHalfShape box.t box.b box.xMid box.r
						swCoEnd  -- swCursiveCoEnd
						swEnd    -- swCursiveEnd
						swMid    -- swCursiveMid
						flatTail -- (stroke1 === STROKE-CURSIVE-FLAT)
					FlipAround box.xMid [mix box.b box.t 0.5]
				__ : glyph-proc
			include : match stroke2
				[Just STROKE-STRAIGHT] : XStrand true  fSlab box.l box.t box.r box.b turn 0.4 tension sw
				[Just STROKE-CURLY]    : XStrand false fSlab box.l box.t box.r box.b turn 0.4 tension sw
				[Just STROKE-CHANCERY] : XChanceryStrand (+1) fSlab box.l box.t box.r box.b false sw
				([Just STROKE-H-SHAPED] || [Just STROKE-H-SHAPED-CURLY]) : no-shape
				[Just STROKE-CURSIVE]  : XCursiveHalfShape box.t box.b box.xMid box.r
					swCoEnd -- swCursiveCoEnd
					swEnd   -- swCursiveEnd
					swMid   -- swCursiveMid
					setMark -- true
				__ : glyph-proc

		export : define [longLeftLeg fSlab botLong] : glyph-proc
			local midy : mix box.t box.b 0.5
			include : match stroke1
				[Just STROKE-STRAIGHT] : XStrand true  fSlab box.l botLong box.r box.t turn 0.4 tension sw
				[Just STROKE-CURLY]    : XStrand false fSlab box.l botLong box.r box.t turn 0.4 tension sw
				[Just STROKE-CHANCERY] : XChanceryStrand (-1) fSlab box.l botLong box.r box.t false sw
				([Just STROKE-H-SHAPED] || [Just STROKE-H-SHAPED-CURLY]) : HShapedXShapeLongLeft box sw (stroke1 === STROKE-H-SHAPED-CURLY) botLong
				([Just STROKE-CURSIVE] || [Just STROKE-CURSIVE-FLAT]) : glyph-proc
					include : intersection [MaskAbove (midy - TINY)] : with-transform [FlipAround box.xMid midy] : XCursiveHalfShape box.t box.b box.xMid box.r
						swCoEnd  -- swCursiveCoEnd
						swEnd    -- swCursiveEnd
						swMid    -- swCursiveMid
						flatTail -- (stroke1 === STROKE-CURSIVE-FLAT)
					include : HalfXStrand true fSlab box.l botLong box.xMid midy turn 0.4 tension sw
				__ : glyph-proc
			include : match stroke2
				[Just STROKE-STRAIGHT] : glyph-proc
					include : HalfXStrand true  fSlab box.l box.t box.xMid midy turn 0.4 tension sw
					include : HalfXStrand true  fSlab box.r box.b box.xMid midy turn 0.4 tension sw
				[Just STROKE-CURLY] : glyph-proc
					include : HalfXStrand false fSlab box.l box.t box.xMid midy turn 0.4 tension sw
					include : HalfXStrand false fSlab box.r box.b box.xMid midy turn 0.4 tension sw
				[Just STROKE-CHANCERY] : XChanceryStrand (+1) fSlab box.l box.t box.r box.b false sw
				([Just STROKE-H-SHAPED] || [Just STROKE-H-SHAPED-CURLY]) : no-shape
				[Just STROKE-CURSIVE]  : XCursiveHalfShape box.t box.b box.xMid box.r
					swCoEnd -- swCursiveCoEnd
					swEnd   -- swCursiveEnd
					swMid   -- swCursiveMid
					setMark -- true
				__ : glyph-proc

		export : define [rightHalf fSlab] : glyph-proc
			local midy : mix box.t box.b 0.5

			include : match stroke1
				[Just STROKE-STRAIGHT] : HalfXStrand true  fSlab box.r box.t box.xMid midy turn 0.4 tension sw
				[Just STROKE-CURLY]    : HalfXStrand false fSlab box.r box.t box.xMid midy turn 0.4 tension sw
				[Just STROKE-CHANCERY] : XChanceryStrand (-1) fSlab box.l box.b box.r box.t true sw
				([Just STROKE-H-SHAPED] || [Just STROKE-H-SHAPED-CURLY]) : intersection [MaskRight box.xMid] : HShapedXShape box sw (stroke1 === STROKE-H-SHAPED-CURLY)
				__ : glyph-proc
			include : match stroke2
				[Just STROKE-STRAIGHT] : HalfXStrand true  fSlab box.r box.b box.xMid midy turn 0.4 tension sw
				[Just STROKE-CURLY]    : HalfXStrand false fSlab box.r box.b box.xMid midy turn 0.4 tension sw
				[Just STROKE-CHANCERY] : XChanceryStrand (+1) fSlab box.l box.t box.r box.b true sw
				([Just STROKE-H-SHAPED] || [Just STROKE-H-SHAPED-CURLY]) : no-shape
				[Just STROKE-CURSIVE]  : XCursiveHalfShape box.t box.b box.xMid box.r
					swCoEnd -- swCursiveCoEnd
					swEnd   -- swCursiveEnd
					swMid   -- swCursiveMid
					setMark -- true
				__ : glyph-proc

		export : define [lowRightRing fSlab] : glyph-proc
			local midy : mix box.t box.b 0.5
			include : match stroke1
				[Just STROKE-STRAIGHT] : XStrand true  fSlab box.l box.b box.r box.t turn 0.4 tension sw
				[Just STROKE-CURLY]    : XStrand false fSlab box.l box.b box.r box.t turn 0.4 tension sw
				[Just STROKE-CHANCERY] : XChanceryStrand (-1) fSlab box.l box.b box.r box.t false sw
				([Just STROKE-H-SHAPED] || [Just STROKE-H-SHAPED-CURLY]) : difference
					HShapedXShape box sw (stroke1 === STROKE-H-SHAPED-CURLY)
					intersection [MaskBelow (midy + TINY)] [MaskRight (box.xMid - TINY)]
				([Just STROKE-CURSIVE] || [Just STROKE-CURSIVE-FLAT]) : composite-proc
					XCursiveHalfShape box.t box.b box.xMid box.r
						swCoEnd  -- swCursiveCoEnd
						swEnd    -- swCursiveEnd
						swMid    -- swCursiveMid
						flatTail -- (stroke1 === STROKE-CURSIVE-FLAT)
					FlipAround box.xMid midy
				__ : glyph-proc
			include : match stroke2
				[Just STROKE-STRAIGHT] : HalfXStrand true  fSlab box.l box.t box.xMid midy turn 0.4 tension sw (-0.001)
				[Just STROKE-CURLY]    : HalfXStrand false fSlab box.l box.t box.xMid midy turn 0.4 tension sw (-0.001)
				[Just STROKE-CHANCERY] : intersection [MaskAbove (midy - TINY)] : XChanceryStrand (+1) fSlab box.l box.t box.r box.b false sw
				([Just STROKE-H-SHAPED] || [Just STROKE-H-SHAPED-CURLY]) : no-shape
				[Just STROKE-CURSIVE]  : intersection [MaskAbove (midy - TINY)] : XCursiveHalfShape box.t box.b box.xMid box.r
					swCoEnd -- swCursiveCoEnd
					swEnd   -- swCursiveEnd
					swMid   -- swCursiveMid
				__ : glyph-proc
			include : XLowRightRingTail box sw (stroke2 === STROKE-STRAIGHT) fSlab turn tension

		export : define [longLeftLowRightRing fSlab botLong] : glyph-proc
			local midy : mix box.t box.b 0.5
			include : match stroke1
				[Just STROKE-STRAIGHT] : XStrand true  fSlab box.l botLong box.r box.t turn 0.4 tension sw
				[Just STROKE-CURLY]    : XStrand false fSlab box.l botLong box.r box.t turn 0.4 tension sw
				[Just STROKE-CHANCERY] : XChanceryStrand (-1) fSlab box.l botLong box.r box.t false sw
				([Just STROKE-H-SHAPED] || [Just STROKE-H-SHAPED-CURLY]) : difference
					HShapedXShapeLongLeft box sw (stroke1 === STROKE-H-SHAPED-CURLY) botLong
					intersection [MaskBelow (midy + TINY)] [MaskRight (box.xMid - TINY)]
				([Just STROKE-CURSIVE] || [Just STROKE-CURSIVE-FLAT]) : glyph-proc
					include : intersection [MaskAbove (midy - TINY)] : with-transform [FlipAround box.xMid midy] : XCursiveHalfShape box.t box.b box.xMid box.r
						swCoEnd  -- swCursiveCoEnd
						swEnd    -- swCursiveEnd
						swMid    -- swCursiveMid
						flatTail -- (stroke1 === STROKE-CURSIVE-FLAT)
					include : HalfXStrand true fSlab box.l botLong box.xMid midy turn 0.4 tension sw
				__ : glyph-proc
			include : match stroke2
				[Just STROKE-STRAIGHT] : HalfXStrand true  fSlab box.l box.t box.xMid midy turn 0.4 tension sw (-0.001)
				[Just STROKE-CURLY]    : HalfXStrand false fSlab box.l box.t box.xMid midy turn 0.4 tension sw (-0.001)
				[Just STROKE-CHANCERY] : intersection [MaskAbove (midy - TINY)] : XChanceryStrand (+1) fSlab box.l box.t box.r box.b false sw
				([Just STROKE-H-SHAPED] || [Just STROKE-H-SHAPED-CURLY]) : no-shape
				[Just STROKE-CURSIVE]  : intersection [MaskAbove (midy - TINY)] : XCursiveHalfShape box.t box.b box.xMid box.r
					swCoEnd -- swCursiveCoEnd
					swEnd   -- swCursiveEnd
					swMid   -- swCursiveMid
				__ : glyph-proc
			include : XLowRightRingTail box sw (stroke2 === STROKE-STRAIGHT) fSlab turn tension

	glyph-block-export XSerifs
	define XSerifs : namespace
		export : define [Full sf]             : composite-proc sf.lt.full [VExtendedRtFull sf] sf.lb.full [VExtendedRbFull sf]
		export : define [SemiChancery sf]     : composite-proc [VExtendedRtFull sf] sf.lb.full
		export : define [UnilateralMotion sf]    : composite-proc sf.lt.outer
		export : define [TopRightMotion sf]      : KInnerRtSerif sf.right sf.top sf.left sf.swRef sf.swSerif
		export : define [BilateralMotion sf]     : composite-proc sf.lt.outer [VExtendedRbOuter sf]
		export : define [BilateralTopMotion sf] : glyph-proc
			include : tagged 'serifLT' : HSerif.lt sf.left sf.top sf.sideJut sf.swSerif
			include : KInnerRtSerif sf.right sf.top sf.left sf.swRef sf.swSerif
		export : define [GrekLowerChi sf]     : composite-proc sf.lt.outer [VExtendedRtFull sf] sf.lb.full [VExtendedRbOuter sf]

	define [XLongLeftSerifs serifShape df top botLong] : glyph-proc
		if serifShape : begin
			local sf : SerifFrame.fromDf df top 0
			local sfLong : SerifFrame.fromDf df top botLong
			include : match serifShape
				[Just XSerifs.Full]                 : composite-proc sf.lt.full [VExtendedRtFull sf] sfLong.lb.full [VExtendedRbFull sf]
				[Just XSerifs.SemiChancery]         : composite-proc [VExtendedRtFull sf] sfLong.lb.full
				[Just XSerifs.UnilateralMotion]     : XSerifs.UnilateralMotion sf
				[Just XSerifs.TopRightMotion]       : XSerifs.TopRightMotion sf
				[Just XSerifs.BilateralMotion]      : XSerifs.BilateralMotion sf
				[Just XSerifs.BilateralTopMotion]   : XSerifs.BilateralTopMotion sf
				[Just XSerifs.GrekLowerChi]         : composite-proc sf.lt.outer [VExtendedRtFull sf] sfLong.lb.full [VExtendedRbOuter sf]
				__                                  : serifShape sf

	define [LowLeftBottomSerif x y _sw] : glyph-proc
		local sw : fallback _sw Stroke
		local length : Math.max VJut : Math.max LongVJut : sw * [StrokeWidthBlend 1.2 1.5]
		local swSerif : Math.max VJutStroke : sw * [StrokeWidthBlend 0.5 0.65]
		include : tagged 'serifLowLeft' : VSerif.ur x y length swSerif

	define [XLowRightRingTail box sw stb fSlab turn tension] : glyph-proc
		local [object radiusIn radiusOut] : RingDims
		local xMid box.xMid
		local yMid : mix box.t box.b 0.5
		local cy : box.b + radiusOut
		local cx : mix xMid box.r : Math.min 1 : Math.max 0 : (yMid - cy) / (yMid - box.b)
		local sx : cx - xMid
		local sy : cy - yMid
		local px : -sy
		local py sx
		local far VERY-FAR
		local farSide : spiro-outline
			corner (cx + px * far) (cy + py * far)
			corner (cx - px * far) (cy - py * far)
			corner (cx - px * far + sx * far) (cy - py * far + sy * far)
			corner (cx + px * far + sx * far) (cy + py * far + sy * far)
		include : difference
			union
				difference
					HalfXStrand stb fSlab box.r box.b xMid yMid turn 0.4 tension sw (-0.001)
					difference farSide : DotAt cx cy radiusOut
				DotAt cx cy radiusOut
			DotAt cx cy radiusIn

	define [XLowRightRingSerifs serifShape df top bot] : glyph-proc
		if serifShape : begin
			local sf : SerifFrame.fromDf df top bot
			include : match serifShape
				[Just XSerifs.Full]               : composite-proc sf.lt.full [VExtendedRtFull sf] sf.lb.full
				[Just XSerifs.SemiChancery]       : composite-proc [VExtendedRtFull sf]
				[Just XSerifs.UnilateralMotion]   : XSerifs.UnilateralMotion sf
				[Just XSerifs.TopRightMotion]     : XSerifs.TopRightMotion sf
				[Just XSerifs.BilateralMotion]    : composite-proc sf.lt.outer
				[Just XSerifs.BilateralTopMotion] : XSerifs.BilateralTopMotion sf
				[Just XSerifs.GrekLowerChi]       : composite-proc sf.lt.outer [VExtendedRtFull sf] sf.lb.full
				__                                : serifShape sf

	define [XLongLeftLowRightRingSerifs serifShape df top botLong] : glyph-proc
		if serifShape : begin
			local sf : SerifFrame.fromDf df top 0
			local sfLong : SerifFrame.fromDf df top botLong
			include : match serifShape
				[Just XSerifs.Full]               : composite-proc sf.lt.full [VExtendedRtFull sf] sfLong.lb.full
				[Just XSerifs.SemiChancery]       : composite-proc [VExtendedRtFull sf]
				[Just XSerifs.UnilateralMotion]   : XSerifs.UnilateralMotion sf
				[Just XSerifs.TopRightMotion]     : XSerifs.TopRightMotion sf
				[Just XSerifs.BilateralMotion]    : composite-proc sf.lt.outer
				[Just XSerifs.BilateralTopMotion] : XSerifs.BilateralTopMotion sf
				[Just XSerifs.GrekLowerChi]       : composite-proc sf.lt.outer [VExtendedRtFull sf] sfLong.lb.full
				__                                : serifShape sf

	glyph-block-export XConfig
	define XConfig : SuffixCfg.combine
		SuffixCfg.weave # standard variants
			object # body
				straight                { STROKE-STRAIGHT       STROKE-STRAIGHT       }
				curly                   { STROKE-CURLY          STROKE-CURLY          }
				hShaped                 { STROKE-H-SHAPED       STROKE-H-SHAPED       }
				hShapedCurly            { STROKE-H-SHAPED-CURLY STROKE-H-SHAPED-CURLY }
			object # height
				""                      { 0         'capital' 'e' }
				descending              { Descender 'capDesc' 'p' }
			object # serifs
				serifless               { null                        false }
				unilateralMotionSerifed { XSerifs.UnilateralMotion    false }
				topRightMotionSerifed   { XSerifs.TopRightMotion      false }
				bilateralMotionSerifed  { XSerifs.BilateralMotion     false }
				bilateralTopMotionSerifed { XSerifs.BilateralTopMotion false }
				serifed                 { XSerifs.Full                true  }
				grekLowerChiSerifed     { XSerifs.GrekLowerChi     true  }
		SuffixCfg.weave # semi-chancery variants
			object # body
				semiChanceryStraight    { STROKE-STRAIGHT STROKE-CHANCERY }
				semiChanceryCurly       { STROKE-CURLY    STROKE-CHANCERY }
			object # height
				""                      { 0         'capital' 'e' }
				descending              { Descender 'capDesc' 'p' }
			object # serifs
				serifless               { null                 false }
				serifed                 { XSerifs.SemiChancery true  }
		object # chancery variants
			chancery              { { STROKE-CHANCERY STROKE-CHANCERY } { 0         'capital' 'e' } { null false } }
			chanceryDescending    { { STROKE-CHANCERY STROKE-CHANCERY } { Descender 'capDesc' 'p' } { null false } }
		object # cursive variants
			cursive               { { STROKE-CURSIVE  STROKE-CURSIVE  } { 0         'capital' 'e' } { null false } }
			cursiveDescending     { { STROKE-CURSIVE  STROKE-CURSIVE  } { Descender 'capDesc' 'p' } { null false } }

	foreach { suffix { { stroke1 stroke2 } { bottom mkCap mkXH } { serifShape fMaskBase } } } [Object.entries XConfig] : do
		define [letterShape df top bot turn tension _sw] : glyph-proc
			local lf : XLetterForm [df.bodyBox top bot] stroke1 stroke2 turn tension _sw
			include : WithSerifOverflowMask fMaskBase [df.bodyBox top bot] : lf.base fMaskBase
			if serifShape : begin
				local sf : SerifFrame.fromDf df top bot
				include : serifShape sf

		create-glyph "X.\(suffix)" : glyph-proc
			include : MarkSet.(mkCap)
			include : letterShape [DivFrame 1 2] CAP bottom 0.1 0.28

		create-glyph "x.\(suffix)" : glyph-proc
			include : MarkSet.(mkXH)
			include : letterShape [DivFrame 1 2] XH bottom 0.1 0.20

		if [not bottom] : begin
			define [longLeftShape df top botLong turn tension _sw] : glyph-proc
				local lf : XLetterForm [df.bodyBox top 0] stroke1 stroke2 turn tension _sw
				include : WithSerifOverflowMask fMaskBase [df.bodyBox top botLong] : lf.longLeftLeg fMaskBase botLong
				include : XLongLeftSerifs serifShape df top botLong

			create-glyph "xLongLeftLeg.\(suffix)" : glyph-proc
				local df : include : DivFrame 1 2
				include : df.markSet.p
				include : longLeftShape df XH Descender 0.1 0.20
				include : LeaningAnchor.Below.VBar.l df.leftSB

			create-glyph "xLongLeftLegSerif.\(suffix)" : glyph-proc
				local df : include : DivFrame 1 2
				include : df.markSet.p
				include : longLeftShape df XH Descender 0.1 0.20
				include : LowLeftBottomSerif df.leftSB Descender
				include : LeaningAnchor.Below.VBar.l df.leftSB

			create-glyph "xLowRightRing.\(suffix)" : glyph-proc
				local df : include : DivFrame 1 2
				include : df.markSet.e
				local lf : XLetterForm [df.bodyBox XH 0] stroke1 stroke2 0.1 0.20
				include : WithSerifOverflowMask fMaskBase [df.bodyBox XH 0] : lf.lowRightRing fMaskBase
				include : XLowRightRingSerifs serifShape df XH 0

			create-glyph "xLongLeftLegLowRightRing.\(suffix)" : glyph-proc
				local df : include : DivFrame 1 2
				include : df.markSet.p
				local lf : XLetterForm [df.bodyBox XH 0] stroke1 stroke2 0.1 0.20
				include : WithSerifOverflowMask fMaskBase [df.bodyBox XH Descender] : lf.longLeftLowRightRing fMaskBase Descender
				include : XLongLeftLowRightRingSerifs serifShape df XH Descender
				include : LeaningAnchor.Below.VBar.l df.leftSB

		if bottom : create-glyph "latn/chiLowLeftSerif.\(suffix)" : glyph-proc
			include [refer-glyph "x.\(suffix)"] AS_BASE ALSO_METRICS
			include : LowLeftBottomSerif SB Descender

		if bottom : create-glyph "latn/chiLowRightRing.\(suffix)" : glyph-proc
			local df : include : DivFrame 1 2
			include : df.markSet.p
			local lf : XLetterForm [df.bodyBox XH bottom] stroke1 stroke2 0.1 0.20
			include : WithSerifOverflowMask fMaskBase [df.bodyBox XH bottom] : lf.lowRightRing fMaskBase
			include : XLowRightRingSerifs serifShape df XH bottom

		if bottom : create-glyph "latn/chiPalatalHook.\(suffix)" : match stroke2
			[Just STROKE-CURSIVE] : glyph-proc
				include [refer-glyph "x.\(suffix)"] AS_BASE ALSO_METRICS
				local attach : currentGlyph.gizmo.unapply (currentGlyph.baseAnchors.palatalHookAttach || currentGlyph.baseAnchors.bottomRight)
				include : PalatalHook.r attach.x bottom (yAttach -- attach.y)
			__ : glyph-proc
				local df : include : DivFrame para.advanceScaleM 1
				include : df.markSet.(mkXH)
				local subDf : DivFrame (0.75 * para.advanceScaleM) 2
				include : letterShape subDf XH bottom 0.1 0.20 subDf.mvs
				local tinyGap : Math.max (Width / 32) : AdviceStroke 24
				local sideJut : piecewise
					(serifShape && serifShape !== XSerifs.UnilateralMotion) SideJut
					(stroke2 === STROKE-STRAIGHT)                           ((-OX) * [StrokeWidthBlend 1 2])
					true                                                    0
				include : PalatalHook.r (df.rightSB + sideJut + tinyGap) 0
					xLink   -- subDf.middle
					yAttach -- ([mix bottom XH 0.5] - subDf.mvs / 2)
					refSw   -- subDf.mvs
					maskOut -- [intersection [MaskBelow : [mix bottom XH 0.5] - subDf.mvs / 2] [MaskLeft : subDf.rightSB + sideJut + tinyGap]]

	select-variant 'X' 'X'
	link-reduced-variant 'X/sansSerif' 'X' MathSansSerif
	select-variant 'smcpX' (shapeFrom -- 'x') (follow -- 'X')

	select-variant 'x' 'x'
	link-reduced-variant 'x/sansSerif' 'x' MathSansSerif

	alias 'grek/Chi' 0x3A7 'X'
	alias-reduced-variant 'grek/Chi/sansSerif' 'grek/Chi' 'X/sansSerif' MathSansSerif
	select-variant 'latn/Chi' 0xA7B3 (shapeFrom -- 'X')

	select-variant 'grek/chi' 0x3C7 (shapeFrom -- 'x')
	link-reduced-variant 'grek/chi/sansSerif' 'grek/chi' MathSansSerif (shapeFrom -- 'x')
	select-variant 'latn/chi' 0xAB53 (shapeFrom -- 'x')
	select-variant 'latn/chiLowLeftSerif' 0xAB55 (follow -- 'latn/chi')
	select-variant 'latn/chiLowRightRing' 0xAB54 (follow -- 'latn/chi')
	select-variant 'latn/chiPalatalHook' 0x1DF3D (follow -- 'latn/chi')
	select-variant 'xLongLeftLeg' 0xAB57 (follow -- 'x')
	select-variant 'xLongLeftLegSerif' 0xAB59 (follow -- 'x')
	select-variant 'xLowRightRing' 0xAB56 (follow -- 'x')
	select-variant 'xLongLeftLegLowRightRing' 0xAB58 (follow -- 'x')

	alias 'cyrl/Kha' 0x425 'X'
	alias 'cyrl/kha' 0x445 'x'
	select-variant 'cyrl/Kha/descBase' (shapeFrom -- 'X') (follow -- 'X/descBase')
	select-variant 'cyrl/kha/descBase' (shapeFrom -- 'x') (follow -- 'x/descBase')

	define [AddDescender Ctor] : function [src sel] : glyph-proc
		include [refer-glyph src] AS_BASE ALSO_METRICS
		local attachAnchor currentGlyph.baseAnchors.palatalHookAttach
		if attachAnchor
		: then : begin
			local attach : currentGlyph.gizmo.unapply attachAnchor
			include : Ctor.r attach.x 0 (yAttach -- attach.y)
		: else : begin
			local sw : Ctor.Sw Stroke
			include : Ctor.r
				x     -- (RightSB + SideJut + sw * TanSlope)
				y     -- 0
				xLink -- (RightSB - [HSwToV HalfStroke])

	derive-glyphs 'cyrl/KhaDescender' 0x4B2 'cyrl/Kha/descBase' [AddDescender CyrDescender]
	derive-glyphs 'cyrl/khaDescender' 0x4B3 'cyrl/kha/descBase' [AddDescender CyrDescender]
	derive-glyphs 'cyrl/KhaHook'      0x4FC 'cyrl/Kha/descBase' [AddDescender PalatalHook]
	derive-glyphs 'cyrl/khaHook'      0x4FD 'cyrl/kha/descBase' [AddDescender PalatalHook]
	alias 'xPalatalHook' 0x1D8D 'cyrl/khaHook'

	define [CyrlKhaBarShape top bot] : HOverlayBar [mix SB RightSB 0.08] [mix SB RightSB 0.92] [mix bot top 0.5]
	derive-composites 'cyrl/KhaBar' 0x4FE 'cyrl/Kha' [CyrlKhaBarShape CAP 0]
	derive-composites 'cyrl/khaBar' 0x4FF 'cyrl/kha' [CyrlKhaBarShape XH  0]

	derive-composites 'latn/chiBar' 0x1DF54 'latn/chi' [CyrlKhaBarShape XH Descender]

	glyph-block-import Letter-Blackboard : BBS BBD
	define [BBXShape l r top] : let [kDiag : DiagCorDs top (r - l) BBD] : union
		intersection [Rect top 0 [mix Width 0 2] [mix 0 Width 2]] : union
			ExtLineCenter  l                top (r - kDiag * BBD) 0 BBS 1
			ExtLineCenter (l + kDiag * BBD) top  r                0 BBS 1
		HBar.t l (l + kDiag * BBD) top BBS
		HBar.b r (r - kDiag * BBD) 0   BBS
		intersection [Rect top 0 [mix Width 0 2] [mix 0 Width 2]] : difference
			ExtLineCenter l 0 r top BBS 1
			spiro-outline
				corner  l                top
				corner (l + kDiag * BBD) top
				corner  r                0
				corner (r - kDiag * BBD) 0

	create-glyph 'mathbb/X' 0x1D54F : composite-proc [MarkSet.capital] [BBXShape SB RightSB CAP]
	create-glyph 'mathbb/x' 0x1D569 : composite-proc [MarkSet.e]       [BBXShape SB RightSB XH]
