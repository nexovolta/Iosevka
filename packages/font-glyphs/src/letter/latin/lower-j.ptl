$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [Dotless MathSansSerif] from "@iosevka/glyph/relation"

glyph-module

glyph-block Letter-Latin-Lower-J : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : LeaningAnchor ExtendAboveBaseAnchors
	glyph-block-import Letter-Shared : CreateAccentedComposition
	glyph-block-import Letter-Shared-Shapes : CurlyTail FlatHookDepth LetterBarOverlay
	glyph-block-import Letter-Shared-Shapes : DiagTail TopHook
	glyph-block-import Letter-Blackboard : BBS BBD
	glyph-block-import Letter-Latin-Lower-I : CasualTop
	glyph-block-import Letter-Arc-Hook : CornerHookDepth CornerHookStart

	glyph-block-export FlatHookDotlessJShape
	define [FlatHookDotlessJShape] : with-params [df dfHook top crossLeft barCenter serif [fCorner false]] : glyph-proc
		local bar : barCenter + [HSwToV HalfStroke]
		local hd : FlatHookDepth dfHook
		local terminal : Math.min
			bar - hd.x - [Math.max (Stroke / 3) (df.width / 6)] - [if fCorner [HSwToV Stroke] 0]
			crossLeft - OX * 2

		if serif : include : HSerif.lt barCenter top [Math.max Jut : mix [HSwToV HalfStroke] LongJut df.adws]
		include : dispiro
			widths.lhs
			if fCorner
				CornerHookStart terminal Descender [CornerHookDepth Hook Stroke] Stroke 1 (-1)
				list
					flat terminal Descender
			curl (bar - hd.x) Descender
			archv.superness DesignParameters.tightHookSuperness
			flat bar (Descender + hd.y)
			curl bar top [heading Upward]
		set-base-anchor 'above' barCenter top
		set-base-anchor 'trailing' (bar - hd.x) Descender
		set-base-anchor 'overlay' barCenter (top / 2)

	define XMiddleT : namespace
		export : define [StraightSerifless df] : df.middle + 0
		export : define [StraightSerifed   df] : df.middle + [IBalance2 df]
		export : define [StraightReverse   df] : df.middle - [IBalance2 df]
		export : define [BentHook          df] : df.middle + JBalance
		export : define [NarrowBentHook    df] : df.middle + JBalance
		export : define [DiagonalTailed    df] : df.middle + [IBalance2 df]
		export : define [FlatHookSerifless df] : df.middle + 0.25 * JBalance * df.adws * [mix 1 df.adws 2]
		export : define [FlatHookSerifed   df] : df.middle + JBalance * df.adws
		export : define [FlatHookReverse   df] : df.middle - JBalance * df.adws

	define JBody : namespace
		export : define [BentHook df top xMiddle] : glyph-proc
			local hookx : Math.min ((xMiddle - df.middle) - [HSwToV HalfStroke] + OXHook) (xMiddle - [HSwToV : 1.5 * Stroke] + OXHook)
			set-base-anchor "below" [mix hookx xMiddle 0.5] Descender
			include : dispiro
				widths.rhs
				flat (xMiddle + [HSwToV HalfStroke]) top [heading Downward]
				curl (xMiddle + [HSwToV HalfStroke]) (Descender + ArchDepthA)
				HookEnd Descender
				g4 hookx (Descender + JHook)

		export : define [NarrowBentHook df top xMiddle] : glyph-proc
			local pAdaptive : if (para.advanceScaleF < 1) ((1 - df.adws) / (1 - para.advanceScaleF)) 0
			local hookScale : mix 0.8 1.0 pAdaptive
			local hookxFull : Math.min ((xMiddle - df.middle) - [HSwToV HalfStroke] + OXHook) (xMiddle - [HSwToV : 1.5 * Stroke] + OXHook)
			local hookx : mix xMiddle hookxFull hookScale
			local swTerminal : mix Stroke [df.adviceStroke 2.75] [mix 0.35 0.1 pAdaptive]
			set-base-anchor "below" [mix hookx xMiddle 0.5] Descender
			include : dispiro
				widths.rhs
				flat (xMiddle + [HSwToV HalfStroke]) top [heading Downward]
				curl (xMiddle + [HSwToV HalfStroke]) (Descender + ArchDepthA)
				HookEnd Descender (swTerminal -- swTerminal)
				g4 hookx (Descender + JHook)

		export : define [Straight df top xMiddle] : glyph-proc
			include : VBar.m xMiddle Descender top
			set-base-anchor "below" xMiddle Descender
			set-base-anchor "trailing" (xMiddle + [HSwToV HalfStroke]) Descender

		export : define [FlatHook df top xMiddle] : glyph-proc
			local dfHook : DivFrame para.advanceScaleI
			local crossLeft : df.middle - (dfHook.middle - [mix 0 dfHook.leftSB : mix 1 dfHook.adws 2])
			include : FlatHookDotlessJShape df dfHook top
				crossLeft -- crossLeft
				barCenter -- xMiddle
				serif     -- false

		export : define [CornerHook df top xMiddle] : glyph-proc
			local dfHook : DivFrame para.advanceScaleI
			local crossLeft : df.middle - (dfHook.middle - [mix 0 dfHook.leftSB : mix 1 dfHook.adws 2])
			include : FlatHookDotlessJShape df dfHook top
				crossLeft -- crossLeft
				barCenter -- xMiddle
				serif     -- false
				fCorner   -- true

		export : define [DiagonalTailed df top xMiddle] : glyph-proc
			include : dispiro
				widths.center
				flat xMiddle top [heading Downward]
				DiagTail.L xMiddle Descender [DiagTail.StdDepth df Stroke] Stroke
			set-base-anchor "trailing" (xMiddle - [HSwToV HalfStroke]) Descender

		# Crossed/curly tail (U+029D). Stem matches BentHook; the hook is CurlyTail.
		export : define [CurlyTailBody df top xMiddle] : glyph-proc
			local fine : AdviceStroke 3.5
			set-base-anchor "below" [mix (xMiddle - [HSwToV HalfStroke] - LongJut) xMiddle 0.5] Descender
			include : dispiro
				widths.rhs
				flat (xMiddle + [HSwToV HalfStroke]) top [heading Downward]
				curl (xMiddle + [HSwToV HalfStroke]) (Descender + LongVJut)
				CurlyTail.n fine Descender ((xMiddle - [HSwToV HalfStroke]) - LongJut)
					x2 -- (df.rightSB + [HSwToV : 0.5 * fine] + JBalance)
					y2 -- (Descender + fine / 2)

		# Keep the existing j bottom (stem + descender) and stack a casual top
		# in the upper half of x-height, replacing the i-stem that Casual would draw.
		export : define [WithCasualTop kind Body] : lambda [df top xMiddle] : glyph-proc
			local yJoin : mix 0 top 0.5
			include : difference
				new-glyph : glyph-proc
					include : Body df top xMiddle
				MaskAbove (yJoin + HalfStroke)
			include : CasualTop df top xMiddle kind
			set-base-anchor "below" xMiddle Descender

	define JSerifs : namespace
		export : define [LongJutOf  df] : Math.max Jut : mix [HSwToV HalfStroke] LongJut df.adws
		export : define [CenterJutOf df] : Math.max MidJutCenter : mix [HSwToV HalfStroke] LongJut df.adws
		export : define [None        df top xMiddle] : no-shape
		export : define [Long        df top xMiddle] : tagged 'serifLT' : HSerif.lt xMiddle top [LongJutOf df]
		export : define [Short       df top xMiddle] : tagged 'serifLT' : HSerif.lt xMiddle top Jut
		export : define [Right       df top xMiddle] : tagged 'serifRT' : HSerif.rt xMiddle top [LongJutOf df]
		export : define [RightShort  df top xMiddle] : tagged 'serifRT' : HSerif.rt xMiddle top Jut
		export : define [Center      df top xMiddle] : tagged 'serifMT' : HSerif.mt xMiddle top [CenterJutOf df]
		export : define [CenterShort df top xMiddle] : tagged 'serifMT' : HSerif.mt xMiddle top [mix Jut [CenterJutOf df] 0.5]

	define JMarks : namespace
		export : define [Serifless df top xMiddle] : glyph-proc
			set-base-anchor 'above'   xMiddle  top
			set-base-anchor 'overlay' xMiddle (top / 2)

		export : define [Serifed df top xMiddle] : glyph-proc
			include : Serifless df top xMiddle
			include : LeaningAnchor.Above.At [mix df.middle xMiddle (7/8)]

	define JBaseConfig : object
		'bentHookSerifless'          { JBody.BentHook        JSerifs.None   XMiddleT.BentHook           JMarks.Serifless  1                   }
		'bentHookShortSerifed'       { JBody.BentHook        JSerifs.Short  XMiddleT.BentHook           JMarks.Serifless  1                   }
		'bentHookSerifed'            { JBody.BentHook        JSerifs.Long   XMiddleT.BentHook           JMarks.Serifed    1                   }
		'narrowBentHookSerifless'    { JBody.NarrowBentHook  JSerifs.None   XMiddleT.NarrowBentHook     JMarks.Serifless  para.advanceScaleF  }
		'narrowBentHookShortSerifed' { JBody.NarrowBentHook  JSerifs.Short  XMiddleT.NarrowBentHook     JMarks.Serifless  para.advanceScaleF  }
		'narrowBentHookSerifed'      { JBody.NarrowBentHook  JSerifs.Long   XMiddleT.NarrowBentHook     JMarks.Serifed    para.advanceScaleF  }
		'diagonalTailedSerifless'    { JBody.DiagonalTailed  JSerifs.None   XMiddleT.DiagonalTailed     JMarks.Serifless  para.advanceScaleI  }
		'diagonalTailedShortSerifed' { JBody.DiagonalTailed  JSerifs.Short  XMiddleT.DiagonalTailed     JMarks.Serifless  para.advanceScaleI  }
		'diagonalTailedSerifed'      { JBody.DiagonalTailed  JSerifs.Long   XMiddleT.DiagonalTailed     JMarks.Serifed    para.advanceScaleI  }
		'straightSerifless'          { JBody.Straight        JSerifs.None   XMiddleT.StraightSerifless  JMarks.Serifless  para.advanceScaleII }
		'straightShortSerifed'       { JBody.Straight        JSerifs.Short  XMiddleT.StraightSerifless  JMarks.Serifless  para.advanceScaleII }
		'straightSerifed'            { JBody.Straight        JSerifs.Long   XMiddleT.StraightSerifed    JMarks.Serifed    para.advanceScaleI  }
		'flatHookSerifless'          { JBody.FlatHook        JSerifs.None   XMiddleT.FlatHookSerifless  JMarks.Serifless  para.advanceScaleII }
		'cornerHookSerifless'          { JBody.CornerHook        JSerifs.None   XMiddleT.FlatHookSerifless  JMarks.Serifless  para.advanceScaleII }
		'flatHookShortSerifed'       { JBody.FlatHook        JSerifs.Short  XMiddleT.FlatHookSerifless  JMarks.Serifless  para.advanceScaleII }
		'cornerHookShortSerifed'       { JBody.CornerHook        JSerifs.Short  XMiddleT.FlatHookSerifless  JMarks.Serifless  para.advanceScaleII }
		'flatHookSerifed'            { JBody.FlatHook        JSerifs.Long   XMiddleT.FlatHookSerifed    JMarks.Serifed    para.advanceScaleI  }
		'cornerHookSerifed'            { JBody.CornerHook        JSerifs.Long   XMiddleT.FlatHookSerifed    JMarks.Serifed    para.advanceScaleI  }
		'bentHookReverseHooky'       { JBody.BentHook        JSerifs.Right       XMiddleT.BentHook           JMarks.Serifed    1                   }
		'bentHookShortReverseHooky'  { JBody.BentHook        JSerifs.RightShort  XMiddleT.BentHook           JMarks.Serifless  1                   }
		'bentHookCenterSerifed'      { JBody.BentHook        JSerifs.Center      XMiddleT.BentHook           JMarks.Serifed    1                   }
		'bentHookCenterShortSerifed' { JBody.BentHook        JSerifs.CenterShort XMiddleT.BentHook           JMarks.Serifless  1                   }
		'narrowBentHookReverseHooky'       { JBody.NarrowBentHook  JSerifs.Right       XMiddleT.NarrowBentHook     JMarks.Serifed    para.advanceScaleF  }
		'narrowBentHookShortReverseHooky'  { JBody.NarrowBentHook  JSerifs.RightShort  XMiddleT.NarrowBentHook     JMarks.Serifless  para.advanceScaleF  }
		'narrowBentHookCenterSerifed'      { JBody.NarrowBentHook  JSerifs.Center      XMiddleT.NarrowBentHook     JMarks.Serifed    para.advanceScaleF  }
		'narrowBentHookCenterShortSerifed' { JBody.NarrowBentHook  JSerifs.CenterShort XMiddleT.NarrowBentHook     JMarks.Serifless  para.advanceScaleF  }
		'diagonalTailedReverseHooky'       { JBody.DiagonalTailed  JSerifs.Right       XMiddleT.DiagonalTailed     JMarks.Serifed    para.advanceScaleI  }
		'diagonalTailedShortReverseHooky'  { JBody.DiagonalTailed  JSerifs.RightShort  XMiddleT.DiagonalTailed     JMarks.Serifless  para.advanceScaleI  }
		'diagonalTailedCenterSerifed'      { JBody.DiagonalTailed  JSerifs.Center      XMiddleT.DiagonalTailed     JMarks.Serifed    para.advanceScaleI  }
		'diagonalTailedCenterShortSerifed' { JBody.DiagonalTailed  JSerifs.CenterShort XMiddleT.DiagonalTailed     JMarks.Serifless  para.advanceScaleI  }
		'straightReverseHooky'       { JBody.Straight        JSerifs.Right       XMiddleT.StraightReverse      JMarks.Serifed    para.advanceScaleI  }
		'straightShortReverseHooky'  { JBody.Straight        JSerifs.RightShort  XMiddleT.StraightSerifless    JMarks.Serifless  para.advanceScaleII }
		'straightCenterSerifed'      { JBody.Straight        JSerifs.Center      XMiddleT.StraightSerifless    JMarks.Serifed    para.advanceScaleI  }
		'straightCenterShortSerifed' { JBody.Straight        JSerifs.CenterShort XMiddleT.StraightSerifless    JMarks.Serifless  para.advanceScaleII }
		'flatHookReverseHooky'       { JBody.FlatHook        JSerifs.Right       XMiddleT.FlatHookReverse      JMarks.Serifed    para.advanceScaleI  }
		'cornerHookReverseHooky'       { JBody.CornerHook        JSerifs.Right       XMiddleT.FlatHookReverse      JMarks.Serifed    para.advanceScaleI  }
		'flatHookShortReverseHooky'  { JBody.FlatHook        JSerifs.RightShort  XMiddleT.FlatHookSerifless    JMarks.Serifless  para.advanceScaleII }
		'cornerHookShortReverseHooky'  { JBody.CornerHook        JSerifs.RightShort  XMiddleT.FlatHookSerifless    JMarks.Serifless  para.advanceScaleII }
		'flatHookCenterSerifed'      { JBody.FlatHook        JSerifs.Center      XMiddleT.FlatHookSerifless    JMarks.Serifed    para.advanceScaleI  }
		'cornerHookCenterSerifed'      { JBody.CornerHook        JSerifs.Center      XMiddleT.FlatHookSerifless    JMarks.Serifed    para.advanceScaleI  }
		'flatHookCenterShortSerifed' { JBody.FlatHook        JSerifs.CenterShort XMiddleT.FlatHookSerifless    JMarks.Serifless  para.advanceScaleII }
		'cornerHookCenterShortSerifed' { JBody.CornerHook        JSerifs.CenterShort XMiddleT.FlatHookSerifless    JMarks.Serifless  para.advanceScaleII }
		'topTailedBentHook'         { [JBody.WithCasualTop 'tailed'    JBody.BentHook]        JSerifs.None XMiddleT.BentHook           JMarks.Serifless  1                   }
		'topFlatBentHook'           { [JBody.WithCasualTop 'flat'      JBody.BentHook]        JSerifs.None XMiddleT.BentHook           JMarks.Serifless  1                   }
		'topSemiBentHook'           { [JBody.WithCasualTop 'semi'      JBody.BentHook]        JSerifs.None XMiddleT.BentHook           JMarks.Serifless  1                   }
		'topDiagBentHook'           { [JBody.WithCasualTop 'diagonal'  JBody.BentHook]        JSerifs.None XMiddleT.BentHook           JMarks.Serifless  1                   }
		'topTailedStraight'         { [JBody.WithCasualTop 'tailed'    JBody.Straight]        JSerifs.None XMiddleT.StraightSerifless  JMarks.Serifless  para.advanceScaleII }
		'topFlatStraight'           { [JBody.WithCasualTop 'flat'      JBody.Straight]        JSerifs.None XMiddleT.StraightSerifless  JMarks.Serifless  para.advanceScaleII }
		'topSemiStraight'           { [JBody.WithCasualTop 'semi'      JBody.Straight]        JSerifs.None XMiddleT.StraightSerifless  JMarks.Serifless  para.advanceScaleII }
		'topDiagStraight'           { [JBody.WithCasualTop 'diagonal'  JBody.Straight]        JSerifs.None XMiddleT.StraightSerifless  JMarks.Serifless  para.advanceScaleII }
		'topTailedFlatHook'         { [JBody.WithCasualTop 'tailed'    JBody.FlatHook]        JSerifs.None XMiddleT.FlatHookSerifless  JMarks.Serifless  para.advanceScaleII }
		'topTailedCornerHook'         { [JBody.WithCasualTop 'tailed'    JBody.CornerHook]        JSerifs.None XMiddleT.FlatHookSerifless  JMarks.Serifless  para.advanceScaleII }
		'topFlatFlatHook'           { [JBody.WithCasualTop 'flat'      JBody.FlatHook]        JSerifs.None XMiddleT.FlatHookSerifless  JMarks.Serifless  para.advanceScaleII }
		'topFlatCornerHook'           { [JBody.WithCasualTop 'flat'      JBody.CornerHook]        JSerifs.None XMiddleT.FlatHookSerifless  JMarks.Serifless  para.advanceScaleII }
		'topSemiFlatHook'           { [JBody.WithCasualTop 'semi'      JBody.FlatHook]        JSerifs.None XMiddleT.FlatHookSerifless  JMarks.Serifless  para.advanceScaleII }
		'topSemiCornerHook'           { [JBody.WithCasualTop 'semi'      JBody.CornerHook]        JSerifs.None XMiddleT.FlatHookSerifless  JMarks.Serifless  para.advanceScaleII }
		'topDiagFlatHook'           { [JBody.WithCasualTop 'diagonal'  JBody.FlatHook]        JSerifs.None XMiddleT.FlatHookSerifless  JMarks.Serifless  para.advanceScaleII }
		'topDiagCornerHook'           { [JBody.WithCasualTop 'diagonal'  JBody.CornerHook]        JSerifs.None XMiddleT.FlatHookSerifless  JMarks.Serifless  para.advanceScaleII }
		'topTailedDiagonalTailed'   { [JBody.WithCasualTop 'tailed'    JBody.DiagonalTailed]  JSerifs.None XMiddleT.DiagonalTailed     JMarks.Serifless  para.advanceScaleI  }
		'topFlatDiagonalTailed'     { [JBody.WithCasualTop 'flat'      JBody.DiagonalTailed]  JSerifs.None XMiddleT.DiagonalTailed     JMarks.Serifless  para.advanceScaleI  }
		'topSemiDiagonalTailed'     { [JBody.WithCasualTop 'semi'      JBody.DiagonalTailed]  JSerifs.None XMiddleT.DiagonalTailed     JMarks.Serifless  para.advanceScaleI  }
		'topDiagDiagonalTailed'     { [JBody.WithCasualTop 'diagonal'  JBody.DiagonalTailed]  JSerifs.None XMiddleT.DiagonalTailed     JMarks.Serifless  para.advanceScaleI  }
		'topTailedNarrowBentHook'   { [JBody.WithCasualTop 'tailed'    JBody.NarrowBentHook]  JSerifs.None XMiddleT.NarrowBentHook     JMarks.Serifless  para.advanceScaleF  }
		'topFlatNarrowBentHook'     { [JBody.WithCasualTop 'flat'      JBody.NarrowBentHook]  JSerifs.None XMiddleT.NarrowBentHook     JMarks.Serifless  para.advanceScaleF  }
		'topSemiNarrowBentHook'     { [JBody.WithCasualTop 'semi'      JBody.NarrowBentHook]  JSerifs.None XMiddleT.NarrowBentHook     JMarks.Serifless  para.advanceScaleF  }
		'topDiagNarrowBentHook'     { [JBody.WithCasualTop 'diagonal'  JBody.NarrowBentHook]  JSerifs.None XMiddleT.NarrowBentHook     JMarks.Serifless  para.advanceScaleF  }

	define JTopStageConfig : object
		'topSerifless'             { JSerifs.None        nothing      'none'   false }
		'topHooky'                 { JSerifs.Long        nothing      'left'   true  }
		'topHookyShort'            { JSerifs.Short       nothing      'left'   false }
		'topReverseHooky'          { JSerifs.Right       nothing      'right'  true  }
		'topReverseHookyShort'     { JSerifs.RightShort  nothing      'right'  false }
		'topCenterSerifed'         { JSerifs.Center      nothing      'center' true  }
		'topCenterShortSerifed'    { JSerifs.CenterShort nothing      'center' false }
		'topTailed'                { JSerifs.None        'tailed'     'none'   false }
		'topFlatTailed'            { JSerifs.None        'flat'       'none'   false }
		'topSemiTailed'            { JSerifs.None        'semi'       'none'   false }
		'topDiagonalTailed'        { JSerifs.None        'diagonal'   'none'   false }

	define JBottomStageConfig : object
		'BottomBentHook'       { JBody.BentHook       XMiddleT.BentHook          1 }
		'BottomStraight'       { JBody.Straight       XMiddleT.StraightSerifless para.advanceScaleII }
		'BottomFlatHook'       { JBody.FlatHook       XMiddleT.FlatHookSerifless para.advanceScaleII }
		'BottomCornerHook'     { JBody.CornerHook     XMiddleT.FlatHookSerifless para.advanceScaleII }
		'BottomDiagonalTailed' { JBody.DiagonalTailed XMiddleT.DiagonalTailed    para.advanceScaleI }
		'BottomNarrowBentHook' { JBody.NarrowBentHook XMiddleT.NarrowBentHook    para.advanceScaleF }

	define [JStageXMiddle bottomName defaultXMiddleT topPosition topHasLongSerif] : begin
		if (bottomName === 'BottomStraight') : begin
			if (topPosition === 'left' && topHasLongSerif) : return XMiddleT.StraightSerifed
			if (topPosition === 'right' && topHasLongSerif) : return XMiddleT.StraightReverse
		if (bottomName === 'BottomFlatHook' || bottomName === 'BottomCornerHook') : begin
			if (topPosition === 'left' && topHasLongSerif) : return XMiddleT.FlatHookSerifed
			if (topPosition === 'right' && topHasLongSerif) : return XMiddleT.FlatHookReverse
		return defaultXMiddleT

	define [JStageVariantConfig top bottomName bottom] : begin
		local { topSerifs topTail topPosition topHasLongSerif } top
		local { bottomBody defaultXMiddleT adws } bottom
		local Body : if topTail [JBody.WithCasualTop topTail bottomBody] bottomBody
		local Marks : if topHasLongSerif JMarks.Serifed JMarks.Serifless
		local xMiddleT : JStageXMiddle bottomName defaultXMiddleT topPosition topHasLongSerif
		local wideSerif : topHasLongSerif && (bottomName === 'BottomStraight' || bottomName === 'BottomFlatHook' || bottomName === 'BottomCornerHook')
		local advanceScale : if wideSerif para.advanceScaleI adws
		return { Body topSerifs xMiddleT Marks advanceScale }

	define [JStageConfig] : Object.fromEntries : [Object.entries JTopStageConfig].flatMap : lambda [top]
		[Object.entries JBottomStageConfig].map : lambda [bottom] : begin
			return { "\(top.0)\(bottom.0)" [JStageVariantConfig top.1 bottom.0 bottom.1] }

	define JConfig : Object.assign JBaseConfig [JStageConfig]

	define JCurlyTailConfig : object
		'bentHookSerifless' { JBody.CurlyTailBody                                  JSerifs.None        JMarks.Serifless }
		'bentHookSerifed'   { JBody.CurlyTailBody                                  JSerifs.Long        JMarks.Serifless }
		'bentHookShortSerifed' { JBody.CurlyTailBody                               JSerifs.Short       JMarks.Serifless }
		'reverseHooky'      { JBody.CurlyTailBody                                  JSerifs.Right       JMarks.Serifless }
		'reverseHookyShort' { JBody.CurlyTailBody                                  JSerifs.RightShort  JMarks.Serifless }
		'centerSerifed'     { JBody.CurlyTailBody                                  JSerifs.Center      JMarks.Serifless }
		'centerShortSerifed' { JBody.CurlyTailBody                                 JSerifs.CenterShort JMarks.Serifless }
		'topTailed'         { [JBody.WithCasualTop 'tailed'    JBody.CurlyTailBody] JSerifs.None        JMarks.Serifless }
		'topFlat'           { [JBody.WithCasualTop 'flat'      JBody.CurlyTailBody] JSerifs.None        JMarks.Serifless }
		'topSemi'           { [JBody.WithCasualTop 'semi'      JBody.CurlyTailBody] JSerifs.None        JMarks.Serifless }
		'topDiag'           { [JBody.WithCasualTop 'diagonal'  JBody.CurlyTailBody] JSerifs.None        JMarks.Serifless }

	foreach { suffix { Body Serifs xMiddleT Marks adws } } [Object.entries JConfig] : do
		local df : DivFrame adws
		local xMiddle : xMiddleT df

		create-glyph "dotlessj.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.p
			include : Body   df XH xMiddle
			include : Serifs df XH xMiddle
			include : Marks  df XH xMiddle

		create-glyph "dotlessjBar.\(suffix)" : glyph-proc
			include [refer-glyph "dotlessj.\(suffix)"] AS_BASE ALSO_METRICS
			include : LetterBarOverlay.m xMiddle (XH / 2) (space -- {0  df.width})

		create-glyph "dotlessjBarHookTop.\(suffix)" : glyph-proc
			include [refer-glyph "dotlessjBar.\(suffix)"] AS_BASE ALSO_METRICS
			include : TopHook.toRight.mBarOuter xMiddle (XH + O) XH

	select-variant 'dotlessj' 0x237

	link-reduced-variant 'dotlessj/sansSerif' 'dotlessj' MathSansSerif
	CreateAccentedComposition 'j'           'j'  'dotlessj'           'tittleAbove'
	CreateAccentedComposition 'j/sansSerif' null 'dotlessj/sansSerif' 'tittleAbove'
	link-reduced-variant 'j/sansSerif' 'j' MathSansSerif

	select-variant 'dotlessjBar'        0x25F (follow -- 'dotlessj')
	select-variant 'dotlessjBarHookTop' 0x284 (follow -- 'dotlessjHookTop')
	CreateAccentedComposition 'jBar'    0x249 'dotlessjBar' 'tittleAbove'

	alias 'grek/yot' 0x3F3 'j'
	alias 'cyrl/je'  0x458 'j'

	foreach { suffix { Body Serifs Marks } } [Object.entries JCurlyTailConfig] : do
		local df : DivFrame 1
		local xMiddle : XMiddleT.BentHook df
		create-glyph "dotlessjCurlyTail.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.p
			include : Body   df XH xMiddle
			include : Serifs df XH xMiddle
			include : Marks  df XH xMiddle

	select-variant 'dotlessjCurlyTail'
	CreateAccentedComposition 'jCurlyTail' 0x29D 'dotlessjCurlyTail' 'tittleAbove'

	CreateAccentedComposition 'jAcute' null 'dotlessj' 'acuteAbove'

	create-glyph 'mathbb/dotlessj' : glyph-proc
		include : MarkSet.p
		local center : Middle + JBalance + BBD / 2
		set-base-anchor 'above'   (center - [HSwToV : 0.5 * BBS] - BBD / 2)  XH
		set-base-anchor 'overlay' (center - [HSwToV : 0.5 * BBS] - BBD / 2) (XH / 2)
		local hookx : (center - Middle) - [HSwToV BBD] + OXHook
		local turn : Arch.adjust-x.bot [mix center hookx 0.5]
		include : dispiro
			widths.rhs BBS
			flat center XH [heading Downward]
			curl center (Descender + ArchDepthA)
			HookEnd Descender (sw -- BBS)
			g4 hookx (Descender + JHook)
		include : HBar.t (center - [HSwToV : 0.5 * BBS] - BBD - Jut) center XH BBS
		include : intersection
			VBar.r (center - BBD) Descender XH BBS
			spiro-outline
				corner center XH [heading Downward]
				curl center (Descender + ArchDepthA)
				HookEnd Descender (sw -- BBS)
				g4 hookx (Descender + JHook)
				corner hookx XH

	create-glyph 'mathbb/j' 0x1D55B : glyph-proc
		include [refer-glyph 'mathbb/dotlessj'] AS_BASE ALSO_METRICS
		include [refer-glyph 'mathbb/dotAbove']
		Dotless.set currentGlyph 'mathbb/dotlessj'
