$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback SuffixCfg] from "@iosevka/util"
import [MathSansSerif] from "@iosevka/glyph/relation"
import [Vec2] from "@iosevka/geometry/point"

glyph-module

glyph-block Letter-Latin-Lower-A : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared : CreateAccentedComposition CreateMultiAccentedComposition CreateTurnedLetter
	glyph-block-import Letter-Shared-Shapes : SerifFrame OBarRight OBarLeft ArcStartSerif
	glyph-block-import Letter-Shared-Shapes : RightwardTailedBar LeftwardTailedBar RetroflexHook
	glyph-block-import Letter-Shared-Shapes : InwardSlabArcStart StemCutY ApplyDiagCut
	glyph-block-import Letter-Arc-Hook : MakeFlatHook

	define HOOK-SLAB-NONE      0
	define HOOK-SLAB-CLASSICAL 1 # TODO
	define HOOK-SLAB-INWARD    2
	define HOOK-HALF           3
	define HOOK-FLAT           4

	glyph-block-export DoubleStorey
	define DoubleStorey : namespace
		export : define [Sw df] : df.adviceStroke2 2 3 XH
		export : define [SmoothA df] : begin
			local sw : Sw df
			local ad : ArchDepth * [StrokeWidthBlend 0.9 0.81 sw]
			return : ArchDepthAClamped XH 0
				df.archDepthAOf ad sw
				df.archDepthBOf ad sw
		export : define [SmoothB df] : begin
			local sw : Sw df
			local ad : ArchDepth * [StrokeWidthBlend 0.9 0.81 sw]
			return : ArchDepthBClamped XH 0
				df.archDepthAOf ad sw
				df.archDepthBOf ad sw

		define [HookAndBarT sink] : function [df hookStyle y0 stroke fine] : begin
			local isMask : sink == spiro-outline
			local barRightX : df.rightSB - [HSwToV : stroke - [fallback fine stroke]]
			local hookLeftX : match hookStyle
				[Just HOOK-HALF] : Math.min
					barRightX - [HSwToV : [fallback fine stroke] + 0.125 * stroke] - TINY - [Math.abs : TanSlope * stroke]
					[Arch.adjust-x.top (barRightX - [HSwToV : 0.5 * [fallback fine stroke]] - HookX) (sw -- [mix stroke [fallback fine stroke] 0.5])] + OXHook
				__ : df.leftSB + 0
			return : sink
				widths.rhs stroke
				match hookStyle
					[Just HOOK-SLAB-INWARD] : InwardSlabArcStart.LtrRhs hookLeftX XH stroke AHook (swAfter -- fine)
					[Just HOOK-HALF] : list
						g4.right.start hookLeftX (XH - O)
						archv
					[Just HOOK-FLAT] : [MakeFlatHook df.leftSB df.rightSB XH 0 (sw -- stroke)].hookStartL
					__ : if fine
						list
							g4.up.start hookLeftX (XH - AHook) [heading Upward]
							Arch.rhs XH (sw -- stroke) (swAfter -- fine)
						list
							g4 hookLeftX (XH - AHook)
							HookStart XH (sw -- stroke)
				flat barRightX [Math.max (XH - [SmoothB df]) (y0 + TINY + [HSwToV : Math.abs : TanSlope * [fallback fine stroke]])] [if fine [widths.rhs fine] nothing]
				[if isMask corner curl] barRightX y0 [heading Downward]
				if isMask { [corner hookLeftX y0] } {}

		export : define [HookAndBar df hookStyle y0 stroke fine] : glyph-proc
			local sw : fallback stroke : Sw df
			include : [HookAndBarT dispiro] df hookStyle y0 sw fine
			include : match hookStyle
				[Just HOOK-SLAB-INWARD] : ArcStartSerif.InwardL df.leftSB XH sw AHook
				__                      : no-shape

		export : define [HookAndBarMask df hookStyle y0 stroke fine] : begin
			local sw : fallback stroke : Sw df
			return : [HookAndBarT spiro-outline] df hookStyle y0 sw fine

		define [ArcT sink] : function [df kind rise stroke fine bbd diag] : glyph-proc
			local isMask : sink == spiro-outline
			local barTop : [mix 0 XH DesignParameters.aBarPos] + stroke * (0.5 + DesignParameters.aBarStrokeAdj)
			local ada  : df.archDepthAOf (SmallArchDepth * 0.9) stroke
			local adb  : df.archDepthBOf (SmallArchDepth * 0.9) stroke
			local ada2 :    ArchDepthAOf (SmallArchDepth * DesignParameters.aBarPos)
			local adb2 :    ArchDepthBOf (SmallArchDepth * DesignParameters.aBarPos)
			local leftSlopeS : 0.1 * (df.width / HalfUPM)
			local leftSlope  : clamp (-1) (+1) (leftSlopeS - TanSlope)
			local rr : [fallback diag 0] * 0.09 * XH
			local xStart : df.rightSB - [HSwToV stroke] * 0.5
			local xEnd : mix df.leftSB df.rightSB 0.42
			include : sink
				widths.lhs stroke
				[if isMask corner flat] [if (rr && !isMask) xStart (df.rightSB + O)] (barTop + rr) [heading : if rr [new Vec2 (-2 * rr / [Math.hypot (xEnd - xStart) (2 * rr)]) ((xEnd - xStart) / [Math.hypot (xEnd - xStart) (2 * rr)])] Leftward]
				curl xEnd (barTop - rr)
				archv
				g4 (df.leftSB + OX) ([YSmoothMidL (barTop - rr) 0 ada2 adb2] - [HSwToV leftSlopeS] * SmoothAdjust) [heading {.x (+HVContrast) .y (+leftSlope)}]
				match kind
					0 : list
						Arch.lhs 0 (sw -- stroke) (swAfter -- fine)
						flat (df.rightSB - bbd - [HSwToV : stroke - fine]) [Math.min (barTop - TINY - [HSwToV : Math.abs : fine * TanSlope]) (0 + ada)] [widths.lhs fine]
						[if isMask corner curl] (df.rightSB - bbd - [HSwToV : stroke - fine]) (barTop + rr) [heading Upward]
					1 : if rise
						list
							Arch.lhs 0 (sw -- stroke) (blendPost -- {})
							g4   df.rightSB rise
						list
							arcvh
							flat [Arch.adjust-x.bot df.middle (sw -- stroke)] 0
							curl (df.rightSB + O) 0 [heading Rightward]
					2 : list
						Arch.lhs 0 (sw -- stroke)
						flat df.rightSB [Math.min rise : YSmoothMidR barTop 0 ada2 adb2]
						curl df.rightSB (rise + TINY + [HSwToV : Math.abs : stroke * TanSlope]) [heading Upward]

		export : define [Arc df kind rise _sw _fine _bbd _diag] : [ArcT dispiro] df kind rise
			fallback _sw : Sw df
			fallback _fine df.shoulderFine
			fallback _bbd  0
			fallback _diag 0

		export : define [ArcMask df kind rise _sw _fine _bbd _diag] : [ArcT spiro-outline] df kind rise
			fallback _sw : Sw df
			fallback _fine df.shoulderFine
			fallback _bbd  0
			fallback _diag 0

		export : define [Serifless df hookStyle _sw cut diag] : union
			HookAndBar df hookStyle [if (cut === 'bottomCut') HalfStroke 0] _sw
			Arc        df 0         0 _sw nothing nothing diag
			ApplyDiagCut (cut -- cut) (side -- 'r') (x -- df.rightSB) (bot -- 0) (top -- XH) (sw -- [fallback _sw : Sw df])

		export : define [Serifed df hookStyle _sw cut diag] : union
			Serifless  df hookStyle _sw cut diag
			begin [SerifFrame.fromDf df XH 0 (swRef -- [fallback _sw : Sw df]) (swSerif -- df.mvs)].rb.outer

		export : define [Tailed df hookStyle _sw cut diag] : union
			HookAndBar df hookStyle [SmoothA df] _sw
			Arc        df 0         0            _sw nothing nothing diag
			RightwardTailedBar df.rightSB 0 (XH - [SmoothB df]) [fallback _sw : Sw df]

		export : define [FlatBottomSerifless df hookStyle _sw cut diag] : union
			HookAndBar df hookStyle [if (cut === 'bottomCut') HalfStroke 0] _sw
			Arc        df 1         0 _sw nothing nothing diag
			ApplyDiagCut (cut -- cut) (side -- 'r') (x -- df.rightSB) (bot -- 0) (top -- XH) (sw -- [fallback _sw : Sw df])

		export : define [FlatBottomSerifed df hookStyle _sw cut diag] : union
			FlatBottomSerifless df hookStyle _sw cut diag
			begin [SerifFrame.fromDf df XH 0 (swRef -- [fallback _sw : Sw df]) (swSerif -- df.mvs)].rb.outer

		export : define [ToothlessCorner df hookStyle _sw cut diag] : union
			HookAndBar df hookStyle DToothlessRise _sw
			Arc        df 1         DToothlessRise _sw nothing nothing diag

		export : define [ToothlessRounded df hookStyle _sw cut diag] : union
			HookAndBar df hookStyle [SmoothA df] _sw
			Arc        df 2         [SmoothA df] _sw nothing nothing diag

		export : define [Mask shapeFn df _sw diag] : match shapeFn
			[Just FlatBottomSerifless] : ArcMask df 1 0              _sw nothing nothing diag
			[Just FlatBottomSerifed]   : ArcMask df 1 0              _sw nothing nothing diag
			[Just ToothlessCorner]     : ArcMask df 1 DToothlessRise _sw nothing nothing diag
			[Just ToothlessRounded]    : ArcMask df 2 [SmoothA df]   _sw nothing nothing diag
			__                         : ArcMask df 0 0              _sw nothing nothing diag

	define RevDoubleStorey : namespace
		export : define [Sw df] : df.adviceStroke2 2 3 XH
		export : define [SmoothA df] : begin
			local sw : Sw df
			local ad : ArchDepth * [StrokeWidthBlend 0.9 0.81 sw]
			return : ArchDepthAClamped XH 0
				df.archDepthAOf ad sw
				df.archDepthBOf ad sw
		export : define [SmoothB df] : begin
			local sw : Sw df
			local ad : ArchDepth * [StrokeWidthBlend 0.9 0.81 sw]
			return : ArchDepthBClamped XH 0
				df.archDepthAOf ad sw
				df.archDepthBOf ad sw

		define [HookAndBarT sink] : function [df hookStyle y0 stroke fine] : begin
			local isMask : sink == spiro-outline
			local barLeftX : df.leftSB + [HSwToV : stroke - [fallback fine stroke]]
			local hookRightX : match hookStyle
				[Just HOOK-HALF] : Math.max
					barLeftX + [HSwToV : [fallback fine stroke] + 0.125 * stroke] + TINY + [Math.abs : TanSlope * stroke]
					[Arch.adjust-x.top (barLeftX + [HSwToV : 0.5 * [fallback fine stroke]] + HookX) (sw -- [mix stroke [fallback fine stroke] 0.5])] - OXHook
				__ : df.rightSB + 0
			return : sink
				widths.lhs stroke
				match hookStyle
					[Just HOOK-SLAB-INWARD] : InwardSlabArcStart.RtlLhs hookRightX XH stroke AHook (swAfter -- fine)
					[Just HOOK-HALF] : list
						g4.left.start hookRightX (XH - O)
						archv
					[Just HOOK-FLAT] : [MakeFlatHook df.leftSB df.rightSB XH 0 (sw -- stroke)].hookStartR
					__ : if fine
						list
							g4.up.start hookRightX (XH - AHook) [heading Upward]
							Arch.lhs XH (sw -- stroke) (swAfter -- fine)
						list
							g4 hookRightX (XH - AHook)
							HookStart XH (sw -- stroke)
				flat barLeftX [Math.max (XH - [SmoothA df]) (y0 + TINY + [HSwToV : Math.abs : TanSlope * [fallback fine stroke]])] [if fine [widths.lhs fine] nothing]
				[if isMask corner curl] barLeftX y0 [heading Downward]
				if isMask { [corner hookRightX y0] } {}

		export : define [HookAndBar df hookStyle y0 stroke fine] : glyph-proc
			local sw : fallback stroke : Sw df
			include : [HookAndBarT dispiro] df hookStyle y0 sw fine
			include : match hookStyle
				[Just HOOK-SLAB-INWARD] : ArcStartSerif.InwardR df.rightSB XH sw AHook
				__                      : no-shape

		export : define [HookAndBarMask df hookStyle y0 stroke fine] : begin
			local sw : fallback stroke : Sw df
			return : [HookAndBarT spiro-outline] df hookStyle y0 sw fine

		define [ArcT sink] : function [df kind rise stroke fine diag] : glyph-proc
			local isMask : sink == spiro-outline
			local barTop : [mix 0 XH DesignParameters.aBarPos] + stroke * (0.5 + DesignParameters.aBarStrokeAdj)
			local ada  : df.archDepthAOf (SmallArchDepth * 0.9) stroke
			local adb  : df.archDepthBOf (SmallArchDepth * 0.9) stroke
			local ada2 :    ArchDepthAOf (SmallArchDepth * DesignParameters.aBarPos)
			local adb2 :    ArchDepthBOf (SmallArchDepth * DesignParameters.aBarPos)
			local rightSlopeS : 0.1 * (df.width / HalfUPM)
			local rightSlope  : clamp (-1) (+1) (rightSlopeS + TanSlope)
			local rr : [fallback diag 0] * 0.09 * XH
			local xStart : df.leftSB + [HSwToV stroke] * 0.5
			local xEnd : mix df.rightSB df.leftSB 0.42
			include : sink
				widths.rhs stroke
				[if isMask corner flat] [if (rr && !isMask) xStart (df.leftSB - O)] (barTop - rr) [heading : if rr [new Vec2 (2 * rr / [Math.hypot (xEnd - xStart) (2 * rr)]) ((xEnd - xStart) / [Math.hypot (xEnd - xStart) (2 * rr)])] Rightward]
				curl xEnd (barTop + rr)
				archv
				g4 (df.rightSB - OX) ([YSmoothMidR (barTop + rr) 0 ada2 adb2] - [HSwToV rightSlopeS] * SmoothAdjust) [heading {.x (+HVContrast) .y (-rightSlope)}]
				match kind
					0 : list
						Arch.rhs 0 (sw -- stroke) (swAfter -- fine)
						flat (df.leftSB + [HSwToV : stroke - fine]) [Math.min (barTop - TINY - [HSwToV : Math.abs : fine * TanSlope]) (0 + adb)] [widths.rhs fine]
						[if isMask corner curl] (df.leftSB + [HSwToV : stroke - fine]) (barTop - rr) [heading Upward]
					1 : if rise
						list
							Arch.rhs 0 (sw -- stroke) (blendPost -- {})
							g4   df.leftSB rise
						list
							arcvh
							flat [Arch.adjust-x.bot df.middle (sw -- stroke)] 0
							curl (df.leftSB - O) 0 [heading Leftward]
					2 : list
						Arch.rhs 0 (sw -- stroke)
						flat df.leftSB [Math.min rise : YSmoothMidL barTop 0 ada2 adb2]
						curl df.leftSB (rise + TINY + [HSwToV : Math.abs : stroke * TanSlope]) [heading Upward]

		export : define [Arc df kind rise _sw _fine _diag] : [ArcT dispiro] df kind rise
			fallback _sw : Sw df
			fallback _fine df.shoulderFine
			fallback _diag 0

		export : define [ArcMask df kind rise _sw _fine _diag] : [ArcT spiro-outline] df kind rise
			fallback _sw : Sw df
			fallback _fine df.shoulderFine
			fallback _diag 0

		export : define [Serifless df hookStyle _sw cut diag] : union
			HookAndBar df hookStyle [if (cut === 'bottomCut') HalfStroke 0] _sw
			Arc        df 0         0 _sw nothing diag
			ApplyDiagCut (cut -- cut) (side -- 'l') (x -- df.leftSB) (bot -- 0) (top -- XH) (sw -- [fallback _sw : Sw df])

		export : define [Serifed df hookStyle _sw cut diag] : union
			Serifless  df hookStyle _sw cut diag
			begin [SerifFrame.fromDf df XH 0 (swRef -- [fallback _sw : Sw df]) (swSerif -- df.mvs)].lb.outer

		export : define [Tailed df hookStyle _sw cut diag] : union
			HookAndBar df hookStyle [SmoothB df] _sw
			Arc        df 0         0            _sw nothing diag
			LeftwardTailedBar df.leftSB 0 (XH - [SmoothA df]) [fallback _sw : Sw df]

		export : define [FlatBottomSerifless df hookStyle _sw cut diag] : union
			HookAndBar df hookStyle [if (cut === 'bottomCut') HalfStroke 0] _sw
			Arc        df 1         0 _sw nothing diag
			ApplyDiagCut (cut -- cut) (side -- 'l') (x -- df.leftSB) (bot -- 0) (top -- XH) (sw -- [fallback _sw : Sw df])

		export : define [FlatBottomSerifed df hookStyle _sw cut diag] : union
			FlatBottomSerifless df hookStyle _sw cut diag
			begin [SerifFrame.fromDf df XH 0 (swRef -- [fallback _sw : Sw df]) (swSerif -- df.mvs)].lb.outer

		export : define [ToothlessCorner df hookStyle _sw cut diag] : union
			HookAndBar df hookStyle DToothlessRise _sw
			Arc        df 1         DToothlessRise _sw nothing diag

		export : define [ToothlessRounded df hookStyle _sw cut diag] : union
			HookAndBar df hookStyle [SmoothB df] _sw
			Arc        df 2         [SmoothB df] _sw nothing diag

		export : define [Mask shapeFn df _sw diag] : match shapeFn
			[Just FlatBottomSerifless] : ArcMask df 1 0              _sw nothing diag
			[Just FlatBottomSerifed]   : ArcMask df 1 0              _sw nothing diag
			[Just ToothlessCorner]     : ArcMask df 1 DToothlessRise _sw nothing diag
			[Just ToothlessRounded]    : ArcMask df 2 [SmoothB df]   _sw nothing diag
			__                         : ArcMask df 0 0              _sw nothing diag

	glyph-block-export DoubleStoreyConfig DoubleStoreyDiagConfig
	define DoubleStoreyConfig : SuffixCfg.weave
		object # Hook style
			doubleStorey                  HOOK-SLAB-NONE
			doubleStoreyHookInwardSerifed HOOK-SLAB-INWARD
			doubleStoreyHookFlat          HOOK-FLAT
		function [hook] : object # cut
			""         ""
			bottomCut  "bottomCut"
		function [hook cut] : begin
			if (cut === 'bottomCut') : return : object
				serifless { DoubleStorey.Serifless RevDoubleStorey.Serifless RightSB }
			return : object
				serifless           { DoubleStorey.Serifless           RevDoubleStorey.Serifless           RightSB            }
				serifed             { DoubleStorey.Serifed             RevDoubleStorey.Serifed            (RightSB + SideJut) }
				tailed              { DoubleStorey.Tailed              RevDoubleStorey.Tailed             (RightSB + SideJut) }
				flatBottomSerifless { DoubleStorey.FlatBottomSerifless RevDoubleStorey.FlatBottomSerifless RightSB            }
				flatBottomSerifed   { DoubleStorey.FlatBottomSerifed   RevDoubleStorey.FlatBottomSerifed  (RightSB + SideJut) }
				toothlessCorner     { DoubleStorey.ToothlessCorner     RevDoubleStorey.ToothlessCorner     null               }
				toothlessRounded    { DoubleStorey.ToothlessRounded    RevDoubleStorey.ToothlessRounded    null               }

	define DoubleStoreyDiagConfig : SuffixCfg.weave DoubleStoreyConfig : object
		""         0
		diagonalBar        0.5
		diagonalBarFalling (-0.5)

	foreach { suffix { { hookStyle cut { body revBody xTrailing } } diag } } [Object.entries DoubleStoreyDiagConfig] : do
		do
			create-glyph "a.\(suffix)" : make [DivFrame 1]
			if (!hookStyle && !diag) : begin
				create-glyph "aHalf.\(suffix)" : make [DivFrame 1] HOOK-HALF
		: where : [make df _hookStyle] : glyph-proc
			set-width df.width
			include : df.markSet.e
			local sw : DoubleStorey.Sw df
			local bp : [mix 0 XH DesignParameters.aBarPos] + sw * DesignParameters.aBarStrokeAdj
			set-base-anchor 'overlay' df.middle [mix 0 (bp + sw / 2) 0.5]
			set-base-anchor 'strike'  df.middle bp
			if xTrailing : set-base-anchor 'trailing' xTrailing 0
			include : body df [fallback _hookStyle hookStyle] nothing cut diag

		create-glyph "aSwash.\(suffix)" : glyph-proc
			include [refer-glyph "a.\(suffix)"] AS_BASE ALSO_METRICS
			eject-contour 'serifRB'
			include : RetroflexHook.rExt RightSB 0
				yAttach -- [DoubleStorey.SmoothA : DivFrame 1]
				sw      -- [DoubleStorey.Sw      : DivFrame 1]

		create-glyph "reva.\(suffix)" : glyph-proc
			local df : include : DivFrame 1
			include : df.markSet.e
			local sw : RevDoubleStorey.Sw df
			local bp : [mix 0 XH DesignParameters.aBarPos] + sw * DesignParameters.aBarStrokeAdj
			set-base-anchor 'overlay' df.middle [mix 0 (bp + sw / 2) 0.5]
			set-base-anchor 'strike'  df.middle bp
			include : revBody df hookStyle nothing cut diag

		if (body === DoubleStorey.Serifless) : begin
			create-glyph "aRetroflexHook.\(suffix)" : glyph-proc
				include [refer-glyph "a.\(suffix)"] AS_BASE ALSO_METRICS
				include : RetroflexHook.rSideJut RightSB 0 (yOverflow -- Stroke)

	glyph-block-import Letter-Blackboard : BBS BBD
	create-glyph 'mathbb/a' 0x1D552 : glyph-proc
		local df : include : DivFrame 1
		include : df.markSet.e

		include : DoubleStorey.HookAndBar df 0 0 BBS
		include : intersection
			DoubleStorey.HookAndBarMask df 0 0
			VBar.r (RightSB - BBD) 0 XH BBS
		include : difference
			union
				DoubleStorey.Arc df 0 0 BBS ShoulderFine BBD
				intersection
					DoubleStorey.ArcMask df 0 0 BBS ShoulderFine BBD
					VBar.l (SB + OX + BBD) 0 XH BBS
			Rect XH 0 (RightSB - BBD) Width
		include : HBar.b (RightSB - BBD) RightSB 0 BBS

	# Greek Lower Alpha
	define [CrossingBody df top _sw _ada _adb] : glyph-proc
		local sw  : fallback _sw    df.mvs
		local ada : fallback _ada : df.archDepthAOf SmallArchDepth sw
		local adb : fallback _adb : df.archDepthBOf SmallArchDepth sw
		local middle : mix df.leftSB df.rightSB 0.42
		local fine : df.adviceStroke 3.25
		local k1 0.25
		local k2 0.50
		local k3 0.35
		local k4 1.00
		include : dispiro
			g4   (df.rightSB - OX * 1.75) top [widths.rhs.heading fine Downward]
			bezControls (0 + k1) (0 + k2) (0 + k3) (0 + k4) 6
			Arch.rhs.centerAt.rtl.b middle 0 (sw -- df.mvs) (swBefore -- fine)
			archv
			flatside.lu df.leftSB 0 top ada adb (OX * 2) [widths.rhs df.mvs]
			arcvh
			Arch.rhs.centerAt.ltr.t middle top (sw -- df.mvs) (swAfter -- fine)
			bezControls (1 - k3) (1 - k4) (1 - k1) (1 - k2) 6
			g4   (df.rightSB - OX * 2.00) 0 [widths.rhs.heading fine Downward]

		set-base-anchor 'overlay' (middle - OX) [mix 0 top OverlayPos]
		set-base-anchor 'strike'  (middle - OX) [mix 0 top 0.5]

	create-glyph "a.crossing" : glyph-proc
		local df : include : DivFrame 1
		include : df.markSet.e
		include : CrossingBody df XH

	glyph-block-export SingleStorey
	define SingleStorey : namespace
		export : define [FullBarBody df top bar cut _sw _ada _adb] : glyph-proc
			local sw  : fallback _sw    df.mvs
			local ada : fallback _ada : df.archDepthAOf SmallArchDepth sw
			local adb : fallback _adb : df.archDepthBOf SmallArchDepth sw
			include : OBarRight.shape
				top   -- top
				left  -- df.leftSB
				right -- df.rightSB
				sw    -- sw
				fine  -- (ShoulderFine * (sw / Stroke))
				ada   -- ada
				adb   -- adb
			include : bar df top sw cut
			include : ApplyDiagCut (cut -- cut) (side -- 'r') (x -- df.rightSB) (bot -- 0) (top -- top) (sw -- sw)
		export : define [FlatTopBody df top bar cut _sw _ada _adb] : glyph-proc
			local sw  : fallback _sw    df.mvs
			local ada : fallback _ada : df.archDepthAOf SmallArchDepth sw
			local adb : fallback _adb : df.archDepthBOf SmallArchDepth sw
			include : OBarRight.earlessCorner
				top   -- top
				left  -- df.leftSB
				right -- df.rightSB
				sw    -- sw
				fine  -- (ShoulderFine * (sw / Stroke))
				ada   -- ada
				adb   -- adb
				rise  -- 0
			include : bar df top sw cut
			include : ApplyDiagCut (cut -- cut) (side -- 'r') (x -- df.rightSB) (bot -- 0) (top -- top) (sw -- sw)
		export : define [EarlessCornerBody df top bar cut _sw _ada _adb] : glyph-proc
			local sw  : fallback _sw    df.mvs
			local ada : fallback _ada : df.archDepthAOf SmallArchDepth sw
			local adb : fallback _adb : df.archDepthBOf SmallArchDepth sw
			include : OBarRight.earlessCorner
				top   -- top
				left  -- df.leftSB
				right -- df.rightSB
				sw    -- sw
				fine  -- (ShoulderFine * (sw / Stroke))
				ada   -- ada
				adb   -- adb
			include : bar df (top - DToothlessRise) sw cut
			include : ApplyDiagCut (cut -- cut) (side -- 'r') (x -- df.rightSB) (bot -- 0) (top -- (top - DToothlessRise)) (sw -- sw)
		export : define [EarlessRoundedBody df top bar cut _sw _ada _adb] : glyph-proc
			local sw  : fallback _sw    df.mvs
			local ada : fallback _ada : df.archDepthAOf SmallArchDepth sw
			local adb : fallback _adb : df.archDepthBOf SmallArchDepth sw
			include : OBarRight.earlessRounded
				top   -- top
				left  -- df.leftSB
				right -- df.rightSB
				sw    -- sw
				fine  -- (ShoulderFine * (sw / Stroke))
				ada   -- ada
				adb   -- adb
				yTerminal -- ada
			include : bar df (top - adb) sw cut
			include : ApplyDiagCut (cut -- cut) (side -- 'r') (x -- df.rightSB) (bot -- 0) (top -- (top - adb)) (sw -- sw)

		export : define [SeriflessBar df top _sw cut] : glyph-proc
			local y : StemCutY (bot -- 0) (top -- top) (cut -- cut)
			set-base-anchor 'trailing' df.rightSB 0
			include : VBar.r df.rightSB y.bot y.top _sw
		export : define [BottomSerifedBar df top _sw cut] : glyph-proc
			include : SeriflessBar df top _sw cut
			local sf : SerifFrame.fromDf df top 0 (swRef -- _sw)
			include sf.rb.outer
		export : define [DoubleSerifedBar df top _sw cut] : glyph-proc
			include : SeriflessBar df top _sw cut
			local sf : SerifFrame.fromDf df top 0 (swRef -- _sw)
			include : composite-proc sf.rt.outer sf.rb.outer
		export : define [TailedBar df top _sw cut] : glyph-proc
			local y : StemCutY (bot -- 0) (top -- top) (cut -- cut)
			set-base-anchor 'trailing' (df.rightSB + SideJut) 0
			include : RightwardTailedBar df.rightSB y.bot y.top _sw
		export : define [TailedSerifedBar df top _sw cut] : glyph-proc
			include : TailedBar df top _sw cut
			local sf : SerifFrame.fromDf df top 0 (swRef -- _sw)
			include sf.rt.outer

	define RevSingleStorey : namespace
		export : define [FullBarBody df top bar cut _sw _ada _adb] : glyph-proc
			local sw  : fallback _sw    df.mvs
			local ada : fallback _ada : df.archDepthAOf SmallArchDepth sw
			local adb : fallback _adb : df.archDepthBOf SmallArchDepth sw
			include : OBarLeft.shape
				top   -- top
				left  -- df.leftSB
				right -- df.rightSB
				sw    -- sw
				fine  -- (ShoulderFine * (sw / Stroke))
				ada   -- ada
				adb   -- adb
			include : bar df top sw cut
			include : ApplyDiagCut (cut -- cut) (side -- 'l') (x -- df.leftSB) (bot -- 0) (top -- top) (sw -- sw)
		export : define [FlatTopBody df top bar cut _sw _ada _adb] : glyph-proc
			local sw  : fallback _sw    df.mvs
			local ada : fallback _ada : df.archDepthAOf SmallArchDepth sw
			local adb : fallback _adb : df.archDepthBOf SmallArchDepth sw
			include : OBarLeft.earlessCorner
				top   -- top
				left  -- df.leftSB
				right -- df.rightSB
				sw    -- sw
				fine  -- (ShoulderFine * (sw / Stroke))
				ada   -- ada
				adb   -- adb
				rise  -- 0
			include : bar df top sw cut
			include : ApplyDiagCut (cut -- cut) (side -- 'l') (x -- df.leftSB) (bot -- 0) (top -- top) (sw -- sw)
		export : define [EarlessCornerBody df top bar cut _sw _ada _adb] : glyph-proc
			local sw  : fallback _sw    df.mvs
			local ada : fallback _ada : df.archDepthAOf SmallArchDepth sw
			local adb : fallback _adb : df.archDepthBOf SmallArchDepth sw
			include : OBarLeft.earlessCorner
				top   -- top
				left  -- df.leftSB
				right -- df.rightSB
				sw    -- sw
				fine  -- (ShoulderFine * (sw / Stroke))
				ada   -- ada
				adb   -- adb
			include : bar df (top - DToothlessRise) sw cut
			include : ApplyDiagCut (cut -- cut) (side -- 'l') (x -- df.leftSB) (bot -- 0) (top -- (top - DToothlessRise)) (sw -- sw)
		export : define [EarlessRoundedBody df top bar cut _sw _ada _adb] : glyph-proc
			local sw  : fallback _sw    df.mvs
			local ada : fallback _ada : df.archDepthAOf SmallArchDepth sw
			local adb : fallback _adb : df.archDepthBOf SmallArchDepth sw
			include : OBarLeft.earlessRounded
				top   -- top
				left  -- df.leftSB
				right -- df.rightSB
				sw    -- sw
				fine  -- (ShoulderFine * (sw / Stroke))
				ada   -- ada
				adb   -- adb
				yTerminal -- adb
			include : bar df (top - ada) sw cut
			include : ApplyDiagCut (cut -- cut) (side -- 'l') (x -- df.leftSB) (bot -- 0) (top -- (top - ada)) (sw -- sw)

		export : define [SeriflessBar df top _sw cut] : glyph-proc
			local y : StemCutY (bot -- 0) (top -- top) (cut -- cut)
			include : VBar.l df.leftSB y.bot y.top _sw
		export : define [BottomSerifedBar df top _sw cut] : glyph-proc
			include : SeriflessBar df top _sw cut
			local sf : SerifFrame.fromDf df top 0 (swRef -- _sw)
			include sf.lb.outer
		export : define [DoubleSerifedBar df top _sw cut] : glyph-proc
			include : SeriflessBar df top _sw cut
			local sf : SerifFrame.fromDf df top 0 (swRef -- _sw)
			include : composite-proc sf.lt.outer sf.lb.outer
		export : define [TailedBar df top _sw cut] : glyph-proc
			local y : StemCutY (bot -- 0) (top -- top) (cut -- cut)
			include : LeftwardTailedBar df.leftSB y.bot y.top _sw
		export : define [TailedSerifedBar df top _sw cut] : glyph-proc
			include : TailedBar df top _sw cut
			local sf : SerifFrame.fromDf df top 0 (swRef -- _sw)
			include sf.lt.outer

	glyph-block-export SingleStoreyConfig
	define SingleStoreyConfig : SuffixCfg.weave
		object # ear
			singleStorey             { SingleStorey.FullBarBody        RevSingleStorey.FullBarBody        }
			singleStoreyFlatTop      { SingleStorey.FlatTopBody        RevSingleStorey.FlatTopBody        }
			singleStoreyEarlessCorner  { SingleStorey.EarlessCornerBody  RevSingleStorey.EarlessCornerBody  }
			singleStoreyEarlessRounded { SingleStorey.EarlessRoundedBody RevSingleStorey.EarlessRoundedBody }
		function [ear] : begin
			if (ear === 'singleStoreyEarlessCorner' || ear === 'singleStoreyEarlessRounded') : return : object
				""         ""
				bottomCut  "bottomCut"
			return : object
				""         ""
				topCut     "topCut"
				bottomCut  "bottomCut"
		function [ear cut] : begin
			if (cut === 'bottomCut') : return : object
				serifless { SingleStorey.SeriflessBar RevSingleStorey.SeriflessBar }
			if (cut === 'topCut' || ear === 'singleStoreyEarlessCorner' || ear === 'singleStoreyEarlessRounded') : return : object
				serifless { SingleStorey.SeriflessBar     RevSingleStorey.SeriflessBar     }
				serifed   { SingleStorey.BottomSerifedBar RevSingleStorey.BottomSerifedBar }
				tailed    { SingleStorey.TailedBar        RevSingleStorey.TailedBar        }
			return : object
				serifless     { SingleStorey.SeriflessBar     RevSingleStorey.SeriflessBar     }
				serifed       { SingleStorey.BottomSerifedBar RevSingleStorey.BottomSerifedBar }
				doubleSerifed { SingleStorey.DoubleSerifedBar RevSingleStorey.DoubleSerifedBar }
				tailed        { SingleStorey.TailedBar        RevSingleStorey.TailedBar        }
				tailedSerifed { SingleStorey.TailedSerifedBar RevSingleStorey.TailedSerifedBar }

	foreach { suffix { { body revBody } cut { bar revBar } } } [Object.entries SingleStoreyConfig] : do
		create-glyph "a.\(suffix)" : glyph-proc
			local df : include : DivFrame 1
			include : df.markSet.e
			include : body df XH bar cut
		create-glyph "aCap.\(suffix)" : glyph-proc
			local df : include : DivFrame 1
			include : df.markSet.capital
			include : body df CAP bar cut nothing ArchDepthA ArchDepthB
		create-glyph "reva.\(suffix)" : glyph-proc
			local df : include : DivFrame 1
			include : df.markSet.e
			include : revBody df XH revBar cut
		create-glyph "aSwash.\(suffix)" : glyph-proc
			include [refer-glyph "a.\(suffix)"] AS_BASE ALSO_METRICS
			eject-contour 'serifRB'
			include : RetroflexHook.rExt RightSB 0
		create-glyph "aRetroflexHook.\(suffix)" : glyph-proc
			include [refer-glyph "a.\(suffix)"] AS_BASE ALSO_METRICS
			eject-contour 'serifRB'
			include : RetroflexHook.rSideJut RightSB 0 (yOverflow -- Stroke)

	select-variant 'a' 'a'
	link-reduced-variant 'a/sansSerif' 'a' MathSansSerif
	link-reduced-variant 'a/doubleStorey' 'a'
	select-variant 'aHalf' 0x1DF5A

	select-variant 'cyrl/a' 0x430 (shapeFrom -- 'a') (follow -- 'a')

	CreateTurnedLetter 'turna' 0x250 'a/doubleStorey' HalfAdvance (XH / 2)

	select-variant 'aRetroflexHook' 0x1D8F
	link-reduced-variant 'aRetroflexHook/doubleStorey' 'aRetroflexHook'

	select-variant 'aSwash' 0x1DF69 (follow -- 'aRTail')
	select-variant 'aRoundTop.upright' (follow -- 'a/doubleStorey') (shapeFrom -- 'reva')

	select-variant 'grek/alpha' 0x3B1 (shapeFrom -- 'a')
	link-reduced-variant 'grek/alpha/sansSerif' 'grek/alpha' MathSansSerif (shapeFrom -- 'a')

	select-variant 'AScript.slab.upright' (shapeFrom -- 'aCap') (follow -- 'a/singleStorey.slab.upright')
	select-variant 'AScript.slab.italic'  (shapeFrom -- 'aCap') (follow -- 'a/singleStorey.slab.italic')
	orthographic-italic 'AScript.slab' null
	select-variant 'AScript.sans' (shapeFrom -- 'aCap') (follow -- 'a/singleStorey.sans')
	orthographic-slab SLAB 'AScript' 0x2C6D

	CreateTurnedLetter 'turnAScript' 0x2C70 'AScript' HalfAdvance (CAP / 2)

	select-variant 'aScript.slab.upright' (shapeFrom -- 'a') (follow -- 'a/singleStorey.slab.upright')
	select-variant 'aScript.slab.italic'  (shapeFrom -- 'a') (follow -- 'a/singleStorey.slab.italic')
	orthographic-italic 'aScript.slab' null
	select-variant 'aScript.sans' (shapeFrom -- 'a') (follow -- 'a/singleStorey.sans')
	orthographic-slab SLAB 'aScript' 0x251

	CreateTurnedLetter 'turnaScript' 0x252 'aScript' HalfAdvance (XH / 2)

	select-variant 'revaScript.slab.upright' (shapeFrom -- 'reva') (follow -- 'a/singleStorey.slab.upright')
	select-variant 'revaScript.slab.italic'  (shapeFrom -- 'reva') (follow -- 'a/singleStorey.slab.italic')
	orthographic-italic 'revaScript.slab' null
	select-variant 'revaScript.sans' (shapeFrom -- 'reva') (follow -- 'a/singleStorey.sans')
	orthographic-slab SLAB 'revaScript' null

	CreateTurnedLetter 'invaScript' 0xAB64 'revaScript' HalfAdvance (XH / 2)

	select-variant 'aScriptRetroflexHook.slab.upright' (shapeFrom -- 'aRetroflexHook') (follow -- 'aRetroflexHook/singleStorey.slab.upright')
	select-variant 'aScriptRetroflexHook.slab.italic'  (shapeFrom -- 'aRetroflexHook') (follow -- 'aRetroflexHook/singleStorey.slab.italic')
	orthographic-italic 'aScriptRetroflexHook.slab' null
	select-variant 'aScriptRetroflexHook.sans' (shapeFrom -- 'aRetroflexHook') (follow -- 'aRetroflexHook/singleStorey.sans')
	orthographic-slab SLAB 'aScriptRetroflexHook' 0x1D90

	CreateAccentedComposition 'aScriptBar' 0xAB30 'aScript' 'hStrike'

	CreateAccentedComposition 'aGrave'      0xE0   'a' 'graveAbove'
	CreateAccentedComposition 'aAcute'      0xE1   'a' 'acuteAbove'
	CreateAccentedComposition 'aCircumflex' 0xE2   'a' 'circumflexAbove'
	CreateAccentedComposition 'aTilde'      0xE3   'a' 'tildeAbove'
	CreateAccentedComposition 'aDieresis'   0xE4   'a' 'dieresisAbove'
	CreateAccentedComposition 'aRing'       0xE5   'a' 'ringAbove'
	CreateAccentedComposition 'aMacron'     0x101  'a' 'macronAbove'
	CreateAccentedComposition 'aBreve'      0x103  'a' 'breveAbove'
	CreateAccentedComposition 'aOgonek'     0x105  'a' 'ogonekBelow'
	CreateAccentedComposition 'aCaron'      0x1CE  'a' 'caronAbove'
	CreateAccentedComposition 'aDblGrave'   0x201  'a' 'doubleGraveAbove'
	CreateAccentedComposition 'aInvBreve'   0x203  'a' 'invBreveAbove'
	CreateAccentedComposition 'aDot'        0x227  'a' 'dotAbove'
	CreateAccentedComposition 'aBelowring'  0x1E01 'a' 'ringBelow'
	CreateAccentedComposition 'aBelowdot'   0x1EA1 'a' 'dotBelow'
	CreateAccentedComposition 'aHook'       0x1EA3 'a' 'hookAbove'
	CreateAccentedComposition 'aBar'        0x1DF41 'a' 'hStrike'
	CreateAccentedComposition 'aRightHalfRingTR' 0x1E9A 'a' 'rightHalfRingTR'

	CreateMultiAccentedComposition 'aDieresisMacron'     0x1DF  'a' { 'dieresisAbove'   'macronAbove' }
	CreateMultiAccentedComposition 'aDotMacron'          0x1E1  'a' { 'dotAbove'        'macronAbove' }
	CreateMultiAccentedComposition 'aRingAcute'          0x1FB  'a' { 'ringAbove'       'acuteAbove' }
	CreateMultiAccentedComposition 'aCircumflexAcute'    0x1EA5 'a' { 'circumflexAbove' 'acuteAbove' }
	CreateMultiAccentedComposition 'aCircumflexGrave'    0x1EA7 'a' { 'circumflexAbove' 'graveAbove' }
	CreateMultiAccentedComposition 'aCircumflexHook'     0x1EA9 'a' { 'circumflexAbove' 'hookAbove'  }
	CreateMultiAccentedComposition 'aCircumflexTilde'    0x1EAB 'a' { 'circumflexAbove' 'tildeAbove' }
	CreateMultiAccentedComposition 'aBelowdotCircumflex' 0x1EAD 'a' { 'dotBelow'        'circumflexAbove' }
	CreateMultiAccentedComposition 'aBreveAcute'         0x1EAF 'a' { 'breveAbove'      'acuteAbove' }
	CreateMultiAccentedComposition 'aBreveGrave'         0x1EB1 'a' { 'breveAbove'      'graveAbove' }
	CreateMultiAccentedComposition 'aBreveHook'          0x1EB3 'a' { 'breveAbove'      'hookAbove'  }
	CreateMultiAccentedComposition 'aBreveTilde'         0x1EB5 'a' { 'breveAbove'      'tildeAbove' }
	CreateMultiAccentedComposition 'aBelowdotBreve'      0x1EB7 'a' { 'dotBelow'        'breveAbove' }

	CreateAccentedComposition 'aGrave/doubleStorey'      null 'a/doubleStorey' 'graveAbove'
	CreateAccentedComposition 'aAcute/doubleStorey'      null 'a/doubleStorey' 'acuteAbove'
	CreateAccentedComposition 'aCircumflex/doubleStorey' null 'a/doubleStorey' 'circumflexAbove'
	CreateAccentedComposition 'aTilde/doubleStorey'      null 'a/doubleStorey' 'tildeAbove'
	CreateAccentedComposition 'aDieresis/doubleStorey'   null 'a/doubleStorey' 'dieresisAbove'
	CreateAccentedComposition 'aRing/doubleStorey'       null 'a/doubleStorey' 'ringAbove'
	CreateAccentedComposition 'aMacron/doubleStorey'     null 'a/doubleStorey' 'macronAbove'
	CreateAccentedComposition 'aBreve/doubleStorey'      null 'a/doubleStorey' 'breveAbove'
	CreateAccentedComposition 'aOgonek/doubleStorey'     null 'a/doubleStorey' 'ogonekBelow'
	CreateAccentedComposition 'aWedge/doubleStorey'      null 'a/doubleStorey' 'caronAbove'
	CreateAccentedComposition 'aDblGrave/doubleStorey'   null 'a/doubleStorey' 'doubleGraveAbove'
	CreateAccentedComposition 'aInvBreve/doubleStorey'   null 'a/doubleStorey' 'invBreveAbove'
	CreateAccentedComposition 'aDot/doubleStorey'        null 'a/doubleStorey' 'dotAbove'
