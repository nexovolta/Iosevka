$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [DesignParameters] from "../../meta/aesthetics.mjs"

glyph-module

glyph-block Symbol-Geometric-Technical : for-width-kinds WideWidth1
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Above : WideBridgeShape aboveMarkTop aboveMarkBot
	glyph-block-import Mark-Shared-Metrics : markFine
	glyph-block-import Letter-Latin-Long-S : LongSShape
	glyph-block-import Symbol-Geometric-Shared : GeometricDim GeometricSizes ConvexPolygonOutline
	glyph-block-import Shared-Symbol-Shapes : TriangleShape Polyline
	glyph-block-import Symbol-Arrow-Shared : ArrowShape ArrowHead TrigArrowShape

	define Geom : GeometricDim MosaicUnitWidth MosaicWidth
	define Size : GeometricSizes Geom

	define fineGeometryStroke : AdviceStroke2 4 4 Geom.Size

	do "Technical Symbols"
		create-glyph [MangleName 'squareFoot'] [MangleUnicode 0x23CD] : glyph-proc
			set-width Geom.Width
			local left Geom.Left
			local right Geom.Right
			local top : right - left
			local stroke : Math.min GeometryStroke ((right - left) * 0.2)
			local primeWidth : stroke * 0.8
			local gap : stroke * 0.3
			local primeTopX : Geom.MidX + (right - left) * 0.08
			local primeBotX : Geom.MidX - (right - left) * 0.08
			local primeTop : top + (right - left) * 0.25
			local primeBot : top - (right - left) * 0.27
			define [PrimeShape extra] : spiro-outline
				corner (primeTopX - primeWidth / 2 - extra) primeTop
				corner (primeTopX + primeWidth / 2 + extra) primeTop
				corner (primeBotX + primeWidth / 2 + extra) primeBot
				corner (primeBotX - primeWidth / 2 - extra) primeBot
				close
			include : difference
				difference
					Rect top 0 left right
					Rect (top - stroke) stroke (left + stroke) (right - stroke)
				PrimeShape gap
			include : PrimeShape 0

		create-glyph [MangleName 'acCurrent'] [MangleUnicode 0x23E6] : glyph-proc
			set-width Geom.Width
			local stroke : Math.min GeometryStroke (Geom.Size * 0.32)
			local amplitude : Geom.Size * 0.65
			local knots {}
			foreach [i : range 0 till 32] : begin
				local t : i / 32
				knots.push : g2
					mix (Geom.Left + Geom.Size * 0.12) (Geom.Right - Geom.Size * 0.12) t
					Geom.MidY + amplitude * [Math.sin (2 * Math.PI * t)]
			include : dispiro [widths.center stroke] knots
			include : HBar.m Geom.Left Geom.Right Geom.MidY stroke

		create-glyph [MangleName 'hysteresisSymbol'] [MangleUnicode 0x238E] : glyph-proc
			set-width Geom.Width
			local span : Geom.Right - Geom.Left
			local stroke : Math.min GeometryStroke (span * 0.18)
			local hookX : span * 0.16
			local leftStem : Geom.Left + hookX
			local rightStem : Geom.Right - hookX
			include : with-transform [Translate (leftStem - Middle) 0] : LongSShape CAP 0 hookX (CAP * 0.2) stroke false
			include : with-transform [Translate (rightStem - Middle) 0] : LongSShape CAP 0 hookX (CAP * 0.2) stroke false
			include : HBar.t (leftStem + hookX) (rightStem + hookX) CAP stroke
			include : HBar.b (leftStem - hookX) (rightStem - hookX) 0 stroke

		define [MetricalSeme poleCount] : glyph-proc
			set-width Geom.Width
			local stroke GeometryStroke
			local barY : Geom.MidY - Geom.Size / 2
			local poleTop : Geom.MidY + Geom.Size / 2
			include : HBar.m Geom.Left Geom.Right barY stroke
			if (poleCount === 1) : include : VBar.m Geom.Right barY poleTop stroke
			: else : begin
				include : VBar.m Geom.Left barY poleTop stroke
				include : VBar.m Geom.Right barY poleTop stroke
				if (poleCount === 3) : include : VBar.m Geom.MidX barY poleTop stroke

		create-glyph [MangleName 'metricalTriseme'] [MangleUnicode 0x23D7] : glyph-proc
			include : MetricalSeme 1

		create-glyph [MangleName 'metricalTetraseme'] [MangleUnicode 0x23D8] : glyph-proc
			include : MetricalSeme 2

		create-glyph [MangleName 'metricalPentaseme'] [MangleUnicode 0x23D9] : glyph-proc
			include : MetricalSeme 3

	do "Dimensions"
		create-glyph [MangleName 'straightness'] [MangleUnicode 0x23E4] : glyph-proc
			set-width Geom.Width
			include : HBar.m Geom.Left Geom.Right Geom.MidY GeometryStroke

		create-glyph [MangleName 'symmetry'] [MangleUnicode 0x232F] : glyph-proc
			set-width Geom.Width
			define yOffset : Geom.Size * 0.4
			define xShrink : Geom.Size * 0.25
			include : HBar.m Geom.Left Geom.Right Geom.MidY GeometryStroke
			include : HBar.b (Geom.Left + xShrink) (Geom.Right - xShrink) (Geom.MidY + yOffset) GeometryStroke
			include : HBar.t (Geom.Left + xShrink) (Geom.Right - xShrink) (Geom.MidY - yOffset) GeometryStroke

		create-glyph [MangleName 'totalRunoff'] [MangleUnicode 0x2330] : glyph-proc
			set-width Geom.Width
			local headSize : Geom.Size * 0.375 / Math.SQRT1_2
			local offset : Geom.Size * 0.4
			local x0   Geom.Left
			local x1 : Geom.Left + offset
			local x2 : Geom.Right - offset - headSize * 0.35
			local x3 : Geom.Right - headSize * 0.35
			local vsw : HSwToV : 0.5 * GeometryStroke
			include : dispiro
				disable-contrast
				flat ([mix x0 x1 0.75] + vsw) [mix Geom.Bot Geom.Top 0.75] [widths.center GeometryStroke]
				sharp-corner (x0 + vsw) Geom.Bot (contrast -- 1)
				corner Geom.MidX Geom.Bot [widths.lhs GeometryStroke]
				sharp-corner (x2 - vsw) Geom.Bot (contrast -- 1)
				curl ([mix x2 x3 0.75] - vsw) [mix Geom.Bot Geom.Top 0.75] [widths.center GeometryStroke]
			include : TrigArrowShape ([mix x0 x1 0.5] + vsw) Geom.MidY (x1 + vsw) Geom.Top headSize (GeometryStroke / 2)
			include : TrigArrowShape ([mix x2 x3 0.5] - vsw) Geom.MidY (x3 - vsw) Geom.Top headSize (GeometryStroke / 2)

		create-glyph [MangleName 'conicalTaper'] [MangleUnicode 0x2332] : glyph-proc
			set-width Geom.Width
			include : TriangleShape Geom.Left (Geom.MidY - Geom.Size * 0.8) Geom.Left (Geom.MidY + Geom.Size * 0.8) Geom.Right Geom.MidY fineGeometryStroke
			include : HBar.m [mix 0 Geom.Left 0.5] [mix Geom.Right Geom.Width 0.5] Geom.MidY GeometryStroke

		create-glyph [MangleName 'slope'] [MangleUnicode 0x2333] : glyph-proc
			set-width Geom.Width
			include : TriangleShape Geom.Left Geom.Bot Geom.Left Geom.MidY Geom.Right Geom.Bot fineGeometryStroke

	create-glyph [MangleName 'electricArrow'] [MangleUnicode 0x2301] : glyph-proc
		set-width Geom.Width
		define amp : Geom.Size / 2
		define amp2 : Geom.Size / 4
		include : intersection [MaskRight Geom.Left] [MaskLeft Geom.Right] : dispiro
			corner (Geom.MidX - Geom.Size * 2) (Geom.MidY + amp2 * 4) [widths.center GeometryStroke]
			sharp-corner Geom.MidX (Geom.MidY - amp)
			corner Geom.MidX Geom.MidY [widths.center.heading GeometryStroke Upward]
			sharp-corner Geom.MidX (Geom.MidY + amp)
			corner (Geom.MidX + Geom.Size * 2) (Geom.MidY - amp2 * 4) [widths.center GeometryStroke]

	create-glyph [MangleName 'viewdataSquare'] [MangleUnicode 0x2317] : glyph-proc
		set-width Geom.Width
		define shrink : Geom.Size * 2 * 0.13
		include : HBar.t Geom.Left Geom.Right (Geom.Top - shrink) GeometryStroke
		include : HBar.b Geom.Left Geom.Right (Geom.Bot + shrink) GeometryStroke
		include : VBar.l (Geom.Left  + shrink) Geom.Bot Geom.Top GeometryStroke
		include : VBar.r (Geom.Right - shrink) Geom.Bot Geom.Top GeometryStroke

	create-glyph [MangleName 'loopedSquare'] [MangleUnicode 0x2318] : glyph-proc
		set-width Geom.Width

		define stroke : AdviceStrokeInSpace (Geom.Size * 2) 6
		define gap : (Geom.Size * 2 - [HSwToV : stroke * 4]) / 6
		include : lift-@ : dispiro
			widths.lhs stroke
			flat Geom.MidX @y3
			curl (@x5 = [mix @x4 @x6 0.5]) (@y3 = Geom.MidY + gap)
			archv 4
			g4.up.mid (@x6 = Geom.Right) @y2
			arcvh 4
			g4.left.mid @x5 (@y1 = Geom.Top)
			archv 4
			flat (@x4 = Geom.MidX + gap) (@y2 = [mix @y1 @y3 0.5])
			curl @x4 @y5
			arcvh 4
			g4.right.mid @x5 @y6
			archv 4
			g4.up.mid @x6 @y5
			arcvh 4
			flat @x5 @y4
			curl (@x2 = [mix @x1 @x3 0.5]) (@y4 = Geom.MidY - gap)
			archv 4
			g4.down.mid (@x1 = Geom.Left) @y5
			arcvh 4
			g4.right.mid @x2 (@y6 = Geom.Bot)
			archv 4
			flat (@x3 = Geom.MidX - gap) (@y5 = [mix @y4 @y6 0.5])
			curl @x3 @y2
			arcvh 4
			g4.left.mid @x2 @y1
			archv 4
			g4.down.mid @x1 @y2
			arcvh 4
			flat @x2 @y3
			curl Geom.MidX @y3

	do "Output Circuit and Benzene Symbols"
		define [DiamondShape cx cy radius] : spiro-outline
			corner cx (cy + radius)
			corner (cx + radius) cy
			corner cx (cy - radius)
			corner (cx - radius) cy
			close

		define [OpenCircuitOutput name unicode topBar middleBar bottomBar] : begin
			create-glyph [MangleName name] [MangleUnicode unicode] : glyph-proc
				set-width Geom.Width
				include : ConvexPolygonOutline [new-glyph : DiamondShape Geom.MidX Geom.MidY Geom.Size] GeometryStroke
				if topBar : include : HBar.m Geom.Left Geom.Right (Geom.Top - GeometryStroke / 2) GeometryStroke
				if middleBar : include : intersection
					DiamondShape Geom.MidX Geom.MidY Geom.Size
					HBar.m Geom.Left Geom.Right Geom.MidY GeometryStroke
				if bottomBar : include : HBar.m Geom.Left Geom.Right (Geom.Bot + GeometryStroke / 2) GeometryStroke

		OpenCircuitOutput 'openCircuitOutputHType' 0x238F true false false
		OpenCircuitOutput 'openCircuitOutputLType' 0x2390 false false true
		OpenCircuitOutput 'passivePullDownOutput' 0x2391 true true false
		OpenCircuitOutput 'passivePullUpOutput' 0x2392 false true true

		create-glyph [MangleName 'decimalSeparatorKeySymbol'] [MangleUnicode 0x2396] : glyph-proc
			set-width Geom.Width
			local halfSize : Geom.Size / 2
			include : spiro-outline
				corner (Geom.MidX - halfSize) (Geom.MidY + halfSize)
				corner (Geom.MidX + halfSize) (Geom.MidY + halfSize)
				corner (Geom.MidX - halfSize) (Geom.MidY - halfSize)
				close

		create-glyph [MangleName 'directCurrentSymbolFormTwo'] [MangleUnicode 0x2393] : glyph-proc
			set-width Geom.Width
			local span : Geom.Right - Geom.Left
			local dashWidth : span * 0.27
			local dashGap : span * 0.08
			local mainY : Geom.MidY + Geom.Size * 0.36
			local lowerY : mainY - GeometryStroke * 1.5
			local lowerWidth : 3 * dashWidth + 2 * dashGap
			local lowerLeft : Geom.MidX - lowerWidth / 2
			include : HBar.m Geom.Left Geom.Right mainY GeometryStroke
			foreach i [range 0 3] : do
				local dashLeft : lowerLeft + i * (dashWidth + dashGap)
				include : HBar.m dashLeft (dashLeft + dashWidth) lowerY GeometryStroke

		define benzeneRadius : Geom.Size * 0.96
		define benzeneHalfWidth : benzeneRadius * [Math.sqrt 0.75]
		define benzeneStroke : Math.min GeometryStroke (0.6 * benzeneHalfWidth)
		define benzeneInnerRadius : benzeneHalfWidth - benzeneStroke
		define benzeneInnerStroke : Math.min (0.65 * benzeneStroke) (0.28 * benzeneInnerRadius)

		define [BenzeneOutline] : glyph-proc
			local radius benzeneRadius
			local halfWidth benzeneHalfWidth
			local hexagon : new-glyph : spiro-outline
					corner Geom.MidX (Geom.MidY + radius)
					corner (Geom.MidX + halfWidth) (Geom.MidY + radius / 2)
					corner (Geom.MidX + halfWidth) (Geom.MidY - radius / 2)
					corner Geom.MidX (Geom.MidY - radius)
					corner (Geom.MidX - halfWidth) (Geom.MidY - radius / 2)
					corner (Geom.MidX - halfWidth) (Geom.MidY + radius / 2)
					close
			include : ConvexPolygonOutline hexagon benzeneStroke

		create-glyph [MangleName 'benzeneRing'] [MangleUnicode 0x232C] : glyph-proc
			set-width Geom.Width
			include : BenzeneOutline
			local innerRadius benzeneInnerRadius
			local innerStroke benzeneInnerStroke
			include : VBar.m (Geom.MidX - 0.65 * innerRadius) (Geom.MidY - 0.5 * innerRadius) (Geom.MidY + 0.5 * innerRadius) innerStroke
			local innerLeft Geom.MidX
			local innerRight : Geom.MidX + 0.7 * innerRadius
			local innerRise : 0.38 * innerRadius
			include : DiagonalHBar innerLeft innerRight (Geom.MidY + 0.49 * innerRadius) (-innerRise) innerStroke
			include : DiagonalHBar innerLeft innerRight (Geom.MidY - 0.49 * innerRadius) innerRise innerStroke

		create-glyph [MangleName 'benzeneRingWithCircle'] [MangleUnicode 0x23E3] : glyph-proc
			set-width Geom.Width
			include : BenzeneOutline
			include : RingStrokeAt Geom.MidX Geom.MidY (0.65 * benzeneInnerRadius) benzeneInnerStroke

	do "Wide Square Brackets"
		local bracketHeight : aboveMarkTop - aboveMarkBot
		local bracketWidth : Width * para.advanceScaleMM
		local bracketStroke : 2 * markFine
		local left : bracketStroke / 2
		local right : bracketWidth - bracketStroke / 2
		local middle : bracketWidth / 2
		local edgeY : Ascender - bracketHeight + bracketStroke / 2
		local peakY : Ascender - bracketStroke / 2
		local waistY : mix edgeY peakY 0.55

		define [TopParenShape] : dispiro
			widths.center bracketStroke
			g4 left edgeY
			quadControls 0.5 1
			g4.right.mid middle peakY [heading Rightward]
			quadControls 0.5 0
			g4 right edgeY

		define [TopCurlyBracketShape] : dispiro
			widths.center bracketStroke
			g4 left edgeY
			g4 (bracketWidth * 0.15) waistY
			g4 (bracketWidth * 0.35) waistY [heading Rightward]
			corner middle peakY
			g4 (bracketWidth * 0.65) waistY [heading Rightward]
			g4 (bracketWidth * 0.85) waistY
			g4 right edgeY

		define [TopTortoiseShellBracketShape] : dispiro
			Polyline [widths.center bracketStroke]
				points -- {
					{ left edgeY }
					{ (bracketWidth * 0.2) peakY }
					{ (bracketWidth * 0.8) peakY }
					{ right edgeY }
				}

		define [BracketPair topName topUnicode bottomName bottomUnicode Shape] : begin
			create-glyph [MangleName topName] [MangleUnicode topUnicode] : glyph-proc
				set-width bracketWidth
				include : Shape
			create-glyph [MangleName bottomName] [MangleUnicode bottomUnicode] : glyph-proc
				set-width bracketWidth
				include : with-transform [ScaleAround middle ((Ascender - bracketHeight) / 2) 1 (-1)] : Shape

		BracketPair 'topParenthesis' 0x23DC 'bottomParenthesis' 0x23DD TopParenShape
		BracketPair 'topCurlyBracket' 0x23DE 'bottomCurlyBracket' 0x23DF TopCurlyBracketShape
		BracketPair 'topTortoiseShellBracket' 0x23E0 'bottomTortoiseShellBracket' 0x23E1 TopTortoiseShellBracketShape

		create-glyph [MangleName 'topSquareBracket'] [MangleUnicode 0x23B4] : glyph-proc
			set-width bracketWidth
			include : WideBridgeShape 0 bracketWidth (Ascender - bracketHeight) Ascender false

		create-glyph [MangleName 'bottomSquareBracket'] [MangleUnicode 0x23B5] : glyph-proc
			set-width bracketWidth
			include : WideBridgeShape 0 bracketWidth (-bracketHeight) 0 true

		create-glyph [MangleName 'bottomSquareBracketOverTopSquareBracket'] [MangleUnicode 0x23B6] : glyph-proc
			set-width bracketWidth
			include : WideBridgeShape 0 bracketWidth (Ascender - bracketHeight) Ascender true
			include : WideBridgeShape 0 bracketWidth 0 bracketHeight false

	do "Keyboard Symbols"
		define topLine : Geom.MidY + Geom.Size / 1.5
		define botLine : Geom.MidY - Geom.Size / 1.5
		define topLineC : topLine - GeometryStroke / 2
		define botLineC : botLine + GeometryStroke / 2

		create-glyph [MangleName 'arrowHeadUpBetweenBars'] [MangleUnicode 0x2324] : glyph-proc
			set-width MosaicWidth
			include : ArrowHead Geom.MidX Geom.Bot Geom.MidX topLine
			include : HBar.t Geom.Left (Geom.MidX - Geom.Size / 3) topLine GeometryStroke
			include : HBar.t (Geom.MidX + Geom.Size / 3) Geom.Right topLine GeometryStroke

		create-glyph [MangleName 'optionKey'] [MangleUnicode 0x2325] : glyph-proc
			set-width Geom.Width
			include : dispiro
				Polyline [widths.center GeometryStroke]
					points -- {
						{ Geom.Left  topLineC }
						{ (Geom.MidX - Geom.Size / 3) topLineC }
						{ (Geom.MidX + Geom.Size / 3) botLineC }
						{ Geom.Right botLineC }
					}
					startAf -- [widths.center.heading GeometryStroke Rightward]
					endAf -- [widths.center.heading GeometryStroke Rightward]
			include : HBar.t (Geom.MidX + Geom.Size / 3) Geom.Right topLine GeometryStroke

		create-glyph [MangleName 'alternateKey'] [MangleUnicode 0x2387] : glyph-proc
			set-width Geom.Width
			include : dispiro
				Polyline [widths.center GeometryStroke]
					points -- {
						{ Geom.Left  botLineC }
						{ (Geom.MidX - Geom.Size / 3) botLineC }
						{ (Geom.MidX + Geom.Size / 3) topLineC }
						{ (Geom.Right - Geom.Size / 6) topLineC }
					}
					startAf -- [widths.center.heading GeometryStroke Rightward]
					endAf -- [widths.center.heading GeometryStroke Rightward]
			include : ArrowShape (Geom.Right - Geom.Size / 6) topLineC (Geom.Right + GeometryStroke / 2) topLineC (GeometryStroke / 2 + Geom.Size / 3)
			include : HBar.b (Geom.MidX + Geom.Size / 3) Geom.Right botLine GeometryStroke
