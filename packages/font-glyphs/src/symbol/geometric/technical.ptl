$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [DesignParameters] from "../../meta/aesthetics.mjs"

glyph-module

glyph-block Symbol-Geometric-Technical : for-width-kinds WideWidth1
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Above : WideBridgeShape aboveMarkTop aboveMarkBot aboveMarkMid
	glyph-block-import Mark-Shared-Metrics : markExtend markFine markMiddle markStroke
	glyph-block-import Symbol-Punctuation-Brackets : Paren Bracket Brace TortoiseShellBracket
	glyph-block-import Letter-Latin-Long-S : LongSShape
	glyph-block-import Symbol-Geometric-Shared : GeometricDim GeometricSizes ConvexPolygonOutline ScreenShape
	glyph-block-import Shared-Symbol-Shapes : TriangleShape Polyline
	glyph-block-import Symbol-Arrow-Shared : ArrowShape ArrowHead TrigArrowShape ArrowDims ArrowT

	define Geom : GeometricDim MosaicUnitWidth MosaicWidth
	define Size : GeometricSizes Geom

	define fineGeometryStroke : AdviceStroke2 4 4 Geom.Size

	do "Technical Symbols"
		create-glyph [MangleName 'clearScreen'] [MangleUnicode 0x239A] : glyph-proc
			set-width Geom.Width
			local radius : ([mix XH Ascender 1.5] - [mix 0 Descender 1.5]) / 2
			local rx : Math.min (Geom.Size * 1.25) (Geom.Width * 0.46)
			local ry : Geom.Size * 1.02
			local sw : Math.min [AdviceStroke 3.5] (Geom.Size * 0.18)
			local slashScale : Math.min 0.7 (sw / Stroke)
			local hyphenMiddle : [query-glyph 'obliqueHyphen'].advanceWidth / 2
			include : with-transform [Translate Geom.MidX Geom.MidY] : difference
				with-transform [Scale (rx / (radius * 1.1)) (ry / (radius * 1.1))] : ScreenShape 0 0 radius 0
				with-transform [Scale ((rx - sw) / (radius * 1.1)) ((ry - sw) / (radius * 1.1))] : ScreenShape 0 0 radius 0
			foreach i [range 0 3] : include
				with-transform [ApparentTranslate (Geom.MidX + (i - 1) * Geom.Size * 0.35 - Middle) 0]
					with-transform [Translate Middle SymbolMid]
						with-transform [Rotate (60 * Math.PI / 180)]
							with-transform [Scale (0.82 * Geom.Width / Width) slashScale]
								with-transform [Rotate (-22 * Math.PI / 180)]
									with-transform [Translate (-hyphenMiddle) (-SymbolMid)] : refer-glyph 'obliqueHyphen'

		create-glyph [MangleName 'electricalIntersection'] [MangleUnicode 0x23E7] : glyph-proc
			set-width Geom.Width
			local size : Math.min (Geom.Size * 1.65) (Geom.Width * 0.47)
			local sw : Math.min GeometryStroke (size * 0.22)
			local dot : Math.max (size * 0.16) (sw * 0.85)
			local end : size * 1.05
			local arrow : ArrowT : ArrowDims (arrowSw -- sw) (fine -- sw) (terminal -- sw)
			local shape : new-glyph : glyph-proc
				local spokes : new-glyph : glyph-proc
					foreach j [range 0 4] : begin
						local angle : 2 * j * Math.PI / 5
						local dx : Math.sin angle
						local dy : Math.cos angle
						include : ExtLineCenter Geom.MidX Geom.MidY (Geom.MidX + end * dx) (Geom.MidY + end * dy) sw
				include : union [RingAt Geom.MidX Geom.MidY dot] spokes
				include : arrow.shape (Geom.MidX - size * 0.5) (Geom.MidY + size * 0.94) (Geom.MidX - size * 0.5) (Geom.MidY + size * 0.24) (size * 0.15) (sw / 2)
			include : with-transform [Translate Geom.MidX Geom.MidY] : with-transform [Rotate (10 * Math.PI / 180)] : with-transform [Translate (-Geom.MidX) (-Geom.MidY)] shape

		create-glyph [MangleName 'rightAngleDownZigzagArrow'] [MangleUnicode 0x237C] : glyph-proc
			set-width Geom.Width
			local left : Geom.MidX - Geom.Size * 0.68
			local right : Geom.MidX + Geom.Size * 0.48
			local cornerX : mix left right 0.3
			local top : Geom.MidY + Geom.Size * 1.16
			local mid1 : Geom.MidY + Geom.Size * 0.29
			local mid2 : Geom.MidY - Geom.Size * 0.2175
			local bottom : Geom.MidY - Geom.Size * 1.0875
			local y : Geom.MidY - Geom.Size * 0.435
			local sw : Geom.Size * 0.24 * GeometryStroke / (GeometryStroke + Geom.Size * 0.3)
			local head : Geom.Size * 0.18 + sw * 1.1
			include : union
				dispiro
					Polyline [widths.center sw]
						points -- {{right top} {left mid1} {right mid2} {left bottom}}
				dispiro
					Polyline [widths.center sw]
						points -- {{left (bottom + head)} {left bottom} {(left + head) bottom}}
				HBar.m (cornerX - [HSwToV sw] / 2) Geom.Right y sw
				VBar.m cornerX y top sw

		create-glyph [MangleName 'undoSymbol'] [MangleUnicode 0x238C] : glyph-proc
			set-width Geom.Width
			local r : Geom.Size * 0.39
			local sw : r * 0.8 * GeometryStroke / (GeometryStroke + r * 1.5)
			local left : Geom.MidX - Geom.Size * 0.51
			local right : Geom.MidX + Geom.Size * 0.51
			local y : Geom.MidY - Geom.Size * 0.48
			define [UndoRing x] : difference [RingAt x y r] [RingAt x y (r - sw)]
			include : UndoRing left
			local head : r * 0.9 + sw
			local radius : right - Geom.MidX
			local cy : y + r - sw / 3
			local ca : Math.cos (35 * Math.PI / 180)
			local sa : Math.sin (35 * Math.PI / 180)
			local endX : Geom.MidX - radius * ca
			local endY : cy + radius * sa
			local baseX : endX + head * 0.32 * sa
			local baseY : endY + head * 0.32 * ca
			local arrow : new-glyph : glyph-proc
				include : intersection
					difference
						RingAt Geom.MidX cy (radius + sw / 2)
						RingAt Geom.MidX cy (radius - sw / 2)
					spiro-outline
						corner Geom.MidX cy
						corner (Geom.MidX + radius * 2) cy
						corner (Geom.MidX + radius * 2) (cy + radius * 2)
						corner (Geom.MidX - radius * 2) (cy + radius * 2)
						corner (Geom.MidX - radius * 2 * ca) (cy + radius * 2 * sa)
						close
			local arrowhead : new-glyph : spiro-outline
				corner (endX - head * 0.52 * sa) (endY - head * 0.52 * ca)
				corner (baseX - head * 0.48 * ca) (baseY + head * 0.48 * sa)
				corner (baseX + head * 0.48 * ca) (baseY - head * 0.48 * sa)
				close
			include : union [UndoRing right] arrow arrowhead

		create-glyph [MangleName 'horizontalLineExtension'] [MangleUnicode 0x23AF] : glyph-proc
			set-width MosaicWidth
			include : HBar.m 0 MosaicWidth SymbolMid Stroke

		create-glyph [MangleName 'verticalLineExtension'] [MangleUnicode 0x23D0] : glyph-proc
			set-width MosaicWidth
			include : VBar.m (MosaicWidth / 2) fontMetrics.os2.sTypoDescender fontMetrics.os2.sTypoAscender Stroke

		create-glyph [MangleName 'squareFoot'] [MangleUnicode 0x23CD] : glyph-proc
			set-width Geom.Width
			local left Geom.Left
			local right Geom.Right
			local top : right - left
			local stroke : Math.min GeometryStroke ((right - left) * 0.2)
			local primeWidth : stroke * 0.8
			local gap : stroke * 0.3
			local primeTopX : Geom.MidX + (right - left) * 0.08
			local primeBotX : Geom.MidX - (right - left) * 0.08
			local primeTop : top + (right - left) * 0.25
			local primeBot : top - (right - left) * 0.27
			define [PrimeShape extra] : spiro-outline
				corner (primeTopX - primeWidth / 2 - extra) primeTop
				corner (primeTopX + primeWidth / 2 + extra) primeTop
				corner (primeBotX + primeWidth / 2 + extra) primeBot
				corner (primeBotX - primeWidth / 2 - extra) primeBot
				close
			include : difference
				difference
					Rect top 0 left right
					Rect (top - stroke) stroke (left + stroke) (right - stroke)
				PrimeShape gap
			include : PrimeShape 0

		create-glyph [MangleName 'acCurrent'] [MangleUnicode 0x23E6] : glyph-proc
			set-width Geom.Width
			local stroke : Math.min GeometryStroke (Geom.Size * 0.32)
			local amplitude : Geom.Size * 0.65
			local knots {}
			foreach [i : range 0 till 32] : begin
				local t : i / 32
				knots.push : g2
					mix (Geom.Left + Geom.Size * 0.12) (Geom.Right - Geom.Size * 0.12) t
					Geom.MidY + amplitude * [Math.sin (2 * Math.PI * t)]
			include : dispiro [widths.center stroke] knots
			include : HBar.m Geom.Left Geom.Right Geom.MidY stroke

		create-glyph [MangleName 'hysteresisSymbol'] [MangleUnicode 0x238E] : glyph-proc
			set-width Geom.Width
			local span : Geom.Right - Geom.Left
			local stroke : Math.min GeometryStroke (span * 0.18)
			local hookX : span * 0.16
			local leftStem : Geom.Left + hookX
			local rightStem : Geom.Right - hookX
			include : with-transform [Translate (leftStem - Middle) 0] : LongSShape CAP 0 hookX (CAP * 0.2) stroke false
			include : with-transform [Translate (rightStem - Middle) 0] : LongSShape CAP 0 hookX (CAP * 0.2) stroke false
			include : HBar.t (leftStem + hookX) (rightStem + hookX) CAP stroke
			include : HBar.b (leftStem - hookX) (rightStem - hookX) 0 stroke

		define [MetricalSeme poleCount] : glyph-proc
			set-width Geom.Width
			local stroke GeometryStroke
			local barY : Geom.MidY - Geom.Size / 2
			local barBottom : barY - stroke / 2
			local barTop : barY + stroke / 2
			local poleTop : Geom.MidY + Geom.Size / 2
			local italicRise : poleTop - SymbolMid
			local italicFall : SymbolMid - barBottom
			local italicInset : Math.abs (TanSlope * [Math.max italicRise italicFall])
			local left : Math.max (Geom.Width * 0.1 + italicInset) Geom.Left
			local right : Math.min (Geom.Width * 0.9 - italicInset) Geom.Right
			local middle Geom.MidX
			local innerLeft : left + stroke
			local innerRight : right - stroke
			local poleMiddleLeft : middle - stroke / 2
			local poleMiddleRight : middle + stroke / 2
			if (poleCount === 1)
			: then : begin
				include : spiro-outline
					corner left barBottom
					corner right barBottom
					corner right poleTop
					corner innerRight poleTop
					corner innerRight barTop
					corner left barTop
					close
			: else : begin
				if (poleCount === 2)
				: then : begin
					include : spiro-outline
						corner left barBottom
						corner right barBottom
						corner right poleTop
						corner innerRight poleTop
						corner innerRight barTop
						corner innerLeft barTop
						corner innerLeft poleTop
						corner left poleTop
						close
				: else : begin
					include : spiro-outline
						corner left barBottom
						corner right barBottom
						corner right poleTop
						corner innerRight poleTop
						corner innerRight barTop
						corner poleMiddleRight barTop
						corner poleMiddleRight poleTop
						corner poleMiddleLeft poleTop
						corner poleMiddleLeft barTop
						corner innerLeft barTop
						corner innerLeft poleTop
						corner left poleTop
						close

		create-glyph [MangleName 'metricalTriseme'] [MangleUnicode 0x23D7] : glyph-proc
			include : MetricalSeme 1

		create-glyph [MangleName 'metricalTetraseme'] [MangleUnicode 0x23D8] : glyph-proc
			include : MetricalSeme 2

		create-glyph [MangleName 'metricalPentaseme'] [MangleUnicode 0x23D9] : glyph-proc
			include : MetricalSeme 3

		define MetricalMidY : Ascender / 2
		define MetricalBreveHeight : aboveMarkTop - aboveMarkBot
		define MetricalStackGap markFine
		define MetricalShortHalfSpan : markExtend + [HSwToV markFine]

		define [MetricalBreve xOffset y] : glyph-proc
			include : with-transform [Translate (Geom.MidX + xOffset - markMiddle) (y - aboveMarkMid)] : refer-glyph 'breveAbove'

		define [MetricalMacron xOffset y scaleX] : glyph-proc
			include : with-transform [Translate (Geom.MidX + xOffset - markMiddle) (y - aboveMarkMid)] : with-transform [ScaleAround markMiddle aboveMarkMid scaleX 1] : refer-glyph 'macronAbove'

		define [MetricalShorts y] : glyph-proc
			include : MetricalBreve (-MetricalShortHalfSpan) y
			include : MetricalBreve (+MetricalShortHalfSpan) y

		create-glyph [MangleName 'metricalBreve'] [MangleUnicode 0x23D1] : glyph-proc
			set-width Geom.Width
			set currentGlyph.gizmo : Italify para.slopeAngle
			include : MetricalBreve 0 MetricalMidY
			include : Italify (-para.slopeAngle)

		create-glyph [MangleName 'metricalLongOverShort'] [MangleUnicode 0x23D2] : glyph-proc
			set-width Geom.Width
			set currentGlyph.gizmo : Italify para.slopeAngle
			local breveY : MetricalMidY - (markStroke + MetricalStackGap) / 2
			local macronY : MetricalMidY + (MetricalBreveHeight + MetricalStackGap) / 2
			include : MetricalBreve 0 breveY
			include : MetricalMacron 0 macronY 1
			include : Italify (-para.slopeAngle)

		create-glyph [MangleName 'metricalShortOverLong'] [MangleUnicode 0x23D3] : glyph-proc
			set-width Geom.Width
			set currentGlyph.gizmo : Italify para.slopeAngle
			local breveY : MetricalMidY + (markStroke + MetricalStackGap) / 2
			local macronY : MetricalMidY - (MetricalBreveHeight + MetricalStackGap) / 2
			include : MetricalBreve 0 breveY
			include : MetricalMacron 0 macronY 1
			include : Italify (-para.slopeAngle)

		create-glyph [MangleName 'metricalLongOverTwoShorts'] [MangleUnicode 0x23D4] : glyph-proc
			set-width Geom.Width
			set currentGlyph.gizmo : Italify para.slopeAngle
			local breveY : MetricalMidY - (markStroke + MetricalStackGap) / 2
			local macronY : MetricalMidY + (MetricalBreveHeight + MetricalStackGap) / 2
			local macronScaleX : 4 * MetricalShortHalfSpan / (3 * markExtend)
			include : MetricalShorts breveY
			include : MetricalMacron 0 macronY macronScaleX
			include : Italify (-para.slopeAngle)

		create-glyph [MangleName 'metricalTwoShortsOverLong'] [MangleUnicode 0x23D5] : glyph-proc
			set-width Geom.Width
			set currentGlyph.gizmo : Italify para.slopeAngle
			local breveY : MetricalMidY + (markStroke + MetricalStackGap) / 2
			local macronY : MetricalMidY - (MetricalBreveHeight + MetricalStackGap) / 2
			local macronScaleX : 4 * MetricalShortHalfSpan / (3 * markExtend)
			include : MetricalShorts breveY
			include : MetricalMacron 0 macronY macronScaleX
			include : Italify (-para.slopeAngle)

		create-glyph [MangleName 'metricalTwoShortsJoined'] [MangleUnicode 0x23D6] : glyph-proc
			set-width Geom.Width
			set currentGlyph.gizmo : Italify para.slopeAngle
			include : MetricalShorts MetricalMidY
			include : Italify (-para.slopeAngle)

	do "Dimensions"
		create-glyph [MangleName 'straightness'] [MangleUnicode 0x23E4] : glyph-proc
			set-width Geom.Width
			include : HBar.m Geom.Left Geom.Right Geom.MidY GeometryStroke

		create-glyph [MangleName 'symmetry'] [MangleUnicode 0x232F] : glyph-proc
			set-width Geom.Width
			define yOffset : Geom.Size * 0.4
			define xShrink : Geom.Size * 0.25
			include : HBar.m Geom.Left Geom.Right Geom.MidY GeometryStroke
			include : HBar.b (Geom.Left + xShrink) (Geom.Right - xShrink) (Geom.MidY + yOffset) GeometryStroke
			include : HBar.t (Geom.Left + xShrink) (Geom.Right - xShrink) (Geom.MidY - yOffset) GeometryStroke

		create-glyph [MangleName 'totalRunoff'] [MangleUnicode 0x2330] : glyph-proc
			set-width Geom.Width
			local headSize : Geom.Size * 0.375 / Math.SQRT1_2
			local offset : Geom.Size * 0.4
			local x0   Geom.Left
			local x1 : Geom.Left + offset
			local x2 : Geom.Right - offset - headSize * 0.35
			local x3 : Geom.Right - headSize * 0.35
			local vsw : HSwToV : 0.5 * GeometryStroke
			include : dispiro
				disable-contrast
				flat ([mix x0 x1 0.75] + vsw) [mix Geom.Bot Geom.Top 0.75] [widths.center GeometryStroke]
				sharp-corner (x0 + vsw) Geom.Bot (contrast -- 1)
				corner Geom.MidX Geom.Bot [widths.lhs GeometryStroke]
				sharp-corner (x2 - vsw) Geom.Bot (contrast -- 1)
				curl ([mix x2 x3 0.75] - vsw) [mix Geom.Bot Geom.Top 0.75] [widths.center GeometryStroke]
			include : TrigArrowShape ([mix x0 x1 0.5] + vsw) Geom.MidY (x1 + vsw) Geom.Top headSize (GeometryStroke / 2)
			include : TrigArrowShape ([mix x2 x3 0.5] - vsw) Geom.MidY (x3 - vsw) Geom.Top headSize (GeometryStroke / 2)

		create-glyph [MangleName 'conicalTaper'] [MangleUnicode 0x2332] : glyph-proc
			set-width Geom.Width
			include : TriangleShape Geom.Left (Geom.MidY - Geom.Size * 0.8) Geom.Left (Geom.MidY + Geom.Size * 0.8) Geom.Right Geom.MidY fineGeometryStroke
			include : HBar.m [mix 0 Geom.Left 0.5] [mix Geom.Right Geom.Width 0.5] Geom.MidY GeometryStroke

		create-glyph [MangleName 'slope'] [MangleUnicode 0x2333] : glyph-proc
			set-width Geom.Width
			include : TriangleShape Geom.Left Geom.Bot Geom.Left Geom.MidY Geom.Right Geom.Bot fineGeometryStroke

	create-glyph [MangleName 'electricArrow'] [MangleUnicode 0x2301] : glyph-proc
		set-width Geom.Width
		define amp : Geom.Size / 2
		define amp2 : Geom.Size / 4
		include : intersection [MaskRight Geom.Left] [MaskLeft Geom.Right] : dispiro
			corner (Geom.MidX - Geom.Size * 2) (Geom.MidY + amp2 * 4) [widths.center GeometryStroke]
			sharp-corner Geom.MidX (Geom.MidY - amp)
			corner Geom.MidX Geom.MidY [widths.center.heading GeometryStroke Upward]
			sharp-corner Geom.MidX (Geom.MidY + amp)
			corner (Geom.MidX + Geom.Size * 2) (Geom.MidY - amp2 * 4) [widths.center GeometryStroke]

	create-glyph [MangleName 'viewdataSquare'] [MangleUnicode 0x2317] : glyph-proc
		set-width Geom.Width
		define shrink : Geom.Size * 2 * 0.13
		include : HBar.t Geom.Left Geom.Right (Geom.Top - shrink) GeometryStroke
		include : HBar.b Geom.Left Geom.Right (Geom.Bot + shrink) GeometryStroke
		include : VBar.l (Geom.Left  + shrink) Geom.Bot Geom.Top GeometryStroke
		include : VBar.r (Geom.Right - shrink) Geom.Bot Geom.Top GeometryStroke

	create-glyph [MangleName 'loopedSquare'] [MangleUnicode 0x2318] : glyph-proc
		set-width Geom.Width

		define stroke : AdviceStrokeInSpace (Geom.Size * 2) 6
		define gap : (Geom.Size * 2 - [HSwToV : stroke * 4]) / 6
		include : lift-@ : dispiro
			widths.lhs stroke
			flat Geom.MidX @y3
			curl (@x5 = [mix @x4 @x6 0.5]) (@y3 = Geom.MidY + gap)
			archv 4
			g4.up.mid (@x6 = Geom.Right) @y2
			arcvh 4
			g4.left.mid @x5 (@y1 = Geom.Top)
			archv 4
			flat (@x4 = Geom.MidX + gap) (@y2 = [mix @y1 @y3 0.5])
			curl @x4 @y5
			arcvh 4
			g4.right.mid @x5 @y6
			archv 4
			g4.up.mid @x6 @y5
			arcvh 4
			flat @x5 @y4
			curl (@x2 = [mix @x1 @x3 0.5]) (@y4 = Geom.MidY - gap)
			archv 4
			g4.down.mid (@x1 = Geom.Left) @y5
			arcvh 4
			g4.right.mid @x2 (@y6 = Geom.Bot)
			archv 4
			flat (@x3 = Geom.MidX - gap) (@y5 = [mix @y4 @y6 0.5])
			curl @x3 @y2
			arcvh 4
			g4.left.mid @x2 @y1
			archv 4
			g4.down.mid @x1 @y2
			arcvh 4
			flat @x2 @y3
			curl Geom.MidX @y3

	do "Output Circuit and Benzene Symbols"
		define [DiamondShape cx cy radius] : spiro-outline
			corner cx (cy + radius)
			corner (cx + radius) cy
			corner cx (cy - radius)
			corner (cx - radius) cy
			close

		define [OpenCircuitOutput name unicode topBar middleBar bottomBar] : begin
			create-glyph [MangleName name] [MangleUnicode unicode] : glyph-proc
				set-width Geom.Width
				include : ConvexPolygonOutline [new-glyph : DiamondShape Geom.MidX Geom.MidY Geom.Size] GeometryStroke
				if topBar : include : HBar.m Geom.Left Geom.Right (Geom.Top - GeometryStroke / 2) GeometryStroke
				if middleBar : include : intersection
					DiamondShape Geom.MidX Geom.MidY Geom.Size
					HBar.m Geom.Left Geom.Right Geom.MidY GeometryStroke
				if bottomBar : include : HBar.m Geom.Left Geom.Right (Geom.Bot + GeometryStroke / 2) GeometryStroke

		OpenCircuitOutput 'openCircuitOutputHType' 0x238F true false false
		OpenCircuitOutput 'openCircuitOutputLType' 0x2390 false false true
		OpenCircuitOutput 'passivePullDownOutput' 0x2391 true true false
		OpenCircuitOutput 'passivePullUpOutput' 0x2392 false true true

		create-glyph [MangleName 'decimalSeparatorKeySymbol'] [MangleUnicode 0x2396] : glyph-proc
			set-width Geom.Width
			local halfSize : Geom.Size / 2
			include : spiro-outline
				corner (Geom.MidX - halfSize) (Geom.MidY + halfSize)
				corner (Geom.MidX + halfSize) (Geom.MidY + halfSize)
				corner (Geom.MidX - halfSize) (Geom.MidY - halfSize)
				close

		create-glyph [MangleName 'directCurrentSymbolFormTwo'] [MangleUnicode 0x2393] : glyph-proc
			set-width Geom.Width
			local span : Geom.Right - Geom.Left
			local dashWidth : span * 0.27
			local dashGap : span * 0.08
			local mainY : Geom.MidY + Geom.Size * 0.36
			local lowerY : mainY - GeometryStroke * 1.5
			local lowerWidth : 3 * dashWidth + 2 * dashGap
			local lowerLeft : Geom.MidX - lowerWidth / 2
			include : HBar.m Geom.Left Geom.Right mainY GeometryStroke
			foreach i [range 0 3] : do
				local dashLeft : lowerLeft + i * (dashWidth + dashGap)
				include : HBar.m dashLeft (dashLeft + dashWidth) lowerY GeometryStroke

		define benzeneRadius : Geom.Size * 0.96
		define benzeneHalfWidth : benzeneRadius * [Math.sqrt 0.75]
		define benzeneStroke : Math.min GeometryStroke (0.6 * benzeneHalfWidth)
		define benzeneInnerRadius : benzeneHalfWidth - benzeneStroke
		define benzeneInnerStroke : Math.min (0.65 * benzeneStroke) (0.28 * benzeneInnerRadius)

		define [BenzeneOutline] : glyph-proc
			local radius benzeneRadius
			local halfWidth benzeneHalfWidth
			local hexagon : new-glyph : spiro-outline
					corner Geom.MidX (Geom.MidY + radius)
					corner (Geom.MidX + halfWidth) (Geom.MidY + radius / 2)
					corner (Geom.MidX + halfWidth) (Geom.MidY - radius / 2)
					corner Geom.MidX (Geom.MidY - radius)
					corner (Geom.MidX - halfWidth) (Geom.MidY - radius / 2)
					corner (Geom.MidX - halfWidth) (Geom.MidY + radius / 2)
					close
			include : ConvexPolygonOutline hexagon benzeneStroke

		create-glyph [MangleName 'benzeneRing'] [MangleUnicode 0x232C] : glyph-proc
			set-width Geom.Width
			include : BenzeneOutline
			local innerRadius benzeneInnerRadius
			local innerStroke benzeneInnerStroke
			include : VBar.m (Geom.MidX - 0.65 * innerRadius) (Geom.MidY - 0.5 * innerRadius) (Geom.MidY + 0.5 * innerRadius) innerStroke
			local innerLeft Geom.MidX
			local innerRight : Geom.MidX + 0.7 * innerRadius
			local innerRise : 0.38 * innerRadius
			include : DiagonalHBar innerLeft innerRight (Geom.MidY + 0.49 * innerRadius) (-innerRise) innerStroke
			include : DiagonalHBar innerLeft innerRight (Geom.MidY - 0.49 * innerRadius) innerRise innerStroke

		create-glyph [MangleName 'benzeneRingWithCircle'] [MangleUnicode 0x23E3] : glyph-proc
			set-width Geom.Width
			include : BenzeneOutline
			include : RingStrokeAt Geom.MidX Geom.MidY (0.65 * benzeneInnerRadius) benzeneInnerStroke

	do "Wide Square Brackets"
		local bracketHeight : Math.max (aboveMarkTop - aboveMarkBot) (Stroke * 2.5)
		local bracketWidth : Width * para.advanceScaleMM
		local bracketStroke Stroke
		local middle : bracketWidth / 2
		local edgeY : Ascender - bracketHeight + bracketStroke / 2
		local peakY : Ascender - bracketStroke / 2
		local topMidY : (edgeY + peakY) / 2
		local parenthesisDf : DivFrame 1
		local parenthesisDim : Paren.Dim parenthesisDf
		local braceLeft : mix SB RightSB DesignParameters.braceOutside
		local braceRight : mix SB RightSB DesignParameters.braceInside
		local tortoiseDim : Paren.Dim parenthesisDf

		define [TopBracketShape baseName sourceLeft sourceRight sourceBottom sourceTop] : glyph-proc
			local sourceMidX : (sourceLeft + sourceRight) / 2
			local sourceMidY : (sourceBottom + sourceTop) / 2
			local sourceWidth : sourceRight - sourceLeft
			local scaleX : bracketWidth / (sourceTop - sourceBottom)
			local shapeMidY : Ascender - sourceWidth / 2
			include : with-transform [Translate middle shapeMidY] : with-transform [Scale scaleX 1] : with-transform [Rotate (-Math.PI / 2)] : with-transform [Translate (-sourceMidX) (-sourceMidY)] : with-transform [Italify (-para.slopeAngle)] : refer-glyph baseName

		define [BracketPair topName topUnicode bottomName bottomUnicode baseName sourceLeft sourceRight sourceBottom sourceTop] : begin
			local shapeHeight : sourceRight - sourceLeft
			local shapeMidY : Ascender - shapeHeight / 2
			create-glyph [MangleName topName] [MangleUnicode topUnicode] : glyph-proc
				set-width bracketWidth
				include : with-transform [Italify para.slopeAngle] : with-transform [Translate 0 (shapeHeight - Ascender)] : TopBracketShape baseName sourceLeft sourceRight sourceBottom sourceTop
			create-glyph [MangleName bottomName] [MangleUnicode bottomUnicode] : glyph-proc
				set-width bracketWidth
				include : with-transform [Italify para.slopeAngle] : with-transform [ScaleAround middle shapeMidY 1 (-1)] : TopBracketShape baseName sourceLeft sourceRight sourceBottom sourceTop

		BracketPair 'topParenthesis' 0x23DC 'bottomParenthesis' 0x23DD 'parenLeft' parenthesisDim.outside parenthesisDim.inside parenthesisDim.bottom parenthesisDim.top
		BracketPair 'topCurlyBracket' 0x23DE 'bottomCurlyBracket' 0x23DF 'braceLeft.straight' braceLeft braceRight ParenBot ParenTop
		BracketPair 'topTortoiseShellBracket' 0x23E0 'bottomTortoiseShellBracket' 0x23E1 'tortoiseShellBracketLeft' tortoiseDim.outside tortoiseDim.inside tortoiseDim.bottom tortoiseDim.top

		define [TopSquareShape] : union
			HBar.t 0 bracketWidth Ascender bracketStroke
			VBar.l 0 (Ascender - bracketHeight) Ascender bracketStroke
			VBar.r bracketWidth (Ascender - bracketHeight) Ascender bracketStroke

		create-glyph [MangleName 'topSquareBracket'] [MangleUnicode 0x23B4] : glyph-proc
			set-width bracketWidth
			include : with-transform [Italify para.slopeAngle] : with-transform [Translate 0 (bracketHeight - Ascender)] : TopSquareShape

		create-glyph [MangleName 'bottomSquareBracket'] [MangleUnicode 0x23B5] : glyph-proc
			set-width bracketWidth
			include : with-transform [Italify para.slopeAngle] : with-transform [ScaleAround middle topMidY 1 (-1)] : TopSquareShape

		create-glyph [MangleName 'bottomSquareBracketOverTopSquareBracket'] [MangleUnicode 0x23B6] : glyph-proc
			set-width bracketWidth
			include : WideBridgeShape 0 bracketWidth (Ascender - bracketHeight) Ascender true bracketStroke
			include : WideBridgeShape 0 bracketWidth 0 bracketHeight false bracketStroke

	do "Keyboard Symbols"
		define topLine : Geom.MidY + Geom.Size / 1.5
		define botLine : Geom.MidY - Geom.Size / 1.5
		define topLineC : topLine - GeometryStroke / 2
		define botLineC : botLine + GeometryStroke / 2

		create-glyph [MangleName 'arrowHeadUpBetweenBars'] [MangleUnicode 0x2324] : glyph-proc
			set-width MosaicWidth
			include : ArrowHead Geom.MidX Geom.Bot Geom.MidX topLine
			include : HBar.t Geom.Left (Geom.MidX - Geom.Size / 3) topLine GeometryStroke
			include : HBar.t (Geom.MidX + Geom.Size / 3) Geom.Right topLine GeometryStroke

		create-glyph [MangleName 'optionKey'] [MangleUnicode 0x2325] : glyph-proc
			set-width Geom.Width
			include : dispiro
				Polyline [widths.center GeometryStroke]
					points -- {
						{ Geom.Left  topLineC }
						{ (Geom.MidX - Geom.Size / 3) topLineC }
						{ (Geom.MidX + Geom.Size / 3) botLineC }
						{ Geom.Right botLineC }
					}
					startAf -- [widths.center.heading GeometryStroke Rightward]
					endAf -- [widths.center.heading GeometryStroke Rightward]
			include : HBar.t (Geom.MidX + Geom.Size / 3) Geom.Right topLine GeometryStroke

		create-glyph [MangleName 'alternateKey'] [MangleUnicode 0x2387] : glyph-proc
			set-width Geom.Width
			include : dispiro
				Polyline [widths.center GeometryStroke]
					points -- {
						{ Geom.Left  botLineC }
						{ (Geom.MidX - Geom.Size / 3) botLineC }
						{ (Geom.MidX + Geom.Size / 3) topLineC }
						{ (Geom.Right - Geom.Size / 6) topLineC }
					}
					startAf -- [widths.center.heading GeometryStroke Rightward]
					endAf -- [widths.center.heading GeometryStroke Rightward]
			include : ArrowShape (Geom.Right - Geom.Size / 6) topLineC (Geom.Right + GeometryStroke / 2) topLineC (GeometryStroke / 2 + Geom.Size / 3)
			include : HBar.b (Geom.MidX + Geom.Size / 3) Geom.Right botLine GeometryStroke
