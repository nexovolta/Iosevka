$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from '@iosevka/util'
import [BezToContoursSink] from '@iosevka/geometry/curve-util'

glyph-module

glyph-block Symbol-Arrow-Circular : for-width-kinds WideWidth1
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Symbol-Arrow-Shared : ArrowDims ArrowT

	define dims : ArrowDims MosaicWidth
	define Arrow : ArrowT dims

	define {
		.arrowTop arrowTop
		.arrowBot arrowBot
		.arrowMidX arrowMidX
		.arrowSB arrowSB
		.arrowRSB arrowRSB

		.arrowSw arrowSw
		.arrowHeadSize arrowHeadSize
		.fine fine
	} dims

	# Arrow Shapes
	local arcSW : Math.min arrowSw [AdviceStroke 5 MosaicWidthScalar]
	local headSize : mix arcSW arrowHeadSize 0.5
	local headLength : (headSize + fine) * Math.SQRT1_2
	local l : arrowSB  + 0.5 * headSize
	local r : arrowRSB - 0.5 * headSize
	local t : arrowTop - 0.5 * headSize
	local b : arrowBot + 0.5 * headSize
	local ada : ArchDepthAOf (SmallArchDepth * (r - l) / (RightSB - SB)) (r - l)
	local adb : ArchDepthBOf (SmallArchDepth * (r - l) / (RightSB - SB)) (r - l)
	local gapWidth : Math.max ((t - b) * 0.05) (fine * Math.SQRT1_2)

	define [HalfCircleArrow headFunc fCcw fGapped] : glyph-proc
		local arrowX : if fCcw (l + [HSwToV : 0.5 * arcSW]) (r - [HSwToV : 0.5 * arcSW])
		local arrowY SymbolMid
		local arrowYS : arrowY + 0.5 * headLength
		local arrowYE : arrowY - 0.5 * headLength
		set-width MosaicWidth
		include : union
			difference
				OShape.NoOvershoot t b l r arcSW ada adb
				if fGapped
					Arrow.Head.barbShape arrowX arrowYS arrowX arrowYE headSize headSize (-gapWidth)
					MaskBelow arrowY
			difference
				dispiro
					widths.center arcSW
					flat arrowX arrowY
					curl arrowX arrowYE [heading Downward]
				Arrow.Head.outerMask arrowX arrowYS arrowX arrowYE headSize
		include : headFunc arrowX arrowYS arrowX arrowYE headSize

	define [ShareAlikeArrow headFunc] : glyph-proc
		local arrowX : l + [HSwToV HalfStroke]
		local headLength : headSize * Math.SQRT1_2
		local gapSize : Math.max (2 * headLength) (CAP - 0 - ada - adb)
		local gapTop : CAP / 2 + 0.5 * gapSize
		local gapBot : CAP / 2 - 0.5 * gapSize
		set-width MosaicWidth
		include : union
			difference
				OShape.NoOvershoot CAP 0 l r Stroke ada adb
				spiro-outline
					corner arrowSB   gapTop
					corner arrowMidX gapTop
					corner arrowMidX gapBot
					corner arrowSB   gapBot
		include : headFunc arrowX gapTop arrowX (gapTop - headLength) headSize

	define [OpenCircleArrow headFunc fCcw fClosed] : glyph-proc
		local arrowX : Arch.adjust-x.top arrowMidX arcSW
		local arrowXS : arrowX + [if fCcw 0.5 (-0.5)] * headLength
		local arrowXE : arrowX + [if fCcw (-0.5) 0.5] * headLength
		local arrowY : t - (0.5 * arcSW)

		local circle : OShape.NoOvershoot t b l r arcSW ada adb
		set-width MosaicWidth
		if fClosed
			include circle
			include : union
				difference
					OShape.NoOvershoot t b l r arcSW ada adb
					intersection [MaskAbove SymbolMid] [[if fCcw MaskLeft MaskRight] arrowX]
				difference
					dispiro
						widths.center arcSW
						flat arrowX arrowY
						curl arrowXE arrowY [heading [if fCcw Leftward Rightward]]
					Arrow.Head.outerMask arrowXS arrowY arrowXE arrowY headSize
		include : headFunc arrowXS arrowY arrowXE arrowY headSize

	# Glyphs
	create-glyph [MangleName 'ccwHalfCircleArrow'] [MangleUnicode 0x21B6] : glyph-proc
		include : HalfCircleArrow Arrow.Head.shape true  false
	create-glyph [MangleName 'cwHalfCircleArrow'] [MangleUnicode 0x21B7] : glyph-proc
		include : HalfCircleArrow Arrow.Head.shape false false
	create-glyph [MangleName 'ccwOpenCircleArrow'] [MangleUnicode 0x21BA] : glyph-proc
		include : OpenCircleArrow Arrow.Head.shape true  false
	create-glyph [MangleName 'cwOpenCircleArrow'] [MangleUnicode 0x21BB] : glyph-proc
		include : OpenCircleArrow Arrow.Head.shape false false
	create-glyph [MangleName 'ccwGappedCircleArrow'] [MangleUnicode 0x27F2] : glyph-proc
		include : HalfCircleArrow Arrow.Head.shape true  true
	create-glyph [MangleName 'cwGappedCircleArrow'] [MangleUnicode 0x27F3] : glyph-proc
		include : HalfCircleArrow Arrow.Head.shape false true
	create-glyph [MangleName 'ccwClosedCircleArrow'] [MangleUnicode 0x2940] : glyph-proc
		include : OpenCircleArrow Arrow.Head.shape true  true
	create-glyph [MangleName 'cwClosedCircleArrow'] [MangleUnicode 0x2941] : glyph-proc
		include : OpenCircleArrow Arrow.Head.shape false true
	create-glyph [MangleName 'cwOpenCircleArrowTriangle'] [MangleUnicode 0x2B6E] : glyph-proc
		include : OpenCircleArrow Arrow.Head.trigShape false false
	create-glyph [MangleName 'ccwOpenCircleArrowTriangle'] [MangleUnicode 0x2B6F] : glyph-proc
		include : OpenCircleArrow Arrow.Head.trigShape true  false

	do 'Curving and semicircular arrows'
		local sw : AdviceStroke 4
		local sz : Math.max (headSize * 0.9) (sw * 2)
		local left : mix arrowMidX arrowSB 0.85
		local right : mix arrowMidX arrowRSB 0.85
		local top : mix SymbolMid arrowTop 0.85
		local bot : mix SymbolMid arrowBot 0.85
		define [CurvingArrow startHorizontal endPositive] : glyph-proc
			set-width MosaicWidth
			if startHorizontal
			: then : begin
				local y0 : if endPositive bot top
				local ye : if endPositive top bot
				local x : Math.min right (MosaicWidth - sz - sw / 2)
				include : dispiro
					widths.center sw
					flat left y0 [heading Rightward]
					g4 [mix left x 0.52] y0 [heading Rightward]
					g4 x SymbolMid [heading [if endPositive Upward Downward]]
					curl x ye [heading [if endPositive Upward Downward]]
				include : Arrow.Head.shape x SymbolMid x ye sz
			: else : begin
				local x0 : if endPositive left right
				local xe : if endPositive right left
				include : dispiro
					widths.center sw
					flat x0 top [heading Downward]
					g4 x0 [mix top bot 0.52] [heading Downward]
					g4 arrowMidX bot [heading [if endPositive Rightward Leftward]]
					curl xe bot [heading [if endPositive Rightward Leftward]]
				include : Arrow.Head.shape arrowMidX bot xe bot sz
		create-glyph [MangleName 'arrowRightCurveUp'] [MangleUnicode 0x2934] : CurvingArrow true true
		create-glyph [MangleName 'arrowRightCurveDown'] [MangleUnicode 0x2935] : CurvingArrow true false
		create-glyph [MangleName 'arrowDownCurveLeft'] [MangleUnicode 0x2936] : CurvingArrow false false
		create-glyph [MangleName 'arrowDownCurveRight'] [MangleUnicode 0x2937] : CurvingArrow false true

		local hw : right - arrowMidX
		local hh : top - SymbolMid
		local radius : Math.max (sw * 1.75) [Math.min hw hh]
		local centerRadius : radius - sw / 2
		local arcHeadWidth : Math.max (headSize * 0.7) (sw * 1.5)
		local arcHeadLength : Math.max (headSize * 1.2) (sw * 2.7)
		define [ArcHead x y dx dy] : Arrow.Head.trigShape (x - dx * arcHeadLength) (y - dy * arcHeadLength) (x + dx * arcHeadLength * 0.6) (y + dy * arcHeadLength * 0.6) arcHeadWidth arcHeadLength
		define [SideArc side] : glyph-proc
			local x : arrowMidX + side * centerRadius * 0.6
			local y : SymbolMid - centerRadius * 0.8
			set-width MosaicWidth
			include : union
				intersection
					RingStrokeAt arrowMidX SymbolMid radius sw
					[if (side > 0) MaskRight MaskLeft] arrowMidX
					MaskAboveLine (arrowMidX - radius) (SymbolMid + side * radius * 4 / 3) (arrowMidX + radius) (SymbolMid - side * radius * 4 / 3) 100
				ArcHead x y (-side * 0.8) (-0.6)
		define [HorizontalArc dir vertical] : glyph-proc
			local x : arrowMidX - dir * centerRadius * 0.8
			local y : SymbolMid + vertical * centerRadius * 0.6
			set-width MosaicWidth
			include : union
				intersection
					RingStrokeAt arrowMidX SymbolMid radius sw
					[if (vertical > 0) MaskAbove MaskBelow] SymbolMid
					[if (vertical > 0) MaskAboveLine MaskBelowLine] (arrowMidX - radius) (SymbolMid + vertical * dir * radius * 0.75) (arrowMidX + radius) (SymbolMid - vertical * dir * radius * 0.75) 100
				ArcHead x y (-dir * 0.6) (-vertical * 0.8)
		define [LowerCircleArc dir] : glyph-proc
			local diagonal : centerRadius * Math.SQRT1_2
			local x : arrowMidX - dir * diagonal
			local y : SymbolMid - diagonal
			set-width MosaicWidth
			include : union
				intersection
					RingStrokeAt arrowMidX SymbolMid radius sw
					MaskBelowLine (arrowMidX - radius) (SymbolMid - dir * radius) (arrowMidX + radius) (SymbolMid + dir * radius) 100
				ArcHead x y (-dir * Math.SQRT1_2) Math.SQRT1_2
		define [ArcWithMark dir mark] : glyph-proc
			set-width MosaicWidth
			include : HorizontalArc dir 1
			local markSize : Math.max (sz * 0.55) (sw * 1.25)
			local y : SymbolMid - markSize * [if (mark == 2) 1.05 0.35]
			include : HBar.m (arrowMidX - markSize) (arrowMidX + markSize) y sw
			if (mark == 2) : include : VBar.m arrowMidX (y - markSize) (y + markSize) sw
		create-glyph [MangleName 'rightArcClockwise'] [MangleUnicode 0x2938] : SideArc 1
		create-glyph [MangleName 'leftArcAnticlockwise'] [MangleUnicode 0x2939] : SideArc (-1)
		create-glyph [MangleName 'topArcAnticlockwise'] [MangleUnicode 0x293A] : HorizontalArc 1 1
		create-glyph [MangleName 'bottomArcAnticlockwise'] [MangleUnicode 0x293B] : HorizontalArc (-1) (-1)
		create-glyph [MangleName 'topArcClockwiseMinus'] [MangleUnicode 0x293C] : ArcWithMark (-1) 1
		create-glyph [MangleName 'topArcAnticlockwisePlus'] [MangleUnicode 0x293D] : ArcWithMark 1 2
		create-glyph [MangleName 'lowerRightSemicircleClockwise'] [MangleUnicode 0x293E] : LowerCircleArc 1
		create-glyph [MangleName 'lowerLeftSemicircleAnticlockwise'] [MangleUnicode 0x293F] : LowerCircleArc (-1)

	do 'Black curved arrows'
		define [BlackCurvedArrow] : glyph-proc
			set-width MosaicWidth
			local w : [Math.min (arrowRSB - arrowSB) (arrowTop - arrowBot)] * 0.9
			local left : arrowMidX - w / 2
			local right : arrowMidX + w / 2
			local headSize : w * 0.25 + OperatorStroke * 0.12
			local head : left + headSize
			local bend : right - w * 0.30
			local y : SymbolMid - w * 0.10
			local upper : y + w * 0.105
			local lower : y - w * 0.105
			local tail : SymbolMid + w * 0.32
			local cs : new BezToContoursSink currentGlyph.gizmo
			cs.moveTo left y
			cs.lineTo head (y + w * 0.22 + OperatorStroke * 0.12)
			cs.lineTo head upper
			cs.lineTo bend upper
			cs.cubicTo (right - w * 0.08) upper (right - w * 0.035) (y + w * 0.15) (right - w * 0.035) tail
			cs.lineTo right tail
			cs.cubicTo right (y + w * 0.02) (right - w * 0.03) lower bend lower
			cs.lineTo head lower
			cs.lineTo head (y - w * 0.22 - OperatorStroke * 0.12)
			cs.endShape
			currentGlyph.includeContours cs.contours

		create-glyph [MangleName 'blackCurvedDownLeft'] [MangleUnicode 0x2BA8] : BlackCurvedArrow
		create-glyph [MangleName 'blackCurvedDownRight'] [MangleUnicode 0x2BA9] : glyph-proc
			set-width MosaicWidth
			include : with-transform [ScaleAround arrowMidX SymbolMid (-1) 1] : refer-glyph [MangleName 'blackCurvedDownLeft']
		create-glyph [MangleName 'blackCurvedUpLeft'] [MangleUnicode 0x2BAA] : glyph-proc
			set-width MosaicWidth
			include : with-transform [ScaleAround arrowMidX SymbolMid 1 (-1)] : refer-glyph [MangleName 'blackCurvedDownLeft']
		create-glyph [MangleName 'blackCurvedUpRight'] [MangleUnicode 0x2BAB] : glyph-proc
			set-width MosaicWidth
			include : with-transform [ScaleAround arrowMidX SymbolMid (-1) (-1)] : refer-glyph [MangleName 'blackCurvedDownLeft']
		create-glyph [MangleName 'blackCurvedLeftUp'] [MangleUnicode 0x2BAC] : glyph-proc
			set-width MosaicWidth
			include : with-transform [Translate arrowMidX SymbolMid] : with-transform [Rotate (-Math.PI / 2)] : with-transform [Translate (-arrowMidX) (-SymbolMid)] : refer-glyph [MangleName 'blackCurvedDownLeft']
		create-glyph [MangleName 'blackCurvedRightUp'] [MangleUnicode 0x2BAD] : glyph-proc
			set-width MosaicWidth
			include : with-transform [ScaleAround arrowMidX SymbolMid (-1) 1] : refer-glyph [MangleName 'blackCurvedLeftUp']
		create-glyph [MangleName 'blackCurvedLeftDown'] [MangleUnicode 0x2BAE] : glyph-proc
			set-width MosaicWidth
			include : with-transform [ScaleAround arrowMidX SymbolMid 1 (-1)] : refer-glyph [MangleName 'blackCurvedLeftUp']
		create-glyph [MangleName 'blackCurvedRightDown'] [MangleUnicode 0x2BAF] : glyph-proc
			set-width MosaicWidth
			include : with-transform [ScaleAround arrowMidX SymbolMid (-1) (-1)] : refer-glyph [MangleName 'blackCurvedLeftUp']

	define [EllipseOutline cx cy rx ry] : glyph-proc
		include : spiro-outline
			g4 cx (cy + ry)
			archv nothing 2
			g4 (cx - rx) cy
			arcvh nothing 2
			g4 cx (cy - ry)
			archv nothing 2
			g4 (cx + rx) cy
			arcvh nothing 2
			close

	define [EllipseRing cx cy rx ry sw] : glyph-proc
		local outer : new-glyph : EllipseOutline cx cy rx ry
		local inner : new-glyph : EllipseOutline cx cy (rx - sw) (ry - sw)
		include : difference outer inner

	define [CircledWhiteArrow dx dy] : glyph-proc
		set-width MosaicWidth
		local r : Math.min ((arrowRSB - arrowSB) * 0.475) ((arrowTop - arrowBot) * 0.475)
		local tipX : arrowMidX + dx * r * 0.84
		local tipY : SymbolMid + dy * r * 0.84
		local tailX : arrowMidX - dx * r * 1.2
		local tailY : SymbolMid - dy * r * 1.2
		local white : new-glyph : PointingTo tailX tailY tipX tipY : lambda [mag] : spiro-outline
			corner 0 0
			corner (r * 0.55) (r * 0.45)
			corner (r * 0.55) (r * 0.18)
			corner mag (r * 0.18)
			corner mag (-r * 0.18)
			corner (r * 0.55) (-r * 0.18)
			corner (r * 0.55) (-r * 0.45)
		local disc : new-glyph : EllipseOutline arrowMidX SymbolMid r r
		include : difference disc white

	create-glyph [MangleName 'leftBlackCircledWhiteArrow'] [MangleUnicode 0x2B88] : CircledWhiteArrow (-1) 0
	create-glyph [MangleName 'upBlackCircledWhiteArrow'] [MangleUnicode 0x2B89] : CircledWhiteArrow 0 1
	create-glyph [MangleName 'rightBlackCircledWhiteArrow'] [MangleUnicode 0x2B8A] : CircledWhiteArrow 1 0
	create-glyph [MangleName 'downBlackCircledWhiteArrow'] [MangleUnicode 0x2B8B] : CircledWhiteArrow 0 (-1)

	create-glyph [MangleName 'heavyOvalWithOvalInside'] [MangleUnicode 0x2B56] : glyph-proc
		set-width MosaicWidth
		local rx : (arrowRSB - arrowSB) * 0.46
		local ry : rx * 0.65
		local sw : Math.max (arrowSw * 1.1) (ry * 0.12)
		local outerSw : ry * 0.12 + [Math.min (ry * 0.17) (Stroke * 0.18)]
		local innerSw : Math.min sw (ry * 0.16)
		local inset : outerSw + innerSw * 1.5
		include : EllipseRing arrowMidX SymbolMid rx ry outerSw
		include : EllipseRing arrowMidX SymbolMid (rx - inset) (ry - inset) (innerSw * 0.7)

	create-glyph [MangleName 'heavyCircleWithCircleInside'] [MangleUnicode 0x2B57] : glyph-proc
		set-width MosaicWidth
		local R : Math.min ((arrowRSB - arrowSB) * 0.45) ((arrowTop - arrowBot) * 0.45)
		local sw : Math.max (arrowSw * 1.1) (R * 0.12)
		local outerSw : R * 0.12 + [Math.min (R * 0.17) (Stroke * 0.18)]
		local innerSw : Math.min sw (R * 0.16)
		local inset : outerSw + innerSw * 1.5
		include : EllipseRing arrowMidX SymbolMid R R outerSw
		include : EllipseRing arrowMidX SymbolMid (R - inset) (R - inset) (innerSw * 0.7)

	if (MosaicWidthScalar == 1) : do
		create-glyph 'ccCcwArrow' : glyph-proc
			include : ShareAlikeArrow Arrow.Head.trigShape
