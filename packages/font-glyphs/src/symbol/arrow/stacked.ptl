$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [BezToContoursSink] from "@iosevka/geometry/curve-util"

glyph-module

glyph-block Symbol-Arrow-Stacked : for-width-kinds WideWidth1
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Symbol-Arrow-Shared : ArrowDims ArrowT MkArrowT

	define dims : ArrowDims MosaicWidth
	define Arrow : ArrowT dims
	define MkArrow : MkArrowT dims

	define {
		.arrowWidth arrowWidth
		.arrowTop arrowTop
		.arrowBot arrowBot
		.arrowMidX arrowMidX
		.arrowSB arrowSB
		.arrowRSB arrowRSB

		.arrowSw arrowSw
		.arrowHeadSize arrowHeadSize
		.compactHeadSize compactHeadSize
		.halfArrowSw halfArrowSw
	} dims

	MkArrow.single Arrow.shape [MangleName 'arrowRightCompact']  null arrowSB SymbolMid arrowRSB SymbolMid nothing compactHeadSize
	MkArrow.single Arrow.shape [MangleName 'arrowLeftCompact']   null arrowRSB SymbolMid arrowSB SymbolMid nothing compactHeadSize

	define hcDist : Math.max (halfArrowSw * 5) (arrowWidth / 2)
	define vcDist2  arrowHeadSize
	define vcDist : arrowHeadSize * 1.75

	VCombine [MangleName 'uni21C4'] [MangleUnicode 0x21C4] [MangleName 'arrowRight'] [MangleName 'arrowLeft'] vcDist
	HCombine [MangleName 'uni21C5'] [MangleUnicode 0x21C5] [MangleName 'arrowUp'] [MangleName 'arrowDown'] hcDist
	VCombine [MangleName 'uni21C6'] [MangleUnicode 0x21C6] [MangleName 'arrowLeft'] [MangleName 'arrowRight'] vcDist
	VCombine [MangleName 'uni21C7'] [MangleUnicode 0x21C7] [MangleName 'arrowLeft'] [MangleName 'arrowLeft'] vcDist
	HCombine [MangleName 'uni21C8'] [MangleUnicode 0x21C8] [MangleName 'arrowUp'] [MangleName 'arrowUp'] hcDist
	VCombine [MangleName 'uni21C9'] [MangleUnicode 0x21C9] [MangleName 'arrowRight'] [MangleName 'arrowRight'] vcDist
	HCombine [MangleName 'uni21CA'] [MangleUnicode 0x21CA] [MangleName 'arrowDown'] [MangleName 'arrowDown'] hcDist
	HCombine [MangleName 'uni21F5'] [MangleUnicode 0x21F5] [MangleName 'arrowDown'] [MangleName 'arrowUp'] hcDist
	VCombine [MangleName 'uni21CB'] [MangleUnicode 0x21CB] [MangleName 'arrowLeftHR'] [MangleName 'arrowRightHR'] vcDist2
	VCombine [MangleName 'uni21CC'] [MangleUnicode 0x21CC] [MangleName 'arrowRightHL'] [MangleName 'arrowLeftHL'] vcDist2
	VCombine [MangleName 'uni21B9'] [MangleUnicode 0x21B9] [MangleName 'arrowBarLeft'] [MangleName 'arrowBarRight'] vcDist
	VCombine [MangleName 'uni2962'] [MangleUnicode 0x2962] [MangleName 'arrowLeftHR'] [MangleName 'arrowLeftHL'] vcDist2
	HCombine [MangleName 'uni2963'] [MangleUnicode 0x2963] [MangleName 'arrowUpHL'] [MangleName 'arrowUpHR'] vcDist2
	VCombine [MangleName 'uni2964'] [MangleUnicode 0x2964] [MangleName 'arrowRightHL'] [MangleName 'arrowRightHR'] vcDist2
	HCombine [MangleName 'uni2965'] [MangleUnicode 0x2965] [MangleName 'arrowDownHR'] [MangleName 'arrowDownHL'] vcDist2
	HCombine [MangleName 'uni296E'] [MangleUnicode 0x296E] [MangleName 'arrowUpHL'] [MangleName 'arrowDownHL'] vcDist2
	HCombine [MangleName 'uni296F'] [MangleUnicode 0x296F] [MangleName 'arrowDownHR'] [MangleName 'arrowUpHR'] vcDist2

	do "Supplemental paired arrows"
		local width : MathOperatorWidth MosaicWidth FMosaicWide
		local d : ArrowDims width
		local a : ArrowT d
		local left d.arrowSB
		local right d.arrowRSB
		local middle d.arrowMidX
		local head : d.compactHeadSize * 0.8
		local sw : AdviceStroke 4
		local distance : Math.max (head * 1.7) (sw * 3.5)
		define [StackedArrow leftward shortUpper shortLower] : glyph-proc
			local y1 : SymbolMid + distance / 2
			local y2 : SymbolMid - distance / 2
			set-width width
			if leftward
			: then : begin
				include : a.shape right y1 left y1 head (sw / 2)
				include : a.shape [if shortLower middle left] y2 right y2 head (sw / 2)
			: else : begin
				include : a.shape [if shortUpper middle left] y1 right y1 head (sw / 2)
				include : a.shape right y2 [if shortLower middle left] y2 head (sw / 2)
		create-glyph [MangleName 'rightArrowAboveShortLeft'] [MangleUnicode 0x2942] : StackedArrow false false true
		create-glyph [MangleName 'leftArrowAboveShortRight'] [MangleUnicode 0x2943] : StackedArrow true false true
		create-glyph [MangleName 'shortRightArrowAboveLeft'] [MangleUnicode 0x2944] : StackedArrow false true false

		define [ArrowPlusBelow rightward] : glyph-proc
			local y : SymbolMid + distance * 0.4
			local py : SymbolMid - distance * 0.65
			local x : mix left right [if rightward 0.25 0.75]
			local size : Math.max (head * 0.5) (sw * 1.4)
			set-width width
			if rightward
			: then : include : a.shape left y right y head (sw / 2)
			: else : include : a.shape right y left y head (sw / 2)
			include : HBar.m (x - size) (x + size) py sw
			include : VBar.m x (py - size) (py + size) sw
		create-glyph [MangleName 'rightArrowPlusBelow'] [MangleUnicode 0x2945] : ArrowPlusBelow true
		create-glyph [MangleName 'leftArrowPlusBelow'] [MangleUnicode 0x2946] : ArrowPlusBelow false

		define [PairedHarpoons firstLeft firstUp secondLeft secondUp] : glyph-proc
			local y1 : SymbolMid + distance / 2
			local y2 : SymbolMid - distance / 2
			set-width width
			if firstLeft
			: then : include : [if firstUp a.rhsShape a.lhsShape] right y1 left y1 head (sw / 2)
			: else : include : [if firstUp a.lhsShape a.rhsShape] left y1 right y1 head (sw / 2)
			if secondLeft
			: then : include : [if secondUp a.rhsShape a.lhsShape] right y2 left y2 head (sw / 2)
			: else : include : [if secondUp a.lhsShape a.rhsShape] left y2 right y2 head (sw / 2)
		create-glyph [MangleName 'leftUpOverRightUp'] [MangleUnicode 0x2966] : PairedHarpoons true true false true
		create-glyph [MangleName 'leftDownOverRightDown'] [MangleUnicode 0x2967] : PairedHarpoons true false false false
		create-glyph [MangleName 'rightUpOverLeftUp'] [MangleUnicode 0x2968] : PairedHarpoons false true true true
		create-glyph [MangleName 'rightDownOverLeftDown'] [MangleUnicode 0x2969] : PairedHarpoons false false true false

		define [HarpoonWithDash leftward above] : glyph-proc
			local y : SymbolMid + [if above 0.5 (-0.5)] * distance
			local ybar : SymbolMid - [if above 0.5 (-0.5)] * distance
			set-width width
			if leftward
			: then : include : [if above a.rhsShape a.lhsShape] right y left y head (sw / 2)
			: else : include : [if above a.lhsShape a.rhsShape] left y right y head (sw / 2)
			include : HBar.m left right ybar sw
		create-glyph [MangleName 'leftUpAboveDash'] [MangleUnicode 0x296A] : HarpoonWithDash true true
		create-glyph [MangleName 'leftDownBelowDash'] [MangleUnicode 0x296B] : HarpoonWithDash true false
		create-glyph [MangleName 'rightUpAboveDash'] [MangleUnicode 0x296C] : HarpoonWithDash false true
		create-glyph [MangleName 'rightDownBelowDash'] [MangleUnicode 0x296D] : HarpoonWithDash false false

	do "Arrow and relation combinations"
		glyph-block-import Symbol-Math-Relation-Inequality : LessShape GreaterShape
		local width : MathOperatorWidth MosaicWidth FMosaicWide
		local d : ArrowDims width
		local a : ArrowT d
		local left d.arrowSB
		local right d.arrowRSB
		local middle d.arrowMidX
		local sw : AdviceStroke 4
		local head : d.compactHeadSize * 0.8
		define [RelationShape relation cy half inset] : new-glyph : glyph-proc
			local innerLeft : left + inset
			if (relation == 'less' || relation == 'greater')
			: then : include : [if (relation == 'less') LessShape GreaterShape] (cy + half) (cy - half) innerLeft right sw
			: else : include : dispiro
				widths.lhs sw
				flat right (cy + half) [heading Leftward]
				curl [mix innerLeft right 0.4] (cy + half)
				archv
				g4 innerLeft cy
				arcvh
				flat [mix innerLeft right 0.4] (cy - half)
				curl right (cy - half) [heading Rightward]
			if (relation == 'supst') : include : FlipAround middle cy
		define [StackedRelationArrow relation above rightward] : glyph-proc
			local gap : Math.max (sw * 4.5) (d.compactHeadSize * 2.4)
			local ya : SymbolMid + [if above (-0.5) 0.5] * gap
			local yr : SymbolMid + [if above 0.5 (-0.5)] * gap
			set-width width
			if rightward
			: then : include : a.shape left ya right ya head (sw / 2)
			: else : include : a.shape right ya left ya head (sw / 2)
			include : RelationShape relation yr [Math.max (sw * 1.5) ((right - left) * 0.23)] 0
		create-glyph [MangleName 'lessAboveLeftArrow'] [MangleUnicode 0x2976] : StackedRelationArrow 'less' true false
		create-glyph [MangleName 'greaterAboveRightArrow'] [MangleUnicode 0x2978] : StackedRelationArrow 'greater' true true
		create-glyph [MangleName 'subsetAboveRightArrow'] [MangleUnicode 0x2979] : StackedRelationArrow 'subst' true true
		create-glyph [MangleName 'supersetAboveLeftArrow'] [MangleUnicode 0x297B] : StackedRelationArrow 'supst' true false
		define [SupsetThrough top bot l r s] : glyph-proc
			include : dispiro
				widths.center s
				flat l top [heading Rightward]
				curl [mix l r 0.6] top
				archv
				g4 r SymbolMid
				arcvh
				flat [mix l r 0.6] bot
				curl l bot [heading Leftward]

		define [ThroughRelationRight kind] : glyph-proc
			local extra : if para.isQuasiProportional (head * 0.8) 0
			local tipL : right - head * 1.15 - sw * 0.8
			local sh : Math.max (sw * 2) ((tipL - left) * 0.32)
			local rsw : Math.min sw ((tipL - left) * 0.16)
			set-width : width + extra
			include : with-transform [ApparentTranslate (extra / 2) 0] : union
				a.shape left SymbolMid right SymbolMid (head * 0.9) (sw / 2)
				if (kind == 'greater')
					GreaterShape (SymbolMid + sh) (SymbolMid - sh) left tipL rsw
					SupsetThrough (SymbolMid + sh) (SymbolMid - sh) left tipL rsw
		create-glyph [MangleName 'rightArrowThroughGreater'] [MangleUnicode 0x2B43] : ThroughRelationRight 'greater'
		create-glyph [MangleName 'rightArrowThroughSuperset'] [MangleUnicode 0x2B44] : ThroughRelationRight 'supst'
		define [ThroughRelationLeft kind] : glyph-proc
			local extra : if para.isQuasiProportional (head * 0.8) 0
			local tipR : left + head * 1.15 + sw * 0.8
			local sh : Math.max (sw * 2) ((right - tipR) * 0.32)
			local rsw : Math.min sw ((right - tipR) * 0.16)
			set-width : width + extra
			include : with-transform [ApparentTranslate (extra / 2) 0] : union
				a.shape right SymbolMid left SymbolMid (head * 0.9) (sw / 2)
				if (kind == 'greater')
					LessShape (SymbolMid + sh) (SymbolMid - sh) tipR right rsw
					with-transform [FlipAround middle SymbolMid] : SupsetThrough (SymbolMid + sh) (SymbolMid - sh) left (right - (tipR - left)) rsw
		create-glyph [MangleName 'leftArrowThroughLess'] [MangleUnicode 0x2977] : ThroughRelationLeft 'greater'
		create-glyph [MangleName 'leftArrowThroughSubset'] [MangleUnicode 0x297A] : ThroughRelationLeft 'supst'

		define [TailRelationWave wl wr y amp dsw] : glyph-proc
			local h : dsw / 2
			# Split the parallel cubic edges at their extrema for hinting.
			local t : (3 - [Math.sqrt 3]) / 6
			local x1 : mix wl wr t
			local x2 : mix wl wr (1 - t)
			local peak : amp * 2.7 / (2 * [Math.sqrt 3])
			local endControl : amp * 2.7 * t
			local cs : new BezToContoursSink currentGlyph.gizmo
			cs.moveTo wl (y + h)
			cs.cubicTo [mix wl x1 (1 / 3)] (y + h + endControl) [mix wl x1 (2 / 3)] (y + h + peak) x1 (y + h + peak)
			cs.cubicTo [mix x1 x2 (1 / 3)] (y + h + peak) [mix x1 x2 (2 / 3)] (y + h - peak) x2 (y + h - peak)
			cs.cubicTo [mix x2 wr (1 / 3)] (y + h - peak) [mix x2 wr (2 / 3)] (y + h - endControl) wr (y + h)
			cs.lineTo wr (y - h)
			cs.cubicTo [mix x2 wr (2 / 3)] (y - h - endControl) [mix x2 wr (1 / 3)] (y - h - peak) x2 (y - h - peak)
			cs.cubicTo [mix x1 x2 (2 / 3)] (y - h - peak) [mix x1 x2 (1 / 3)] (y - h + peak) x1 (y - h + peak)
			cs.cubicTo [mix wl x1 (2 / 3)] (y - h + peak) [mix wl x1 (1 / 3)] (y - h + endControl) wl (y - h)
			cs.endShape
			currentGlyph.includeContours cs.contours
		define [TailDecoration kind above leftward] : glyph-proc
			local Ls : (right - left) * 0.55
			local xa : if leftward (right - Ls) left
			local xb : xa + Ls
			local xm : mix xa xb 0.5
			local dsw : Math.min sw (Ls * 0.15)
			local amp : Ls * 0.15
			local gap : Math.max (sw * 0.6 + dsw * 3.5 + amp * 0.6) (d.compactHeadSize * 1.5)
			local ya : SymbolMid + [if above (-0.5) 0.5] * gap
			local yd : SymbolMid + [if above 0.5 (-0.5)] * gap
			local flipX : if (kind == 'revWave' || kind == 'revApprox') (-1) 1
			local arrowHead : if (kind == 'approx' || kind == 'revApprox') (head + sw * 0.5) head
			set-width width
			if leftward
			: then : include : a.shape right ya left ya arrowHead (sw / 2)
			: else : include : a.shape left ya right ya arrowHead (sw / 2)
			if (kind == 'equal') : include : HBar.m xa xb (yd + dsw) dsw
			if (kind == 'equal') : include : HBar.m xa xb (yd - dsw) dsw
			if (kind == 'wave' || kind == 'revWave') : include : with-transform [ScaleAround xm yd flipX 1] : TailRelationWave xa xb yd amp dsw
			if (kind == 'approx' || kind == 'revApprox') : include : with-transform [ScaleAround xm yd flipX 1] : TailRelationWave xa xb (yd + dsw * 1.6) (amp * 0.6) dsw
			if (kind == 'approx' || kind == 'revApprox') : include : with-transform [ScaleAround xm yd flipX 1] : TailRelationWave xa xb (yd - dsw * 1.6) (amp * 0.6) dsw
		create-glyph [MangleName 'equalAboveLeftArrowTail'] [MangleUnicode 0x2B40] : TailDecoration 'equal' true true
		create-glyph [MangleName 'reverseTildeAboveLeftArrowTail'] [MangleUnicode 0x2B41] : TailDecoration 'revWave' true true
		create-glyph [MangleName 'leftArrowAboveReverseApproxTail'] [MangleUnicode 0x2B42] : TailDecoration 'revApprox' false true
		create-glyph [MangleName 'reverseTildeAboveRightArrowTail'] [MangleUnicode 0x2B47] : TailDecoration 'revWave' true false
		create-glyph [MangleName 'rightArrowAboveReverseApproxTail'] [MangleUnicode 0x2B48] : TailDecoration 'revApprox' false false
		create-glyph [MangleName 'tildeAboveLeftArrowTail'] [MangleUnicode 0x2B49] : TailDecoration 'wave' true true
		create-glyph [MangleName 'leftArrowAboveApproxTail'] [MangleUnicode 0x2B4A] : TailDecoration 'approx' false true
		create-glyph [MangleName 'leftArrowAboveReverseTildeTail'] [MangleUnicode 0x2B4B] : TailDecoration 'revWave' false true
		create-glyph [MangleName 'rightArrowAboveReverseTildeTail'] [MangleUnicode 0x2B4C] : TailDecoration 'revWave' false false
		create-glyph [MangleName 'equalAboveRightArrow'] [MangleUnicode 0x2971] : TailDecoration 'equal' true false
		create-glyph [MangleName 'tildeAboveRightArrow'] [MangleUnicode 0x2972] : TailDecoration 'wave' true false
		create-glyph [MangleName 'leftArrowAboveTilde'] [MangleUnicode 0x2973] : TailDecoration 'wave' false true
		create-glyph [MangleName 'rightArrowAboveTilde'] [MangleUnicode 0x2974] : TailDecoration 'wave' false false
		create-glyph [MangleName 'rightArrowAboveApprox'] [MangleUnicode 0x2975] : TailDecoration 'approx' false false

	VCombine [MangleName 'uni2B80'] [MangleUnicode 0x2B80] [MangleName 'trigArrowLeft'] [MangleName 'trigArrowRight'] vcDist
	HCombine [MangleName 'uni2B81'] [MangleUnicode 0x2B81] [MangleName 'trigArrowUp'] [MangleName 'trigArrowDown'] hcDist
	VCombine [MangleName 'uni2B82'] [MangleUnicode 0x2B82] [MangleName 'trigArrowRight'] [MangleName 'trigArrowLeft'] vcDist
	HCombine [MangleName 'uni2B83'] [MangleUnicode 0x2B83] [MangleName 'trigArrowDown'] [MangleName 'trigArrowUp'] hcDist
	VCombine [MangleName 'uni2B84'] [MangleUnicode 0x2B84] [MangleName 'trigArrowLeft'] [MangleName 'trigArrowLeft'] vcDist
	HCombine [MangleName 'uni2B85'] [MangleUnicode 0x2B85] [MangleName 'trigArrowUp'] [MangleName 'trigArrowUp'] hcDist
	VCombine [MangleName 'uni2B86'] [MangleUnicode 0x2B86] [MangleName 'trigArrowRight'] [MangleName 'trigArrowRight'] vcDist
	HCombine [MangleName 'uni2B87'] [MangleUnicode 0x2B87] [MangleName 'trigArrowDown'] [MangleName 'trigArrowDown'] hcDist
	VCombine [MangleName 'uni2B7E'] [MangleUnicode 0x2B7E] [MangleName 'trigArrowBarLeft'] [MangleName 'trigArrowBarRight'] vcDist
	HCombine [MangleName 'uni2B7F'] [MangleUnicode 0x2B7F] [MangleName 'trigArrowBarDown'] [MangleName 'trigArrowBarUp'] hcDist

	define [VStackCentered newid unicode ids heights widths] : begin
		local bWidths  : if [Array.isArray widths]  widths  : [Array ids.length].fill widths
		local bHeights : if [Array.isArray heights] heights : [Array ids.length].fill heights

		local maxWidth : Math.max.apply null bWidths
		local totalHeight 0
		foreach [i : range 0 ids.length] : set totalHeight : totalHeight + bHeights.(i)

		local offsetY : totalHeight / 2
		create-glyph newid unicode : glyph-proc
			set-width maxWidth
			foreach [i : range 0 ids.length] : do
				include : with-transform
					ApparentTranslate ((maxWidth - bWidths.(i)) / 2) (offsetY - (bHeights.(i) / 2))
					refer-glyph ids.(i)
				set offsetY : offsetY - bHeights.(i)

	# Triple Stacked Arrows
	create-glyph [MangleName 'uni21F6'] [MangleUnicode 0x21F6] : glyph-proc
		set-width MosaicWidth
		local distance : compactHeadSize * 2 - arrowSw
		include : with-transform [ApparentTranslate 0 (+distance)] : refer-glyph : MangleName 'arrowRightCompact'
		include : refer-glyph : MangleName 'arrowRightCompact'
		include : with-transform [ApparentTranslate 0 (-distance)] : refer-glyph : MangleName 'arrowRightCompact'
	create-glyph [MangleName 'uni2B31'] [MangleUnicode 0x2B31] : glyph-proc
		set-width MosaicWidth
		local distance : compactHeadSize * 2 - arrowSw
		include : with-transform [ApparentTranslate 0 (+distance)] : refer-glyph : MangleName 'arrowLeftCompact'
		include : refer-glyph : MangleName 'arrowLeftCompact'
		include : with-transform [ApparentTranslate 0 (-distance)] : refer-glyph : MangleName 'arrowLeftCompact'

	# These arrows are always wide. In force-monospace variants they will be deleted
	if (MosaicWidthScalar > 1 && !para.forceMonospace) : do
		VCombine 'uni1F8D0' 0x1F8D0 'longArrowRight' 'longArrowLeft' vcDist
		VCombine 'uni1F8D1' 0x1F8D1 'longArrowRightHL' 'longArrowLeftHL' vcDist
		VStackCentered 'uni1F8D2' 0x1F8D2 { 'longArrowRightHL' 'arrowLeftHL.NWID' } vcDist { MosaicWidth MosaicUnitWidth }
		VStackCentered 'uni1F8D3' 0x1F8D3 { 'arrowRightHL.NWID' 'longArrowLeftHL' } vcDist { MosaicUnitWidth MosaicWidth }
		VStackCentered 'uni1F8D4' 0x1F8D4 { 'longArrowLeftHR' 'arrowRightHR.NWID' } vcDist { MosaicWidth MosaicUnitWidth }
		VStackCentered 'uni1F8D5' 0x1F8D5 { 'arrowLeftHR.NWID' 'longArrowRightHR' } vcDist { MosaicUnitWidth MosaicWidth }
