$$include '../../meta/macros.ptl'

import [mix] from "@iosevka/util"

glyph-module

glyph-block Symbol-Arrow-Misc-Symbols : for-width-kinds WideWidth1
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Symbol-Arrow-Shared : ArrowDims ArrowT

	define width : MathOperatorWidth MosaicWidth FMosaicWide
	define d : ArrowDims width
	define a : ArrowT d
	define mx : width / 2
	define cy SymbolMid
	define sw d.arrowSw
	define head d.compactHeadSize
	define r : d.arrowWidth * 0.46

	define [ShortSlanted down] : glyph-proc
		set-width width
		local h : d.arrowHeight * 0.23
		local dx : d.arrowWidth * 0.09
		include : a.shape (mx - dx) (cy + [if down h (-h)]) (mx + dx) (cy + [if down (-h) h]) (head * 0.7)
	create-glyph [MangleName 'shortSlantedNorthArrow'] [MangleUnicode 0x2B4E] : ShortSlanted false
	create-glyph [MangleName 'shortBackslantedSouthArrow'] [MangleUnicode 0x2B4F] : ShortSlanted true

	define [HorizontalTail down] : glyph-proc
		set-width width
		local h : d.arrowHeight * 0.34
		local dx : d.arrowWidth * 0.13
		local y0 : cy + [if down h (-h)]
		local y1 : cy + [if down (-h) h]
		include : union
			a.Head.shape (mx - dx) y0 (mx + dx) y1 (head * 0.8)
			a.Bar.shape (mx - dx) y0 (mx + dx) y1 (sw / 2) 0 0
			HBar.m (mx - dx - head * 0.8) (mx - dx + sw / 2) y0 sw
	create-glyph [MangleName 'slantedNorthArrowHorizontalTail'] [MangleUnicode 0x2B5C] : HorizontalTail false
	create-glyph [MangleName 'backslantedSouthArrowHorizontalTail'] [MangleUnicode 0x2B5D] : HorizontalTail true

	define [HookedSlanted tailHook] : glyph-proc
		set-width width
		local top : cy + d.arrowHeight * 0.36
		local bot : cy - d.arrowHeight * 0.36
		local left : mx - d.arrowWidth * 0.19
		local right : mx + d.arrowWidth * 0.19
		local mid : (left + right) / 2
		local hookBottom : top - head * 0.8
		if tailHook
		: then : include : union
			dispiro
				widths.center sw
				flat left hookBottom [heading Upward]
				arcvh
				g4 mid top
				archv
				curl right hookBottom [heading Downward]
			a.Bar.shape right hookBottom (right + d.arrowWidth * 0.12) bot (sw / 2) 0 0
			a.Head.shape right hookBottom (right + d.arrowWidth * 0.12) bot (head * 0.7)
		: else : include : union
			a.Bar.shape (left - d.arrowWidth * 0.12) bot left hookBottom (sw / 2) 0 0
			dispiro
				widths.center sw
				flat left hookBottom [heading Upward]
				arcvh
				g4 mid top
				archv
				curl right hookBottom [heading Downward]
			a.Head.shape right top right hookBottom (head * 0.7)
	create-glyph [MangleName 'slantedNorthArrowHookedHead'] [MangleUnicode 0x2B5A] : HookedSlanted false
	create-glyph [MangleName 'backslantedSouthArrowHookedTail'] [MangleUnicode 0x2B5B] : HookedSlanted true

	define [BentNortheast short] : glyph-proc
		set-width width
		local h : d.arrowHeight * [if short 0.22 0.36]
		local x0 : mx - d.arrowWidth * 0.18
		local y0 : cy - h
		local x1 : mx + d.arrowWidth * 0.4
		local y1 : y0 + d.arrowHeight * 0.13
		local lineSw : Math.min sw (d.arrowWidth * 0.09)
		local bentHead : Math.min (head * 0.65) ((x1 - x0) * 0.43)
		include : union
			a.Bar.shape (x0 + d.arrowWidth * 0.16) (cy + h) x0 y0 (lineSw / 2) 0 0
			a.Bar.shape x0 y0 x1 y1 (lineSw / 2) 0 0
			a.Head.shape x0 y0 x1 y1 bentHead
	create-glyph [MangleName 'bentArrowDownThenNortheast'] [MangleUnicode 0x2B5E] : BentNortheast false
	create-glyph [MangleName 'shortBentArrowDownThenNortheast'] [MangleUnicode 0x2B5F] : BentNortheast true

	define [DiagonalToBar right up] : glyph-proc
		set-width width
		local x0 : if right d.arrowDiagSB d.arrowDiagRSB
		local x1 : if right d.arrowDiagRSB d.arrowDiagSB
		local y0 : if up d.arrowDiagBot d.arrowDiagTop
		local y1 : if up d.arrowDiagTop d.arrowDiagBot
		local gap : Math.max (sw * 1.5) (d.arrowHeight * 0.07)
		local barY : y1 + [if up gap (-gap)]
		include : a.trigShape x0 y0 x1 y1 head
		include : HBar.m (x1 - head * 0.85) (x1 + head * 0.85) barY sw
	create-glyph [MangleName 'trigArrowNorthwestToHorizontalBar'] [MangleUnicode 0x2B76] : DiagonalToBar false true
	create-glyph [MangleName 'trigArrowNortheastToHorizontalBar'] [MangleUnicode 0x2B77] : DiagonalToBar true true
	create-glyph [MangleName 'trigArrowSoutheastToHorizontalBar'] [MangleUnicode 0x2B78] : DiagonalToBar true false
	create-glyph [MangleName 'trigArrowSouthwestToHorizontalBar'] [MangleUnicode 0x2B79] : DiagonalToBar false false

	define [DoubleRing oval] : glyph-proc
		set-width width
		local outerSw : Math.min (r * 0.18) (GeometryStroke * 1.2 + r * 0.035)
		local innerSw : Math.min (r * 0.12) (GeometryStroke * 0.8 + r * 0.02)
		include : with-transform [ScaleAround mx cy 1 [if oval 0.68 1]] : glyph-proc
			include : RingStrokeAt mx cy (r - outerSw / 2) outerSw
			include : RingStrokeAt mx cy (r * 0.61) innerSw
	create-glyph [MangleName 'heavyOvalWithOvalInside'] [MangleUnicode 0x2B56] : DoubleRing true
	create-glyph [MangleName 'heavyCircleWithCircleInside'] [MangleUnicode 0x2B57] : DoubleRing false

	define [RotateAt angle shape] : with-transform [Translate mx cy] : with-transform [Rotate angle] : with-transform [Translate (-mx) (-cy)] shape
	define [CircleArrowRight] : difference
		Circle.Outline.At mx cy r
		spiro-outline
			corner (mx - r * 1.1) (cy + r * 0.24)
			corner (mx + r * 0.12) (cy + r * 0.24)
			corner (mx + r * 0.12) (cy + r * 0.55)
			corner (mx + r * 0.9) cy
			corner (mx + r * 0.12) (cy - r * 0.55)
			corner (mx + r * 0.12) (cy - r * 0.24)
			corner (mx - r * 1.1) (cy - r * 0.24)
	define [CircledWhiteArrow angle] : glyph-proc
		set-width width
		include : RotateAt angle : CircleArrowRight
	create-glyph [MangleName 'blackCircledWhiteArrowLeft'] [MangleUnicode 0x2B88] : CircledWhiteArrow Math.PI
	create-glyph [MangleName 'blackCircledWhiteArrowUp'] [MangleUnicode 0x2B89] : CircledWhiteArrow (Math.PI / 2)
	create-glyph [MangleName 'blackCircledWhiteArrowRight'] [MangleUnicode 0x2B8A] : CircledWhiteArrow 0
	create-glyph [MangleName 'blackCircledWhiteArrowDown'] [MangleUnicode 0x2B8B] : CircledWhiteArrow (-Math.PI / 2)

	define [ArrowheadRight threeD] : glyph-proc
		local xTip : mx + r
		local xBack : mx - r
		local xNotch : mx - r * 0.3
		local yEdge : r * 0.87
		local k : Math.min 0.6 : Math.max 0.12 ((GeometryStroke + r * 0.025) / (r * 0.45))
		local cx : (xTip + xBack + xNotch) / 3
		local yc : cy + yEdge / 3
		local outer : spiro-outline
			corner xTip cy
			corner xBack (cy + yEdge)
			corner xNotch cy
			corner xBack (cy - yEdge)
		local inner : spiro-outline
			corner [mix xTip cx k] [mix cy yc k]
			corner [mix xBack cx k] [mix (cy + yEdge) yc k]
			corner [mix xNotch cx k] [mix cy yc k]
		if threeD
		: then : include : difference outer inner
		: else : include outer
	define [EquilateralArrowhead angle mirror threeD] : glyph-proc
		set-width width
		include : with-transform [ScaleAround mx cy [if mirror (-1) 1] 1] : RotateAt angle : ArrowheadRight threeD
	create-glyph [MangleName 'threeDLeftEquilateralArrowhead'] [MangleUnicode 0x2B98] : EquilateralArrowhead 0 true true
	create-glyph [MangleName 'threeDUpEquilateralArrowhead'] [MangleUnicode 0x2B99] : EquilateralArrowhead (Math.PI / 2) true true
	create-glyph [MangleName 'threeDRightEquilateralArrowhead'] [MangleUnicode 0x2B9A] : EquilateralArrowhead 0 false true
	create-glyph [MangleName 'threeDDownEquilateralArrowhead'] [MangleUnicode 0x2B9B] : EquilateralArrowhead (-Math.PI / 2) true true
	create-glyph [MangleName 'blackLeftEquilateralArrowhead'] [MangleUnicode 0x2B9C] : EquilateralArrowhead 0 true false
	create-glyph [MangleName 'blackUpEquilateralArrowhead'] [MangleUnicode 0x2B9D] : EquilateralArrowhead (Math.PI / 2) true false
	create-glyph [MangleName 'blackRightEquilateralArrowhead'] [MangleUnicode 0x2B9E] : EquilateralArrowhead 0 false false
	create-glyph [MangleName 'blackDownEquilateralArrowhead'] [MangleUnicode 0x2B9F] : EquilateralArrowhead (-Math.PI / 2) true false
