### Punctuation symbols
$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback Waveform] from "@iosevka/util"

glyph-module

glyph-block Symbol-Punctuation-Percentages : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Above : RingDims

	define NarrowUnicode : NarrowUnicodeT WideWidth1
	define WideUnicode   : WideUnicodeT   WideWidth1

	define [PercentBarCor df sw] : begin
		local a : Waveform.sawtooth : (df.rightSB - df.leftSB - sw) / (CAP - 0)
		return : 1 / [Math.sqrt : 1 - a * a]

	define [PercentBarShape df sw] : begin
		local cor : PercentBarCor df sw
		return : spiro-outline
			corner df.leftSB 0
			corner (df.rightSB - [HSwToV : cor * sw]) CAP
			corner  df.rightSB                        CAP
			corner (df.leftSB  + [HSwToV : cor * sw]) 0

	create-glyph 'percent.dots' : glyph-proc
		include : PercentBarShape [DivFrame 1] Stroke
		local dotwidth : [AdviceStroke 4] * 1.5
		include : VBar.l SB [mix CAP 0 0.3] CAP dotwidth
		include : VBar.r RightSB 0 [mix 0 CAP 0.3] dotwidth

	WithDotVariants "commercialMinusSign" 0x2052 : function [DrawAt kdr overshoot] : glyph-proc
		include : PercentBarShape [DivFrame 1] [AdviceStroke 4]
		local r : PeriodRadius * kdr
		include : DrawAt (SB      + r) (CAP - r) (r - overshoot)
		include : DrawAt (RightSB - r) (0   + r) (r - overshoot)

	create-glyph 'permille.NWID.dots' : glyph-proc
		define df : include : DivFrame para.advanceScaleM
		define slopeDf : DivFrame 1

		define refSw : df.adviceStroke 4

		include : PercentBarShape slopeDf refSw
		local dotwidth : refSw * 1.5
		include : VBar.l SB [mix CAP 0 0.3] CAP dotwidth

		local cor : PercentBarCor slopeDf refSw
		local gap : [mix 0 df.rightSB 0.9] - [HSwToV : cor * refSw]
		local lowerDotWidth : 1.5 * [AdviceStroke 3 (gap / Width)]
		include : VBar.r (df.rightSB - gap * 0.45) 0 [mix 0 CAP 0.3] lowerDotWidth
		include : VBar.r  df.rightSB               0 [mix 0 CAP 0.3] lowerDotWidth

	create-glyph 'basepoint.NWID.dots' : glyph-proc
		define df : include : DivFrame para.advanceScaleM
		define slopeDf : DivFrame (0.75 * para.advanceScaleM)

		define refSw : df.adviceStroke 5

		include : PercentBarShape slopeDf refSw
		local dotwidth : refSw * 1.5
		include : VBar.l SB [mix CAP 0 0.3] CAP dotwidth

		local cor : PercentBarCor slopeDf refSw
		local gap : [mix 0 df.rightSB 0.9] - [HSwToV : cor * refSw]
		local lowerDotWidth : 1.5 * [AdviceStroke 4 (gap / Width)]
		include : VBar.r (df.rightSB - gap * 0.6) 0 [mix 0 CAP 0.3] lowerDotWidth
		include : VBar.r (df.rightSB - gap * 0.3) 0 [mix 0 CAP 0.3] lowerDotWidth
		include : VBar.r  df.rightSB              0 [mix 0 CAP 0.3] lowerDotWidth

	create-glyph 'percent.ringsContinuousSlash' : glyph-proc
		set-width Width
		local l   : SB / 2
		local r   : Width - l
		local m   : mix l r 0.5
		local ada  : ArchDepthA * 0.5
		local adb  : ArchDepthB * 0.5
		local swRing : AdviceStroke 3.75
		local swBar  : AdviceStroke 3.75
		local fineBar : AdviceStroke 4.5
		local halfGapRing : [AdviceStroke 6] / 2
		local cor : DiagCorDs CAP (r - l) swBar

		include : OShape CAP (CAP / 2 + halfGapRing) l (m - halfGapRing) swRing ada adb
		include : OShape (CAP / 2 - halfGapRing)  0  (m + halfGapRing) r swRing ada adb
		include : dispiro
			corner r CAP [widths.rhs.heading (swBar * cor) Downward]
			corner [mix r l 0.5] [mix CAP 0 0.5] [widths.center.heading (fineBar * cor) Downward]
			corner l 0 [widths.lhs.heading (swBar * cor) Downward]

		local perMilleOffset : Width + l - halfGapRing * 1.5 - m

		define [ConnnectedBar] : difference
			HBar.t [Arch.adjust-x.top [mix l (m - halfGapRing) 0.5] swRing] (r - [HSwToV swBar]) CAP fineBar
			OShapeOutline.NoOvershoot CAP (CAP / 2 + halfGapRing) l (m - halfGapRing) swRing ada adb

		define [PerMilleProc] : glyph-proc
			set-width WideWidth0
			include : OShape (CAP / 2 - halfGapRing) 0 (m + halfGapRing + perMilleOffset) (r + perMilleOffset) swRing ada adb
			include : Translate ((WideWidth0 - r - perMilleOffset) / 2) 0

		define [BasePointProc] : glyph-proc
			set-width WideWidth0
			include : OShape (CAP / 2 - halfGapRing) 0 (m + halfGapRing + perMilleOffset) (r + perMilleOffset) swRing ada adb
			include : OShape (CAP / 2 - halfGapRing) 0 (m + halfGapRing + 2 * perMilleOffset) (r + 2 * perMilleOffset) swRing ada adb
			include : Translate ((WideWidth0 - r - 2 * perMilleOffset) / 2) 0

		create-forked-glyph 'percent.ringsContinuousSlashAlsoConnected' : ConnnectedBar
		if para.isQuasiProportional : begin
			create-forked-glyph 'permille.WWID.ringsContinuousSlash' : PerMilleProc
			create-forked-glyph 'basepoint.WWID.ringsContinuousSlash' : BasePointProc
			create-forked-glyph 'permille.WWID.ringsContinuousSlashAlsoConnected' : composite-proc [ConnnectedBar] [PerMilleProc]
			create-forked-glyph 'basepoint.WWID.ringsContinuousSlashAlsoConnected' : composite-proc [ConnnectedBar] [BasePointProc]

	create-glyph 'percent.ringsSegmentedSlash' : glyph-proc
		set-width Width
		local l   : SB / 2
		local r   : Width - l
		local m   : mix l r 0.5
		local ada  : ArchDepthA * 0.5
		local adb  : ArchDepthB * 0.5
		local swRing : AdviceStroke 3.5
		local swBar : AdviceStroke 3
		local fine : AdviceStroke 4
		local cor : DiagCorDs CAP (r - l) swBar
		local pFine : 0.5 - [Math.max (CAP / 10) HalfStroke] / [Math.hypot CAP (r - l)]

		include : OShape CAP (CAP / 2) l m swRing ada adb
		include : OShape (CAP / 2)  0  m r swRing ada adb
		include : dispiro
			widths.rhs (swBar * cor)
			flat r CAP [heading Downward]
			curl [mix r l pFine] [mix CAP 0 pFine] [widths.heading (fine * cor) 0 Downward]

		include : dispiro
			widths.rhs (swBar * cor)
			flat l 0 [heading Upward]
			curl [mix l r pFine] [mix 0 CAP pFine] [widths.heading (fine * cor) 0 Upward]

	# Compact 1-em (or M-width) rings permille / permyriad: top ring, squeezed slash,
	# and a slightly smaller lower-ring cluster so the extras do not collide.
	define [RingsCompactSlashForm width nLower fConnected] : glyph-proc
		set-width width
		local adws : width / Width
		local l : SB / 2
		local r : width - l
		local m : mix l r 0.5
		local sw : AdviceStroke2 4 5 CAP adws
		local fine : AdviceStroke2 5 5 CAP adws
		local ada : ArchDepthA * 0.5 * adws
		local adb : ArchDepthB * 0.5 * adws

		local otop : CAP / 2 - [Math.max (CAP / 10) fine]
		local coOtop : CAP - otop

		include : OShape CAP coOtop l m sw ada adb

		local xSlashL : mix l r 0.06
		local xSlashR : mix r l 0.06
		local ySlashL : mix otop coOtop 0.18
		local ySlashR : mix otop coOtop 0.88
		if fConnected : set ySlashR CAP
		include : dispiro
			flat xSlashL ySlashL [widths.center fine]
			curl xSlashR ySlashR [widths.center sw]

		if fConnected : include : difference
			HBar.t [Arch.adjust-x.top [mix l m 0.5] sw] (xSlashR - [HSwToV sw]) CAP fine
			OShapeOutline.NoOvershoot CAP coOtop l m sw ada adb

		local inset : Math.max OX (0.035 * (r - l))
		local left : l + inset
		local right : r - inset
		local avail : right - left
		local crwX : if (nLower > 2) 6 4
		local swp0 : AdviceStroke2 crwX 5 CAP adws
		local minGap : Math.max (0.70 * swp0) (0.11 * avail / nLower)
		local ringW : 0.90 * (avail - (nLower - 1) * minGap) / nLower
		local used : nLower * ringW + (nLower - 1) * minGap
		local x0 : left + (avail - used) / 2
		local ringH : 0.94 * otop
		local yBot : 0.22 * (otop - ringH)
		local yTop : yBot + ringH
		local swp : Math.min swp0 : Math.min (0.28 * ringW) (0.28 * ringH)
		local adaP : Math.min (0.48 * ringW) (0.48 * ringH)
		local adbP : Math.min (0.48 * ringW) (0.48 * ringH)
		foreach i [range 0 nLower] : begin
			local xL : x0 + i * (ringW + minGap)
			include : OShape yTop yBot xL (xL + ringW) swp adaP adbP

	create-glyph 'permille.NWID.ringsContinuousSlash' : glyph-proc
		include : RingsCompactSlashForm (Width * para.advanceScaleM) 2 false
	create-glyph 'basepoint.NWID.ringsContinuousSlash' : glyph-proc
		include : RingsCompactSlashForm (Width * para.advanceScaleM) 3 false

	if [not para.isQuasiProportional] : begin
		create-glyph 'permille.WWID.ringsContinuousSlash' : glyph-proc
			include : RingsCompactSlashForm Width 2 false
		create-glyph 'basepoint.WWID.ringsContinuousSlash' : glyph-proc
			include : RingsCompactSlashForm Width 3 false
		create-glyph 'permille.WWID.ringsContinuousSlashAlsoConnected' : glyph-proc
			include : RingsCompactSlashForm Width 2 true
		create-glyph 'basepoint.WWID.ringsContinuousSlashAlsoConnected' : glyph-proc
			include : RingsCompactSlashForm Width 3 true

	define [PercentCircle cx cy radius] : glyph-proc
		local [object radiusIn radiusOut] : RingDims radius
		include : difference
			DotAt cx cy radiusOut
			DotAt cx cy : Math.max radiusIn (radiusOut * 0.4)

	# Inscribed in the same half-width / half-height cell as rings-segmented-slash.
	define [PercentCircleDiam cell] : Math.min (cell / 2) (CAP / 2)
	# Previous percent circle size, kept for permille and per-ten-thousand.
	define [SmallPercentCircleDiam cell] : Math.min (cell * 0.46) (CAP * 0.40)

	define [CircleZeros l r radius extra] : glyph-proc
		include : PercentCircle (l + radius) (CAP - radius) radius
		include : PercentCircle (r - radius) radius radius
		local step : 2 * radius + [Math.max (SB / 2) (radius * 0.35)]
		foreach i [range 1 (extra + 1)] : begin
			include : PercentCircle (r - radius + i * step) radius radius

	define [CircleSlashContinuous l r] : glyph-proc
		local swBar : AdviceStroke 3.75
		local fineBar : AdviceStroke 4.5
		local cor : DiagCorDs CAP (r - l) swBar
		include : dispiro
			corner r CAP [widths.rhs.heading (swBar * cor) Downward]
			corner [mix r l 0.5] [mix CAP 0 0.5] [widths.center.heading (fineBar * cor) Downward]
			corner l 0 [widths.lhs.heading (swBar * cor) Downward]

	define [CircleSlashSegmented l r] : glyph-proc
		local swBar : AdviceStroke 3
		local fine : AdviceStroke 4
		local cor : DiagCorDs CAP (r - l) swBar
		local pFine : 0.5 - [Math.max (CAP / 10) HalfStroke] / [Math.hypot CAP (r - l)]
		include : dispiro
			widths.rhs (swBar * cor)
			flat r CAP [heading Downward]
			curl [mix r l pFine] [mix CAP 0 pFine] [widths.heading (fine * cor) 0 Downward]
		include : dispiro
			widths.rhs (swBar * cor)
			flat l 0 [heading Upward]
			curl [mix l r pFine] [mix 0 CAP pFine] [widths.heading (fine * cor) 0 Upward]

	define [CircleAlsoConnectedBar l r radius] : begin
		local swBar : AdviceStroke 3.75
		local fineBar : AdviceStroke 4.5
		return : difference
			HBar.t [Arch.adjust-x.top (l + radius) fineBar] (r - [HSwToV swBar]) CAP fineBar
			DotAt (l + radius) (CAP - radius) radius

	define [CircleClusterPair x1 y1 x2 y2 radius] : glyph-proc
		local [object radiusIn radiusOut] : RingDims radius
		local hole : Math.max radiusIn (radiusOut * 0.4)
		include : difference
			union [DotAt x1 y1 radiusOut] [DotAt x2 y2 radiusOut]
			union [DotAt x1 y1 hole] [DotAt x2 y2 hole]

	define [CircleClusterTriple x1 y1 x2 y2 x3 y3 radius] : glyph-proc
		local [object radiusIn radiusOut] : RingDims radius
		local hole : Math.max radiusIn (radiusOut * 0.4)
		include : difference
			union [union [DotAt x1 y1 radiusOut] [DotAt x2 y2 radiusOut]] [DotAt x3 y3 radiusOut]
			union [union [DotAt x1 y1 hole] [DotAt x2 y2 hole]] [DotAt x3 y3 hole]

	define [CircleSlashContinuousSteep xBot xTop] : glyph-proc
		local swBar : AdviceStroke 3.75
		local dx : Math.max TINY (xTop - xBot)
		local cor : DiagCorDs CAP dx swBar
		include : dispiro
			corner xTop CAP [widths.center.heading (swBar * cor) Downward]
			corner xBot 0 [widths.center.heading (swBar * cor) Downward]

	define [CircleSlashContinuousEnds xBot xTop] : glyph-proc
		local swBar : AdviceStroke 3.75
		local fineBar : AdviceStroke 4.5
		local cor : DiagCorDs CAP (xTop - xBot) swBar
		include : dispiro
			corner xTop CAP [widths.rhs.heading (swBar * cor) Downward]
			corner [mix xTop xBot 0.5] [mix CAP 0 0.5] [widths.center.heading (fineBar * cor) Downward]
			corner xBot 0 [widths.lhs.heading (swBar * cor) Downward]

	define [CircleSlashSegmentedShifted l r xShift] : glyph-proc
		local swBar : AdviceStroke 3
		local fine : AdviceStroke 4
		local cor : DiagCorDs CAP (r - l) swBar
		local pFine : 0.5 - [Math.max (CAP / 10) HalfStroke] / [Math.hypot CAP (r - l)]
		include : dispiro
			widths.rhs (swBar * cor)
			flat r CAP [heading Downward]
			curl [mix r l pFine] [mix CAP 0 pFine] [widths.heading (fine * cor) 0 Downward]
		include : dispiro
			widths.rhs (swBar * cor)
			flat (l + xShift) 0 [heading Upward]
			curl ([mix l r pFine] + xShift) [mix 0 CAP pFine] [widths.heading (fine * cor) 0 Upward]

	define [CirclePercentGlyph extra fSegmented fConnected] : glyph-proc
		local l : SB / 2
		local r : Width - l
		local diamFn : if extra SmallPercentCircleDiam PercentCircleDiam
		local radius : [diamFn (r - l)] / 2
		local step : 2 * radius + [Math.max (SB / 2) (radius * 0.35)]
		include : CircleZeros l r radius extra
		include : if fSegmented [CircleSlashSegmented l r] [CircleSlashContinuous l r]
		if fConnected : include : CircleAlsoConnectedBar l r radius
		if extra : begin
			set-width WideWidth0
			include : Translate ((WideWidth0 - r - extra * step) / 2) 0

	define [CirclePermilleGlyph extra fSegmented fConnected fNarrow] : glyph-proc
		local fMyriad : extra > 1
		local fHori para.isQuasiProportional
		local mW : Width * para.advanceScaleM
		local dblW : 2 * Width
		local destNarrow mW
		if fMyriad : set destNarrow dblW
		local destWide WideWidth0
		if fMyriad : set destWide : Math.max WideWidth0 dblW
		local destW destWide
		if fNarrow : set destW destNarrow

		local l : SB / 2
		local rW : Width - l
		local largeR : [PercentCircleDiam (Width - SB)] / 2
		local sR largeR
		local dist : 1.16 * sR
		local slashGap : Math.max [HSwToV : 1.15 * [AdviceStroke 3.75]] (0.08 * (Width - SB))

		local cx0 : rW - sR
		local cy0 sR
		local xLow : cx0 - 0.50 * dist
		local yLow cy0
		local xUp cx0
		local yUp : cy0 + 0.87 * dist
		local xHook cx0
		local yHook cy0
		local xStem : cx0 + dist
		local yBot cy0
		local yTop : cy0 + dist
		local xHori0 cx0
		local xHori1 : cx0 + dist
		local xHori2 : cx0 + 2 * dist
		local yHori cy0

		local contentRight rW
		if fHori : set contentRight : rW + extra * dist
		if [not fHori] : begin
			if fMyriad : set contentRight : rW + dist
		local contentW : contentRight + l
		local kFit : destW / [Math.max TINY contentW]
		local k : Math.min 1 kFit

		local clusterLeft xLow
		if fHori : set clusterLeft : xHori0 - sR
		if [not fHori] : begin
			if fMyriad : set clusterLeft : xHook - sR
		local cl : l + k * (clusterLeft - l)

		local hypotLen : Math.hypot CAP (rW - l)
		local pFine : 0.5 - [Math.max (CAP / 10) HalfStroke] / hypotLen
		local stubEndX : mix l rW pFine
		local xShiftPref : cl - slashGap - stubEndX
		local xShiftMin : 0 - l
		local xShiftClamped : Math.min 0 xShiftPref
		local xShift : Math.max xShiftMin xShiftClamped

		set-width destW
		include : PercentCircle (l + largeR) (CAP - largeR) largeR
		include : with-transform [ScaleAround l 0 k k] : glyph-proc
			if fHori : begin
				if fMyriad : include : CircleClusterTriple xHori0 yHori xHori1 yHori xHori2 yHori sR
				if [not fMyriad] : include : CircleClusterPair xHori0 yHori xHori1 yHori sR
			if [not fHori] : begin
				if fMyriad : include : CircleClusterTriple xHook yHook xStem yBot xStem yTop sR
				if [not fMyriad] : include : CircleClusterPair xLow yLow xUp yUp sR
		include : if fSegmented [CircleSlashSegmentedShifted l rW xShift] [CircleSlashContinuous l rW]
		if fConnected : include : CircleAlsoConnectedBar l rW largeR
		include : Translate ((destW - k * contentW) / 2) 0

	create-glyph 'percent.circlesContinuousSlash' : glyph-proc
		include : CirclePercentGlyph 0 false false
	create-glyph 'percent.circlesContinuousSlashAlsoConnected' : glyph-proc
		include : CirclePercentGlyph 0 false true
	create-glyph 'percent.circlesSegmentedSlash' : glyph-proc
		include : CirclePercentGlyph 0 true false

	create-glyph 'permille.WWID.circlesContinuousSlash' : glyph-proc
		include : CirclePermilleGlyph 1 false false false
	create-glyph 'permille.WWID.circlesContinuousSlashAlsoConnected' : glyph-proc
		include : CirclePermilleGlyph 1 false true false
	create-glyph 'permille.WWID.circlesSegmentedSlash' : glyph-proc
		include : CirclePermilleGlyph 1 true false false
	create-glyph 'basepoint.WWID.circlesContinuousSlash' : glyph-proc
		include : CirclePermilleGlyph 2 false false false
	create-glyph 'basepoint.WWID.circlesContinuousSlashAlsoConnected' : glyph-proc
		include : CirclePermilleGlyph 2 false true false
	create-glyph 'basepoint.WWID.circlesSegmentedSlash' : glyph-proc
		include : CirclePermilleGlyph 2 true false false

	create-glyph 'permille.NWID.circlesContinuousSlash' : glyph-proc
		include : CirclePermilleGlyph 1 false false true
	create-glyph 'permille.NWID.circlesSegmentedSlash' : glyph-proc
		include : CirclePermilleGlyph 1 true false true
	create-glyph 'basepoint.NWID.circlesContinuousSlash' : glyph-proc
		include : CirclePermilleGlyph 2 false false true
	create-glyph 'basepoint.NWID.circlesSegmentedSlash' : glyph-proc
		include : CirclePermilleGlyph 2 true false true

	select-variant 'percent' '%'
	select-variant 'permille.NWID'  [NarrowUnicode 0x2030] (follow -- 'permille.NWID')
	select-variant 'permille.WWID'  [WideUnicode   0x2030] (follow -- 'permille.WWID')
	select-variant 'basepoint.NWID' [NarrowUnicode 0x2031] (follow -- 'permille.NWID')
	select-variant 'basepoint.WWID' [WideUnicode   0x2031] (follow -- 'permille.WWID')
