### Punctuation symbols
$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [Joining] from "@iosevka/glyph/relation"

glyph-module

glyph-block Symbol-Punctuation-Dashes : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Symbol-Math-Relation-Common : EqualHalfSpace

	define openBoxGap : Math.max (Stroke * 1.25) (XH / 4)

	do 'underscore'
		define [OpenBoxSide y] : union
			VBar.l SB      y (y + openBoxGap) OperatorStroke
			VBar.r RightSB y (y + openBoxGap) OperatorStroke
		define [OpenBoxShoulderSide y] : union
			OpenBoxSide y
			HBar.t [mix 0     SB      0.25] SB      (y + openBoxGap) OperatorStroke
			HBar.t [mix Width RightSB 0.25] RightSB (y + openBoxGap) OperatorStroke

		glyph-block-export UnderScoreConfig
		define UnderScoreConfig : object
			aboveBaseline { 0         }
			high          { (-Stroke) }
			low           { Descender }

		define joiningOverlap : (-Width) / 6

		foreach { suffix { yBar } } [Object.entries UnderScoreConfig] : do
			create-glyph "underscore.\(suffix)" : HBar.b SB RightSB yBar
			create-glyph "doubleUnderscore.\(suffix)" : composite-proc
				HBar.b SB RightSB  yBar
				HBar.b SB RightSB (yBar - openBoxGap)
			create-glyph "openBox.\(suffix)" : composite-proc
				HBar.b SB RightSB yBar
				OpenBoxSide (yBar + HalfStroke)
			create-glyph "openBoxShoulder.\(suffix)" : composite-proc
				HBar.b SB RightSB yBar
				OpenBoxShoulderSide (yBar + HalfStroke)

		select-variant 'underscore'       '_'
		select-variant 'openBox'          0x2423 (follow -- 'underscore')
		select-variant 'openBoxShoulder'  0x237D (follow -- 'underscore')
		select-variant 'doubleUnderscore' 0x2017 (follow -- 'underscore')

	create-glyph 'hyphen' '-' : glyph-proc
		local df : include : DivFrame para.advanceScaleF
		include : HBar.m df.leftSB df.rightSB SymbolMid

	define ObliqueHyphenAngle : 22 / 180 * Math.PI
	define ObliqueHyphenCos : 1 * [Math.cos ObliqueHyphenAngle]
	define ObliqueHyphenSin : 1 * [Math.sin ObliqueHyphenAngle]
	define [ObliqueHyphenDelta df] : begin
		local half : (df.rightSB - df.leftSB) / 2
		local dx : half * ObliqueHyphenCos
		local dy : half * ObliqueHyphenSin
		return {dx dy}
	define [ObliqueHyphenShape df yMid] : begin
		local {dx dy} : ObliqueHyphenDelta df
		return : dispiro
			widths.center
			corner (df.middle - dx) (yMid - dy)
			corner (df.middle + dx) (yMid + dy)
	define [DoubleObliqueHyphenShape df] : union
		ObliqueHyphenShape df (SymbolMid + EqualHalfSpace)
		ObliqueHyphenShape df (SymbolMid - EqualHalfSpace)

	create-glyph 'obliqueHyphen' 0x2E5D : glyph-proc
		local df : include : DivFrame para.advanceScaleF
		include : ObliqueHyphenShape df SymbolMid

	create-glyph 'doubleObliqueHyphen' 0x2E17 : glyph-proc
		local df : include : DivFrame para.advanceScaleF
		include : DoubleObliqueHyphenShape df

	WithDotVariants 'cornishVerseDivider' 0x2E4F : function [DrawAt kr ov] : glyph-proc
		local df : include : DivFrame para.advanceScaleF
		local {dx dy} : ObliqueHyphenDelta df
		local r : DotRadius * kr * OperatorStroke / Stroke
		local lift : HalfStroke + r * 2.3
		include : DoubleObliqueHyphenShape df
		include : DrawAt (df.middle - dx) (SymbolMid + EqualHalfSpace - dy + lift) (r - ov)
		include : DrawAt (df.middle + dx) (SymbolMid - EqualHalfSpace + dy - lift) (r - ov)

	create-glyph 'ancoraDownwards' 0x2E14 : glyph-proc
		local df : include : DivFrame para.advanceScaleF
		local sw : Math.min Stroke OperatorStroke
		local halfExtent : 0.5 * (df.rightSB - df.leftSB)
		local cupR : 0.7 * halfExtent
		local yBottom : SymbolMid - 1.05 * halfExtent
		local yTop : SymbolMid + 1.05 * halfExtent
		local yArm : yBottom + 0.5 * cupR
		include : new-glyph : glyph-proc
			include : dispiro
				widths.center sw
				flat df.middle yTop [heading Downward]
				curl df.middle yBottom [heading Downward]
			include : dispiro
				widths.center sw
				g4.down.start (df.middle - cupR) yArm [heading Downward]
				arcvh
				g4.right.mid df.middle yBottom [heading Rightward]
				archv
				g4.up.end (df.middle + cupR) yArm [heading Upward]
			include : Ungizmo
			include : Translate (-df.middle) (-SymbolMid)
			include : Rotate (-Math.PI / 4)
			include : Translate df.middle SymbolMid
			include : Regizmo

	turned 'ancoraUpwards' 0x2E15 'ancoraDownwards' [DivFrame para.advanceScaleF].middle SymbolMid
	create-glyph 'armn/hyphen' 0x58A : glyph-proc
		local df : include : DivFrame para.advanceScaleF
		include : dispiro
			widths.center
			g4 df.leftSB  SymbolMid [heading Rightward]
			g4 df.middle (SymbolMid + 2 * O)
			g4 df.rightSB SymbolMid [heading Rightward]

	alias 'softhyphen' 0xAD  'hyphen'
	alias 'gpHyphen' 0x2010 'hyphen'
	alias 'nbHyphen' 0x2011 'hyphen'
	alias 'hyphenBullet' 0x2043 'hyphen'

	create-glyph 'figureDash' 0x2012 : HBar.m SB RightSB SymbolMid
	create-glyph 'overline' 0x203E : HBar.t SB RightSB CAP

	create-glyph 'enDash' 0x2013 : glyph-proc
		set-width Width
		include : HBar.m [mix 0 SB 0.5] [mix Width RightSB 0.5] SymbolMid

	for-width-kinds WideWidth1
		define emDashWidth : if (para.isQuasiProportional && MosaicWidthScalar > 1) UPM MosaicWidth
		create-glyph [MangleName 'emDash'] [MangleUnicode 0x2014] : glyph-proc
			set-width emDashWidth
			include : HBar.m 0 emDashWidth SymbolMid

		alias [MangleName 'horizontalBar'] [MangleUnicode 0x2015] [MangleName 'emDash']

		define paragraphosOver 2
		define [ParagraphosBar] : HBar.m (-paragraphosOver) (emDashWidth + paragraphosOver) SymbolMid
		define [ParagraphosFork xStart xEnd] : dispiro
			widths.center
			flat xStart SymbolMid
			curl xEnd (SymbolMid - 0.184 * emDashWidth)

		create-glyph [MangleName 'paragraphos'] [MangleUnicode 0x2E0F] : glyph-proc
			set-width emDashWidth
			include : ParagraphosBar

		create-glyph [MangleName 'forkedParagraphos'] [MangleUnicode 0x2E10] : glyph-proc
			set-width emDashWidth
			include : ParagraphosBar
			include : ParagraphosFork (0.375 * emDashWidth) (0.02 * emDashWidth)

		create-glyph [MangleName 'reversedForkedParagraphos'] [MangleUnicode 0x2E11] : glyph-proc
			set-width emDashWidth
			include : ParagraphosBar
			include : ParagraphosFork (0.625 * emDashWidth) (0.98 * emDashWidth)

		create-glyph [MangleName 'spear'] [MangleUnicode 0x2E43] : glyph-proc
			set-width emDashWidth
			local bot : SymbolMid - HalfStroke
			local top : SymbolMid + (RightSB - SB) * 0.55
			include : dispiro
				widths.lhs
				flat (SB + OX) top [heading Downward]
				curl (SB + OX) [Math.min (bot + SmallArchDepthB) (top - TINY)]
				arcvh
				flat Middle bot
				curl (emDashWidth - SB) bot [heading Rightward]

	define emUnit : if para.isQuasiProportional UPM Width
	create-glyph 'twoEmDash' 0x2E3A : glyph-proc
		local w : 2 * emUnit
		set-width w
		include : HBar.m 0 w SymbolMid
	create-glyph 'threeEmDash' 0x2E3B : glyph-proc
		local w : 3 * emUnit
		set-width w
		include : HBar.m 0 w SymbolMid

	derive-multi-part-glyphs 'hyphenDieresis' 0x2E1A { 'figureDash' 'dieresisAbove'}
		function [src sel] : composite-proc
			refer-glyph src.0
			MarkSet.plus
			refer-glyph src.1
			clear-anchors

	create-glyph 'editorialCoronis' 0x2E0E : glyph-proc
		local df : include : DivFrame para.advanceScaleF
		local W : df.rightSB - df.leftSB
		local u : W / 625
		local sw : Math.min (0.6 * Stroke) (0.045 * W)
		local yC SymbolMid
		local ringR : 0.07 * W
		define [LowerHalf] : glyph-proc
			include : HBar.m (df.middle - 0.5 * W) (df.middle + 0.5 * W) yC sw
			foreach { len off } [items-of { {0.72 88} {0.45 176} {0.18 258} }] : do
				include : HBar.m (df.middle - 0.5 * len * W) (df.middle + 0.5 * len * W) (yC - off * u) sw
			local ringY : yC - ringR + 0.5 * sw
			include : difference [DotAt df.middle ringY ringR] [DotAt df.middle ringY (ringR - sw)]
			include : with-transform [ApparentTranslate (df.middle - Middle) (yC - 405 * u)] : with-transform [ScaleAround Middle 0 0.4 0.4] : refer-glyph 'comma'
		local sectionH : ParenTop - ParenBot
		local kFit : sectionH / (644 * (UPM / 1000))
		include : with-transform [ScaleAround df.middle yC kFit kFit] : glyph-proc
			include : LowerHalf
			include : with-transform [FlipAround df.middle yC] : LowerHalf
		include : ApparentTranslate 0 ([mix ParenTop ParenBot 0.5] - yC)

	create-glyph 'dblHyphen' 0x2E40 : glyph-proc
		local df : include : DivFrame para.advanceScaleF
		include : HBar.m df.leftSB df.rightSB (SymbolMid + EqualHalfSpace)
		include : HBar.m df.leftSB df.rightSB (SymbolMid - EqualHalfSpace)
