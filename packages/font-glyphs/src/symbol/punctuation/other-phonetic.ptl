### Punctuation symbols
$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from '@iosevka/util'
import [Joining] from '@iosevka/glyph/relation'

glyph-module

glyph-block Symbol-Other-Phonetic : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Shared-Symbol-Shapes : Polyline
	glyph-block-import Mark-Above : TildeShape aboveMarkTop aboveMarkBot
	glyph-block-import Mark-Overlay : DownTackShape
	glyph-block-import Mark-Shared-Metrics : markExtend

	local triangleSize : Math.min (PeriodRadius) (XH / 6)
	local toneMarkLeft : mix SB RightSB 0.1
	local toneMarkRight : Width - toneMarkLeft

	define [dblToneMarkLeft df] : mix df.leftSB df.rightSB 0.1
	define [dblToneMarkRight df] : mix df.leftSB df.rightSB 0.9
	define [dblToneMarkMiddle df] : mix [dblToneMarkLeft df] [dblToneMarkRight df] 0.5

	create-glyph 'triangleColon' 0x2D0 : glyph-proc
		include : MarkSet.e
		include : union
			spiro-outline
				corner (Middle - triangleSize * 1.35) XH
				corner Middle (XH - triangleSize * 2.75)
				corner (Middle + triangleSize * 1.35) XH
			spiro-outline
				corner (Middle - triangleSize * 1.35) 0
				corner Middle (0 + triangleSize * 2.75)
				corner (Middle + triangleSize * 1.35) 0

	create-glyph 'halfTriangleColon' 0x2D1 : glyph-proc
		include : MarkSet.e
		include : spiro-outline
			corner (Middle - triangleSize * 1.35) XH
			corner Middle (XH - triangleSize * 2.75)
			corner (Middle + triangleSize * 1.35) XH

	define [yOfTone tone]        : mix (OperatorStroke / 2) (CAP - OperatorStroke / 2) (tone / 4)
	define [yOfToneNeutral tone] : mix DotRadius (CAP - DotRadius) (tone / 4)
	define [yOfToneDepart a b p] : mix (CAP * a + OperatorStroke / 2) (CAP * b - OperatorStroke / 2) p
	define [ToneCorner] : with-params [left a b pos [swV OperatorStroke] [swH OperatorStroke]] : glyph-proc
		include : [if left VBar.l VBar.r] [if left toneMarkLeft toneMarkRight] (CAP * a) (CAP * b) swV
		include : HBar.m (toneMarkLeft + [if left TINY 0]) (toneMarkRight - [if left 0 TINY]) [yOfToneDepart a b pos] swH

	foreach tone [range 4 downtill 0] : begin
		create-glyph ('tone' + tone) (0x2E5 + 4 - tone) : glyph-proc
			include : VBar.r toneMarkRight 0 CAP OperatorStroke
			include : HBar.m toneMarkLeft (toneMarkRight - TINY) [yOfTone tone] OperatorStroke
		create-glyph ('toneSandhi' + tone) (0xA712 + 4 - tone) : glyph-proc
			include : VBar.l toneMarkLeft 0 CAP OperatorStroke
			include : HBar.m (toneMarkLeft + TINY) toneMarkRight [yOfTone tone] OperatorStroke
		create-glyph ('toneNeutral' + tone) (0xA708 + 4 - tone) : glyph-proc
			include : VBar.r toneMarkRight 0 CAP OperatorStroke
			include : DotAt (toneMarkLeft + DotRadius) [yOfToneNeutral tone] DotRadius
		create-glyph ('toneSandhiNeutral' + tone) (0xA70D + 4 - tone) : glyph-proc
			include : VBar.l toneMarkLeft 0 CAP OperatorStroke
			include : DotAt (toneMarkRight - DotRadius) [yOfToneNeutral tone] DotRadius

	# Connected tones
	foreach toneStart [range 4 downtill 0] : foreach toneEnd [range 4 downtill 0] : begin
		create-glyph ('toneStart' + toneStart + toneEnd) : glyph-proc
			Joining.set currentGlyph Joining.Classes.Right
			include : intersection
				Rect CAP 0 Middle Width
				dispiro
					widths.center OperatorStroke
					corner (Width / 2) [yOfTone toneStart]
					corner (Width + Width / 2) [yOfTone toneEnd]
		create-glyph ('toneSandhiStart' + toneStart + toneEnd) : glyph-proc
			Joining.set currentGlyph Joining.Classes.Right
			include : intersection
				Rect CAP 0 Middle Width
				dispiro
					widths.center OperatorStroke
					corner (0 - Width / 2) [yOfTone : mix toneEnd toneStart 2]
					corner (Width + Width / 2) [yOfTone toneEnd]
			include : VBar.m Middle 0 CAP OperatorStroke

	foreach toneStart [range 4 downtill 0] : foreach toneEnd [range 4 downtill 0] : begin
		create-glyph ('toneEnd' + toneStart + toneEnd) : glyph-proc
			Joining.set currentGlyph Joining.Classes.Left
			include : intersection
				Rect CAP 0 0 Middle
				dispiro
					widths.center OperatorStroke
					corner (0 - Width / 2)         [yOfTone toneStart]
					corner (Width + Width / 2)     [yOfTone : mix toneStart toneEnd 2]
			include : VBar.m Middle 0 CAP OperatorStroke
		create-glyph ('toneSandhiEnd' + toneStart + toneEnd) : glyph-proc
			Joining.set currentGlyph Joining.Classes.Left
			include : intersection
				Rect CAP 0 0 Width
				dispiro
					widths.center OperatorStroke
					corner (0 - Width / 2) [yOfTone toneStart]
					corner (Width / 2) [yOfTone toneEnd]

	foreach toneStart [range 4 downtill 0] : foreach toneMid [range 4 downtill 0] : foreach toneEnd [range 4 downtill 0] : begin
		create-glyph ('toneMid' + toneStart + toneMid + toneEnd) : glyph-proc
			Joining.set currentGlyph Joining.Classes.Mid
			include : intersection
				Rect CAP 0 0 Width
				union
					intersection
						dispiro
							widths.center OperatorStroke
							corner (0 - Width / 2)     [yOfTone toneStart]
							corner (Width + Width / 2) [yOfTone : mix toneStart toneMid 2]
						dispiro
							widths.center OperatorStroke
							corner (0 - Width / 2)     [yOfTone : mix toneEnd toneMid 2]
							corner (Width + Width / 2) [yOfTone toneEnd]
					dispiro
						widths.center OperatorStroke
						corner (0 - Width / 2) [yOfTone toneStart]
						corner (Width / 2)     [yOfTone toneMid]
					dispiro
						widths.center OperatorStroke
						corner (Width / 2)         [yOfTone toneMid]
						corner (Width + Width / 2) [yOfTone toneEnd]
		create-glyph ('toneSandhiMid' + toneStart + toneMid + toneEnd) : glyph-proc
			include [refer-glyph ('toneMid' + toneStart + toneMid + toneEnd)] AS_BASE ALSO_METRICS
			Joining.set currentGlyph Joining.Classes.Mid

	# Departing tones
	local DepartingToneConfig : list
		list 'departingToneYin'  0x2EA  0    0.5  0
		list 'departingToneYang' 0x2EB  0    0.5  0.5
		list 'beginHighTone'     0x2F9  0.6  1    1.0
		list 'beginLowTone'      0x2FB  0    0.4  0
	foreach { name code a b pos } [items-of DepartingToneConfig] : begin
		create-glyph name code : glyph-proc
			include : ToneCorner true a b pos

	glyph-block-export TaperedVBar TaperedHBar
	define [TaperedVBar x yBot yTop yBar sw] : union
		dispiro
			flat x yBot [widths.center sw]
			curl x yBar [widths.center (0.55 * sw)]
		dispiro
			flat x yTop [widths.center sw]
			curl x yBar [widths.center (0.55 * sw)]

	define [TaperedHBar xStem xEnd yBar sw] : dispiro
		flat xStem yBar [widths.center (0.55 * sw)]
		curl xEnd yBar [widths.center sw]
	# Cross patties: yang departing mark with serifs on all three spokes
	define [CrossPattyShape fArmRight] : glyph-proc
		local yBot : CAP * 0.02
		local yTop : CAP * 0.98
		local yBar : yOfToneDepart 0.02 0.98 0.5
		local sw OperatorStroke
		local jutH Jut
		local jutMid : Math.min VJut : (yTop - yBot) / 2 - sw
		local swVJut : VJutStroke * (sw / Stroke)
		if fArmRight : then : begin
			include : TaperedVBar (toneMarkLeft + [HSwToV : 0.5 * sw]) yBot yTop yBar sw
			include : TaperedHBar (toneMarkLeft + [HSwToV : 0.5 * sw]) toneMarkRight yBar sw
			include : HSerif.mt (toneMarkLeft + [HSwToV : 0.5 * sw]) yTop jutH sw
			include : HSerif.mb (toneMarkLeft + [HSwToV : 0.5 * sw]) yBot jutH sw
			include : VSerif.mr toneMarkRight yBar jutMid swVJut
		: else : begin
			include : TaperedVBar (toneMarkRight - [HSwToV : 0.5 * sw]) yBot yTop yBar sw
			include : TaperedHBar (toneMarkRight - [HSwToV : 0.5 * sw]) toneMarkLeft yBar sw
			include : HSerif.mt (toneMarkRight - [HSwToV : 0.5 * sw]) yTop jutH sw
			include : HSerif.mb (toneMarkRight - [HSwToV : 0.5 * sw]) yBot jutH sw
			include : VSerif.ml toneMarkLeft yBar jutMid swVJut

	create-glyph 'crossPattyWithRightCrossbar' 0x2E50 : glyph-proc
		include : CrossPattyShape true
	create-glyph 'crossPattyWithLeftCrossbar' 0x2E51 : glyph-proc
		include : CrossPattyShape false

	create-glyph 'palmBranch' 0x2E19 : glyph-proc
		local kFit : (ParenTop - ParenBot) / CAP
		local yMidPalm : mix ParenTop ParenBot 0.5
		include : new-glyph : glyph-proc
			local twigCount 6
			local halfW : 0.5 * (RightSB - SB)
			local pitch : CAP * 0.11
			local stemW : 0.6 * Stroke
			include : VBar.m Middle 0 CAP stemW
			foreach i [range 0 twigCount] : do
				local a : (12 + 8 * i) * Math.PI / 180
				local len : (0.5 * stemW) + (halfW - 0.5 * stemW) * (1 - 0.1 * i)
				local yBase : CAP * 0.22 + pitch * i
				local tw : Math.min Stroke (0.55 * pitch * [Math.cos a])
				local nx : (-[Math.sin a]) * tw / 2
				local ny : [Math.cos a] * tw / 2
				foreach s [items-of {(-1) 1}] : do
					local tx : Middle + s * len * [Math.cos a]
					local ty : yBase + len * [Math.sin a]
					if (s < 0) : then : include : spiro-outline
						corner Middle (yBase - ny)
						corner (tx - s * nx) (ty - ny)
						corner (tx + s * nx) (ty + ny)
						corner Middle (yBase + ny)
					: else : include : spiro-outline
						corner Middle (yBase + ny)
						corner (tx + s * nx) (ty + ny)
						corner (tx - s * nx) (ty - ny)
						corner Middle (yBase - ny)
			include : Ungizmo
			include : Translate (-Middle) (-CAP / 2)
			include : Scale kFit
			include : Translate Middle yMidPalm
			include : Translate (-Middle) (-yMidPalm)
			include : Rotate (-15 * Math.PI / 180)
			include : Translate Middle yMidPalm
			include : Regizmo

	local EnteringToneConfig : list
		list 'endHighTone'       0x2FA  0.6  1    1.0
		list 'endLowTone'        0x2FC  0    0.4  0
	foreach { name code a b pos } [items-of EnteringToneConfig] : begin
		create-glyph name code : glyph-proc
			include : ToneCorner false a b pos

	do 'Editorial markers'
		local top : yOfToneDepart 0.48 1 1
		local bot : CAP * 0.48
		local sw OperatorStroke
		local dr : Math.min (Width * 0.065) (sw * 0.65)
		local left : mix Middle (toneMarkLeft + sw / 1.7) 0.85
		local right : mix Middle toneMarkRight 0.85
		local dotX : mix left right 0.72
		local dotY : mix bot top 0.45
		define [Dot x y] : RingAt x y dr
		define [Corner] : with-transform [ScaleAround Middle 0 0.85 1] : ToneCorner true 0.48 1 1 (swV -- (sw / 0.85))
		define [AngledCorner reversed] : dispiro
			Polyline [widths.center sw]
				points -- {{[if reversed (Width - left) left] bot} {[if reversed (Width - left) left] (top - Width * 0.15)} {[if reversed (Width - right) right] top}}
		create-glyph 'rightAngleSubstitutionMarker' 0x2E00 : Corner
		create-glyph 'rightAngleDottedSubstitutionMarker' 0x2E01 : union [Corner] [Dot dotX dotY]
		create-glyph 'leftSubstitutionBracket' 0x2E02 : AngledCorner false
		create-glyph 'rightSubstitutionBracket' 0x2E03 : AngledCorner true
		create-glyph 'leftDottedSubstitutionBracket' 0x2E04 : union [AngledCorner false] [Dot dotX dotY]
		create-glyph 'rightDottedSubstitutionBracket' 0x2E05 : union [AngledCorner true] [Dot (Width - dotX) dotY]
		local markExt : Math.min markExtend (aboveMarkTop - aboveMarkBot)
		local interpolationScale : (CAP - bot) / (markExt * 2)
		define [Interpolation] : with-transform [Translate Middle [mix bot CAP 0.5]] : with-transform [Scale (interpolationScale * 0.72) interpolationScale] : DownTackShape (swV -- (sw / (interpolationScale * 0.72))) (swH -- (sw / interpolationScale))
		create-glyph 'raisedInterpolationMarker' 0x2E06 : Interpolation
		create-glyph 'raisedDottedInterpolationMarker' 0x2E07 : union [Interpolation] [Dot (Middle + markExtend * interpolationScale * 0.65) dotY]
		define [TranspositionSource halfStroke] : new-glyph : glyph-proc
			include : with-transform [Rotate (-Math.PI * 0.75)] : with-transform [Scale 1 (-1)] : TildeShape
				ttop -- (CAP * 0.165)
				tbot -- (0 - CAP * 0.165)
				leftEnd -- (0 - CAP * 0.26)
				rightEnd -- (CAP * 0.26)
				hs -- halfStroke
				compact -- true
				stretch -- 1
		define [TranspositionBounds source] : begin
			local bottom CAP
			local top : 0 - CAP
			foreach contour [items-of : source.geometry.toContours] : foreach point [items-of contour] : begin
				set bottom : Math.min bottom point.y
				set top : Math.max top point.y
			return { bottom top }
		local probe : TranspositionSource (sw / 2)
		local {probeBot probeTop} : TranspositionBounds probe
		local probeScale : (CAP - bot) / (probeTop - probeBot)
		local transpositionSource : TranspositionSource (sw / (2 * probeScale))
		local {transBot transTop} : TranspositionBounds transpositionSource
		local transScale : (CAP - bot) / (transTop - transBot)
		define [Transposition] : with-transform [Translate (Middle - Width * 0.06) ([mix bot CAP 0.5] - transScale * [mix transBot transTop 0.5])] : with-transform [Scale (transScale * 0.7) transScale] transpositionSource
		create-glyph 'dottedTranspositionMarker' 0x2E08 : union [Transposition] [Dot (Middle + Width * 0.3) dotY]
		create-glyph 'leftTranspositionBracket' 0x2E09 : union [Transposition] [no-shape]
		create-glyph 'rightTranspositionBracket' 0x2E0A : union [with-transform [ScaleAround Middle 0 (-1) 1] : Transposition] [no-shape]

	local DblToneConfig : list
		list 'stressAndHighTone'     0xA720  0.6  1    1.0
		list 'stressAndLowTone'      0xA721  0    0.4  0
	foreach { name code a b pos } [items-of DblToneConfig] : begin
		create-glyph name code : glyph-proc
			local df : include : DivFrame 1 3.75
			local fine : OperatorStroke * df.mvs / Stroke
			include : VBar.l [dblToneMarkLeft df] (CAP * a) (CAP * b) fine
			include : VBar.m [dblToneMarkMiddle df] (CAP * a) (CAP * b) fine
			include : HBar.m ([dblToneMarkLeft df] + TINY) [dblToneMarkRight df] [yOfToneDepart a b pos] OperatorStroke
