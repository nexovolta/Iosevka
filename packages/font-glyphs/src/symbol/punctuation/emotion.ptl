### Punctuation symbols
$$include '../../meta/macros.ptl'

import [mix clamp SuffixCfg] from "@iosevka/util"

glyph-module

glyph-block Symbol-Punctuation-Emotion : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives

	define emotionBottom : Math.max (CAP * 0.3) (DotSize * 1.5)
	define medievalSlashSlope 0.55

	do "Exclamation"
		glyph-block-import Letter-Shared : CreateTurnedLetter
		glyph-block-import Letter-Shared-Shapes : RetroflexHook

		foreach { suffix { DrawAt kdr overshoot } } [Object.entries DotVariants] : do
			local dr : DotRadius * kdr
			create-glyph "exclam.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleI
				include : VBar.m df.middle [clamp 0 (CAP * 0.4) (emotionBottom * 1.18)] CAP
				include : DrawAt df.middle dr (dr - overshoot)
				create-forked-glyph "alveolarClick.\(suffix)" : df.markSet.capital
				create-forked-glyph "exclamDown.\(suffix)" : FlipAround df.middle (XH / 2)

		select-variant 'exclam' '!' (follow -- 'punctuationDot')
		select-variant 'exclamDown' 0xA1 (follow -- 'punctuationDot')

		foreach { suffix { DrawAt kdr overshoot } } [Object.entries DotVariants] : do
			local dr : DotRadius * kdr
			create-glyph "wigglyExclam.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleI
				local yBot : clamp 0 (CAP * 0.4) (emotionBottom * 1.18)
				local amp : 0.85 * (0.5 * (df.rightSB - df.leftSB) - [HSwToV : 0.5 * Stroke])
				local nExt 6
				local sw : Math.min (0.85 * Stroke) (0.4 * amp)
				local knots {}
				foreach k [range 0 nExt] : begin
					local u : k / (nExt - 1)
					local side : if (k % 2 === 0) 1 (-1)
					local yExt : mix (CAP - 0.5 * sw) (yBot + 0.5 * sw) u
					local xExt : df.middle + side * amp * (1 - 0.6 * u)
					if (k === 0) : then : knots.push : g2.down.start xExt yExt [widths.center sw]
					: else : begin
						local yMid : mix (CAP - 0.5 * sw) (yBot + 0.5 * sw) ((k - 0.5) / (nExt - 1))
						knots.push : if (side > 0) [g2.right.mid df.middle yMid] [g2.left.mid df.middle yMid]
						knots.push : if (k === nExt - 1) [g2.down.end xExt yExt] [g2.down.mid xExt yExt]
				include : dispiro knots
				include : DrawAt df.middle dr (dr - overshoot)
				create-forked-glyph "wigglyExclamDown.\(suffix)" : FlipAround df.middle (XH / 2)

		select-variant 'wigglyExclam' 0x2E60 (follow -- 'punctuationDot')
		select-variant 'wigglyExclamDown' 0x2E61 (follow -- 'punctuationDot')
		foreach { suffix { DrawAt kdr overshoot } } [Object.entries DotVariants] : do
			create-glyph "medievalExclam.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleI
				local dr : PeriodRadius * kdr
				local slope medievalSlashSlope
				local sw Stroke
				local gap : Math.max (0.35 * sw) [AdviceStroke 6]
				local yTop CAP
				local strokeLen : CAP * 0.38
				local yStrokeBot : yTop - strokeLen
				local yDotHi : yStrokeBot - gap - dr
				local yDotLo dr
				if (yDotHi < yDotLo + 2 * dr + gap) : begin
					set yDotHi : yDotLo + 2 * dr + gap
					set yStrokeBot : yDotHi + dr + gap
				local yRef : mix yDotLo yTop 0.5
				define [xAt y] : df.middle + slope * (y - yRef)
				local pad : dr + [HSwToV : 0.5 * sw]
				local xMin : Math.min [xAt yTop] [xAt yStrokeBot] [xAt yDotHi] [xAt yDotLo]
				local xMax : Math.max [xAt yTop] [xAt yStrokeBot] [xAt yDotHi] [xAt yDotLo]
				local xShift 0
				if ((xMin - pad) < df.leftSB) : set xShift : df.leftSB - (xMin - pad)
				if ((xMax + pad + xShift) > df.rightSB) : set xShift : df.rightSB - (xMax + pad)
				define [xFit y] : [xAt y] + xShift
				include : dispiro
					widths.center sw
					corner [xFit yTop] yTop
					corner [xFit yStrokeBot] yStrokeBot
				include : DrawAt [xFit yDotHi] yDotHi (dr - overshoot)
				include : DrawAt [xFit yDotLo] yDotLo (dr - overshoot)

		select-variant 'medievalExclam' 0x2E53 (follow -- 'punctuationDot')

		select-variant 'alveolarClick' 0x1C3 (follow -- 'diacriticDot')
		CreateTurnedLetter 'alveolarPercussive'          null 'alveolarClick' HalfAdvance (XH  / 2)
		CreateTurnedLetter 'alveolarPercussive/baseline' null 'alveolarClick' HalfAdvance (CAP / 2)

		derive-glyphs 'alveolarClickRTail' 0x1DF0A 'alveolarClick' : function [src sel] : glyph-proc
			local df : include : DivFrame para.advanceScaleI
			include : df.markSet.capDesc
			include : refer-glyph src
			include : RetroflexHook.m
				x -- df.middle
				y -- 0
				yAttach -- DotRadius

	do "Question"
		glyph-block-import Mark-Above : TildeShape
		glyph-block-import Letter-Latin-Glottal-Stop : QuestionSmoothShape QuestionRevSmoothShape
		glyph-block-import Letter-Latin-Glottal-Stop : QuestionCornerShape QuestionRevCornerShape
		glyph-block-import Letter-Latin-Glottal-Stop : QuestionCornerFlatShape QuestionRevCornerFlatShape
		glyph-block-import Letter-Latin-Glottal-Stop : QuestionSmoothFlatHookedShape QuestionRevSmoothFlatHookedShape

		define HookConfig : object
			smooth              { QuestionSmoothShape            QuestionRevSmoothShape }
			corner              { QuestionCornerShape            QuestionRevCornerShape }
			cornerFlatHooked    { QuestionCornerFlatShape        QuestionRevCornerFlatShape }
			smoothFlatHooked    { QuestionSmoothFlatHookedShape  QuestionRevSmoothFlatHookedShape }

		define Config : SuffixCfg.dotWeave DotVariants HookConfig
		foreach { suffix { { DrawAt kdr overshoot } { Body RevBody } } } [Object.entries Config] : do
			create-glyph "question.\(suffix)" : glyph-proc
				include : Body CAP emotionBottom SB RightSB
				include : DrawAt Middle (DotRadius * kdr) (DotRadius * kdr - overshoot)

			create-glyph "questionDown.\(suffix)" : glyph-proc
				include [refer-glyph "question.\(suffix)"] AS_BASE ALSO_METRICS
				include : FlipAround Middle (XH / 2)

			create-glyph "revQuestion.\(suffix)" : glyph-proc
				include : RevBody CAP emotionBottom SB RightSB
				include : DrawAt Middle (DotRadius * kdr) (DotRadius * kdr - overshoot)

			define [InterroBangBodyImpl] : glyph-proc
				local angle : 12 / 180 * Math.PI
				include : Body CAP emotionBottom [mix Middle SB 0.75] RightSB
				include : Translate (-Middle) (-DotRadius)
				include : Rotate (-2 * angle)
				include : Translate Middle DotRadius
				include : VBar.m Middle emotionBottom CAP
				include : Translate (-Middle) (-DotRadius)
				include : Rotate (1.2 * angle)
				include : Translate Middle DotRadius

			create-glyph "interrobang.\(suffix)" : glyph-proc
				include : InterroBangBodyImpl
				include : DrawAt Middle (DotRadius * kdr) (DotRadius * kdr - overshoot)

			create-glyph "gnaborretni.\(suffix)" : glyph-proc
				include : refer-glyph "interrobang.\(suffix)" AS_BASE ALSO_METRICS
				include : FlipAround Middle (XH / 2)

		select-multi-dimensional-variant 'question' '?'
			follows -- { 'punctuationDot' 'question' }
		select-multi-dimensional-variant 'questionDown' 0xBF
			follows -- { 'punctuationDot' 'question' }
		select-multi-dimensional-variant 'revQuestion' 0x2E2E
			follows -- { 'punctuationDot' 'question' }
		select-multi-dimensional-variant 'interrobang' 0x203D
			follows -- { 'punctuationDot' 'question' }
		select-multi-dimensional-variant 'gnaborretni' 0x2E18
			follows -- { 'punctuationDot' 'question' }

		alias 'symbolForSubstituteFormTwo' 0x2426 'revQuestion'

		foreach { suffix { DrawAt kdr overshoot } } [Object.entries DotVariants] : do
			create-glyph "medievalQuestion.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleI
				local dr : PeriodRadius * kdr
				local slope medievalSlashSlope
				local angle : Math.atan2 1 slope
				local yDot dr
				local yTop CAP
				local gap : Math.max (0.7 * Stroke) (XH * 0.12)
				local yTildeBot : 2 * dr + gap
				local yTildeTop : yTop - O
				local yRef : mix yDot yTop 0.5
				define [xAt y] : df.middle + slope * (y - yRef)
				local pad : dr + [HSwToV HalfStroke]
				local xMin : Math.min [xAt yDot] [xAt yTildeBot] [xAt yTildeTop]
				local xMax : Math.max [xAt yDot] [xAt yTildeBot] [xAt yTildeTop]
				local xShift 0
				if ((xMin - pad) < df.leftSB) : set xShift : df.leftSB - (xMin - pad)
				if ((xMax + pad + xShift) > df.rightSB) : set xShift : df.rightSB - (xMax + pad)
				define [xFit y] : [xAt y] + xShift
				include : DrawAt [xFit yDot] yDot (dr - overshoot)
				local yMid : mix yTildeBot yTildeTop 0.5
				local length : (yTildeTop - yTildeBot) * [Math.hypot slope 1]
				local wave : 0.24 * (df.rightSB - df.leftSB)
				include : new-glyph : glyph-proc
					include : TildeShape
						ttop     -- wave
						tbot     -- 0
						leftEnd  -- 0
						rightEnd -- length
						hs       -- (Stroke / 2)
					include : Ungizmo
					include : Translate (0 - length / 2) (0 - wave / 2)
					include : Rotate angle
					include : Translate [xFit yMid] yMid
					include : Regizmo

		select-variant 'medievalQuestion' 0x2E54 (follow -- 'punctuationDot')
