### Punctuation symbols
$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from '@iosevka/util'
import [Arcs ShapeConv] from 'typo-geom'
import [BezToContoursSink] from '@iosevka/geometry/curve-util'
import [Vec2] from '@iosevka/geometry/point'

glyph-module

glyph-block Symbol-Punctuation-Ampersand : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Above : MeasureGlyphBounds
	glyph-block-import Letter-Latin-Ezh : RevEzh
	glyph-block-import Letter-Latin-Rams-Horn : UmShape
	glyph-block-import Letter-Shared-Shapes : RightwardTailedBar SerifedArcStart SerifedArcEnd InwardSlabArcStart ArcStartSerif
	glyph-block-import Letter-Arc-Hook : MakeFlatHook MakeCornerHookBase CornerHookDepth

	define SwAmpersand : AdviceStroke2 2.5 3 CAP
	define fineAmp : AdviceStroke 3.5
	define pxUpperLoopRight : 0.75 + HalfStroke / (RightSB - SB)
	define pxUpperLoopLeft  0.05
	define pXTerminal 1.1
	define pStraightBar 0.4

	define adaUpperLoop : ArchDepthAOf (ArchDepth * (pxUpperLoopRight - pxUpperLoopLeft)) Width
	define adbUpperLoop : ArchDepthBOf (ArchDepth * (pxUpperLoopRight - pxUpperLoopLeft)) Width

	define xTerminal : [mix SB RightSB pXTerminal] - [HSwToV SwAmpersand]
	define xUpperLoopLeft : mix SB RightSB pxUpperLoopLeft
	define yUpperLoopLeft : CAP - adaUpperLoop
	define xUpperLoopRight : mix SB RightSB pxUpperLoopRight
	define yUpperLoopRight : CAP - adbUpperLoop
	define xUpperLoopTop : mix xUpperLoopLeft xUpperLoopRight 0.5
	define yMockUpperLoopLeftBottom : CAP - adaUpperLoop - adbUpperLoop * 0.3

	define ClosedTipSw     : AdviceStroke 3
	define ClosedIncisedSw : AdviceStroke 5
	define ClosedBottomSlopeVal : (-0.5) * (SwAmpersand - ClosedIncisedSw) / SwAmpersand
	define ClosedBottomSlope {.x ClosedBottomSlopeVal .y (-1)}
	define xClosedAmpersandBottom : [mix SB RightSB 0.44] + (0.125 + 0.5 * CorrectionOMidX + ClosedBottomSlopeVal) * SwAmpersand
	define [ClosedAmpersandLeadDim sw swTip offset] : begin
		define x1 : [mix SB RightSB 0.80] - offset
		define x2 : [mix SB RightSB pXTerminal] + [HSwToV : 0.1 * sw] - offset
		define y1   0
		define y2 : [mix 0 CAP 0.375] + sw / 2
		define k1   0.5
		return : object x1 x2 y1 y2 k1
	define [ClosedAmpersandLead sw swTip] : begin
		define [object x1 x2 y1 y2 k1] : ClosedAmpersandLeadDim sw swTip 0
		return : intersection [MaskBelow y2] : dispiro
			flat [mix x1 x2 4]  [mix y1 y2 4]  [widths.rhs swTip]
			curl [mix x1 x2 k1] [mix y1 y2 k1]
			g4.left.mid xClosedAmpersandBottom O [widths.rhs.heading sw ClosedBottomSlope]

	define [ClosedAmpersandLeadMask2 sw swTip] : begin
		define [object x1 x2 y1 y2 k1] : ClosedAmpersandLeadDim sw swTip [HSwToV : sw - swTip]
		return : intersection [MaskBelow y2] : spiro-outline
			flat [mix x1 x2 4]  [mix y1 y2 4]  [widths.rhs swTip]
			curl [mix x1 x2 k1] [mix y1 y2 k1]
			g4.left.mid xClosedAmpersandBottom O [widths.rhs sw]
			corner 0 O
			corner 0 [mix y1 y2 4]

	define [ClosedAmpersandLeadMask] : union
		intersection
			MaskAbove [mix yMockUpperLoopLeftBottom 0 pStraightBar]
			MaskRight xClosedAmpersandBottom
		spiro-outline
			corner [mix xUpperLoopLeft xTerminal pStraightBar] [mix yMockUpperLoopLeftBottom 0 pStraightBar]
			corner [mix xUpperLoopLeft xTerminal 2]            (-yMockUpperLoopLeftBottom)
			corner [mix xUpperLoopLeft xTerminal 4]            (-yMockUpperLoopLeftBottom)
			corner [mix xUpperLoopLeft xTerminal 4]            [mix yMockUpperLoopLeftBottom 0 pStraightBar]

	define [ClosedAmpersandBowlLead] : union
		intersection
			ClosedAmpersandLead SwAmpersand ClosedTipSw
			ClosedAmpersandLeadMask
		difference
			intersection
				ClosedAmpersandLead SwAmpersand ClosedTipSw
				ClosedAmpersandLeadMask2 SwAmpersand ClosedIncisedSw
			ClosedAmpersandLeadMask

	define [ClosedAmpersandBodyKnots] : list
		g4.left.mid xClosedAmpersandBottom O [widths.rhs.heading SwAmpersand ClosedBottomSlope]
		archv
		g4   (SB + OX) [YSmoothMidL (0.66 * yUpperLoopRight + HalfStroke) O ArchDepthA ArchDepthB]
		alsoThru 0.5 0.5 [widths.center SwAmpersand]
		g4   xUpperLoopRight yUpperLoopRight [widths.lhs SwAmpersand]
		Arch.lhs CAP (sw -- SwAmpersand)
		g4   xUpperLoopLeft yUpperLoopLeft

	glyph-block-export ClosedRest ClosedRotunda
	define [ClosedRest] : union
		ClosedAmpersandBowlLead
		difference
			dispiro
				ClosedAmpersandBodyKnots
				flat [mix xUpperLoopLeft xTerminal pStraightBar] [mix yMockUpperLoopLeftBottom 0 pStraightBar]
				curl [mix xUpperLoopLeft xTerminal 2] (-yMockUpperLoopLeftBottom)
			Rect 0 ((-CAP) * 2) xTerminal (Width * 2)

	class RotundaJoinEdge
		public [new x0 y0 x1 y1 slope0 slope1 curvature1] : begin
			local dy : y1 - y0
			local dx : x1 - x0 - slope0 * dy
			local ds : (slope1 - slope0) * dy
			local dc : curvature1 * dy * dy
			set this.x0 x0
			set this.y0 y0
			set this.dy dy
			set this.c1 : slope0 * dy
			# Match zero curvature at the straight stroke and the um hook's curvature.
			set this.c3 : 10 * dx - 4 * ds + 0.5 * dc
			set this.c4 : -15 * dx + 7 * ds - dc
			set this.c5 : 6 * dx - 3 * ds + 0.5 * dc
		public [eval t] : new Vec2
			this.x0 + t * (this.c1 + t * t * (this.c3 + t * (this.c4 + t * this.c5)))
			this.y0 + t * this.dy
		public [derivative t] : new Vec2
			this.c1 + t * t * (3 * this.c3 + t * (4 * this.c4 + t * 5 * this.c5))
			0 + this.dy

	define [ClosedRotunda bottom] : begin
		local xCross : mix SB RightSB 0.36
		local yCross : 0.56 * CAP
		local xFlat : mix SB RightSB 0.11
		local yFlat : 0.78 * Ascender
		local slope : (xCross - xFlat) / (yFlat - yCross)
		local xBase : xCross + slope * yCross
		local yLowerCross : 0.20 * CAP
		local xLowerCross : xBase - slope * yLowerCross
		local xOuter : Math.max (RightSB - OX - 0.5 * SwAmpersand) (xLowerCross + 0.12 * Width)
		local df : DivFrame 1
		local umTop CAP
		local umHeight : umTop - bottom
		local umCross : bottom + 0.42 * umHeight + [clamp (0.15 * 0.58 * umHeight) (0.28 * 0.58 * umHeight) (1.05 * SwAmpersand)]
		local umJoin : umCross - 0.22 * CAP
		local yJoinTop : umJoin + 0.12 * CAP
		local overlap : 0.02 * SwAmpersand
		# Keep the um's lower hook, excluding its upper loop and left spur.
		define [UmLower clipY] : difference
			intersection [MaskBelow clipY]
				UmShape df umTop bottom df.adws SwAmpersand SwAmpersand 0.625
			intersection [MaskLeft df.middle] [MaskAbove (bottom + 0.2 * umHeight)]
		local umPart : new-glyph : UmLower umJoin
		local umLeft nothing
		local umRight nothing
		local umLeftSlope nothing
		local umRightSlope nothing
		local umLeftCurvature nothing
		local umRightCurvature nothing
		foreach contour [items-of : umPart.geometry.toBezArcs] : foreach arc [items-of contour] : begin
			local a : umPart.gizmo.unapply arc.a
			local b : umPart.gizmo.unapply arc.b
			local c : umPart.gizmo.unapply arc.c
			local d : umPart.gizmo.unapply arc.d
			local p nothing
			local q nothing
			local r nothing
			if (([Math.abs (a.y - umJoin)] < 0.01) && (d.y < umJoin - 0.01)) : begin
				set p a
				set q b
				set r c
			if (([Math.abs (d.y - umJoin)] < 0.01) && (a.y < umJoin - 0.01)) : begin
				set p d
				set q c
				set r b
			if p : begin
				local dx : q.x - p.x
				local dy : q.y - p.y
				if ([Math.abs dy] < 0.001) : throw : new Error 'Cannot measure rotunda um hook tangent'
				local tangent : dx / dy
				local curvature : (2 / 3) * ((r.x - 2 * q.x + p.x) * dy - dx * (r.y - 2 * q.y + p.y)) / (dy * dy * dy)
				if ((umLeft === nothing) || (p.x < umLeft)) : begin
					set umLeft p.x
					set umLeftSlope tangent
					set umLeftCurvature curvature
				if ((umRight === nothing) || (p.x > umRight)) : begin
					set umRight p.x
					set umRightSlope tangent
					set umRightCurvature curvature
		if ((umLeft === nothing) || (umRight === nothing) || (umRight - umLeft < TINY)) : throw : new Error 'Cannot align rotunda um hook'
		local umSlope : (umLeftSlope + umRightSlope) / 2
		local umX : xBase - slope * yJoinTop + 0.5 * (umSlope - slope) * (umJoin - yJoinTop)
		local umShift : umX - (umLeft + umRight) / 2
		local crossNormalScale : 1 / [Math.sqrt : 1 + slope * slope]
		local nx : 0.5 * SwAmpersand * HVContrast * crossNormalScale
		local ny : 0.5 * SwAmpersand * slope * crossNormalScale
		local lineX : xBase - slope * yJoinTop
		local joinLeft : new RotundaJoinEdge (lineX - nx - slope * ny) yJoinTop (umLeft + umShift) umJoin (-slope) umLeftSlope umLeftCurvature
		local joinRight : new RotundaJoinEdge (lineX + nx + slope * ny) yJoinTop (umRight + umShift) umJoin (-slope) umRightSlope umRightCurvature
		local arcEndY : yCross - 0.2 * SwAmpersand
		local lineStartY yCross
		local lineStartX : xBase - slope * lineStartY
		local lineEndY : yJoinTop - 2 * ny - 2 * overlap
		local lineEndX : xBase - slope * lineEndY
		local crossHeading {.x (-HVContrast * crossNormalScale) .y (-slope * crossNormalScale)}
		define [LowerArc] : dispiro
			widths.center SwAmpersand
			flat xCross yCross
			g4 (SB + OX) (0.24 * CAP)
			g4 xClosedAmpersandBottom (O + 0.5 * SwAmpersand)
			curl xLowerCross yLowerCross
		define [OuterArc topY] : difference
			dispiro
				widths.center SwAmpersand
				flat (xBase - slope * arcEndY) arcEndY [heading crossHeading]
				g4 xCross yCross [heading crossHeading]
				g4 xFlat yFlat
				g4 [mix SB RightSB 0.40] topY
				g4 xOuter (0.48 * CAP)
				curl xLowerCross yLowerCross
			# Clear the arc end where the straight diagonal replaces it.
			intersection [MaskBelow yCross] [MaskAbove (yJoinTop - overlap)] : spiro-outline
				corner (-VERY-FAR) (-VERY-FAR)
				corner (xBase + slope * VERY-FAR + nx + slope * ny - 0.25 * SwAmpersand) (-VERY-FAR)
				corner (xBase - slope * CAP + nx + slope * ny - 0.25 * SwAmpersand) CAP
				corner (-VERY-FAR) CAP
		local arcTop : Ascender - 0.5 * SwAmpersand
		foreach iteration [range 0 5] : begin
			local measuredTop nothing
			local probe : new-glyph : glyph-proc
				include : OuterArc arcTop
				local bounds : include : MeasureGlyphBounds
				if [not bounds] : throw : new Error 'Cannot measure rotunda outer arc'
				set measuredTop bounds.yMax
			set arcTop : arcTop + Ascender - measuredTop
		define [CrossingHook] : union
			intersection [MaskAbove (yJoinTop - overlap)] : spiro-outline
				corner (lineStartX - nx) (lineStartY - ny)
				corner (lineEndX - nx) (lineEndY - ny)
				corner (lineEndX + nx) (lineEndY + ny)
				corner (lineStartX + nx) (lineStartY + ny)
			glyph-proc
				local cs : new BezToContoursSink currentGlyph.gizmo
				ShapeConv.transferGenericShapeAsBezier {{joinLeft [new Arcs.Reverted joinRight]}} cs 0.01
				currentGlyph.includeContours cs.contours
			with-transform [Translate umShift 0] : UmLower (umJoin + overlap)
		return : with-transform [Translate (0.075 * Width) 0] : with-transform [Scale 0.85 1] : union
			LowerArc
			OuterArc arcTop
			CrossingHook

	create-glyph 'ampersand.closed' : ClosedRest

	define HOOK-ROUND  0
	define HOOK-FLAT   1
	define HOOK-CORNER 2
	define TOP-SERIFLESS       0
	define TOP-SERIFED         1
	define TOP-INWARD-SERIFED  2

	define [UpperOpenRest hookType topSerif] : begin
		local xCornerRight : xUpperLoopRight + [if para.isItalic [HSwToV : SwAmpersand * 0.2] 0]
		return : union
			intersection
				ClosedAmpersandLead SwAmpersand ClosedTipSw
				ClosedAmpersandLeadMask
			difference
				intersection
					ClosedAmpersandLead SwAmpersand ClosedTipSw
					ClosedAmpersandLeadMask2 SwAmpersand ClosedIncisedSw
				ClosedAmpersandLeadMask
			difference
				dispiro
					g4.left.mid xClosedAmpersandBottom O [widths.rhs.heading SwAmpersand ClosedBottomSlope]
					archv
					g4   (SB + OX) [YSmoothMidL (0.66 * yUpperLoopRight + HalfStroke) O ArchDepthA ArchDepthB]
					alsoThru 0.5 0.5 [widths.center SwAmpersand]
					g4   xUpperLoopRight yUpperLoopRight [widths.lhs SwAmpersand]
				Rect (CAP * 2) yUpperLoopRight 0 Width
				Rect (CAP * 2) (0.5 * CAP) Middle Width
				intersection
					Rect (CAP * 2) ArchDepthA 0 (RightSB - [HSwToV fineAmp])
					with-transform [Translate (-O) 0] : spiro-outline
						Arch.lhs.centerAt.rtl.t xUpperLoopTop CAP (sw -- SwAmpersand)
						archv
						g4   xUpperLoopLeft yUpperLoopLeft
						flat [mix xUpperLoopLeft xTerminal pStraightBar] [mix yMockUpperLoopLeftBottom 0 pStraightBar]
						corner [mix xUpperLoopLeft xTerminal 2] (-yMockUpperLoopLeftBottom)
						corner ([mix xUpperLoopLeft xTerminal 2] + Width * 2) (-yMockUpperLoopLeftBottom)
						corner ([mix xUpperLoopLeft xTerminal 2] + Width * 2) (CAP - O)
			if (hookType === HOOK-CORNER) [VBar.r [MakeCornerHookBase xUpperLoopLeft xCornerRight CAP 0 (sw -- SwAmpersand)].xRHook CAP (CAP - [CornerHookDepth Hook SwAmpersand]) SwAmpersand] [no-shape]
			difference
				dispiro
					match hookType
						[Just HOOK-FLAT] : [MakeFlatHook xUpperLoopLeft xUpperLoopRight CAP 0 (sw -- SwAmpersand)].hookStartR
						[Just HOOK-CORNER] : [MakeCornerHookBase xUpperLoopLeft xCornerRight CAP 0 (sw -- SwAmpersand)].hookStartR
						__ : match topSerif
							[Just TOP-SERIFED] : SerifedArcStart.RtlLhs xUpperLoopRight CAP SwAmpersand (CAP - yUpperLoopRight)
							[Just TOP-INWARD-SERIFED] : InwardSlabArcStart.RtlLhs xUpperLoopRight CAP SwAmpersand (CAP - yUpperLoopRight)
							__ : list
								g4.up.start xUpperLoopRight yUpperLoopRight [widths.heading SwAmpersand 0 Upward]
								arcvh
								Arch.lhs.centerAt.rtl.t xUpperLoopTop CAP (sw -- SwAmpersand)
								archv
					g4  xUpperLoopLeft yUpperLoopLeft
					flat [mix xUpperLoopLeft xTerminal pStraightBar] [mix yMockUpperLoopLeftBottom 0 pStraightBar]
					curl [mix xUpperLoopLeft xTerminal 2] (-yMockUpperLoopLeftBottom)
				Rect 0 ((-CAP) * 2) xTerminal (Width * 2)
			match topSerif
				[Just TOP-SERIFED] : ArcStartSerif.R xUpperLoopRight CAP SwAmpersand (CAP - yUpperLoopRight)
				[Just TOP-INWARD-SERIFED] : ArcStartSerif.InwardR xUpperLoopRight CAP SwAmpersand (CAP - yUpperLoopRight)
				__ : no-shape

	create-glyph 'ampersand.upperOpen' : UpperOpenRest HOOK-ROUND TOP-SERIFLESS
	create-glyph 'ampersand.upperOpenFlatHook' : UpperOpenRest HOOK-FLAT TOP-SERIFLESS
	create-glyph 'ampersand.upperOpenCornerHook' : UpperOpenRest HOOK-CORNER TOP-SERIFLESS
	create-glyph 'ampersand.upperOpenSerifed' : UpperOpenRest HOOK-ROUND TOP-SERIFED
	create-glyph 'ampersand.upperOpenInwardSerifed' : UpperOpenRest HOOK-ROUND TOP-INWARD-SERIFED
	create-glyph 'ampersand.closedFlatHook' : UpperOpenRest HOOK-FLAT TOP-SERIFLESS
	create-glyph 'ampersand.closedCornerHook' : UpperOpenRest HOOK-CORNER TOP-SERIFLESS

	define xLowerOpenRight : mix xUpperLoopRight RightSB 0.5
	define xLowerOpenBottom : mix SB xLowerOpenRight 0.5
	define yLowerOpenEnd : Math.max (ArchDepthA + fineAmp) (CAP * 0.45)
	define xLowerOpenBarRight : mix xLowerOpenRight Width 0.5
	define xLowerOpenBarLeft : Math.min
		xLowerOpenRight - [HSwToV Stroke] - xLowerOpenBarRight + xLowerOpenRight
		mix Middle xLowerOpenRight 0.5
	define [LowerOpenCrossbar y] : dispiro
		widths.rhs fineAmp
		corner (xLowerOpenBarLeft  + TanSlope * fineAmp / 2) y
		corner (xLowerOpenBarRight + TanSlope * fineAmp / 2) y

	define FORM-TOOTHED           0
	define FORM-FLAT-BOTTOM       1
	define FORM-TOOTHLESS-CORNER  2
	define FORM-TOOTHLESS-ROUNDED 3

	# Match EtLowerHalf's terminal construction without changing existing Et outlines.
	define [EtBowlEnd form right center depth barTop sw] : match form
		[Just FORM-TOOTHED] : SerifedArcEnd.LtrLhs right 0 sw depth Stroke
		[Just FORM-FLAT-BOTTOM] : list
			arcvh
			flat [Arch.adjust-x.bot center (sw -- sw)] 0
			curl (right - TINY) 0 [heading Rightward]
		[Just FORM-TOOTHLESS-CORNER] : list
			Arch.lhs 0 (sw -- sw) (blendPost -- {})
			g4 right DToothlessRise
		[Just FORM-TOOTHLESS-ROUNDED] : list
			Arch.lhs 0 (sw -- sw)
			flat right depth
			curl right barTop [heading Upward]
		__ : list

	define [LowerOpenBody form] : match form
		[Just FORM-TOOTHLESS-ROUNDED] : dispiro
			widths.rhs SwAmpersand
			flat (xLowerOpenRight - O) yLowerOpenEnd [heading Downward]
			curl (xLowerOpenRight - O) ArchDepthA
			arcvh
			Arch.rhs.centerAt.rtl.b xLowerOpenBottom 0 (sw -- SwAmpersand)
			archv
			g4 (SB + O) ArchDepthB
			alsoThru 0.5 0.5 [widths.center SwAmpersand]
			g4 xUpperLoopRight yUpperLoopRight [widths.lhs SwAmpersand]
			arcvh
			Arch.lhs.centerAt.rtl.t xUpperLoopTop CAP (sw -- SwAmpersand)
		__ : dispiro
			Arch.rhs.centerAt.ltr.t xUpperLoopTop CAP (sw -- SwAmpersand)
			archv
			g4 xUpperLoopRight yUpperLoopRight [widths.rhs SwAmpersand]
			alsoThru 0.5 0.5 [widths.center SwAmpersand]
			g4 (SB + O) ArchDepthB [widths.lhs SwAmpersand]
			EtBowlEnd form (xLowerOpenRight - O) xLowerOpenBottom ArchDepthA yLowerOpenEnd SwAmpersand

	define [LowerOpenRest form] : union
		LowerOpenCrossbar yLowerOpenEnd
		LowerOpenBody form
		difference
			dispiro
				Arch.lhs.centerAt.rtl.t xUpperLoopTop CAP (sw -- SwAmpersand)
				archv
				g4   xUpperLoopLeft yUpperLoopLeft
				flat [mix xUpperLoopLeft xTerminal pStraightBar] [mix yMockUpperLoopLeftBottom 0 pStraightBar]
				curl xTerminal 0
			spiro-outline
				Arch.rhs.centerAt.rtl.b xLowerOpenBottom 0 (sw -- SwAmpersand)
				archv
				g4   (SB + OX) [YSmoothMidL (0.66 * yUpperLoopRight + HalfStroke) O ArchDepthA ArchDepthB]
				alsoThru 0.5 0.5 [widths.center SwAmpersand]
				g4   xUpperLoopRight yUpperLoopRight
				arcvh
				Arch.lhs.centerAt.rtl.t (knot-ty -- corner) xUpperLoopTop CAP (sw -- SwAmpersand)
				Arch.lhs.centerAt.rtl.t (knot-ty -- corner) xUpperLoopTop (CAP * 2) (sw -- SwAmpersand)
				corner (Width * 2) (CAP * 2)
				corner (Width * 2) O
		match form
			[Just FORM-TOOTHED] : union
				VBar.r (xLowerOpenRight - O) (ArchDepthA + O) yLowerOpenEnd SwAmpersand
				VBar.r (xLowerOpenRight - O) ArchDepthA 0 [Math.max [AdviceStroke 5] (SwAmpersand - ShoulderFine / 2)]
			[Just FORM-FLAT-BOTTOM] : VBar.r (xLowerOpenRight - O) 0 yLowerOpenEnd SwAmpersand
			[Just FORM-TOOTHLESS-CORNER] : VBar.r (xLowerOpenRight - O) DToothlessRise yLowerOpenEnd SwAmpersand
			__ : no-shape

	create-glyph 'ampersand.lowerOpen' : LowerOpenRest FORM-TOOTHLESS-ROUNDED
	create-glyph 'ampersand.lowerOpenToothlessRounded' : LowerOpenRest FORM-TOOTHLESS-ROUNDED
	create-glyph 'ampersand.lowerOpenFlatBottom' : LowerOpenRest FORM-FLAT-BOTTOM
	create-glyph 'ampersand.lowerOpenToothed' : LowerOpenRest FORM-TOOTHED
	create-glyph 'ampersand.lowerOpenToothlessCorner' : LowerOpenRest FORM-TOOTHLESS-CORNER

	define yEtMiddle : CAP * OverlayPos
	define adaEt : CAP - [mix (yEtMiddle + SwAmpersand / 2) (CAP - O - SwAmpersand) (ArchDepthB / (ArchDepthA + ArchDepthB))] - [HSwToV TanSlope] * SwAmpersand
	define adbEt : [mix (SwAmpersand + O) (yEtMiddle - SwAmpersand / 2) (ArchDepthB / (ArchDepthA + ArchDepthB))] + [HSwToV TanSlope] * SwAmpersand
	define fineEt : SwAmpersand * CThin
	define xEtLeft SB
	define xEtRight : mix xUpperLoopRight RightSB 0.5
	define xEtCenterBarRight : mix xEtRight Width 0.5
	define yEtRightBarTop : mix (yEtMiddle + SwAmpersand / 2) (CAP - SHook) 0.375
	define xEtCornerRight : xEtRight + [if para.isItalic [HSwToV : SwAmpersand * 0.2] 0]

	define [EtUpperHalfStroke hookType topSerif] : dispiro
		match hookType
			[Just HOOK-FLAT] : [MakeFlatHook xEtLeft xEtRight CAP 0 (sw -- SwAmpersand)].hookStartR
			[Just HOOK-CORNER] : [MakeCornerHookBase xEtLeft xEtCornerRight CAP 0 (sw -- SwAmpersand)].hookStartR
			__ : match topSerif
				[Just TOP-SERIFED] : SerifedArcStart.RtlLhs xEtRight CAP SwAmpersand SHook
				[Just TOP-INWARD-SERIFED] : InwardSlabArcStart.RtlLhs xEtRight CAP SwAmpersand SHook
				__ : list
					g4 xEtRight (CAP - SHook) [widths.lhs]
					HookStart CAP
		g4 xEtLeft (CAP - adaEt)
		arcvh
		flat Middle (yEtMiddle - (fineEt - SwAmpersand / 2)) [widths.heading fineEt 0 Rightward]
		curl xEtCenterBarRight (yEtMiddle - (fineEt - SwAmpersand / 2)) [heading Rightward]

	define [EtUpperHalf hookType topSerif] : glyph-proc
		include : EtUpperHalfStroke hookType topSerif
		if (hookType === HOOK-CORNER) : include : VBar.r [MakeCornerHookBase xEtLeft xEtCornerRight CAP 0 (sw -- SwAmpersand)].xRHook CAP (CAP - [CornerHookDepth SHook SwAmpersand]) SwAmpersand
		if (topSerif === TOP-SERIFED) : include : ArcStartSerif.R xEtRight CAP SwAmpersand SHook
		if (topSerif === TOP-INWARD-SERIFED) : include : ArcStartSerif.InwardR xEtRight CAP SwAmpersand SHook

	define [EtLowerHalf form] : dispiro
		flat xEtCenterBarRight (yEtMiddle + (fineEt - SwAmpersand / 2)) [widths.heading fineEt 0 Leftward]
		curl Middle (yEtMiddle + (fineEt - SwAmpersand / 2)) [heading Leftward]
		archv
		g4 (xEtLeft + O * 2) adbEt [widths.lhs]
		match form
			[Just FORM-TOOTHED] : begin
				SerifedArcEnd.LtrLhs xEtRight 0 Stroke adaEt Stroke
			[Just FORM-FLAT-BOTTOM] : list
				arcvh
				flat [Arch.adjust-x.bot [mix (xEtLeft + O * 2) xEtRight 0.5]] 0
				curl (xEtRight - TINY) 0 [heading Rightward]
			[Just FORM-TOOTHLESS-CORNER] : list
				Arch.lhs 0 (blendPost -- {})
				g4   xEtRight DToothlessRise
			[Just FORM-TOOTHLESS-ROUNDED] : list
				Arch.lhs 0
				flat xEtRight adaEt
				curl xEtRight yEtRightBarTop [heading Upward]
			__ : list

	create-glyph 'ampersand.etToothed' : union
		EtUpperHalf HOOK-ROUND TOP-SERIFLESS
		EtLowerHalf FORM-TOOTHED
		VBar.r xEtRight (adaEt + O) yEtRightBarTop
		VBar.r xEtRight adaEt 0 [Math.max [AdviceStroke 5] (Stroke - ShoulderFine / 2)]

	create-glyph 'ampersand.etTailed' : union
		EtUpperHalf HOOK-ROUND TOP-SERIFLESS
		EtLowerHalf FORM-TOOTHED
		RightwardTailedBar xEtRight 0 yEtRightBarTop

	create-glyph 'ampersand.etFlatBottom' : union
		EtUpperHalf HOOK-ROUND TOP-SERIFLESS
		EtLowerHalf FORM-FLAT-BOTTOM
		VBar.r xEtRight 0 yEtRightBarTop

	create-glyph 'ampersand.etToothlessCorner' : union
		EtUpperHalf HOOK-ROUND TOP-SERIFLESS
		EtLowerHalf FORM-TOOTHLESS-CORNER
		VBar.r xEtRight DToothlessRise yEtRightBarTop

	create-glyph 'ampersand.etToothlessRounded' : union
		EtUpperHalf HOOK-ROUND TOP-SERIFLESS
		EtLowerHalf FORM-TOOTHLESS-ROUNDED

	create-glyph 'ampersand.etFlatHookToothed' : union
		EtUpperHalf HOOK-FLAT TOP-SERIFLESS
		EtLowerHalf FORM-TOOTHED
		VBar.r xEtRight (adaEt + O) yEtRightBarTop
		VBar.r xEtRight adaEt 0 [Math.max [AdviceStroke 5] (Stroke - ShoulderFine / 2)]

	create-glyph 'ampersand.etFlatHookTailed' : union
		EtUpperHalf HOOK-FLAT TOP-SERIFLESS
		EtLowerHalf FORM-TOOTHED
		RightwardTailedBar xEtRight 0 yEtRightBarTop

	create-glyph 'ampersand.etFlatHookFlatBottom' : union
		EtUpperHalf HOOK-FLAT TOP-SERIFLESS
		EtLowerHalf FORM-FLAT-BOTTOM
		VBar.r xEtRight 0 yEtRightBarTop

	create-glyph 'ampersand.etFlatHookToothlessCorner' : union
		EtUpperHalf HOOK-FLAT TOP-SERIFLESS
		EtLowerHalf FORM-TOOTHLESS-CORNER
		VBar.r xEtRight DToothlessRise yEtRightBarTop

	create-glyph 'ampersand.etFlatHookToothlessRounded' : union
		EtUpperHalf HOOK-FLAT TOP-SERIFLESS
		EtLowerHalf FORM-TOOTHLESS-ROUNDED

	create-glyph 'ampersand.etCornerHookToothed' : union
		EtUpperHalf HOOK-CORNER TOP-SERIFLESS
		EtLowerHalf FORM-TOOTHED
		VBar.r xEtRight (adaEt + O) yEtRightBarTop
		VBar.r xEtRight adaEt 0 [Math.max [AdviceStroke 5] (Stroke - ShoulderFine / 2)]

	create-glyph 'ampersand.etCornerHookTailed' : union
		EtUpperHalf HOOK-CORNER TOP-SERIFLESS
		EtLowerHalf FORM-TOOTHED
		RightwardTailedBar xEtRight 0 yEtRightBarTop

	create-glyph 'ampersand.etCornerHookFlatBottom' : union
		EtUpperHalf HOOK-CORNER TOP-SERIFLESS
		EtLowerHalf FORM-FLAT-BOTTOM
		VBar.r xEtRight 0 yEtRightBarTop

	create-glyph 'ampersand.etCornerHookToothlessCorner' : union
		EtUpperHalf HOOK-CORNER TOP-SERIFLESS
		EtLowerHalf FORM-TOOTHLESS-CORNER
		VBar.r xEtRight DToothlessRise yEtRightBarTop

	create-glyph 'ampersand.etCornerHookToothlessRounded' : union
		EtUpperHalf HOOK-CORNER TOP-SERIFLESS
		EtLowerHalf FORM-TOOTHLESS-ROUNDED

	define yEtFlatTopEnd : Math.max (0 + ArchDepthA + fineAmp) [mix 0 CAP 0.4]
	define pyEtFlatTopBarPos : ([mix 0 CAP OverlayPos] + Stroke * 0.125) / (CAP - 0)

	define EtFlatTopConfig : object
		'flatTopSerifless' false
		'flatTopSerifed'   true

	foreach {suffix fSerifed} [pairs-of EtFlatTopConfig] : do
		create-glyph "ampersand.\(suffix)" : glyph-proc
			define et : RevEzh CAP 0
				fSerifed   -- fSerifed
				terminal   -- 0
				stroke     -- SwAmpersand
				ada        -- adaEt
				adb        -- adbEt
				pyMidRight -- pyEtFlatTopBarPos
				lowerEnd   -- [lambda [xArcMid] : EtBowlEnd FORM-TOOTHLESS-ROUNDED (xLowerOpenRight - OX) [mix xArcMid (xLowerOpenRight - OX) 0.5] adaEt yEtFlatTopEnd SwAmpersand]
			include : union
				LowerOpenCrossbar yEtFlatTopEnd
				et.Shape

	define FlatTopToothForms : object
		'FlatBottom'       FORM-FLAT-BOTTOM
		'Toothed'          FORM-TOOTHED
		'ToothlessCorner'  FORM-TOOTHLESS-CORNER
		'ToothlessRounded' FORM-TOOTHLESS-ROUNDED
	define FlatTopSerifs : object
		'Serifless' false
		'Serifed'   true

	foreach {formSuffix form} [pairs-of FlatTopToothForms] : do
		foreach {serifSuffix fSerifed} [pairs-of FlatTopSerifs] : do
			create-glyph "ampersand.flatTop\(formSuffix)\(serifSuffix)" : glyph-proc
				define et : RevEzh CAP 0
					fSerifed   -- fSerifed
					terminal   -- 0
					stroke     -- SwAmpersand
					ada        -- adaEt
					adb        -- adbEt
					pyMidRight -- pyEtFlatTopBarPos
					lowerEnd   -- [lambda [xArcMid] : EtBowlEnd form (xLowerOpenRight - OX) [mix xArcMid (xLowerOpenRight - OX) 0.5] adaEt yEtFlatTopEnd SwAmpersand]
				include : union
					LowerOpenCrossbar yEtFlatTopEnd
					et.Shape
					match form
						[Just FORM-TOOTHED] : union
							VBar.r (xLowerOpenRight - OX) (adaEt + O) yEtFlatTopEnd SwAmpersand
							VBar.r (xLowerOpenRight - OX) adaEt 0 [Math.max [AdviceStroke 5] (SwAmpersand - ShoulderFine / 2)]
						[Just FORM-FLAT-BOTTOM] : VBar.r (xLowerOpenRight - OX) 0 yEtFlatTopEnd SwAmpersand
						[Just FORM-TOOTHLESS-CORNER] : VBar.r (xLowerOpenRight - OX) DToothlessRise yEtFlatTopEnd SwAmpersand
						__ : no-shape

	define FlatTopAndBottomConfig : object
		'flatTopAndBottomSerifless'                 {FORM-FLAT-BOTTOM        false}
		'flatTopAndBottomSerifed'                   {FORM-FLAT-BOTTOM        true }
		'flatTopAndBottomToothedSerifless'          {FORM-TOOTHED            false}
		'flatTopAndBottomToothedSerifed'            {FORM-TOOTHED            true }
		'flatTopAndBottomToothlessCornerSerifless'  {FORM-TOOTHLESS-CORNER   false}
		'flatTopAndBottomToothlessCornerSerifed'    {FORM-TOOTHLESS-CORNER   true }
		'flatTopAndBottomToothlessRoundedSerifless' {FORM-TOOTHLESS-ROUNDED  false}
		'flatTopAndBottomToothlessRoundedSerifed'   {FORM-TOOTHLESS-ROUNDED  true }

	foreach {suffix {form fSerifed}} [pairs-of FlatTopAndBottomConfig] : do
		create-glyph "ampersand.\(suffix)" : glyph-proc
			define et : RevEzh CAP 0
				fSerifed   -- fSerifed
				terminal   -- 0
				stroke     -- SwAmpersand
				ada        -- adaEt
				adb        -- adbEt
				pyMidRight -- pyEtFlatTopBarPos
				lowerEnd   -- [lambda [xArcMid] : EtBowlEnd form xEtRight [mix xArcMid xEtRight 0.5] adaEt yEtRightBarTop SwAmpersand]
			include : et.Shape
			if (form === FORM-FLAT-BOTTOM) : include : VBar.r xEtRight 0 yEtRightBarTop SwAmpersand
			if (form === FORM-TOOTHED) : include : VBar.r xEtRight (adaEt + O) yEtRightBarTop SwAmpersand
			if (form === FORM-TOOTHED) : include : VBar.r xEtRight adaEt 0 [Math.max [AdviceStroke 5] (SwAmpersand - ShoulderFine / 2)]
			if (form === FORM-TOOTHLESS-CORNER) : include : VBar.r xEtRight DToothlessRise yEtRightBarTop SwAmpersand

	define [UpperOpenRoundRest] : UpperOpenRest HOOK-ROUND TOP-SERIFLESS
	define [UpperOpenFlatRest] : UpperOpenRest HOOK-FLAT TOP-SERIFLESS
	define [UpperOpenCornerRest] : UpperOpenRest HOOK-CORNER TOP-SERIFLESS
	define [UpperOpenRoundSerifed] : UpperOpenRest HOOK-ROUND TOP-SERIFED
	define [UpperOpenRoundInwardSerifed] : UpperOpenRest HOOK-ROUND TOP-INWARD-SERIFED

	define HYBRID-TOOTHED          0
	define HYBRID-TAILED           1
	define HYBRID-FLAT-BOTTOM      2
	define HYBRID-TOOTHLESS-CORNER 3
	define HYBRID-TOOTHLESS-ROUND  4

	define [HybridEtGlyph topShape kind] : glyph-proc
		include : intersection
			Rect (CAP * 2) (yEtMiddle - fineEt * 0.5) (-VERY-FAR) (+VERY-FAR)
			topShape
		include : dispiro
			flat Middle (yEtMiddle - (fineEt - SwAmpersand / 2)) [widths.heading fineEt 0 Rightward]
			curl xEtCenterBarRight (yEtMiddle - (fineEt - SwAmpersand / 2)) [heading Rightward]
		match kind
			[Just HYBRID-TOOTHED] : begin
				include : EtLowerHalf FORM-TOOTHED
				include : VBar.r xEtRight (adaEt + O) yEtRightBarTop
				include : VBar.r xEtRight adaEt 0 [Math.max [AdviceStroke 5] (Stroke - ShoulderFine / 2)]
			[Just HYBRID-TAILED] : begin
				include : EtLowerHalf FORM-TOOTHED
				include : RightwardTailedBar xEtRight 0 yEtRightBarTop
			[Just HYBRID-FLAT-BOTTOM] : begin
				include : EtLowerHalf FORM-FLAT-BOTTOM
				include : VBar.r xEtRight 0 yEtRightBarTop
			[Just HYBRID-TOOTHLESS-CORNER] : begin
				include : EtLowerHalf FORM-TOOTHLESS-CORNER
				include : VBar.r xEtRight DToothlessRise yEtRightBarTop
			__ : begin
				include : EtLowerHalf FORM-TOOTHLESS-ROUNDED

	define [EtGlyph hookType topSerif kind] : glyph-proc
		include : EtUpperHalf hookType topSerif
		match kind
			[Just HYBRID-TOOTHED] : begin
				include : EtLowerHalf FORM-TOOTHED
				include : VBar.r xEtRight (adaEt + O) yEtRightBarTop
				include : VBar.r xEtRight adaEt 0 [Math.max [AdviceStroke 5] (Stroke - ShoulderFine / 2)]
			[Just HYBRID-TAILED] : begin
				include : EtLowerHalf FORM-TOOTHED
				include : RightwardTailedBar xEtRight 0 yEtRightBarTop
			[Just HYBRID-FLAT-BOTTOM] : begin
				include : EtLowerHalf FORM-FLAT-BOTTOM
				include : VBar.r xEtRight 0 yEtRightBarTop
			[Just HYBRID-TOOTHLESS-CORNER] : begin
				include : EtLowerHalf FORM-TOOTHLESS-CORNER
				include : VBar.r xEtRight DToothlessRise yEtRightBarTop
			__ : begin
				include : EtLowerHalf FORM-TOOTHLESS-ROUNDED

	define [EtTopVariants hookSuffix hookType topSuffix topSerif] : begin
		create-glyph "ampersand.et\(hookSuffix)\(topSuffix)Toothed"           : EtGlyph hookType topSerif HYBRID-TOOTHED
		create-glyph "ampersand.et\(hookSuffix)\(topSuffix)Tailed"            : EtGlyph hookType topSerif HYBRID-TAILED
		create-glyph "ampersand.et\(hookSuffix)\(topSuffix)FlatBottom"        : EtGlyph hookType topSerif HYBRID-FLAT-BOTTOM
		create-glyph "ampersand.et\(hookSuffix)\(topSuffix)ToothlessCorner"   : EtGlyph hookType topSerif HYBRID-TOOTHLESS-CORNER
		create-glyph "ampersand.et\(hookSuffix)\(topSuffix)ToothlessRounded"  : EtGlyph hookType topSerif HYBRID-TOOTHLESS-ROUND

	define [UpperOpenEtTopVariants hookSuffix topShape topSuffix] : begin
		create-glyph "ampersand.upperOpenEt\(hookSuffix)\(topSuffix)Toothed"         : HybridEtGlyph topShape HYBRID-TOOTHED
		create-glyph "ampersand.upperOpenEt\(hookSuffix)\(topSuffix)Tailed"           : HybridEtGlyph topShape HYBRID-TAILED
		create-glyph "ampersand.upperOpenEt\(hookSuffix)\(topSuffix)FlatBottom"       : HybridEtGlyph topShape HYBRID-FLAT-BOTTOM
		create-glyph "ampersand.upperOpenEt\(hookSuffix)\(topSuffix)ToothlessCorner"  : HybridEtGlyph topShape HYBRID-TOOTHLESS-CORNER
		create-glyph "ampersand.upperOpenEt\(hookSuffix)\(topSuffix)ToothlessRounded" : HybridEtGlyph topShape HYBRID-TOOTHLESS-ROUND

	EtTopVariants '' HOOK-ROUND 'Serifed' TOP-SERIFED
	EtTopVariants '' HOOK-ROUND 'InwardSerifed' TOP-INWARD-SERIFED

	UpperOpenEtTopVariants '' UpperOpenRoundSerifed 'Serifed'
	UpperOpenEtTopVariants '' UpperOpenRoundInwardSerifed 'InwardSerifed'

	create-glyph 'ampersand.closedEtToothed'          : HybridEtGlyph ClosedRest HYBRID-TOOTHED
	create-glyph 'ampersand.closedEtTailed'           : HybridEtGlyph ClosedRest HYBRID-TAILED
	create-glyph 'ampersand.closedEtFlatBottom'       : HybridEtGlyph ClosedRest HYBRID-FLAT-BOTTOM
	create-glyph 'ampersand.closedEtToothlessCorner'  : HybridEtGlyph ClosedRest HYBRID-TOOTHLESS-CORNER
	create-glyph 'ampersand.closedEtToothlessRounded' : HybridEtGlyph ClosedRest HYBRID-TOOTHLESS-ROUND
	create-glyph 'ampersand.upperOpenEtToothed'          : HybridEtGlyph UpperOpenRoundRest HYBRID-TOOTHED
	create-glyph 'ampersand.upperOpenEtTailed'           : HybridEtGlyph UpperOpenRoundRest HYBRID-TAILED
	create-glyph 'ampersand.upperOpenEtFlatBottom'       : HybridEtGlyph UpperOpenRoundRest HYBRID-FLAT-BOTTOM
	create-glyph 'ampersand.upperOpenEtToothlessCorner'  : HybridEtGlyph UpperOpenRoundRest HYBRID-TOOTHLESS-CORNER
	create-glyph 'ampersand.upperOpenEtToothlessRounded' : HybridEtGlyph UpperOpenRoundRest HYBRID-TOOTHLESS-ROUND
	create-glyph 'ampersand.upperOpenEtFlatHookToothed'          : HybridEtGlyph UpperOpenFlatRest HYBRID-TOOTHED
	create-glyph 'ampersand.upperOpenEtFlatHookTailed'           : HybridEtGlyph UpperOpenFlatRest HYBRID-TAILED
	create-glyph 'ampersand.upperOpenEtFlatHookFlatBottom'       : HybridEtGlyph UpperOpenFlatRest HYBRID-FLAT-BOTTOM
	create-glyph 'ampersand.upperOpenEtFlatHookToothlessCorner'  : HybridEtGlyph UpperOpenFlatRest HYBRID-TOOTHLESS-CORNER
	create-glyph 'ampersand.upperOpenEtFlatHookToothlessRounded' : HybridEtGlyph UpperOpenFlatRest HYBRID-TOOTHLESS-ROUND
	create-glyph 'ampersand.upperOpenEtCornerHookToothed'          : HybridEtGlyph UpperOpenCornerRest HYBRID-TOOTHED
	create-glyph 'ampersand.upperOpenEtCornerHookTailed'           : HybridEtGlyph UpperOpenCornerRest HYBRID-TAILED
	create-glyph 'ampersand.upperOpenEtCornerHookFlatBottom'       : HybridEtGlyph UpperOpenCornerRest HYBRID-FLAT-BOTTOM
	create-glyph 'ampersand.upperOpenEtCornerHookToothlessCorner'  : HybridEtGlyph UpperOpenCornerRest HYBRID-TOOTHLESS-CORNER
	create-glyph 'ampersand.upperOpenEtCornerHookToothlessRounded' : HybridEtGlyph UpperOpenCornerRest HYBRID-TOOTHLESS-ROUND

	select-variant 'ampersand' '&'
