### Punctuation symbols
$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from '@iosevka/util'
import [DesignParameters] from '../../meta/aesthetics.mjs'

glyph-module

glyph-block Symbol-Punctuation-Small : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Symbol-Punctuation-Ellipsis EllipsisDotRadius
	glyph-block-import Mark-Above : OgonekTickShape MeasureGlyphBounds

	foreach {suffix {DrawAt kDotRadius overshoot}} [Object.entries DotVariants] : do
		create-glyph "period.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleI
			include : DrawAt df.middle (PeriodRadius * kDotRadius) (PeriodRadius * kDotRadius - overshoot)
		create-glyph "halfXhPeriod.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleI
			include : DrawAt df.middle (XH / 2) (PeriodRadius * kDotRadius - overshoot)
		create-glyph "xhPeriod.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleI
			include : DrawAt df.middle (XH - PeriodRadius * kDotRadius) (PeriodRadius * kDotRadius - overshoot)
			create-forked-glyph "sinologicalDot.\(suffix)" : df.markSet.e
		create-glyph "capPeriod.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleI
			include : DrawAt df.middle (CAP - PeriodRadius * kDotRadius) (PeriodRadius * kDotRadius - overshoot)

		create-glyph "smallPeriod.\(suffix)"        : DrawAt Middle (0   + DotRadius * kDotRadius) (DotRadius * kDotRadius - overshoot)
		create-glyph "halfXhSmallPeriod.\(suffix)"  : DrawAt Middle (XH  / 2)                      (DotRadius * kDotRadius - overshoot)
		create-glyph "halfCapSmallPeriod.\(suffix)" : DrawAt Middle (CAP / 2)                      (DotRadius * kDotRadius - overshoot)
		create-glyph "xhSmallPeriod.\(suffix)"      : DrawAt Middle (XH  - DotRadius * kDotRadius) (DotRadius * kDotRadius - overshoot)
		create-glyph "capSmallPeriod.\(suffix)"     : DrawAt Middle (CAP - DotRadius * kDotRadius) (DotRadius * kDotRadius - overshoot)

	select-variant 'period' '.' (follow -- 'punctuationDot')
	select-variant 'sinologicalDot' 0xA78F (follow -- 'diacriticDot')

	define [CommaShapeT cx cy gp] : new-glyph : glyph-proc
		set currentGlyph.gizmo [Translate 0 0]
		include gp
		local {.x mx1 .y my1} : GlobalTransform.apply {.x cx .y cy}
		include : Translate (mx1) (my1)

	glyph-block-export PrimeShape
	define [PrimeShape cx top bottom wide fine] : dispiro
		flat (cx + wide) top [widths.heading (fine * 1.2) (fine * 1.2) Downward]
		curl (cx - wide) bottom [widths.heading fine fine Downward]

	define [CommaShape kdr o _tailY] : namespace
		define r : PeriodRadius * kdr
		define tailY : fallback _tailY Descender
		define ro : r - o
		define sw    : Math.min [AdviceStroke 4] (r * 0.8)
		define swEnd : Math.min [AdviceStroke 2] (r * 1.0)
		define commaOverflow : r - swEnd / 2
		define rFill : ro - sw / 4
		define [CircularTail] : dispiro
			g4 r r [widths.rhs (sw / 4)]
			arcvh
			g4 0 o [widths.rhs (sw / 2)]
			archv
			g4 (-ro) r
			arcvh
			g4 0 (r + ro)
			archv
			g4 (+ro) r [widths.rhs sw]
			quadControls (0 + TanSlope / 2) (0.5 - TanSlope * (r / tailY)) 12
			g4 ([mix 0 tailY TanSlope] - commaOverflow) tailY [widths.rhs swEnd]

		export : define [round cx cy] : CommaShapeT cx cy : glyph-proc
			include : union
				spiro-outline
					g4 rFill rFill
					arcvh
					g4 0 0
					archv
					g4 (-rFill) rFill
					arcvh
					g4 0 (2 * rFill)
					archv
					close
				CircularTail

		export : define [square cx cy] : with-transform [Translate cx cy] : glyph-proc
			include : union
				SquareAt 0 r r
				dispiro
					flat r r [widths.rhs sw]
					curl r 0 [widths.rhs sw]
					quadControls (0 + TanSlope / 2) (0.5 - TanSlope * (r / tailY)) 12
					g4 ([mix 0 tailY TanSlope] - commaOverflow) tailY [widths.rhs swEnd]

		define q : r * Math.SQRT2
		define swDia : 0.88 * q
		define swDiaTip : 0.48 * swDia
		define diamondOverflow : r - swDiaTip / 2
		define [DiamondTail] : dispiro
			flat q r [widths.rhs.heading swDia Downward]
			curl q [mix r (r - q) 0.18] [widths.rhs.heading swDia Downward]
			quadControls (0 + TanSlope / 2) (0.6 - TanSlope * (r / tailY)) 12
			g4 ([mix 0 tailY TanSlope] - diamondOverflow) tailY [widths.rhs swDiaTip]

		export : define [diamond cx cy] : CommaShapeT cx cy : glyph-proc
			include : union
				DiamondAt 0 r r
				DiamondTail

		export : define [hexagon cx cy] : with-transform [Translate cx cy] : AngularCommaAt 'hexagon' 0 r r tailY
		export : define [corner cx cy] : with-transform [Translate cx cy] : AngularCommaAt 'corner' 0 r r tailY
		export : define [bottomCut cx cy] : with-transform [Translate cx cy] : AngularCommaAt 'bottomCut' 0 r r tailY

		export : define [prime cx cy] : CommaShapeT cx cy : glyph-proc
			local fine : 0.5 * [AdviceStroke 2]
			local stress : 1.2 * fine
			include : PrimeShape 0 (2 * rFill - stress / 2) tailY r fine

		export : define [tick cx cy] : glyph-proc
			local tickBounds nothing
			local tickShape : new-glyph : glyph-proc
				include : OgonekTickShape cx (cy + 2 * r)
				set tickBounds : include : MeasureGlyphBounds
			local primeBounds nothing
			local primeShape : new-glyph : glyph-proc
				include : prime cx cy
				set primeBounds : include : MeasureGlyphBounds
			local scale : (primeBounds.yMax - primeBounds.yMin) / (tickBounds.yMax - tickBounds.yMin)
			include : with-transform [ApparentTranslate (cx * (1 - scale)) (primeBounds.yMax - scale * tickBounds.yMax)]
				with-transform [Scale scale scale] tickShape

	define [RevCommaShape kdr o] : namespace
		define r : PeriodRadius * kdr
		define ro : r - o
		define sw    : Math.min [AdviceStroke 4] (r * 0.8)
		define swEnd : Math.min [AdviceStroke 2] (r * 1.0)
		define commaOverflow : r - swEnd / 2
		define rFill : ro - sw / 4
		define [CircularTail] : dispiro
			g4 (-r) r [widths.lhs (sw / 4)]
			arcvh
			g4 0 o [widths.lhs (sw / 2)]
			archv
			g4 (+ro) r
			arcvh
			g4 0 (r + ro)
			archv
			g4 (-ro) r [widths.lhs sw]
			quadControls (0 - TanSlope / 2) (0.5 - TanSlope * (r / Descender)) 12
			g4 ([mix 0 Descender TanSlope] + commaOverflow) Descender [widths.lhs swEnd]

		export : define [round cx cy] : CommaShapeT cx cy : glyph-proc
			include : union
				spiro-outline
					g4 rFill rFill
					arcvh
					g4 0 0
					archv
					g4 (-rFill) rFill
					arcvh
					g4 0 (2 * rFill)
					archv
					close
				CircularTail

		export : define [square cx cy] : with-transform [Translate cx cy] : glyph-proc
			include : union
				SquareAt 0 r r
				dispiro
					flat (-r) r [widths.lhs sw]
					curl (-r) 0
					quadControls (0 - TanSlope / 2) (0.5 - TanSlope * (r / Descender)) 12
					g4 ([mix 0 Descender TanSlope] + commaOverflow) Descender [widths.lhs swEnd]

		define q : r * Math.SQRT2
		define swDia : 0.88 * q
		define swDiaTip : 0.48 * swDia
		define diamondOverflow : r - swDiaTip / 2
		define [DiamondTail] : dispiro
			flat (-q) r [widths.lhs.heading swDia Downward]
			curl (-q) [mix r (r - q) 0.18] [widths.lhs.heading swDia Downward]
			quadControls (0 - TanSlope / 2) (0.6 - TanSlope * (r / Descender)) 12
			g4 ([mix 0 Descender TanSlope] + diamondOverflow) Descender [widths.lhs swDiaTip]

		export : define [diamond cx cy] : CommaShapeT cx cy : glyph-proc
			include : union
				DiamondAt 0 r r
				DiamondTail

		export : define [hexagon cx cy] : with-transform [Translate cx cy] : with-transform [ScaleAround 0 0 (-1) 1] : AngularCommaAt 'hexagon' 0 r r Descender
		export : define [corner cx cy] : with-transform [Translate cx cy] : with-transform [ScaleAround 0 0 (-1) 1] : AngularCommaAt 'corner' 0 r r Descender
		export : define [bottomCut cx cy] : with-transform [Translate cx cy] : with-transform [ScaleAround 0 0 (-1) 1] : AngularCommaAt 'bottomCut' 0 r r Descender

		export : define [prime cx cy] : CommaShapeT cx cy : glyph-proc
			local fine : 0.5 * [AdviceStroke 2]
			local stress : 1.2 * fine
			include : with-transform [ScaleAround 0 0 (-1) 1] : PrimeShape 0 (2 * rFill - stress / 2) Descender r fine

	foreach {suffix {DrawAt kDotRadius overshoot}} [Object.entries DotVariants] : do
		create-glyph "comma.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleI
			include : [CommaShape kDotRadius overshoot].(suffix) df.middle 0
		create-glyph "revComma.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleI
			include : [RevCommaShape kDotRadius overshoot].(suffix) df.middle 0
		create-glyph "comma/asDiacritic.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleSp
			include : [CommaShape kDotRadius overshoot].(suffix) df.middle 0
		create-glyph "revComma/asDiacritic.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleSp
			include : [RevCommaShape kDotRadius overshoot].(suffix) df.middle 0

	create-glyph 'comma.prime' : glyph-proc
		local df : include : DivFrame para.advanceScaleI
		include : [CommaShape 1 O].prime df.middle 0
	create-glyph 'revComma.prime' : glyph-proc
		local df : include : DivFrame para.advanceScaleI
		include : [RevCommaShape 1 O].prime df.middle 0
	create-glyph 'comma/asDiacritic.prime' : glyph-proc
		local df : include : DivFrame para.advanceScaleSp
		include : [CommaShape 1 O].prime df.middle 0
	create-glyph 'revComma/asDiacritic.prime' : glyph-proc
		local df : include : DivFrame para.advanceScaleSp
		include : [RevCommaShape 1 O].prime df.middle 0

	foreach {name scale reversed} {
		{'comma' para.advanceScaleI false}
		{'revComma' para.advanceScaleI true}
		{'comma/asDiacritic' para.advanceScaleSp false}
		{'revComma/asDiacritic' para.advanceScaleSp true}
	} : do
		create-glyph "\(name).tick" : glyph-proc
			local df : include : DivFrame scale
			include : with-transform [ScaleAround df.middle 0 [if reversed (-1) 1] 1]
				[CommaShape 1 O].tick df.middle 0

	foreach suffix {'corner' 'bottomCut'} : do
		foreach {name scale reversed} {
			{'comma' para.advanceScaleI false}
			{'revComma' para.advanceScaleI true}
			{'comma/asDiacritic' para.advanceScaleSp false}
			{'revComma/asDiacritic' para.advanceScaleSp true}
		} : do
			create-glyph "\(name).\(suffix)" : glyph-proc
				local df : include : DivFrame scale
				include : with-transform [ScaleAround df.middle 0 [if reversed (-1) 1] 1]
					[CommaShape SquareDotScalar 0].(suffix) df.middle 0

	select-variant 'comma' ',' (follow -- 'punctuationComma')
	select-variant 'revComma' 0x2E41 (follow -- 'punctuationComma')

	select-variant 'comma/asDiacritic' (follow -- 'diacriticComma')
	select-variant 'revComma/asDiacritic' (follow -- 'diacriticComma')

	turned 'turnComma.round'  null 'comma.round'  [DivFrame para.advanceScaleI].middle PeriodRadius
	turned 'turnComma.square' null 'comma.square' [DivFrame para.advanceScaleI].middle (PeriodRadius * SquareDotScalar)
	turned 'turnComma.diamond' null 'comma.diamond' [DivFrame para.advanceScaleI].middle (PeriodRadius * SquareDotScalar)
	turned 'turnComma.prime'  null 'comma.prime'  [DivFrame para.advanceScaleI].middle PeriodRadius
	turned 'turnComma.tick'   null 'comma.tick'   [DivFrame para.advanceScaleI].middle PeriodRadius
	foreach suffix {'hexagon' 'corner' 'bottomCut'} : do
		turned "turnComma.\(suffix)" null "comma.\(suffix)" [DivFrame para.advanceScaleI].middle (PeriodRadius * [if (suffix === 'hexagon') HexagonDotScalar SquareDotScalar])
	select-variant 'turnComma' 0x2E32 (follow -- 'punctuationComma')

	derive-composites 'raisedPeriod.round'  null 'period.round'  [ApparentTranslate 0 (XH / 2 - PeriodRadius)]
	derive-composites 'raisedPeriod.square' null 'period.square' [ApparentTranslate 0 (XH / 2 - PeriodRadius * SquareDotScalar)]
	derive-composites 'raisedPeriod.diamond' null 'period.diamond' [ApparentTranslate 0 (XH / 2 - PeriodRadius * SquareDotScalar)]
	derive-composites 'raisedPeriod.hexagon' null 'period.hexagon' [ApparentTranslate 0 (XH / 2 - PeriodRadius * HexagonDotScalar)]
	derive-composites 'raisedComma.round'   null 'comma.round'   [ApparentTranslate 0 (XH / 2 - PeriodRadius)]
	derive-composites 'raisedComma.square'  null 'comma.square'  [ApparentTranslate 0 (XH / 2 - PeriodRadius * SquareDotScalar)]
	derive-composites 'raisedComma.diamond' null 'comma.diamond' [ApparentTranslate 0 (XH / 2 - PeriodRadius * SquareDotScalar)]
	derive-composites 'raisedComma.prime'   null 'comma.prime'   [ApparentTranslate 0 (XH / 2 - PeriodRadius)]
	derive-composites 'raisedComma.tick'    null 'comma.tick'    [ApparentTranslate 0 (XH / 2 - PeriodRadius)]
	foreach suffix {'hexagon' 'corner' 'bottomCut'} : do
		derive-composites "raisedComma.\(suffix)" null "comma.\(suffix)" [ApparentTranslate 0 (XH / 2 - PeriodRadius * [if (suffix === 'hexagon') HexagonDotScalar SquareDotScalar])]
	select-variant 'raisedPeriod' 0x2E33 (follow -- 'punctuationDot')
	select-variant 'raisedComma'  0x2E34 (follow -- 'punctuationComma')

	foreach {suffix {DrawAt kDotRadius overshoot}} [Object.entries DotVariants] : do
		create-glyph "colon.\(suffix)" : glyph-proc
			include [refer-glyph "period.\(suffix)"] AS_BASE ALSO_METRICS
			include [refer-glyph "xhPeriod.\(suffix)"]

			create-forked-glyph "colon/mid.\(suffix)" : glyph-proc
				include : ApparentTranslate 0 (SymbolMid - XH / 2)

		create-glyph "capColon.\(suffix)" : glyph-proc
			include [refer-glyph "period.\(suffix)"] AS_BASE ALSO_METRICS
			include [refer-glyph "capPeriod.\(suffix)"]

		create-glyph "mdfColon.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleSp
			local k 0.9
			local dr : DotRadius * kDotRadius
			include : DrawAt df.middle [mix dr (XH - dr) (0 + k)] (dr - overshoot)
			include : DrawAt df.middle [mix dr (XH - dr) (1 - k)] (dr - overshoot)

		create-glyph "mdfRaisedColon.\(suffix)" : glyph-proc
			local df : include : DivFrame para.advanceScaleSp
			local k 0.9
			local dr : DotRadius * kDotRadius
			include : DrawAt df.middle (CAP - [mix dr (XH - dr) (0 + k)]) (dr - overshoot)
			include : DrawAt df.middle (CAP - [mix dr (XH - dr) (1 - k)]) (dr - overshoot)

		create-glyph "doubleStackedComma.\(suffix)" : glyph-proc
			local shift : XH - 2 * PeriodRadius * kDotRadius
			if (suffix === 'hexagon') : begin
				local commaBounds nothing
				local commaShape : new-glyph : glyph-proc
					include : refer-glyph "comma.\(suffix)"
					set commaBounds : include : MeasureGlyphBounds
				set shift : Math.max shift (commaBounds.yMax - commaBounds.yMin + 0.1 * PeriodRadius)
			include [refer-glyph "comma.\(suffix)"] AS_BASE ALSO_METRICS
			include : with-transform [ApparentTranslate 0 shift] : composite-proc
				refer-glyph "comma.\(suffix)"

		local multiDotShift : RightSB - (DotRadius * kDotRadius) - Middle
		local multiDotShiftDense : [mix Width RightSB 0.5] - (DotRadius * kDotRadius) - Middle

		create-glyph "threeDotPunct.\(suffix)" : glyph-proc
			include : with-transform [ApparentTranslate (+multiDotShift) 0] : composite-proc
				refer-glyph "smallPeriod.\(suffix)"
				refer-glyph "xhSmallPeriod.\(suffix)"
			include : with-transform [ApparentTranslate (-multiDotShift) 0] : composite-proc
				refer-glyph "halfXhSmallPeriod.\(suffix)"

		create-glyph "geor/paragraphSeparator.\(suffix)" : glyph-proc
			include : with-transform [ApparentTranslate (+multiDotShift) 0] : composite-proc
				refer-glyph "halfXhSmallPeriod.\(suffix)"
			include : with-transform [ApparentTranslate (-multiDotShift) 0] : composite-proc
				refer-glyph "smallPeriod.\(suffix)"
				refer-glyph "xhSmallPeriod.\(suffix)"

		create-glyph "twoDotOverOneDotPunct.\(suffix)" : glyph-proc
			include [refer-glyph "smallPeriod.\(suffix)"]
			include : with-transform [ApparentTranslate (+multiDotShiftDense) 0] : composite-proc
				refer-glyph "xhSmallPeriod.\(suffix)"
			include : with-transform [ApparentTranslate (-multiDotShiftDense) 0] : composite-proc
				refer-glyph "xhSmallPeriod.\(suffix)"

		create-glyph "oneDotOverTwoDotPunct.\(suffix)" : glyph-proc
			include [refer-glyph "xhSmallPeriod.\(suffix)"]
			include : with-transform [ApparentTranslate (+multiDotShiftDense) 0] : composite-proc
				refer-glyph "smallPeriod.\(suffix)"
			include : with-transform [ApparentTranslate (-multiDotShiftDense) 0] : composite-proc
				refer-glyph "smallPeriod.\(suffix)"

		create-glyph "fourDotPunct.\(suffix)" : glyph-proc
			include [refer-glyph "smallPeriod.\(suffix)"]
			include [refer-glyph "xhSmallPeriod.\(suffix)"]
			include : with-transform [ApparentTranslate (+multiDotShiftDense) 0] : composite-proc
				refer-glyph "halfXhSmallPeriod.\(suffix)"
			include : with-transform [ApparentTranslate (-multiDotShiftDense) 0] : composite-proc
				refer-glyph "halfXhSmallPeriod.\(suffix)"

		create-glyph "capFourDotPunct.\(suffix)" : glyph-proc
			include [refer-glyph "smallPeriod.\(suffix)"]
			include [refer-glyph "capSmallPeriod.\(suffix)"]
			include : with-transform [ApparentTranslate (+multiDotShiftDense) 0] : composite-proc
				refer-glyph "halfCapSmallPeriod.\(suffix)"
			include : with-transform [ApparentTranslate (-multiDotShiftDense) 0] : composite-proc
				refer-glyph "halfCapSmallPeriod.\(suffix)"

		create-glyph "squareFourDotPunct.\(suffix)" : glyph-proc
			include : with-transform [ApparentTranslate (-multiDotShiftDense) 0] : composite-proc
				refer-glyph "smallPeriod.\(suffix)"
				refer-glyph "xhSmallPeriod.\(suffix)"
			include : with-transform [ApparentTranslate (+multiDotShiftDense) 0] : composite-proc
				refer-glyph "smallPeriod.\(suffix)"
				refer-glyph "xhSmallPeriod.\(suffix)"

		create-glyph "fiveDotPunct.\(suffix)" : glyph-proc
			include : refer-glyph "squareFourDotPunct.\(suffix)"
			include : refer-glyph "halfXhSmallPeriod.\(suffix)"

		create-glyph "fiveDotMark.\(suffix)" : glyph-proc
			local l : mix SB 0 0.5
			local r : mix RightSB Width 0.5
			local radius : EllipsisDotRadius 3 [Math.min XH (r - l)]
			include : DrawAt  Middle  radius       (kDotRadius * radius - overshoot)
			include : DrawAt  Middle (XH / 2)      (kDotRadius * radius - overshoot)
			include : DrawAt  Middle (XH - radius) (kDotRadius * radius - overshoot)

			include : DrawAt (l + radius) (XH / 2) (kDotRadius * radius - overshoot)
			include : DrawAt (r - radius) (XH / 2) (kDotRadius * radius - overshoot)

		create-glyph "dottedCross.\(suffix)" : glyph-proc
			include : HBar.m [mix 0 SB 0.5] [mix Width RightSB 0.5] (XH / 2) OperatorStroke
			include : VBar.m Middle 0 XH OperatorStroke
			local radius : HSwToV : 0.5 * [AdviceStroke 3]
			include : DrawAt (SB + radius)      (XH * 0.75) (kDotRadius * radius - overshoot)
			include : DrawAt (SB + radius)      (XH * 0.25) (kDotRadius * radius - overshoot)
			include : DrawAt (RightSB - radius) (XH * 0.75) (kDotRadius * radius - overshoot)
			include : DrawAt (RightSB - radius) (XH * 0.25) (kDotRadius * radius - overshoot)

	create-glyph 'doubleStackedComma.prime' : glyph-proc
		include [refer-glyph 'comma.prime'] AS_BASE ALSO_METRICS
		include : with-transform [ApparentTranslate 0 (XH - 2 * PeriodRadius)] : composite-proc
			refer-glyph 'comma.prime'

	create-glyph 'doubleStackedComma.tick' : glyph-proc
		local commaBounds nothing
		local commaShape : new-glyph : glyph-proc
			include : refer-glyph 'comma.tick'
			set commaBounds : include : MeasureGlyphBounds
		local shift : Math.max (XH - 2 * PeriodRadius) (commaBounds.yMax - commaBounds.yMin + 0.1 * PeriodRadius)
		include [refer-glyph 'comma.tick'] AS_BASE ALSO_METRICS
		include : with-transform [ApparentTranslate 0 shift] : refer-glyph 'comma.tick'

	foreach suffix {'corner' 'bottomCut'} : do
		create-glyph "doubleStackedComma.\(suffix)" : glyph-proc
			local commaBounds nothing
			local commaShape : new-glyph : glyph-proc
				include : refer-glyph "comma.\(suffix)"
				set commaBounds : include : MeasureGlyphBounds
			local shift : Math.max (XH - 2 * PeriodRadius * SquareDotScalar) (commaBounds.yMax - commaBounds.yMin + 0.1 * PeriodRadius)
			include [refer-glyph "comma.\(suffix)"] AS_BASE ALSO_METRICS
			include : with-transform [ApparentTranslate 0 shift] : refer-glyph "comma.\(suffix)"

	# Glyphs that draw both a dot and a comma follow both selectors at once.
	foreach dotSuffix [Object.keys DotVariants] : do
		foreach commaSuffix [Object.keys DotVariants] : do
			create-glyph "semicolon.\(dotSuffix).\(commaSuffix)" : glyph-proc
				include [refer-glyph "comma.\(commaSuffix)"] AS_BASE ALSO_METRICS
				include [refer-glyph "xhPeriod.\(dotSuffix)"]

			create-glyph "revSemicolon.\(dotSuffix).\(commaSuffix)" : glyph-proc
				include [refer-glyph "revComma.\(commaSuffix)"] AS_BASE ALSO_METRICS
				include [refer-glyph "xhPeriod.\(dotSuffix)"]

		create-glyph "semicolon.\(dotSuffix).prime" : glyph-proc
			include [refer-glyph 'comma.prime'] AS_BASE ALSO_METRICS
			include [refer-glyph "xhPeriod.\(dotSuffix)"]

		create-glyph "revSemicolon.\(dotSuffix).prime" : glyph-proc
			include [refer-glyph 'revComma.prime'] AS_BASE ALSO_METRICS
			include [refer-glyph "xhPeriod.\(dotSuffix)"]

		create-glyph "semicolon.\(dotSuffix).tick" : glyph-proc
			include [refer-glyph 'comma.tick'] AS_BASE ALSO_METRICS
			include [refer-glyph "xhPeriod.\(dotSuffix)"]
		create-glyph "revSemicolon.\(dotSuffix).tick" : glyph-proc
			include [refer-glyph 'revComma.tick'] AS_BASE ALSO_METRICS
			include [refer-glyph "xhPeriod.\(dotSuffix)"]

		foreach suffix {'corner' 'bottomCut'} : do
			create-glyph "semicolon.\(dotSuffix).\(suffix)" : glyph-proc
				include [refer-glyph "comma.\(suffix)"] AS_BASE ALSO_METRICS
				include [refer-glyph "xhPeriod.\(dotSuffix)"]
			create-glyph "revSemicolon.\(dotSuffix).\(suffix)" : glyph-proc
				include [refer-glyph "revComma.\(suffix)"] AS_BASE ALSO_METRICS
				include [refer-glyph "xhPeriod.\(dotSuffix)"]

	select-variant 'colon' ':' (follow -- 'punctuationDot')
	select-variant 'colon/mid' (follow -- 'punctuationDot')
	select-variant 'mdfColon' 0xA789 (follow -- 'diacriticDot')
	select-variant 'mdfRaisedColon' 0x2F8 (follow -- 'diacriticDot')
	select-multi-dimensional-variant 'semicolon' ';'
		follows -- {'punctuationDot' 'punctuationComma'}
	select-multi-dimensional-variant 'revSemicolon' 0x204F
		follows -- {'punctuationDot' 'punctuationComma'}
	select-variant 'doubleStackedComma' 0x2E49 (follow -- 'punctuationComma')

	select-variant 'threeDotPunct' 0x2056 (follow -- 'punctuationDot')
	select-variant 'geor/paragraphSeparator' 0x10FB (follow -- 'punctuationDot')
	select-variant 'twoDotOverOneDotPunct' 0x2E2A (follow -- 'punctuationDot')
	select-variant 'oneDotOverTwoDotPunct' 0x2E2B (follow -- 'punctuationDot')

	select-variant 'fourDotPunct' 0x2058 (follow -- 'punctuationDot')
	select-variant 'squareFourDotPunct' 0x2E2C (follow -- 'punctuationDot')
	select-variant 'fiveDotPunct' 0x2059 (follow -- 'punctuationDot')
	select-variant 'fiveDotMark' 0x2E2D (follow -- 'punctuationDot')

	select-variant 'capColon' 0x205A (follow -- 'punctuationDot')
	select-variant 'capFourDotPunct' 0x205B (follow -- 'punctuationDot')

	select-variant 'dottedCross' 0x205C (follow -- 'punctuationDot')

	alias 'grek/question' 0x37E 'semicolon'
	alias 'armn/fullstop' 0x589 'colon'

	turned 'turnSemicolon' 0x2E35 'semicolon' [DivFrame para.advanceScaleI].middle (XH / 2)

	do 'Stenographic full stop, medieval comma, punctus elevatus'
		foreach {suffix {DrawAt kDotRadius overshoot}} [Object.entries DotVariants] : do
			create-glyph "stenographicFullStop.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleI
				local r : PeriodRadius * kDotRadius
				local cy r
				local arm : r * 1.28
				local sw : Math.min OverlayStroke (r * 0.95)
				include : union
					dispiro
						widths.center sw
						corner (df.middle - arm) (cy - arm)
						corner (df.middle + arm) (cy + arm)
					dispiro
						widths.center sw
						corner (df.middle - arm) (cy + arm)
						corner (df.middle + arm) (cy - arm)

			create-glyph "medievalComma.\(suffix)" : glyph-proc
				local df : include : DivFrame para.advanceScaleI
				local dr : PeriodRadius * kDotRadius
				include : DrawAt df.middle dr (dr - overshoot)
				local sw : Math.min Stroke [AdviceStroke 3]
				local yBot : 2 * dr + 0.5 * sw + 0.6 * dr
				local rad : (0 - Descender) / 2
				local cy : yBot + rad
				include : dispiro
					widths.center sw
					g4.right.start df.middle (cy + rad) [heading Rightward]
					archv
					g4.down.mid (df.middle + rad) cy [heading Downward]
					arcvh
					g4.left.end df.middle (cy - rad) [heading Leftward]

		select-variant 'stenographicFullStop' 0x2E3C (follow -- 'punctuationDot')
		select-variant 'medievalComma' 0x2E4C (follow -- 'punctuationDot')

		foreach {dotSuffix {DrawAtDot kDotRadiusDot overshootDot}} [Object.entries DotVariants] : do
			foreach {commaSuffix {DrawAtComma kCommaRadius overshootComma}} [Object.entries DotVariants] : do
				create-glyph "punctusElevatus.\(dotSuffix).\(commaSuffix)" : glyph-proc
					local df : include : DivFrame para.advanceScaleI
					local r : PeriodRadius * kCommaRadius
					include [refer-glyph "period.\(dotSuffix)"] AS_BASE ALSO_METRICS
					include : new-glyph : glyph-proc
						include : [CommaShape kCommaRadius overshootComma (0 - 2.05 * r)].(commaSuffix) df.middle 0
						include : Ungizmo
						include : Translate (-df.middle) (-r)
						include : Rotate (Math.PI / 2)
						include : Scale 1 (-1)
						include : Translate df.middle (XH - 1.2 * r)
						include : Regizmo

			create-glyph "punctusElevatus.\(dotSuffix).prime" : glyph-proc
				local df : include : DivFrame para.advanceScaleI
				local r : PeriodRadius * 1
				include [refer-glyph "period.\(dotSuffix)"] AS_BASE ALSO_METRICS
				include : new-glyph : glyph-proc
					include : [CommaShape 1 O (0 - 2.05 * r)].prime df.middle 0
					include : Ungizmo
					include : Translate (-df.middle) (-r)
					include : Rotate (Math.PI / 2)
					include : Scale 1 (-1)
					include : Translate df.middle (XH - 1.2 * r)
					include : Regizmo

			create-glyph "punctusElevatus.\(dotSuffix).tick" : glyph-proc
				local df : include : DivFrame para.advanceScaleI
				local r PeriodRadius
				include [refer-glyph "period.\(dotSuffix)"] AS_BASE ALSO_METRICS
				include : new-glyph : glyph-proc
					include : [CommaShape 1 O (0 - 2.05 * r)].tick df.middle 0
					include : Ungizmo
					include : Translate (-df.middle) (-r)
					include : Rotate (Math.PI / 2)
					include : Scale 1 (-1)
					include : Translate df.middle (XH - 1.2 * r)
					include : Regizmo

			foreach suffix {'corner' 'bottomCut'} : do
				create-glyph "punctusElevatus.\(dotSuffix).\(suffix)" : glyph-proc
					local df : include : DivFrame para.advanceScaleI
					local r : PeriodRadius * SquareDotScalar
					include [refer-glyph "period.\(dotSuffix)"] AS_BASE ALSO_METRICS
					include : new-glyph : glyph-proc
						include : [CommaShape SquareDotScalar 0 (0 - 2.05 * r)].(suffix) df.middle 0
						include : Ungizmo
						include : Translate (-df.middle) (-r)
						include : Rotate (Math.PI / 2)
						include : Scale 1 (-1)
						include : Translate df.middle (XH - 1.2 * r)
						include : Regizmo

		select-multi-dimensional-variant 'punctusElevatus' 0x2E4E
			follows -- {'punctuationDot' 'punctuationComma'}

	# Hollow (no CV)

	define [RingCommaStroke mx my rad s k1x k1y k2x k2y] : begin
		local u : my + rad
		local d : my - rad
		local l : mx - rad
		local r : mx + rad
		local fine : s * CThin
		return : dispiro
			widths.rhs [fallback fine]
			g4 mx (u - s + fine) [heading Rightward]
			archv
			g4 (r - s + [mix fine s 0.5]) my [widths.rhs : mix fine s 0.5]
			arcvh
			g4 mx d [widths.rhs.heading s Leftward]
			archv
			g4 l my
			arcvh
			g4 mx u [heading Rightward]
			archv
			g4 r my [widths.rhs fine]
			flat (mx + rad * k1x) (d + rad * k1y) [widths.rhs s]
			curl (mx - rad * k2x) (d - rad * k2y)

	create-glyph 'hollowColon' 0x2982 : glyph-proc
		local df : include : DivFrame para.advanceScaleI
		define sw : AdviceStroke 5
		define dotRadius : Math.max PeriodRadius (XH / 8)
		include : RingStrokeAt df.middle (XH - dotRadius) (dotRadius + sw / 2 - O) sw
		include : RingStrokeAt df.middle dotRadius (dotRadius + sw / 2 - O) sw

	create-glyph 'zNotationSchemaComposition' 0x2A1F : glyph-proc
		local df : include : DivFrame para.advanceScaleI
		define sw : AdviceStroke 5
		define dotRadius : Math.max PeriodRadius (XH / 8)
		include : RingStrokeAt df.middle (XH - dotRadius) (dotRadius + sw / 2 - O) sw
		include : intersection
			MaskAbove Descender
			RingCommaStroke df.middle dotRadius (dotRadius + sw / 2 - O) sw 0.75 0 1 3

	create-glyph 'zNotationRelationalComposition' 0x2A3E : glyph-proc
		local df : include : DivFrame para.advanceScaleI
		define sw : AdviceStroke 6.5
		define dotRadius : 0.625 * [Math.max PeriodRadius (XH / 8)]
		include : RingStrokeAt df.middle (0.625 * XH - dotRadius) (dotRadius + sw / 2 - O) sw
		include : intersection
			MaskAbove (Descender * 0.75)
			RingCommaStroke df.middle dotRadius (dotRadius + sw / 2 - O) sw 0.75 0 0.75 3
