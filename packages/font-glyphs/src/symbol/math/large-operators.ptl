$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"

glyph-module

glyph-block Symbol-Math-Large-Operators : for-width-kinds WideWidth1
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Shared-Symbol-Shapes : TriangleShape
	glyph-block-import Letter-Latin-Long-S : LongSShape
	glyph-block-import Letter-Greek-Upper-Sigma : SigmaShape
	glyph-block-import Letter-Greek-Pi : PiShape
	glyph-block-import Letter-Blackboard : BBS BBD

	define MosaicTop    fontMetrics.os2.sTypoAscender
	define MosaicBottom fontMetrics.os2.sTypoDescender
	define MosaicHeight : MosaicTop - MosaicBottom

	define advanceScaleLargeOperators : if (FMosaicWide && para.isQuasiProportional) para.advanceScaleMM : Math.max para.advanceScaleM (MosaicWidth / Width)
	define df : DivFrame advanceScaleLargeOperators 0 [if FMosaicWide advanceScaleLargeOperators 1]

	glyph-block-export TwoWedgeShape TwoVeeShape

	create-glyph [MangleName 'sum'] [MangleUnicode 0x2211] : glyph-proc
		set-width df.width
		include : SigmaShape df BgOpTop BgOpBot OperatorStroke

	create-glyph [MangleName 'sumUpper'] [MangleUnicode 0x23B2] : glyph-proc
		set-width df.width
		include : intersection
			MaskAbove MosaicBottom
			SigmaShape df BgOpTop (BgOpBot - MosaicHeight * 2) OperatorStroke (pxMid -- 0.75)

	create-glyph [MangleName 'sumLower'] [MangleUnicode 0x23B3] : glyph-proc
		set-width df.width
		include : intersection
			MaskBelow MosaicTop
			SigmaShape df (BgOpTop + MosaicHeight * 2) BgOpBot OperatorStroke (pxMid -- 0.75)

	create-glyph [MangleName 'mathbb/sum'] [MangleUnicode 0x2140] : glyph-proc
		set-width df.width
		local kDiag : DiagCorDs (BgOpTop - BgOpBot) (df.rightSB - df.leftSB) BBD
		include : SigmaShape df BgOpTop BgOpBot BBS (doSerif -- false)
		include : SigmaShape df BgOpTop BgOpBot BBS (doSerif -- false) (offsetLeft -- (kDiag * BBD))

	create-glyph [MangleName 'product'] [MangleUnicode 0x220F] : glyph-proc
		set-width df.width
		include : PiShape df BgOpTop BgOpBot (shrinkRate -- 0) (fine -- OperatorStroke) (doSerif -- SLAB)

	turned [MangleName 'coproduct'] [MangleUnicode 0x2210] [MangleName 'product'] df.middle SymbolMid

	create-glyph [MangleName 'Vee'] [MangleUnicode 0x22C1] : glyph-proc
		set-width df.width
		include : dispiro
			widths.center OperatorStroke
			flat df.leftSB BgOpTop
			curl df.middle BgOpBot [heading Downward]
		include : dispiro
			widths.center OperatorStroke
			flat df.rightSB BgOpTop
			curl df.middle BgOpBot [heading Downward]

	turned [MangleName 'Wedge'] [MangleUnicode 0x22C0] [MangleName 'Vee'] df.middle SymbolMid

	create-glyph [MangleName 'Cup'] [MangleUnicode 0x22C3] : glyph-proc
		set-width df.width
		include : UShape BgOpTop BgOpBot df.leftSB df.rightSB OperatorStroke
			df.archDepthAOf (ArchDepth / [Math.sqrt df.adws]) OperatorStroke
			df.archDepthBOf (ArchDepth / [Math.sqrt df.adws]) OperatorStroke

	turned [MangleName 'Cap'] [MangleUnicode 0x22C2] [MangleName 'Cup'] df.middle SymbolMid

	WithDotVariants [MangleName 'CupDot'] [MangleUnicode 0x2A03] : function [DrawAt kr ov] : glyph-proc
		local sw : AdviceStroke 4
		local span : Math.max (df.rightSB - df.leftSB) [HSwToV (sw * 5)]
		local radius : Math.min (DotRadius * kr * OperatorStroke / Stroke) ((span - [HSwToV (2 * sw)]) * 0.18)
		set-width df.width
		include : UShape BgOpTop BgOpBot (df.middle - span / 2) (df.middle + span / 2) sw
			df.archDepthAOf (ArchDepth / [Math.sqrt df.adws]) sw
			df.archDepthBOf (ArchDepth / [Math.sqrt df.adws]) sw
		include : DrawAt df.middle (SymbolMid + (BgOpTop - BgOpBot) * 0.05) (radius - ov)

	create-glyph [MangleName 'CupPlus'] [MangleUnicode 0x2A04] : glyph-proc
		local outerSw : AdviceStroke 4
		local span : Math.max (df.rightSB - df.leftSB) [HSwToV (outerSw * 5)]
		local size : Math.min ((span - [HSwToV (2 * outerSw)]) * 0.3) ((BgOpTop - BgOpBot) * 0.15)
		local sw : Math.min [AdviceStrokeInSpace (size * 2) 3] (size * 0.45)
		local y : SymbolMid + (BgOpTop - BgOpBot) * 0.04
		set-width df.width
		include : UShape BgOpTop BgOpBot (df.middle - span / 2) (df.middle + span / 2) outerSw
			df.archDepthAOf (ArchDepth / [Math.sqrt df.adws]) outerSw
			df.archDepthBOf (ArchDepth / [Math.sqrt df.adws]) outerSw
		include : HBar.m (df.middle - size) (df.middle + size) y sw
		include : VBar.m df.middle (y - size) (y + size) sw

	define [TwoWedgeShape frame top bot] : glyph-proc
		local usable : frame.rightSB - frame.leftSB
		local shift : usable * 0.15
		local sw : Math.min [AdviceStroke 4] (usable * 0.1)
		local outerSw : Math.min [AdviceStroke2 2.5 3 (top - bot)] (usable * 0.16)
		set-width frame.width
		foreach j [range 0 2] : begin
			local x : frame.middle + (j * 2 - 1) * shift
			include : dispiro
				widths.center [if (j == 0) outerSw sw]
				flat (x - usable * 0.35) bot
				curl x top
			include : dispiro
				widths.center [if (j == 1) outerSw sw]
				flat x top
				curl (x + usable * 0.35) bot

	create-glyph [MangleName 'twoWedge'] [MangleUnicode 0x2A07] : TwoWedgeShape df BgOpTop BgOpBot

	define [TwoVeeShape frame top bot] : glyph-proc
		include : with-transform [FlipAround frame.middle SymbolMid] : TwoWedgeShape frame top bot

	turned [MangleName 'twoVee'] [MangleUnicode 0x2A08] [MangleName 'twoWedge'] df.middle SymbolMid

	create-glyph [MangleName 'moduloTwoSum'] [MangleUnicode 0x2A0A] : glyph-proc
		local ringRadius : Math.min [Math.max ((df.rightSB - df.leftSB) * 0.36) [HSwToV (OperatorStroke * 1.5)]] ((BgOpTop - BgOpBot) * 0.36)
		local ringStroke : Math.min [AdviceStrokeInSpace (ringRadius * 2) 4] (ringRadius * 0.3)
		local sigma : new-glyph : SigmaShape df BgOpTop BgOpBot [AdviceStroke 4]
		local ringMask : OShapeOutline.NoOvershoot (SymbolMid + ringRadius) (SymbolMid - ringRadius) (df.middle - ringRadius) (df.middle + ringRadius)
		set-width df.width
		include : union
			difference sigma ringMask
			intersection ringMask : SigmaShape df BgOpTop BgOpBot ringStroke
			RingStrokeAt df.middle SymbolMid ringRadius ringStroke

	create-glyph [MangleName 'sumIntegral'] [MangleUnicode 0x2A0B] : glyph-proc
		local halfHeight : (BgOpTop - BgOpBot) * 0.31
		set-width df.width
		include : SigmaShape df (SymbolMid + halfHeight) (SymbolMid - halfHeight) [AdviceStroke 4]
		include : with-transform [ApparentTranslate (df.middle - Middle) 0]
			LongSShape BgOpTop BgOpBot Hook (Hook * 0.75) [AdviceStroke 4]

	create-glyph [MangleName 'Top'] [MangleUnicode 0x27D9] : glyph-proc
		set-width df.width
		include : HBar.t df.leftSB df.rightSB BgTkTop OperatorStroke
		include : VBar.m df.middle BgTkTop BgTkBot OperatorStroke

	turned [MangleName 'Bot'] [MangleUnicode 0x27D8] [MangleName 'Top'] df.middle SymbolMid

	# These operators are always wide. In force-monospace variants they will be deleted
	if (MosaicWidthScalar > 1 && !para.forceMonospace) : do
		define longWidth : MathOperatorWidth MosaicWidth FMosaicWide
		define kLongTackSB : [DivFrame MosaicWidthScalar 4].leftSB / [DivFrame MosaicWidthScalar 2].leftSB

		define l : mix 0 SB kLongTackSB
		define r : longWidth - l

		create-glyph 'longVDash' 0x27DD : glyph-proc
			set-width longWidth
			include : HBar.m l r SymbolMid OperatorStroke
			include : VBar.l l TackTop TackBot OperatorStroke

		turned 'longDashV' 0x27DE 'longVDash' (longWidth / 2) SymbolMid

	create-glyph [MangleName 'SquareCap'] [MangleUnicode 0x2A05] : glyph-proc
		set-width df.width
		include : PiShape df BgOpTop BgOpBot (shrinkRate -- 0) (fine -- OperatorStroke) (doSerif -- false)

	turned [MangleName 'SquareCup'] [MangleUnicode 0x2A06] [MangleName 'SquareCap'] df.middle SymbolMid

	create-glyph [MangleName 'Multiply'] [MangleUnicode 0x2A09] : glyph-proc
		set-width df.width
		include : dispiro
			widths.center OperatorStroke
			corner df.leftSB  BgOpTop
			corner df.rightSB BgOpBot
		include : dispiro
			widths.center OperatorStroke
			corner df.leftSB  BgOpBot
			corner df.rightSB BgOpTop

	create-glyph [MangleName 'Bowtie'] [MangleUnicode 0x2A1D] : glyph-proc
		set-width df.width
		define swBowtie   : Math.min OperatorStroke : AdviceStroke 4.25 MosaicWidthScalar
		define swBowtieHv : Math.min OperatorStroke : AdviceStroke 4.75 MosaicWidthScalar
		include : union
			intersection
				MaskRight df.leftSB
				MaskLeft df.rightSB
				union
					dispiro
						widths.center swBowtie
						corner df.leftSB  BgOpTop
						corner df.rightSB BgOpBot
					dispiro
						widths.center swBowtie
						corner df.leftSB  BgOpBot
						corner df.rightSB BgOpTop
			intersection
				spiro-outline
					corner df.leftSB  BgOpBot
					corner df.rightSB BgOpTop
					corner df.rightSB BgOpBot
					corner df.leftSB  BgOpTop
				union
					VBar.l df.leftSB  BgOpBot BgOpTop swBowtieHv
					VBar.r df.rightSB BgOpBot BgOpTop swBowtieHv

	create-glyph [MangleName 'WhiteTriangleLeft'] [MangleUnicode 0x2A1E] : glyph-proc
		set-width df.width
		include : TriangleShape df.leftSB SymbolMid df.rightSB BgOpTop df.rightSB BgOpBot OperatorStroke
