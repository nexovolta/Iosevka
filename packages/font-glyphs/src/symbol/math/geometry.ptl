$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"

glyph-module

glyph-block Symbol-Math-Geometry : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Shared-Symbol-Shapes : VZigzag Polyline
	glyph-block-import Symbol-Geometric-Shared : ConvexPolygonOutline
	glyph-block-import Symbol-Math-Relation-Inequality : LessShape GreaterShape

	local kBox : 2 / 3
	local leftBox : SB * kBox
	local rightBox : Width - SB * kBox
	local radiusBox : (rightBox - leftBox) / 2
	local topBox : SymbolMid + radiusBox
	local bottomBox : SymbolMid - radiusBox

	define [UpTriangle cx cy halfWidth halfHeight] : spiro-outline
		corner cx (cy + halfHeight)
		corner (cx + halfWidth) (cy - halfHeight)
		corner (cx - halfWidth) (cy - halfHeight)

	define [UpTriangleOutline cx cy halfWidth halfHeight stroke] : ConvexPolygonOutline [new-glyph : UpTriangle cx cy halfWidth halfHeight] stroke

	create-glyph 'mathRightTriangle' 0x22BF : glyph-proc
		include : intersection
			spiro-outline
				corner leftBox bottomBox
				corner rightBox bottomBox
				corner rightBox topBox
			union
				dispiro [widths.lhs GeometryStroke] [flat leftBox bottomBox] [curl rightBox bottomBox]
				dispiro [widths.lhs GeometryStroke] [flat rightBox bottomBox] [curl rightBox topBox]
				dispiro [widths.lhs GeometryStroke] [flat rightBox topBox] [curl leftBox bottomBox]

	create-glyph 'angle' 0x2220 : glyph-proc
		include : intersection
			spiro-outline
				corner leftBox bottomBox
				corner rightBox bottomBox
				corner rightBox topBox
			union
				dispiro [widths.lhs GeometryStroke] [flat leftBox bottomBox] [curl rightBox bottomBox]
				dispiro [widths.lhs GeometryStroke] [flat rightBox topBox] [curl leftBox bottomBox]

	turned 'turnAngle' 0x29A2 'angle' Middle SymbolMid

	create-glyph 'revAngle' 0x29A3 : glyph-proc
		include : intersection
			spiro-outline
				corner leftBox topBox
				corner leftBox bottomBox
				corner rightBox bottomBox
			union
				dispiro [widths.lhs GeometryStroke] [flat leftBox bottomBox] [curl rightBox bottomBox]
				dispiro [widths.rhs GeometryStroke] [flat leftBox topBox] [curl rightBox bottomBox]

	create-glyph 'threeDimensionalAngle' 0x27C0 : glyph-proc
		local halfStroke : GeometryStroke / 2
		local left : leftBox + TanSlope * radiusBox + halfStroke
		local rightBottom : rightBox + TanSlope * radiusBox - halfStroke
		local rightTop : rightBox - TanSlope * radiusBox - halfStroke
		include : union
			dispiro
				widths.center GeometryStroke
				corner left bottomBox
				corner left topBox
			dispiro
				widths.center GeometryStroke
				corner left bottomBox
				corner rightBottom bottomBox
			dispiro
				widths.center GeometryStroke
				corner left bottomBox
				corner rightTop topBox
			Rect (bottomBox + halfStroke) (bottomBox - halfStroke) (left - halfStroke) (left + halfStroke)

	create-glyph 'whiteTriangleContainingWhiteTriangle' 0x27C1 : glyph-proc
		local triangleHalfWidth : radiusBox * 0.97
		local triangleHalfHeight : radiusBox * 0.95
		local triangleStroke : Math.min [AdviceStroke 5] (GeometryStroke * 0.75)
		local outerStroke : Math.min (triangleStroke * 1.25) (radiusBox * 0.14)
		local innerInset 0.54
		local innerHalfWidth : triangleHalfWidth * (1 - innerInset)
		local innerHalfHeight : triangleHalfHeight * (1 - innerInset)
		local triangleCentroidY : SymbolMid - triangleHalfHeight / 3
		local innerCenterY : triangleCentroidY + innerHalfHeight / 3
		include : union
			UpTriangleOutline Middle SymbolMid triangleHalfWidth triangleHalfHeight outerStroke
			UpTriangle Middle innerCenterY innerHalfWidth innerHalfHeight

	create-glyph 'measuredAngle' 0x2221 : glyph-proc
		include [refer-glyph 'angle'] AS_BASE ALSO_METRICS
		include : intersection
			spiro-outline
				corner leftBox (bottomBox - [Math.tan (15 / 180 * Math.PI)] * radiusBox)
				corner rightBox (bottomBox - [Math.tan (15 / 180 * Math.PI)] * radiusBox)
				corner rightBox (bottomBox + 2 * [Math.tan (60 / 180 * Math.PI)] * radiusBox)
				corner leftBox bottomBox
			RingStrokeAt leftBox bottomBox (1.2 * radiusBox + GeometryStroke) GeometryStroke

	create-glyph 'sphericalAngle' 0x2222 : glyph-proc
		include : intersection
			spiro-outline
				corner leftBox SymbolMid
				corner rightBox bottomBox
				corner rightBox topBox
			union
				dispiro [widths.lhs GeometryStroke] [flat leftBox SymbolMid] [curl rightBox bottomBox]
				dispiro [widths.lhs GeometryStroke] [flat rightBox topBox] [curl leftBox SymbolMid]
		include : intersection
			spiro-outline
				corner leftBox SymbolMid
				corner rightBox (SymbolMid - 2 * [Math.tan (45 / 180 * Math.PI)] * radiusBox)
				corner rightBox (SymbolMid + 2 * [Math.tan (45 / 180 * Math.PI)] * radiusBox)
			RingStrokeAt leftBox SymbolMid (1.2 * radiusBox + GeometryStroke) GeometryStroke

	create-glyph 'rightAngle' 0x221F : glyph-proc
		include : intersection
			spiro-outline
				corner leftBox bottomBox
				corner rightBox bottomBox
				corner rightBox topBox
				corner leftBox topBox
			union
				dispiro [widths.lhs GeometryStroke] [flat leftBox bottomBox] [curl rightBox bottomBox]
				dispiro [widths.lhs GeometryStroke] [flat leftBox topBox] [curl leftBox bottomBox]

	create-glyph 'rightAngleWithArc' 0x22BE : glyph-proc
		include [refer-glyph 'rightAngle'] AS_BASE ALSO_METRICS
		include : intersection
			spiro-outline
				corner leftBox bottomBox
				corner rightBox bottomBox
				corner rightBox topBox
				corner leftBox topBox
			RingStrokeAt leftBox bottomBox (1.2 * radiusBox + GeometryStroke) GeometryStroke

	define symbolFine : AdviceStrokeInSpace (radiusBox * 2) 8
	define arrowStroke : AdviceStrokeInSpace (radiusBox * 2) 6.5
	define tallStroke : AdviceStrokeInSpace (radiusBox * 2) 4.5
	define [AcuteAngleShape l r b t sw] : intersection
		spiro-outline
			corner l b
			corner r b
			corner r t
		union
			dispiro [widths.lhs sw] [flat l b] [curl r b]
			dispiro [widths.lhs sw] [flat r t] [curl l b]

	create-glyph 'rightAngleWithSquare' 0x299C : glyph-proc
		local l : leftBox + symbolFine * 0.6
		local r : rightBox - symbolFine * 0.6
		local side : radiusBox * 0.85
		include : VBar.m (l + symbolFine / 2) bottomBox topBox symbolFine
		include : HBar.m l r (bottomBox + symbolFine / 2) symbolFine
		include : VBar.m (l + side) bottomBox (bottomBox + side) symbolFine
		include : HBar.m l (l + side) (bottomBox + side) symbolFine

	create-glyph 'measuredRightAngleWithDot' 0x299D : glyph-proc
		local l : leftBox + symbolFine * 0.6
		local r : rightBox - symbolFine * 0.6
		include : VBar.m (l + symbolFine / 2) bottomBox topBox symbolFine
		include : HBar.m l r (bottomBox + symbolFine / 2) symbolFine
		include : intersection
			Rect topBox bottomBox l r
			RingStrokeAt l bottomBox (radiusBox * 1.25) symbolFine
		local dotRadius : AdviceStrokeInSpace (radiusBox * 0.6) 4
		include : DotAt (l + radiusBox * 0.5) (bottomBox + radiusBox * 0.5) dotRadius

	create-glyph 'angleWithS' 0x299E : glyph-proc
		local l : leftBox + symbolFine * 1.5
		local r : rightBox - symbolFine * 1.5
		include : AcuteAngleShape l r bottomBox topBox symbolFine
		include : with-transform [ApparentTranslate (radiusBox * 0.48) (bottomBox + radiusBox * 0.25)] : with-transform [ScaleAround Middle 0 0.22 0.22] : refer-glyph 's'

	create-glyph 'acuteAngle' 0x299F : glyph-proc
		local y : SymbolMid - radiusBox * 0.35
		include : AcuteAngleShape leftBox rightBox y (SymbolMid + radiusBox * 0.35) symbolFine

	create-glyph 'sphericalAngleFine' : glyph-proc
		include : intersection
			spiro-outline
				corner leftBox SymbolMid
				corner rightBox bottomBox
				corner rightBox topBox
			union
				dispiro [widths.lhs symbolFine] [flat leftBox SymbolMid] [curl rightBox bottomBox]
				dispiro [widths.lhs symbolFine] [flat rightBox topBox] [curl leftBox SymbolMid]
		include : intersection
			Rect (SymbolMid + radiusBox * 0.72) (SymbolMid - radiusBox * 0.72) (leftBox + radiusBox * 0.75) (leftBox + radiusBox * 1.3)
			RingStrokeAt leftBox SymbolMid (radiusBox * 1.2) symbolFine
	turned 'sphericalAngleOpeningLeft' 0x29A0 'sphericalAngleFine' Middle SymbolMid
	create-glyph 'sphericalAngleOpeningUp' 0x29A1 : glyph-proc
		include : with-transform [Italify para.slopeAngle] : with-transform [Translate Middle SymbolMid] : with-transform [Rotate (Math.PI / 2)] : with-transform [Translate (-Middle) (-SymbolMid)] : with-transform [Italify (-para.slopeAngle)] : refer-glyph 'sphericalAngleFine'

	create-glyph 'angleWithUnderbar' 0x29A4 : glyph-proc
		local y : SymbolMid - radiusBox * 0.4
		local l : leftBox + symbolFine * 1.5
		local r : rightBox - symbolFine * 1.5
		include : AcuteAngleShape l r y topBox symbolFine
		include : HBar.m l r (bottomBox + symbolFine / 2) symbolFine
	create-glyph 'reversedAngleWithUnderbar' 0x29A5 : glyph-proc
		include : with-transform [ScaleAround Middle SymbolMid (-1) 1] : refer-glyph 'angleWithUnderbar'

	create-glyph 'obliqueAngleOpeningUp' 0x29A6 : glyph-proc
		local l : leftBox + symbolFine
		local y : SymbolMid - radiusBox * 0.65
		local x : l + radiusBox * 0.5
		include : dispiro : Polyline [widths.center symbolFine]
			points -- { { l (SymbolMid + radiusBox * 0.65) } { x y } { (rightBox - symbolFine) y } }
	create-glyph 'obliqueAngleOpeningDown' 0x29A7 : glyph-proc
		include : with-transform [ScaleAround Middle SymbolMid 1 (-1)] : refer-glyph 'obliqueAngleOpeningUp'

	define [MeasuredArrowAngle arrow] : glyph-proc
		local sw : if arrow arrowStroke symbolFine
		local l : leftBox + sw * 0.8
		local r : rightBox - sw * 0.8
		local b : bottomBox + sw * 0.5
		local t : topBox - sw * 0.5
		local angleBody : union
			AcuteAngleShape l r b t sw
			intersection
				spiro-outline
					corner l b
					corner r b
					corner r t
				RingStrokeAt l b (radiusBox * 1.25) symbolFine
		if arrow : begin
			local a : radiusBox * 0.6
			include : union angleBody : dispiro : Polyline [widths.center sw]
				points -- { { (r - a) t } { r t } { r (t - a) } }
		: else : include angleBody

	create-glyph 'measuredAngleOpeningLeft' 0x299B : glyph-proc
		include : with-transform [ScaleAround Middle SymbolMid (-1) 1] : MeasuredArrowAngle false
	create-glyph 'measuredAngleArrowUpRight' 0x29A8 : MeasuredArrowAngle true
	create-glyph 'measuredAngleArrowUpLeft' 0x29A9 : glyph-proc
		include : with-transform [ScaleAround Middle SymbolMid (-1) 1] : refer-glyph 'measuredAngleArrowUpRight'
	create-glyph 'measuredAngleArrowDownRight' 0x29AA : glyph-proc
		include : with-transform [ScaleAround Middle SymbolMid 1 (-1)] : refer-glyph 'measuredAngleArrowUpRight'
	turned 'measuredAngleArrowDownLeft' 0x29AB 'measuredAngleArrowUpRight' Middle SymbolMid

	create-glyph 'measuredAngleArrowRightUp' 0x29AC : glyph-proc
		include : with-transform [ScaleAround Middle SymbolMid (-1) 1] : with-transform [Italify para.slopeAngle] : with-transform [Translate Middle SymbolMid] : with-transform [Rotate (Math.PI / 2)] : with-transform [Translate (-Middle) (-SymbolMid)] : with-transform [Italify (-para.slopeAngle)] : refer-glyph 'measuredAngleArrowUpRight'
	create-glyph 'measuredAngleArrowLeftUp' 0x29AD : glyph-proc
		include : with-transform [ScaleAround Middle SymbolMid (-1) 1] : refer-glyph 'measuredAngleArrowRightUp'
	create-glyph 'measuredAngleArrowRightDown' 0x29AE : glyph-proc
		include : with-transform [ScaleAround Middle SymbolMid 1 (-1)] : refer-glyph 'measuredAngleArrowRightUp'
	turned 'measuredAngleArrowLeftDown' 0x29AF 'measuredAngleArrowRightUp' Middle SymbolMid

	define circleStroke symbolFine
	define [CircleRelationShape less] : glyph-proc
		local r : radiusBox * 0.95
		local w : r * 0.5
		local h : r * 0.5
		include : RingStrokeAt Middle SymbolMid r circleStroke
		if less : include : LessShape (SymbolMid + h) (SymbolMid - h) (Middle - w) (Middle + w) circleStroke
		: else : include : GreaterShape (SymbolMid + h) (SymbolMid - h) (Middle - w) (Middle + w) circleStroke
	create-glyph 'circledLessThan' 0x29C0 : CircleRelationShape true
	create-glyph 'circledGreaterThan' 0x29C1 : CircleRelationShape false

	create-glyph 'circleWithSmallCircleRight' 0x29C2 : glyph-proc
		local r : radiusBox * 0.68
		local x : Middle - radiusBox * 0.2
		include : RingStrokeAt x SymbolMid r circleStroke
		include : RingStrokeAt (x + r * 1.35) SymbolMid (r * 0.25) [AdviceStrokeInSpace (r * 0.5) 4]
	create-glyph 'circleWithTwoStrokesRight' 0x29C3 : glyph-proc
		local r : radiusBox * 0.68
		local x : Middle - radiusBox * 0.2
		include : RingStrokeAt x SymbolMid r circleStroke
		include : HBar.m (x + r * 0.9) rightBox (SymbolMid + r * 0.22) circleStroke
		include : HBar.m (x + r * 0.9) rightBox (SymbolMid - r * 0.22) circleStroke

	create-glyph 'sInTriangle' 0x29CC : glyph-proc
		include : UpTriangleOutline Middle SymbolMid (radiusBox * 0.97) (radiusBox * 0.95) [AdviceStrokeInSpace (radiusBox * 2) 10]
		include : with-transform [ApparentTranslate 0 (bottomBox + radiusBox * 0.28)] : with-transform [ScaleAround Middle 0 0.27 0.27] : refer-glyph 'S'

	define [LeftTriangleShape l r h] : spiro-outline
		corner l SymbolMid
		corner r (SymbolMid + h)
		corner r (SymbolMid - h)
	create-glyph 'leftTriangleBesideVerticalBar' 0x29CF : glyph-proc
		local l : leftBox + radiusBox * 0.12
		local r : rightBox - radiusBox * 0.32
		local h : radiusBox * 0.67
		include : ConvexPolygonOutline [new-glyph : LeftTriangleShape l r h] circleStroke
		include : VBar.m (rightBox - circleStroke / 2) (SymbolMid - h) (SymbolMid + h) circleStroke
	turned 'verticalBarBesideRightTriangle' 0x29D0 'leftTriangleBesideVerticalBar' Middle SymbolMid

	define [SmallDiamond cx cy r] : spiro-outline
		corner cx (cy + r)
		corner (cx + r) cy
		corner cx (cy - r)
		corner (cx - r) cy

	define [DownArrowBelowShape top] : glyph-proc
		local bottom : Descender + tallStroke / 2
		local a : radiusBox * 0.42
		include : union
			VBar.m Middle bottom top tallStroke
			dispiro : Polyline [widths.center tallStroke]
				points -- { { (Middle - a) (bottom + a) } { Middle bottom } { (Middle + a) (bottom + a) } }

	create-glyph 'blackDiamondWithDownArrow' 0x29EA : glyph-proc
		local r : radiusBox * 0.76 + tallStroke * 0.2
		local cy : Ascender - r - tallStroke / 2
		include : SmallDiamond Middle cy r
		include : DownArrowBelowShape (cy - r + tallStroke)
	create-glyph 'whiteCircleWithDownArrow' 0x29EC : glyph-proc
		local r : radiusBox * 0.76 + tallStroke * 0.2
		local cy : Ascender - r - tallStroke / 2
		include : RingStrokeAt Middle cy r tallStroke
		include : DownArrowBelowShape (cy - r + tallStroke)
	create-glyph 'blackCircleWithDownArrow' 0x29ED : glyph-proc
		local r : radiusBox * 0.76 + tallStroke * 0.2
		local cy : Ascender - r - tallStroke / 2
		include : RingAt Middle cy r
		include : DownArrowBelowShape (cy - r + tallStroke)

	define [ErrorBarredShape shape filled] : glyph-proc
		local r : radiusBox * 0.77 + tallStroke * 0.2
		local sw tallStroke
		local capTop : Ascender - sw / 2
		local capBottom : Descender + sw / 2
		local mid : mix Ascender Descender 0.5
		local capWidth : radiusBox * 0.52
		include : VBar.m Middle (mid + r - sw) capTop sw
		include : VBar.m Middle capBottom (mid - r + sw) sw
		include : HBar.m (Middle - capWidth) (Middle + capWidth) capTop sw
		include : HBar.m (Middle - capWidth) (Middle + capWidth) capBottom sw
		if (shape === 'square') : begin
			if filled : include : Rect (mid + r) (mid - r) (Middle - r) (Middle + r)
			: else : include : difference
				Rect (mid + r) (mid - r) (Middle - r) (Middle + r)
				Rect (mid + r - sw) (mid - r + sw) (Middle - r + sw) (Middle + r - sw)
		if (shape === 'diamond') : begin
			if filled : include : SmallDiamond Middle mid r
			: else : include : ConvexPolygonOutline [new-glyph : SmallDiamond Middle mid r] sw
		if (shape === 'circle') : begin
			if filled : include : RingAt Middle mid r
			: else : include : RingStrokeAt Middle mid r sw
	create-glyph 'errorBarredWhiteSquare' 0x29EE : ErrorBarredShape 'square' false
	create-glyph 'errorBarredBlackSquare' 0x29EF : ErrorBarredShape 'square' true
	create-glyph 'errorBarredWhiteDiamond' 0x29F0 : ErrorBarredShape 'diamond' false
	create-glyph 'errorBarredBlackDiamond' 0x29F1 : ErrorBarredShape 'diamond' true
	create-glyph 'errorBarredWhiteCircle' 0x29F2 : ErrorBarredShape 'circle' false
	create-glyph 'errorBarredBlackCircle' 0x29F3 : ErrorBarredShape 'circle' true

	create-glyph 'revRightAngle' 0x2BFE : glyph-proc
		include : intersection
			spiro-outline
				corner leftBox bottomBox
				corner rightBox bottomBox
				corner rightBox topBox
				corner leftBox topBox
			union
				dispiro [widths.lhs GeometryStroke] [flat leftBox bottomBox] [curl rightBox bottomBox]
				dispiro [widths.rhs GeometryStroke] [flat rightBox topBox] [curl rightBox bottomBox]

	WithDotVariants 'pullback' 0x27D3 : function [DrawAt kr ov] : glyph-proc
		include [refer-glyph 'revRightAngle'] AS_BASE ALSO_METRICS
		local offset : mix 0 GeometryStroke 0.5
		include : DrawAt (Middle - offset) (SymbolMid + offset) (DotRadius * kr * [AdviceStroke 4] / Stroke - ov)

	turned 'pushout' 0x27D4 'pullback' Middle SymbolMid

	create-glyph 'sineWave' 0x223F : glyph-proc
		define N 64
		local knots {}
		define [Wave x] : [Math.sin x] + 0.05 * [Math.sin (3 * x)]
		foreach t [range 0 till N] : begin
			knots.push : g2
				mix leftBox rightBox (t / N)
				mix bottomBox topBox : 0.5 + 0.5 * [Wave : 2 * Math.PI * t / N]

		include : dispiro [widths.center GeometryStroke] knots

	create-glyph 'wavyLine' 0x2307 : glyph-proc
		define N 64
		local knots {}
		define [Wave x] : [Math.sin x] + 0.05 * [Math.sin (3 * x)]
		foreach t [range 0 till N] : begin
			knots.push : g2
				mix leftBox rightBox : 0.5 + 0.1 * [Wave : 4 * Math.PI * t / N]
				mix TackBot TackTop (t / N)

		include : dispiro [widths.center GeometryStroke] knots

	create-glyph 'wigglyLine' 0x2E3E : glyph-proc
		define N 4
		local knots {}
		local stroke : AdviceStroke2 4 12 (ParenTop - ParenBot)
		local halfSw : 0.5 * stroke
		local halfVSw : HSwToV halfSw

		local bot : ParenBot + halfSw
		local top : ParenTop - halfSw
		local left  : Middle - [Math.max (radiusBox / 4) (halfVSw * 1.1)] - halfVSw
		local right : Middle + [Math.max (radiusBox / 4) (halfVSw * 1.1)] + halfVSw

		foreach t [range 0 till N] : begin
			local cl : left + halfVSw
			local cr : right - halfVSw
			local pm   0.875
			knots.push : g2.right.mid [mix cl cr 0.5] [mix bot top ((t + 0/8) / N)] [heading Rightward]
			knots.push : g2.up.mid    cr              [mix bot top ((t + 2/8) / N)] [heading Upward]
			knots.push : g2.left.mid  [mix cl cr 0.5] [mix bot top ((t + 4/8) / N)] [heading Leftward]
			knots.push : g2.up.mid    cl              [mix bot top ((t + 6/8) / N)] [heading Upward]

		include : dispiro
			widths.center stroke
			straight.right.start left bot
			knots.slice 0 (-3)
			straight.right.end right top

	do 'Zigzags'
		create-glyph 'vertZigzag' 0x299A : intersection [MaskAbove ParenBot] [MaskBelow ParenTop]
			VZigzag.fromSide Middle ParenBot ParenTop (radiusBox / 4) 9 0 GeometryStroke
		create-glyph 'wigglyFenceLeft'  0x29D8 : intersection [MaskAbove ParenBot] [MaskBelow ParenTop]
			VZigzag.fromSide Middle ParenBot ParenTop (radiusBox / 4) 10 1 GeometryStroke
		create-glyph 'wigglyFenceRight' 0x29D9 : intersection [MaskAbove ParenBot] [MaskBelow ParenTop]
			VZigzag.fromSide Middle ParenBot ParenTop (radiusBox / 4) 10 0 GeometryStroke

		define space : (rightBox - leftBox - [HSwToV GeometryStroke] * 2) / 3
		create-glyph 'doubleWigglyFenceLeft' 0x29DA : glyph-proc
			include : with-transform [ApparentTranslate   space  0] : refer-glyph 'wigglyFenceLeft'
			include : with-transform [ApparentTranslate (-space) 0] : refer-glyph 'wigglyFenceLeft'
		create-glyph 'doubleWigglyFenceRight' 0x29DB : glyph-proc
			include : with-transform [ApparentTranslate   space  0] : refer-glyph 'wigglyFenceRight'
			include : with-transform [ApparentTranslate (-space) 0] : refer-glyph 'wigglyFenceRight'
